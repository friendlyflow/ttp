7574206974732076616C7565
#     .equ msg_value_len, . - msg_value
:msg_many 4D313A20746F6F206D616E79206D6163 # msg_many:       .ascii "M1: too many macros"
726F73
#     .equ msg_many_len, . - msg_many
:msg_large 4D313A20696E70757420746F6F206C61 # msg_large:      .ascii "M1: input too large"
726765
#     .equ msg_large_len, . - msg_large
:msg_long 4D313A206F757470757420746F6F206C # msg_long:       .ascii "M1: output too large"
61726765
#     .equ msg_long_len, . - msg_long
:msg_read 4D313A2072656164206661696C6564 # msg_read:       .ascii "M1: read failed"
#     .equ msg_read_len, . - msg_read
:msg_write 4D313A207772697465206661696C6564 # msg_write:      .ascii "M1: write failed"
#     .equ msg_write_len, . - msg_write
000000                                  #     .balign 4                           // the code, 4-byte aligned (zeros)

