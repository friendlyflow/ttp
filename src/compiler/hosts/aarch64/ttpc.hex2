~buf 13000090 !buf 73020091             #     la      x19, buf
F40313AA                                #     mov     x20, x19
0902A0D2                                #     mov     x9, #BUF_SIZE
7802098B                                #     add     x24, x19, x9                // end of buf
:read_loop                              # read_loop:
9F0218EB                                #     cmp     x20, x24
