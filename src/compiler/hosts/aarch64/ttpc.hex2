#
# The section .bss: no bytes in the file, only its labels
#     .section .bss
#     .balign 8
^00412158 :nodes                        # nodes:          .skip MAX_NODES * NODE_size
^00612158 :ptrs                         # ptrs:           .skip MAX_NODES * 8
^00652158 :syms                         # syms:           .skip MAX_NODES * 8         // the function NODEs, see collect_syms
^00692158 :labels                       # labels:         .skip MAX_NODES * LABEL_size
^00752158 :scopes                       # scopes:         .skip MAX_DEPTH * 8         // the placed functions around pc
^00752358 :vregs                        # vregs:          .skip 32 * 8                // the registers of exec context
^00752458 :linebuf                      # linebuf:        .skip 24                    // hex of an emitted word
^00752470 :outbuf                       # outbuf:         .skip OUT_SIZE
^00852470 :buf                          # buf:            .skip BUF_SIZE

# Registers that live across the whole program:
#   x19 (s0)  parse cursor in buf
#   x20 (s1)  end of the loaded bytes
#   x21 (s2)  next free NODE in nodes
#   x22 (s3)  next free slot in ptrs

