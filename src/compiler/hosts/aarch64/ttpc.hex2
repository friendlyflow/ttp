29F17DD3                                #     lsl     x9, x9, #3
4A01098B                                #     add     x10, x10, x9
5A815FF8                                #     ldr     x26, [x10, #-8]             // the program page
3B0080D2                                #     mov     x27, #1                     // pass
:assemble.1 ~pass 09000090 !pass 29010091 # 1:  la      x9, pass
3B0100F9                                #     str     x27, [x9, #0]
~cur_pc 09000090 !cur_pc 29010091       #     la      x9, cur_pc
3F0100F9                                #     str     xzr, [x9, #0]
