F80B00F9                                #     str     x24, [sp, #16]              // width
F90F00F9                                #     str     x25, [sp, #24]              // the call
    # [sp, #32]: the word in memory
F70300AA                                #     mov     x23, x0
F80301AA                                #     mov     x24, x1
F90302AA                                #     mov     x25, x2
F71300F9                                #     str     x23, [sp, #32]
