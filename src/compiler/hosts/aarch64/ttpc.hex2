020314CB                                #     sub     x2, x24, x20
E80780D2                                #     mov     x8, #SYS_read
010000D4                                #     svc     #0
1F0000F1                                #     cmp     x0, #0
@read_failed 0B000054                   #     b.lt    read_failed
