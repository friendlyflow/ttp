# The ops of exec_ops: x11 = x10 op x9 (t2 = t1 op t0), then exec_store,
# still in the frame of execute. All 64 bits, as RV64: mul keeps the low
# 64 bits, the shifts take their amount mod 64.
:op_add                                 # op_add:
4B01098B                                #     add     x11, x10, x9
^~exec_store 14                         #     b       exec_store
:op_sub                                 # op_sub:
4B0109CB                                #     sub     x11, x10, x9
^~exec_store 14                         #     b       exec_store
:op_and                                 # op_and:
4B01098A                                #     and     x11, x10, x9
^~exec_store 14                         #     b       exec_store
:op_or                                  # op_or:
4B0109AA                                #     orr     x11, x10, x9
^~exec_store 14                         #     b       exec_store
:op_xor                                 # op_xor:
4B0109CA                                #     eor     x11, x10, x9
^~exec_store 14                         #     b       exec_store
:op_sll                                 # op_sll:
4B21C99A                                #     lsl     x11, x10, x9
^~exec_store 14                         #     b       exec_store
:op_srl                                 # op_srl:
4B25C99A                                #     lsr     x11, x10, x9
^~exec_store 14                         #     b       exec_store
:op_sra                                 # op_sra:
4B29C99A                                #     asr     x11, x10, x9
^~exec_store 14                         #     b       exec_store
:op_mul                                 # op_mul:
4B7D099B                                #     mul     x11, x10, x9
# exec_store: stores x11 in the destination vreg x28 and returns from
# execute.
:exec_store                             # exec_store:
@exec_store.1 1C0000B4                  #     cbz     x28, 1f                     // x0 stays 0
~vregs 09000090 !vregs 29010091         #     la      x9, vregs
8AF37DD3                                #     lsl     x10, x28, #3
29010A8B                                #     add     x9, x9, x10
2B0100F9                                #     str     x11, [x9, #0]
:exec_store.1 FE0340F9                  # 1:  ldr     x30, [sp, #0]
F70740F9                                #     ldr     x23, [sp, #8]
F80B40F9                                #     ldr     x24, [sp, #16]
F90F40F9                                #     ldr     x25, [sp, #24]
FA1340F9                                #     ldr     x26, [sp, #32]
FB1740F9                                #     ldr     x27, [sp, #40]
FC1B40F9                                #     ldr     x28, [sp, #48]
FD1F40F9                                #     ldr     x29, [sp, #56]
FF830191                                #     add     sp, sp, #96
C0035FD6                                #     ret

# ---------------------------------------------------------------------------
# Encoding and output
# ---------------------------------------------------------------------------

# encode: encodes instruction x0, its parameters bound in frame x1: x0 =
# the word, x1 = its width in bits (8, 16, 32 or 64). The fields come MSB
# first: word = word << width | value.
:encode                                 # encode:
FF4301D1                                #     sub     sp, sp, #80
FE0300F9                                #     str     x30, [sp, #0]
F70700F9                                #     str     x23, [sp, #8]               // the instruction
F80B00F9                                #     str     x24, [sp, #16]              // frame
F90F00F9                                #     str     x25, [sp, #24]              // fields left
FA1300F9                                #     str     x26, [sp, #32]              // next field
FB1700F9                                #     str     x27, [sp, #40]              // word
FC1B00F9                                #     str     x28, [sp, #48]              // width so far
FD1F00F9                                #     str     x29, [sp, #56]              // width of this field
F70300AA                                #     mov     x23, x0
F80301AA                                #     mov     x24, x1
^~param_count 97                        #     bl      param_count
F9824039                                #     ldrb    w25, [x23, #NODE_children_len]
390300CB                                #     sub     x25, x25, x0
FA1640F9                                #     ldr     x26, [x23, #NODE_children]
00F07DD3                                #     lsl     x0, x0, #3
5A03008B                                #     add     x26, x26, x0
1B0080D2                                #     mov     x27, #0
1C0080D2                                #     mov     x28, #0
:encode.1 @encode.4 190000B4            # 1:  cbz     x25, 4f
400340F9                                #     ldr     x0, [x26, #0]
^~is_fn 97                              #     bl      is_fn
490340F9                                #     ldr     x9, [x26, #0]
@encode.2 000000B4                      #     cbz     x0, 2f
2A814039                                #     ldrb    w10, [x9, #NODE_children_len]   // a fixed field: its child is its bits
@encode.8 0A0000B4                      #     cbz     x10, 8f
2A1540F9                                #     ldr     x10, [x9, #NODE_children]
4A0140F9                                #     ldr     x10, [x10, #0]
401D40F9                                #     ldr     x0, [x10, #NODE_content]
41C14039                                #     ldrb    w1, [x10, #NODE_content_len]
FD0301AA                                #     mov     x29, x1
^~parse_bits 97                         #     bl      parse_bits
^~encode.3 14                           #     b       3f
:encode.2 E00309AA                      # 2:  mov     x0, x9                      // a slice call: run it, value in a0
E10318AA                                #     mov     x1, x24
^~exec_call 97                          #     bl      exec_call
490340F9                                #     ldr     x9, [x26, #0]
201D40F9                                #     ldr     x0, [x9, #NODE_content]
21C14039                                #     ldrb    w1, [x9, #NODE_content_len]
^~slice_width 97                        #     bl      slice_width
FD0300AA                                #     mov     x29, x0
~vregs 09000090 !vregs 29010091         #     la      x9, vregs
202940F9                                #     ldr     x0, [x9, #VREG_a0*8]
:encode.3 090880D2                      # 3:  mov     x9, #64
BF0309EB                                #     cmp     x29, x9
@encode.10 00000054                     #     b.eq    10f                         // a 64-bit field is the whole word
290080D2                                #     mov     x9, #1
2921DD9A                                #     lsl     x9, x9, x29
290500D1                                #     sub     x9, x9, #1
0000098A                                #     and     x0, x0, x9
7B23DD9A                                #     lsl     x27, x27, x29
:encode.10 7B0300AA                     # 10: orr     x27, x27, x0
9C031D8B                                #     add     x28, x28, x29
5A230091                                #     add     x26, x26, #8
390700D1                                #     sub     x25, x25, #1
^~encode.1 17                           #     b       1b
:encode.4 090180D2                      # 4:  mov     x9, #8
9F0309EB                                #     cmp     x28, x9
@encode.5 00000054                      #     b.eq    5f
090280D2                                #     mov     x9, #16
9F0309EB                                #     cmp     x28, x9
@encode.5 00000054                      #     b.eq    5f
090480D2                                #     mov     x9, #32
9F0309EB                                #     cmp     x28, x9
@encode.5 00000054                      #     b.eq    5f
090880D2                                #     mov     x9, #64
