3F010AEB                                #     cmp     x9, x10
@emit.5 01000054                        #     b.ne    5f
~linebuf 09000090 !linebuf 29010091     #     la      x9, linebuf
~hexdigits 0A000090 !hexdigits 4A010091 #     la      x10, hexdigits
