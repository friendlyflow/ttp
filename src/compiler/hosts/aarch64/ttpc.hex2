:cur_pc 0000000000000000                # cur_pc:         .dword 0                    // address of the next byte
:in_bss 0000000000000000                # in_bss:         .dword 0                    // 1 after the builtin bss
:scope_depth 0000000000000000           # scope_depth:    .dword 0                    // placed functions in scopes

# The exec seed: the instructions that exec context runs itself, rd = v1 op
