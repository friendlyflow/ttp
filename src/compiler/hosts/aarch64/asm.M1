ldr_x9,[x19,96]                         #     ldr     x9, [x19, #V_loc+24]        // .bss's file offset, and .shstrtab's: the end
add_x0,x0,x9                            #     add     x0, x0, x9                  // of .data (ld's, though .bss be aligned)
str_x0,[x19,224]                        #     str     x0, [x19, #V_off+32]
str_x0,[x19,232]                        #     str     x0, [x19, #V_shstr]
