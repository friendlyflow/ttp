and_x9,x9,0xfff                         #     and     x9, x9, #0xfff              // bytes before the base's next 4 KiB page,
and_x10,x0,0xfff                        #     and     x10, x0, #0xfff             // the bytes after the end's last one, both
@layout_files cbz_x9                    #     cbz     x9, layout_files            // there, the two in other pages, and no
@layout_files cbz_x10                   #     cbz     x10, layout_files           // more than a page together: from v up to
lsr_x11,x5,12                           #     lsr     x11, x5, #12                // 4 KiB in the 64 KiB after v's instead
lsr_x12,x0,12                           #     lsr     x12, x0, #12
cmp_x11,x12                             #     cmp     x11, x12
@layout_files b.eq                      #     b.eq    layout_files
add_x9,x9,x10                           #     add     x9, x9, x10
cmp_x9,0x1,lsl12                        #     cmp     x9, #0x1000
@layout_files b.hi                      #     b.hi    layout_files
add_x9,x3,0xfff                         #     add     x9, x3, #0xfff
and_x9,x9,0xf000                        #     and     x9, x9, #0xf000
add_x0,x6,x9                            #     add     x0, x6, x9
^~data_place FCALL                      #     bl      data_place
:layout_files                           # layout_files:                           // .data's file offset: from the code's end,
ldr_x9,[x19,176]                        #     ldr     x9, [x19, #V_base+24]       // the same as its address in 64 KiB
ldr_x10,[x19,256]                       #     ldr     x10, [x19, #V_tend]
sub_x11,x9,x10                          #     sub     x11, x9, x10
and_x11,x11,0xffff                      #     and     x11, x11, #0xffff
add_x0,x10,x11                          #     add     x0, x10, x11
