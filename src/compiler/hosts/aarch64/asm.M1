mov_x1,0x8                              #     mov     x1, #8
^~alignup FCALL                         #     bl      alignup
mov_x30,x14                             #     mov     x30, x14
ret                                     #     ret

:place                                  # place:                                  // section x1 from file offset x0, aligned; x0 = its end (uses x1, x2, x9)
lsl_x2,x1,3                             #     lsl     x2, x1, #3
