:eputs                                  # eputs:                                  // writes the C string x1 to stderr
mov_x2,x1                               #     mov     x2, x1
:eputs_len                              # eputs_len:
ldrb_w9,[x2]                            #     ldrb    w9, [x2]
@eputs_end cbz_x9                       #     cbz     x9, eputs_end
add_x2,x2,0x1                           #     add     x2, x2, #1
^~eputs_len RBRANCH                     #     b       eputs_len
:eputs_end                              # eputs_end:
sub_x2,x2,x1                            #     sub     x2, x2, x1
:ewrite                                 # ewrite:                                 // writes x1, x2 to stderr
mov_x8,0x40                             #     mov     x8, #SYS_write
mov_x0,0x2                              #     mov     x0, #2                      // fd 2, stderr
svc_0x0                                 #     svc     #0
ret                                     #     ret

:eputn                                  # eputn:                                  // writes x0 in decimal to stderr
add_x1,x19,0x4c8                        #     add     x1, x19, #NUMBUF + 24       // the last digit first, from the end
mov_x2,x1                               #     mov     x2, x1
mov_x10,0xa                             #     mov     x10, #10
:eputn_digit                            # eputn_digit:
udiv_x16,x0,x10                         #     udiv    x16, x0, x10
msub_x9,x16,x10,x0                      #     msub    x9, x16, x10, x0
add_x9,x9,0x30                          #     add     x9, x9, #0x30
sub_x1,x1,0x1                           #     sub     x1, x1, #1
strb_w9,[x1]                            #     strb    w9, [x1]
udiv_x0,x0,x10                          #     udiv    x0, x0, x10
@eputn_digit cbnz_x0                    #     cbnz    x0, eputn_digit
sub_x2,x2,x1                            #     sub     x2, x2, x1
^~ewrite RBRANCH                        #     b       ewrite

