#
# asm for aarch64 Linux: the assembler of the seed. The fourth link of the
# bootstrap, built by M1 and hex2 from hosts/aarch64/asm.M1 (made from this
# file once by gen/mkhex.pl, a dev aid; the chain never reads this file).
# It assembles hosts/aarch64/ttpc.s, the readable seed, into the seed: the
# bytes binutils' as and ld make of it (as, ld -static -s -z
# noseparate-code -Ttext=0x4000b0), with no binutils. Its generic part
# (lines, symbols, expressions, directives, the output) is a translation
# of gen/hex/riscv64/asm.s, nearly instruction by instruction, with
# ttpc.s's register map (s0-s9 x19-x28, s10 x29, s11 x18, a0-a6 x0-x6, a7
# x8, t0-t6 x9-x15, ra x30); its instructions are AArch64's own.
#
#   asm < ttpc.s > ttpc
#
# The asm it reads: aarch64 GNU syntax as ttpc.s uses it.
#   lines      labels (name: and the local n: of 0-99, as 1b and 1f), then
#              a directive, an instruction or a macro's name; '//' starts
#              a comment to the end of the line
#   directives .equ name, expr  .dword .word .hword .byte expr, ...
#              .ascii .asciz "text", ...  (escapes \n \t \ooo, \x as x)
#              .skip n  .balign n (not in .text)  .section name (.text
#              .rodata .data .bss)  .text .data .bss  .globl name
#              .macro name param, ... (its lines up to .endm; \param in
#              them is the call's argument)
#   exprs      numbers (decimal, 0x hex, 0 octal), names, '.' (here), and
#              as gas: unary - ~, then * / % << >>, then | & ^, then + -,
#              and ( ); a label's address plus or minus a number, or two
#              labels of a section minus each other
#   operands   registers (x0-x30 xzr sp, w0-w30 wzr), #expr, [xn] and
#              [xn, #expr], :lo12:expr, a condition (cset), and the label
#              (an expr) of a branch or adrp
#   mnemonics  mov, add sub adds subs cmp neg (immediate: 12 bits, or
#              shifted by 12; a negative one the other way, as gas; with sp
#              the extended register form), and orr eor (register or
#              bitmask immediate), lsl lsr asr (immediate or register), mul
#              udiv sdiv msub, cset, ldr str ldrb strb (unsigned offset,
#              or gas's ldur, stur, ldurb, sturb for a negative or
#              unaligned one), b bl b.cond cbz cbnz, ret br blr svc, adrp
# mov is gas's: of a register orr (add #0 with sp), of a number movz, else
# movn, else orr with a bitmask immediate. Every instruction is 4 bytes,
# so the passes need no relaxing. The output is the file ld makes: the ELF
# header, two program headers (the code: the headers, .text, .rodata; the
# data: .data, .bss, placed as ld's DATA_SEGMENT_ALIGN of 64 KiB pages,
# see layout), the sections, .shstrtab and six section headers. Each of
# .text .rodata .data .bss must have bytes.
#
# The input is read whole, then in two passes. Pass 1 sizes: every label
# gets its section and place (an instruction is 4 bytes, its operands
# unread); layout then gives every section its place. Pass 2 encodes and
# writes the sections into the output, which is then written whole. On
# an error it says so on stderr with the line (asm: line N: what: the
# line) and ends with status 1; else with 0.
#
# One flat file, loaded at BASE by its first program header, read and
# run; the second maps the memory it writes, VARS to the end of OUTBUF.
# The registers:
#   x19  VARS, the variables               x20  the next byte of the input
#   x21  the end of the input
#   x22  the instruction's base bits (from mnemonics), x23 its other bits
#   x24  rd (or rt)  x25  rn  x26  rm or the immediate
#   x27-x29, x18  scratch of the instructions; sp the stack of the routines
# The routines take and give x0-x8 and use x9-x15 (each says which); a
# routine that calls another keeps x30 on the stack, or in x14 or x15 when
# what it calls does not use them. A symbol is 40 bytes (S_*), a local
# label's definition 32 (L_*), a macro 96 (MAC_*). A definition (D) is a
# symbol's S_value or a local label's L_value: its value, kind (0 a
# number, 1-4 the section) and pass (0 not defined) at 0, 8, 16.

#     .equ BASE, 0x600000
#     .equ VARS, 0x700000                 // the variables, 64 KiB
#     .equ MACROS, VARS + 0x2000          // 16 macros
#     .equ MAC_max, 16
#     .equ ARGS, VARS + 0x3000            // a macro call's arguments
#     .equ EXPBUF, VARS + 0x4000          // a macro's line, expanded
#     .equ EXPBUF_END, VARS + 0x5000
#     .equ SYMS, VARS + 0x10000           // 65536 symbols
#     .equ SYM_size, 40
#     .equ SYMS_END, SYMS + 0x10000 * SYM_size
#     .equ LOCAL_max, 4096                // definitions of each local label
#     .equ LOCALS, SYMS_END               // 100 local labels
#     .equ LOCALS_END, LOCALS + 100 * LOCAL_max * 32
#     .equ INPUT, LOCALS_END              // 16 MiB of input
#     .equ INPUT_END, INPUT + 0x1000000
#     .equ OUTBUF, INPUT_END              // 16 MiB of output
#     .equ OUTBUF_END, OUTBUF + 0x1000000
#     .equ ADDR, 0x400000                 // where ld places the output
#     .equ SHSTRTAB_len, 36               // the section names' bytes (shstrtab)
#     .equ SYS_read, 63
#     .equ SYS_write, 64
#     .equ SYS_exit, 93

    # a symbol: its name in the input, then its definition
#     .equ S_name, 0
#     .equ S_len, 8
#     .equ S_value, 16
#     .equ S_kind, 24
#     .equ S_pass, 32
    # a definition of a local label
#     .equ L_value, 0
#     .equ L_kind, 8
#     .equ L_pass, 16
    # a macro: its name (8 bytes), its parameters' count, then each
    # parameter's name and length, its lines' first byte and their end
#     .equ MAC_name, 0
#     .equ MAC_n, 8
#     .equ MAC_params, 16
#     .equ MAC_body, 80
#     .equ MAC_end, 88
#     .equ MAC_size, 96

    # the variables, at x19
#     .equ V_pass, 0                      // the pass, 1 or 2
#     .equ V_emit, 8                      // 1 in pass 2, which writes
#     .equ V_sec, 16                      // the section: 1 .text 2 .rodata 3 .data 4 .bss
#     .equ V_line, 24                     // the line's number
#     .equ V_nmac, 32                     // the next free macro
#     .equ V_nsym, 40                     // the next free symbol
#     .equ V_exact, 48                    // 0 once an expression used a name not defined before it
#     .equ V_known, 56                    // 0 once it used a name not defined at all
#     .equ V_lstart, 64                   // the line's first byte
#     .equ V_loc, 72                      // section s's location counter at V_loc + 8 * s
#     .equ V_align, 112                   // its alignment
#     .equ V_base, 152                    // its address (0 for s = 0, a number)
#     .equ V_off, 192                     // its file offset
#     .equ V_shstr, 232                   // the file offset of .shstrtab
#     .equ V_shoff, 240                   // of the section headers
#     .equ V_fend, 248                    // the file's size
#     .equ V_tend, 256                    // the end of .rodata in the file: of the code segment
#     .equ V_sret, 280                    // statement's return address
#     .equ COUNTS, 400                    // local label n's definitions so far at COUNTS + 8 * n
#     .equ NUMBUF, 1200                   // a decimal number, 24

# la: reg = the address of sym, as ttpc.s's
#     .macro la reg, sym
#     adrp    \reg, \sym
#     add     \reg, \reg, :lo12:\sym
#     .endm
# li32: reg = the 32-bit number val
#     .macro li32 reg, val
#     movz    \reg, #(\val) & 0xffff
#     movk    \reg, #((\val) >> 16) & 0xffff, lsl #16
#     .endm

:ehdr                                   # ehdr:                                   // the ELF header, 64 bytes
7F454C46                                #     .byte 0x7f, 0x45, 0x4c, 0x46        // e_ident: the magic, 0x7f 'E' 'L' 'F'
02                                      #     .byte 2                             // EI_CLASS: ELFCLASS64
01                                      #     .byte 1                             // EI_DATA: ELFDATA2LSB, little endian
01                                      #     .byte 1                             // EI_VERSION: EV_CURRENT
00                                      #     .byte 0                             // EI_OSABI: System V
0000000000000000                        #     .byte 0, 0, 0, 0, 0, 0, 0, 0        // EI_ABIVERSION 0, then padding to 16
0200                                    #     .hword 2                            // e_type: ET_EXEC, an executable
B700                                    #     .hword 0xb7                         // e_machine: EM_AARCH64
01000000                                #     .word 1                             // e_version: EV_CURRENT
B000600000000000                        #     .dword BASE + _start - ehdr         // e_entry: the address of _start
4000000000000000                        #     .dword phdr - ehdr                  // e_phoff: the program headers follow
0000000000000000                        #     .dword 0                            // e_shoff: no section headers
00000000                                #     .word 0                             // e_flags: none on aarch64
4000                                    #     .hword 64                           // e_ehsize: this header's size
3800                                    #     .hword 56                           // e_phentsize: a program header's size
0200                                    #     .hword 2                            // e_phnum: two program headers
0000                                    #     .hword 0                            // e_shentsize: no section headers
0000                                    #     .hword 0                            // e_shnum: none
0000                                    #     .hword 0                            // e_shstrndx: none
:phdr                                   # phdr:                                   // the program: 56 bytes
01000000                                #     .word 1                             // p_type: PT_LOAD
05000000                                #     .word 5                             // p_flags: PF_R | PF_X, read and run
0000000000000000                        #     .dword 0                            // p_offset: from the file's first byte
0000600000000000                        #     .dword BASE                         // p_vaddr: loaded at BASE
0000600000000000                        #     .dword BASE                         // p_paddr: the same
372A000000000000                        #     .dword end - ehdr                   // p_filesz: the whole file
372A000000000000                        #     .dword end - ehdr                   // p_memsz: the same
0010000000000000                        #     .dword 0x1000                       // p_align: a page
                                        # its memory: 56 bytes
01000000                                #     .word 1                             // p_type: PT_LOAD
06000000                                #     .word 6                             // p_flags: PF_R | PF_W, read and write
0000000000000000                        #     .dword 0                            // p_offset: none of the file
0000700000000000                        #     .dword VARS                         // p_vaddr: the variables, ..., the output
0000700000000000                        #     .dword VARS                         // p_paddr: the same
0000000000000000                        #     .dword 0                            // p_filesz: none, all zero
0000F10200000000                        #     .dword OUTBUF_END - VARS            // p_memsz: to the end of the output
0010000000000000                        #     .dword 0x1000                       // p_align: a page

:_start                                 # _start:                                 // read all of stdin into INPUT
mov_x19,0x700000                        #     mov     x19, #VARS
mov_x21,0x1610000                       #     mov     x21, #INPUT                 // the end of what is read
:read                                   # read:
mov_x2,0xffff                           #     movz    x2, #0xffff   // INPUT_END - 1 // a 0 stays after the input
movk_x2,0x2c8,lsl16                     #     movk    x2, #0x2c8, lsl #16
sub_x2,x2,x21                           #     sub     x2, x2, x21                 // the room left
@too_large cbz_x2                       #     cbz     x2, too_large
mov_x8,0x3f                             #     mov     x8, #SYS_read
mov_x0,0x0                              #     mov     x0, #0                      // fd 0, stdin
mov_x1,x21                              #     mov     x1, x21                     // after what is read
svc_0x0                                 #     svc     #0
cmp_x0,0x0                              #     cmp     x0, #0
@read_failed b.lt                       #     b.lt    read_failed
@read_all cbz_x0                        #     cbz     x0, read_all                // the end of stdin
add_x21,x21,x0                          #     add     x21, x21, x0
^~read RBRANCH                          #     b       read
:read_all                               # read_all:
mov_x9,0x710000                         #     mov     x9, #SYMS                   // no symbols yet
str_x9,[x19,40]                         #     str     x9, [x19, #V_nsym]
mov_x9,0x4                              #     mov     x9, #4                      // .text aligned to 4 (gas's)
str_x9,[x19,120]                        #     str     x9, [x19, #V_align+8]
mov_x9,0x1                              #     mov     x9, #1                      // the others to 1, until .balign
str_x9,[x19,128]                        #     str     x9, [x19, #V_align+16]
str_x9,[x19,136]                        #     str     x9, [x19, #V_align+24]
str_x9,[x19,144]                        #     str     x9, [x19, #V_align+32]
str_x9,[x19]                            #     str     x9, [x19, #V_pass]          // pass 1: sizes and labels
^~pass FCALL                            #     bl      pass
^~layout FCALL                          #     bl      layout
mov_x9,0x2                              #     mov     x9, #2                      // pass 2 writes
str_x9,[x19]                            #     str     x9, [x19, #V_pass]
mov_x9,0x1                              #     mov     x9, #1
str_x9,[x19,8]                          #     str     x9, [x19, #V_emit]
^~pass FCALL                            #     bl      pass
^~headers FCALL                         #     bl      headers
mov_x1,0x2610000                        #     mov     x1, #OUTBUF                 // write the output
ldr_x3,[x19,248]                        #     ldr     x3, [x19, #V_fend]
add_x3,x3,x1                            #     add     x3, x3, x1                  // its end
:write                                  # write:
sub_x2,x3,x1                            #     sub     x2, x3, x1                  // what is left
@done cbz_x2                            #     cbz     x2, done
mov_x8,0x40                             #     mov     x8, #SYS_write
mov_x0,0x1                              #     mov     x0, #1                      // fd 1, stdout
svc_0x0                                 #     svc     #0
cmp_x0,0x0                              #     cmp     x0, #0
@write_failed b.le                      #     b.le    write_failed
add_x1,x1,x0                            #     add     x1, x1, x0
^~write RBRANCH                         #     b       write
:done                                   # done:
mov_x0,0x0                              #     mov     x0, #0                      // status 0
^~exit FBRANCH                          #     b       exit

# A pass over the input, line by line.
:pass                                   # pass:
sub_sp,sp,0x10                          #     sub     sp, sp, #16
str_x30,[sp]                            #     str     x30, [sp]
str_xzr,[x19,72]                        #     str     xzr, [x19, #V_loc]          // every section from 0
str_xzr,[x19,80]                        #     str     xzr, [x19, #V_loc+8]
str_xzr,[x19,88]                        #     str     xzr, [x19, #V_loc+16]
str_xzr,[x19,96]                        #     str     xzr, [x19, #V_loc+24]
str_xzr,[x19,104]                       #     str     xzr, [x19, #V_loc+32]
add_x9,x19,0x2,lsl12                    #     add     x9, x19, #MACROS - VARS     // no macros yet
str_x9,[x19,32]                         #     str     x9, [x19, #V_nmac]
add_x9,x19,0x190                        #     add     x9, x19, #COUNTS            // no local labels yet
add_x10,x19,0x4b0                       #     add     x10, x19, #COUNTS + 800
:pass_count                             # pass_count:
str_xzr,[x9]                            #     str     xzr, [x9]
add_x9,x9,0x8                           #     add     x9, x9, #8
cmp_x9,x10                              #     cmp     x9, x10
@pass_count b.ne                        #     b.ne    pass_count
mov_x9,0x1                              #     mov     x9, #1                      // in .text
str_x9,[x19,16]                         #     str     x9, [x19, #V_sec]
str_x9,[x19,24]                         #     str     x9, [x19, #V_line]
mov_x20,0x1610000                       #     mov     x20, #INPUT
:pass_line                              # pass_line:
cmp_x20,x21                             #     cmp     x20, x21
@pass_end b.cs                          #     b.hs    pass_end
str_x20,[x19,64]                        #     str     x20, [x19, #V_lstart]
^~statement FCALL                       #     bl      statement
ldr_x9,[x19,24]                         #     ldr     x9, [x19, #V_line]
add_x9,x9,0x1                           #     add     x9, x9, #1
str_x9,[x19,24]                         #     str     x9, [x19, #V_line]
^~pass_line RBRANCH                     #     b       pass_line
:pass_end                               # pass_end:
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x10                          #     add     sp, sp, #16
ret                                     #     ret

# One line, to after its newline: labels, then a directive or an
# instruction (each ends with end_line, which returns from statement).
:statement                              # statement:
str_x30,[x19,280]                       #     str     x30, [x19, #V_sret]
:statement_next                         # statement_next:
^~blanks FCALL                          #     bl      blanks
ldrb_w0,[x20]                           #     ldrb    w0, [x20]
^~is_ident FCALL                        #     bl      is_ident
@end_line cbz_x0                        #     cbz     x0, end_line                // no name: only a comment may follow
^~word FCALL                            #     bl      word                        // x1, x2
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x3a                            #     mov     x10, #0x3a                  // ':': a label
cmp_x9,x10                              #     cmp     x9, x10
@label b.eq                             #     b.eq    label
ldrb_w9,[x1]                            #     ldrb    w9, [x1]
mov_x10,0x2e                            #     mov     x10, #0x2e                  // '.': a directive
cmp_x9,x10                              #     cmp     x9, x10
@directive b.eq                         #     b.eq    directive
^~insn FBRANCH                          #     b       insn
:label                                  # label:
add_x20,x20,0x1                         #     add     x20, x20, #1
^~define_label FCALL                    #     bl      define_label
^~statement_next RBRANCH                #     b       statement_next

:end_line                               # end_line:                               // nothing but a comment until the newline, then after it
^~blanks FCALL                          #     bl      blanks
cmp_x20,x21                             #     cmp     x20, x21
@end_line_done b.cs                     #     b.hs    end_line_done
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x2f                            #     mov     x10, #0x2f                  // '//'
cmp_x9,x10                              #     cmp     x9, x10
@end_line_nl b.ne                       #     b.ne    end_line_nl
ldrb_w9,[x20,1]                         #     ldrb    w9, [x20, #1]
cmp_x9,x10                              #     cmp     x9, x10
@end_comment b.eq                       #     b.eq    end_comment
^~junk FBRANCH                          #     b       junk
:end_line_nl                            # end_line_nl:
mov_x10,0xa                             #     mov     x10, #0x0a                  // '\n'
cmp_x9,x10                              #     cmp     x9, x10
@junk b.ne                              #     b.ne    junk
add_x20,x20,0x1                         #     add     x20, x20, #1
:end_line_done                          # end_line_done:
ldr_x30,[x19,280]                       #     ldr     x30, [x19, #V_sret]
ret                                     #     ret
:end_comment                            # end_comment:
add_x20,x20,0x1                         #     add     x20, x20, #1
cmp_x20,x21                             #     cmp     x20, x21
@end_line_done b.cs                     #     b.hs    end_line_done
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0xa                             #     mov     x10, #0x0a
cmp_x9,x10                              #     cmp     x9, x10
@end_comment b.ne                       #     b.ne    end_comment
add_x20,x20,0x1                         #     add     x20, x20, #1
^~end_line_done RBRANCH                 #     b       end_line_done

:blanks                                 # blanks:                                 // skips spaces and tabs (uses x9, x10)
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x20                            #     mov     x10, #0x20                  // ' '
cmp_x9,x10                              #     cmp     x9, x10
@blanks_skip b.eq                       #     b.eq    blanks_skip
mov_x10,0x9                             #     mov     x10, #0x09                  // '\t'
cmp_x9,x10                              #     cmp     x9, x10
@blanks_done b.ne                       #     b.ne    blanks_done
:blanks_skip                            # blanks_skip:
add_x20,x20,0x1                         #     add     x20, x20, #1
^~blanks RBRANCH                        #     b       blanks
:blanks_done                            # blanks_done:
ret                                     #     ret

:is_ident                               # is_ident:                               // x0 = 1 if byte x0 is a letter, a digit, '_' or '.', else 0 (uses x9)
mov_x9,0x2e                             #     mov     x9, #0x2e                   // '.'
cmp_x0,x9                               #     cmp     x0, x9
@ident_yes b.eq                         #     b.eq    ident_yes
mov_x9,0x5f                             #     mov     x9, #0x5f                   // '_'
cmp_x0,x9                               #     cmp     x0, x9
@ident_yes b.eq                         #     b.eq    ident_yes
sub_x9,x0,0x30                          #     sub     x9, x0, #0x30               // '0'-'9'
cmp_x9,0xa                              #     cmp     x9, #10
cset_x9,cc                              #     cset    x9, lo
@ident_yes cbnz_x9                      #     cbnz    x9, ident_yes
orr_x9,x0,0x20                          #     orr     x9, x0, #0x20               // 'A'-'Z' as 'a'-'z'
sub_x9,x9,0x61                          #     sub     x9, x9, #0x61
cmp_x9,0x1a                             #     cmp     x9, #26
cset_x9,cc                              #     cset    x9, lo
@ident_yes cbnz_x9                      #     cbnz    x9, ident_yes
mov_x0,0x0                              #     mov     x0, #0
ret                                     #     ret
:ident_yes                              # ident_yes:
mov_x0,0x1                              #     mov     x0, #1
ret                                     #     ret

:word                                   # word:                                   // x1, x2 = the name at x20, which moves after it (uses x0, x9, x14)
mov_x14,x30                             #     mov     x14, x30
mov_x1,x20                              #     mov     x1, x20
:word_byte                              # word_byte:
ldrb_w0,[x20]                           #     ldrb    w0, [x20]
^~is_ident RCALL                        #     bl      is_ident
@word_end cbz_x0                        #     cbz     x0, word_end
add_x20,x20,0x1                         #     add     x20, x20, #1
^~word_byte RBRANCH                     #     b       word_byte
:word_end                               # word_end:
sub_x2,x20,x1                           #     sub     x2, x20, x1
mov_x30,x14                             #     mov     x30, x14
ret                                     #     ret

:pack                                   # pack:                                   // x0 = name x1, x2 as 8 bytes (the first lowest), -1 if longer (uses x9, x10)
mov_x0,0xffffffffffffffff               #     mov     x0, #-1
mov_x9,0x8                              #     mov     x9, #8
cmp_x9,x2                               #     cmp     x9, x2
@pack_done b.cc                         #     b.lo    pack_done
mov_x0,0x0                              #     mov     x0, #0
mov_x9,x2                               #     mov     x9, x2
:pack_byte                              # pack_byte:                              // from the last byte to the first
@pack_done cbz_x9                       #     cbz     x9, pack_done
lsl_x0,x0,8                             #     lsl     x0, x0, #8
add_x10,x1,x9                           #     add     x10, x1, x9
ldurb_w10,[x10,-1]                      #     ldrb    w10, [x10, #-1]
orr_x0,x0,x10                           #     orr     x0, x0, x10
sub_x9,x9,0x1                           #     sub     x9, x9, #1
^~pack_byte RBRANCH                     #     b       pack_byte
:pack_done                              # pack_done:
ret                                     #     ret

# The symbols.

:define_label                           # define_label:                           // name x1, x2: here
sub_sp,sp,0x10                          #     sub     sp, sp, #16
str_x30,[sp]                            #     str     x30, [sp]
^~digits FCALL                          #     bl      digits                      // n: a local label
@define_local cbz_x3                    #     cbz     x3, define_local
^~here_def FCALL                        #     bl      here_def                    // x3, x4
mov_x5,0x1                              #     mov     x5, #1                      // defined twice in a pass: an error
^~define FCALL                          #     bl      define
^~define_label_done FBRANCH             #     b       define_label_done
:define_local                           # define_local:
^~local_def FCALL                       #     bl      local_def
:define_label_done                      # define_label_done:
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x10                          #     add     sp, sp, #16
ret                                     #     ret

:here_def                               # here_def:                               // x3 = here's value, x4 its kind (uses x9)
ldr_x4,[x19,16]                         #     ldr     x4, [x19, #V_sec]
lsl_x9,x4,3                             #     lsl     x9, x4, #3
add_x9,x9,x19                           #     add     x9, x9, x19
ldr_x3,[x9,72]                          #     ldr     x3, [x9, #V_loc]            // the section's location
ret                                     #     ret

:define                                 # define:                                 // x0 = symbol x1, x2, defined as x3 of kind x4 (uses x9-x15)
mov_x15,x30                             #     mov     x15, x30                    // x5 = 1: an error if defined in this pass
^~find_sym FCALL                        #     bl      find_sym
@define_found cbnz_x0                   #     cbnz    x0, define_found
^~sym_new FCALL                         #     bl      sym_new
^~define_set FBRANCH                    #     b       define_set
:define_found                           # define_found:
@define_set cbz_x5                      #     cbz     x5, define_set
ldr_x9,[x0,32]                          #     ldr     x9, [x0, #S_pass]
ldr_x10,[x19]                           #     ldr     x10, [x19, #V_pass]
cmp_x9,x10                              #     cmp     x9, x10
@twice b.eq                             #     b.eq    twice
:define_set                             # define_set:
str_x3,[x0,16]                          #     str     x3, [x0, #S_value]
str_x4,[x0,24]                          #     str     x4, [x0, #S_kind]
ldr_x9,[x19]                            #     ldr     x9, [x19, #V_pass]
str_x9,[x0,32]                          #     str     x9, [x0, #S_pass]
mov_x30,x15                             #     mov     x30, x15
ret                                     #     ret

:sym_new                                # sym_new:                                // x0 = a new symbol x1, x2, not yet defined (uses x9)
ldr_x0,[x19,40]                         #     ldr     x0, [x19, #V_nsym]
mov_x9,0x990000                         #     mov     x9, #SYMS_END
cmp_x0,x9                               #     cmp     x0, x9
@too_many_symbols b.cs                  #     b.hs    too_many_symbols
add_x9,x0,0x28                          #     add     x9, x0, #SYM_size
str_x9,[x19,40]                         #     str     x9, [x19, #V_nsym]
str_x1,[x0]                             #     str     x1, [x0, #S_name]
str_x2,[x0,8]                           #     str     x2, [x0, #S_len]
ret                                     #     ret

:find_sym                               # find_sym:                               // x0 = symbol x1, x2, or 0 (uses x9-x14)
mov_x0,0x710000                         #     mov     x0, #SYMS
ldr_x13,[x19,40]                        #     ldr     x13, [x19, #V_nsym]
:find_sym_next                          # find_sym_next:
cmp_x0,x13                              #     cmp     x0, x13
@find_sym_none b.cs                     #     b.hs    find_sym_none
ldr_x9,[x0,8]                           #     ldr     x9, [x0, #S_len]            // the same length
cmp_x9,x2                               #     cmp     x9, x2
@find_sym_on b.ne                       #     b.ne    find_sym_on
ldr_x10,[x0]                            #     ldr     x10, [x0, #S_name]          // and the same bytes
mov_x11,x1                              #     mov     x11, x1
add_x12,x1,x2                           #     add     x12, x1, x2
:find_sym_byte                          # find_sym_byte:
cmp_x11,x12                             #     cmp     x11, x12
@find_sym_found b.eq                    #     b.eq    find_sym_found
ldrb_w9,[x10]                           #     ldrb    w9, [x10]
ldrb_w14,[x11]                          #     ldrb    w14, [x11]
cmp_x9,x14                              #     cmp     x9, x14
@find_sym_on b.ne                       #     b.ne    find_sym_on
add_x10,x10,0x1                         #     add     x10, x10, #1
add_x11,x11,0x1                         #     add     x11, x11, #1
^~find_sym_byte RBRANCH                 #     b       find_sym_byte
:find_sym_on                            # find_sym_on:
add_x0,x0,0x28                          #     add     x0, x0, #SYM_size
^~find_sym_next RBRANCH                 #     b       find_sym_next
:find_sym_none                          # find_sym_none:
mov_x0,0x0                              #     mov     x0, #0
:find_sym_found                         # find_sym_found:
ret                                     #     ret

:local_def                              # local_def:                              // local label x0: here (uses x9, x10, x15)
mov_x9,0x64                             #     mov     x9, #100
cmp_x0,x9                               #     cmp     x0, x9
@bad_local b.cs                         #     b.hs    bad_local
lsl_x9,x0,3                             #     lsl     x9, x0, #3                  // its definitions so far: this one's number
add_x9,x9,x19                           #     add     x9, x9, x19
ldr_x1,[x9,400]                         #     ldr     x1, [x9, #COUNTS]
add_x10,x1,0x1                          #     add     x10, x1, #1
str_x10,[x9,400]                        #     str     x10, [x9, #COUNTS]
mov_x15,x30                             #     mov     x15, x30
^~local_entry FCALL                     #     bl      local_entry
^~here_def RCALL                        #     bl      here_def
mov_x30,x15                             #     mov     x30, x15
str_x3,[x0]                             #     str     x3, [x0, #L_value]
str_x4,[x0,8]                           #     str     x4, [x0, #L_kind]
ldr_x9,[x19]                            #     ldr     x9, [x19, #V_pass]
str_x9,[x0,16]                          #     str     x9, [x0, #L_pass]
ret                                     #     ret

:local_entry                            # local_entry:                            // x0 = definition x1 of local label x0 (uses x9)
mov_x9,0x64                             #     mov     x9, #100
cmp_x0,x9                               #     cmp     x0, x9
@bad_local b.cs                         #     b.hs    bad_local
mov_x9,0x1000                           #     mov     x9, #LOCAL_max              // (-1 too: below 0)
cmp_x1,x9                               #     cmp     x1, x9
@bad_local b.cs                         #     b.hs    bad_local
mul_x0,x0,x9                            #     mul     x0, x0, x9
add_x0,x0,x1                            #     add     x0, x0, x1
lsl_x0,x0,5                             #     lsl     x0, x0, #5
mov_x9,0x990000                         #     mov     x9, #LOCALS
add_x0,x0,x9                            #     add     x0, x0, x9
ret                                     #     ret

:local_ref                              # local_ref:                              // x0 = the definition nf or nb of local label x0, by the last byte of x1, x2 (uses x9-x11)
mov_x9,0x64                             #     mov     x9, #100
cmp_x0,x9                               #     cmp     x0, x9
@bad_local b.cs                         #     b.hs    bad_local
lsl_x9,x0,3                             #     lsl     x9, x0, #3                  // nf: the next definition of n
add_x9,x9,x19                           #     add     x9, x9, x19
ldr_x11,[x9,400]                        #     ldr     x11, [x9, #COUNTS]
add_x10,x1,x2                           #     add     x10, x1, x2
ldurb_w10,[x10,-1]                      #     ldrb    w10, [x10, #-1]
mov_x9,0x66                             #     mov     x9, #0x66                   // 'f'
cmp_x10,x9                              #     cmp     x10, x9
@local_ref_entry b.eq                   #     b.eq    local_ref_entry
sub_x11,x11,0x1                         #     sub     x11, x11, #1                // nb: the last one
:local_ref_entry                        # local_ref_entry:
mov_x1,x11                              #     mov     x1, x11
^~local_entry RBRANCH                   #     b       local_entry

:digits                                 # digits:                                 // x0 = name x1, x2 when it is decimal digits only, x3 = 0; else x3 = 1 (uses x9-x11)
mov_x0,0x0                              #     mov     x0, #0
mov_x9,0x0                              #     mov     x9, #0
:digits_next                            # digits_next:
cmp_x9,x2                               #     cmp     x9, x2
@digits_done b.cs                       #     b.hs    digits_done
add_x10,x1,x9                           #     add     x10, x1, x9
ldrb_w10,[x10]                          #     ldrb    w10, [x10]
sub_x10,x10,0x30                        #     sub     x10, x10, #0x30             // '0'-'9'
mov_x11,0xa                             #     mov     x11, #10
cmp_x10,x11                             #     cmp     x10, x11
@digits_not b.cs                        #     b.hs    digits_not
mul_x0,x0,x11                           #     mul     x0, x0, x11
add_x0,x0,x10                           #     add     x0, x0, x10
add_x9,x9,0x1                           #     add     x9, x9, #1
^~digits_next RBRANCH                   #     b       digits_next
:digits_done                            # digits_done:
mov_x3,0x0                              #     mov     x3, #0
ret                                     #     ret
:digits_not                             # digits_not:
mov_x3,0x1                              #     mov     x3, #1
ret                                     #     ret

:here                                   # here:                                   // x0 = the address of the next byte, x1 its section (uses x9, x10)
ldr_x1,[x19,16]                         #     ldr     x1, [x19, #V_sec]
lsl_x9,x1,3                             #     lsl     x9, x1, #3
add_x9,x9,x19                           #     add     x9, x9, x19
ldr_x0,[x9,72]                          #     ldr     x0, [x9, #V_loc]
ldr_x10,[x9,152]                        #     ldr     x10, [x9, #V_base]
add_x0,x0,x10                           #     add     x0, x0, x10
ret                                     #     ret

# Expressions: x0 the value (with its section's address in pass 2), x1
# the kind; V_exact and V_known cleared as it says. Each level keeps its
# left side on the stack.

:eval                                   # eval:                                   // the expression at x20
mov_x9,0x1                              #     mov     x9, #1
str_x9,[x19,48]                         #     str     x9, [x19, #V_exact]
str_x9,[x19,56]                         #     str     x9, [x19, #V_known]
^~expr FBRANCH                          #     b       expr

:eval_number                            # eval_number:                            // x0 = the expression at x20: a number known here
sub_sp,sp,0x10                          #     sub     sp, sp, #16
str_x30,[sp]                            #     str     x30, [sp]
^~eval RCALL                            #     bl      eval
@not_number cbnz_x1                     #     cbnz    x1, not_number
ldr_x9,[x19,48]                         #     ldr     x9, [x19, #V_exact]
@not_number cbz_x9                      #     cbz     x9, not_number
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x10                          #     add     sp, sp, #16
ret                                     #     ret

:expr                                   # expr:                                   // + -
sub_sp,sp,0x20                          #     sub     sp, sp, #32
str_x30,[sp]                            #     str     x30, [sp]
^~expr_or FCALL                         #     bl      expr_or
:expr_more                              # expr_more:
^~blanks RCALL                          #     bl      blanks
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x2b                            #     mov     x10, #0x2b                  // '+'
cmp_x9,x10                              #     cmp     x9, x10
@expr_add b.eq                          #     b.eq    expr_add
mov_x10,0x2d                            #     mov     x10, #0x2d                  // '-'
cmp_x9,x10                              #     cmp     x9, x10
@expr_sub b.eq                          #     b.eq    expr_sub
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x20                          #     add     sp, sp, #32
ret                                     #     ret
:expr_add                               # expr_add:
add_x20,x20,0x1                         #     add     x20, x20, #1
str_x0,[sp,8]                           #     str     x0, [sp, #8]
str_x1,[sp,16]                          #     str     x1, [sp, #16]
^~expr_or FCALL                         #     bl      expr_or
ldr_x9,[sp,8]                           #     ldr     x9, [sp, #8]                // the left one's value
ldr_x10,[sp,16]                         #     ldr     x10, [sp, #16]              // its kind
add_x0,x0,x9                            #     add     x0, x0, x9
@expr_more cbz_x10                      #     cbz     x10, expr_more              // a number + x: x's kind
@expr_kinds cbnz_x1                     #     cbnz    x1, expr_kinds              // a label + a number: the label's
mov_x1,x10                              #     mov     x1, x10
^~expr_more RBRANCH                     #     b       expr_more
:expr_sub                               # expr_sub:
add_x20,x20,0x1                         #     add     x20, x20, #1
str_x0,[sp,8]                           #     str     x0, [sp, #8]
str_x1,[sp,16]                          #     str     x1, [sp, #16]
^~expr_or FCALL                         #     bl      expr_or
ldr_x9,[sp,8]                           #     ldr     x9, [sp, #8]
ldr_x10,[sp,16]                         #     ldr     x10, [sp, #16]
sub_x0,x9,x0                            #     sub     x0, x9, x0
@expr_sub_kind cbz_x1                   #     cbz     x1, expr_sub_kind           // x - a number: x's kind
cmp_x1,x10                              #     cmp     x1, x10                     // two labels of a section: a number
@expr_kinds b.ne                        #     b.ne    expr_kinds
mov_x1,0x0                              #     mov     x1, #0
^~expr_more RBRANCH                     #     b       expr_more
:expr_sub_kind                          # expr_sub_kind:
mov_x1,x10                              #     mov     x1, x10
^~expr_more RBRANCH                     #     b       expr_more
:expr_kinds                             # expr_kinds:
^~kinds FCALL                           #     bl      kinds
^~expr_more RBRANCH                     #     b       expr_more

:kinds                                  # kinds:                                  // an operation on labels it cannot do: fine while names are unknown (uses x9)
mov_x1,0x0                              #     mov     x1, #0
ldr_x9,[x19,56]                         #     ldr     x9, [x19, #V_known]
@kinds_unknown cbz_x9                   #     cbz     x9, kinds_unknown
~msg_kinds adrp_x0 !msg_kinds add_x0,x0,:lo12: #     la      x0, msg_kinds
^~fail FBRANCH                          #     b       fail
:kinds_unknown                          # kinds_unknown:
ret                                     #     ret

:expr_or                                # expr_or:                                // | & ^
sub_sp,sp,0x20                          #     sub     sp, sp, #32
str_x30,[sp]                            #     str     x30, [sp]
^~expr_mul FCALL                        #     bl      expr_mul
:expr_or_more                           # expr_or_more:
^~blanks RCALL                          #     bl      blanks
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x7c                            #     mov     x10, #0x7c                  // '|'
cmp_x9,x10                              #     cmp     x9, x10
@expr_or_op b.eq                        #     b.eq    expr_or_op
mov_x10,0x26                            #     mov     x10, #0x26                  // '&'
cmp_x9,x10                              #     cmp     x9, x10
@expr_or_op b.eq                        #     b.eq    expr_or_op
mov_x10,0x5e                            #     mov     x10, #0x5e                  // '^'
cmp_x9,x10                              #     cmp     x9, x10
@expr_or_op b.eq                        #     b.eq    expr_or_op
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x20                          #     add     sp, sp, #32
ret                                     #     ret
:expr_or_op                             # expr_or_op:
add_x20,x20,0x1                         #     add     x20, x20, #1
str_x9,[sp,24]                          #     str     x9, [sp, #24]               // the operator
str_x0,[sp,8]                           #     str     x0, [sp, #8]
str_x1,[sp,16]                          #     str     x1, [sp, #16]
^~expr_mul FCALL                        #     bl      expr_mul
ldr_x10,[sp,16]                         #     ldr     x10, [sp, #16]              // numbers only
orr_x10,x10,x1                          #     orr     x10, x10, x1
@expr_or_numbers cbz_x10                #     cbz     x10, expr_or_numbers
^~kinds RCALL                           #     bl      kinds
:expr_or_numbers                        # expr_or_numbers:
mov_x1,0x0                              #     mov     x1, #0
ldr_x9,[sp,8]                           #     ldr     x9, [sp, #8]
ldr_x11,[sp,24]                         #     ldr     x11, [sp, #24]
mov_x10,0x7c                            #     mov     x10, #0x7c                  // '|'
cmp_x11,x10                             #     cmp     x11, x10
@expr_and b.ne                          #     b.ne    expr_and
orr_x0,x9,x0                            #     orr     x0, x9, x0
^~expr_or_more RBRANCH                  #     b       expr_or_more
:expr_and                               # expr_and:
mov_x10,0x26                            #     mov     x10, #0x26                  // '&'
cmp_x11,x10                             #     cmp     x11, x10
@expr_xor b.ne                          #     b.ne    expr_xor
and_x0,x9,x0                            #     and     x0, x9, x0
^~expr_or_more RBRANCH                  #     b       expr_or_more
:expr_xor                               # expr_xor:
eor_x0,x9,x0                            #     eor     x0, x9, x0
^~expr_or_more RBRANCH                  #     b       expr_or_more

:expr_mul                               # expr_mul:                               // * / % << >>
sub_sp,sp,0x20                          #     sub     sp, sp, #32
str_x30,[sp]                            #     str     x30, [sp]
^~expr_unary FCALL                      #     bl      expr_unary
:expr_mul_more                          # expr_mul_more:
^~blanks RCALL                          #     bl      blanks
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x2a                            #     mov     x10, #0x2a                  // '*'
cmp_x9,x10                              #     cmp     x9, x10
@expr_mul_op b.eq                       #     b.eq    expr_mul_op
mov_x10,0x2f                            #     mov     x10, #0x2f                  // '/', but not '//' (a comment)
cmp_x9,x10                              #     cmp     x9, x10
@expr_slash b.eq                        #     b.eq    expr_slash
mov_x10,0x25                            #     mov     x10, #0x25                  // '%'
cmp_x9,x10                              #     cmp     x9, x10
@expr_mul_op b.eq                       #     b.eq    expr_mul_op
mov_x10,0x3c                            #     mov     x10, #0x3c                  // '<' of '<<'
cmp_x9,x10                              #     cmp     x9, x10
@expr_shift b.eq                        #     b.eq    expr_shift
mov_x10,0x3e                            #     mov     x10, #0x3e                  // '>' of '>>'
cmp_x9,x10                              #     cmp     x9, x10
@expr_shift b.eq                        #     b.eq    expr_shift
:expr_mul_done                          # expr_mul_done:
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x20                          #     add     sp, sp, #32
ret                                     #     ret
:expr_slash                             # expr_slash:
ldrb_w10,[x20,1]                        #     ldrb    w10, [x20, #1]
cmp_x10,x9                              #     cmp     x10, x9
@expr_mul_op b.ne                       #     b.ne    expr_mul_op
^~expr_mul_done RBRANCH                 #     b       expr_mul_done
:expr_shift                             # expr_shift:
ldrb_w10,[x20,1]                        #     ldrb    w10, [x20, #1]              // doubled
cmp_x10,x9                              #     cmp     x10, x9
@expr_mul_done b.ne                     #     b.ne    expr_mul_done
add_x20,x20,0x1                         #     add     x20, x20, #1
:expr_mul_op                            # expr_mul_op:
add_x20,x20,0x1                         #     add     x20, x20, #1
str_x9,[sp,24]                          #     str     x9, [sp, #24]               // the operator
str_x0,[sp,8]                           #     str     x0, [sp, #8]
str_x1,[sp,16]                          #     str     x1, [sp, #16]
^~expr_unary FCALL                      #     bl      expr_unary
ldr_x10,[sp,16]                         #     ldr     x10, [sp, #16]              // numbers only
orr_x10,x10,x1                          #     orr     x10, x10, x1
@expr_mul_numbers cbz_x10               #     cbz     x10, expr_mul_numbers
^~kinds RCALL                           #     bl      kinds
:expr_mul_numbers                       # expr_mul_numbers:
mov_x1,0x0                              #     mov     x1, #0
ldr_x9,[sp,8]                           #     ldr     x9, [sp, #8]                // the left one
ldr_x11,[sp,24]                         #     ldr     x11, [sp, #24]
mov_x10,0x2a                            #     mov     x10, #0x2a                  // '*'
cmp_x11,x10                             #     cmp     x11, x10
@expr_div b.ne                          #     b.ne    expr_div
mul_x0,x9,x0                            #     mul     x0, x9, x0
^~expr_mul_more RBRANCH                 #     b       expr_mul_more
:expr_div                               # expr_div:
mov_x10,0x3c                            #     mov     x10, #0x3c                  // '<<'
cmp_x11,x10                             #     cmp     x11, x10
@expr_shl b.eq                          #     b.eq    expr_shl
mov_x10,0x3e                            #     mov     x10, #0x3e                  // '>>'
cmp_x11,x10                             #     cmp     x11, x10
@expr_shr b.eq                          #     b.eq    expr_shr
@expr_by_zero cbz_x0                    #     cbz     x0, expr_by_zero
mov_x10,0x2f                            #     mov     x10, #0x2f                  // '/': signed, as gas
cmp_x11,x10                             #     cmp     x11, x10
@expr_rem b.ne                          #     b.ne    expr_rem
sdiv_x0,x9,x0                           #     sdiv    x0, x9, x0
^~expr_mul_more RBRANCH                 #     b       expr_mul_more
:expr_rem                               # expr_rem:                               // '%'
sdiv_x16,x9,x0                          #     sdiv    x16, x9, x0
msub_x0,x16,x0,x9                       #     msub    x0, x16, x0, x9
^~expr_mul_more RBRANCH                 #     b       expr_mul_more
:expr_by_zero                           # expr_by_zero:                           // fine while names are unknown
ldr_x10,[x19,56]                        #     ldr     x10, [x19, #V_known]
@bad_expr cbnz_x10                      #     cbnz    x10, bad_expr
^~expr_mul_more RBRANCH                 #     b       expr_mul_more
:expr_shl                               # expr_shl:
lsl_x0,x9,x0                            #     lsl     x0, x9, x0
^~expr_mul_more RBRANCH                 #     b       expr_mul_more
:expr_shr                               # expr_shr:
asr_x0,x9,x0                            #     asr     x0, x9, x0
^~expr_mul_more RBRANCH                 #     b       expr_mul_more

:expr_unary                             # expr_unary:                             // - ~ ( ), a number, a name, '.'
sub_sp,sp,0x10                          #     sub     sp, sp, #16
str_x30,[sp]                            #     str     x30, [sp]
^~blanks RCALL                          #     bl      blanks
ldrb_w0,[x20]                           #     ldrb    w0, [x20]
mov_x9,0x2d                             #     mov     x9, #0x2d                   // '-'
cmp_x0,x9                               #     cmp     x0, x9
@unary_neg b.eq                         #     b.eq    unary_neg
mov_x9,0x7e                             #     mov     x9, #0x7e                   // '~'
cmp_x0,x9                               #     cmp     x0, x9
@unary_not b.eq                         #     b.eq    unary_not
mov_x9,0x28                             #     mov     x9, #0x28                   // '('
cmp_x0,x9                               #     cmp     x0, x9
@unary_paren b.eq                       #     b.eq    unary_paren
^~is_ident RCALL                        #     bl      is_ident
@bad_expr cbz_x0                        #     cbz     x0, bad_expr
^~word RCALL                            #     bl      word
ldrb_w9,[x1]                            #     ldrb    w9, [x1]
sub_x9,x9,0x30                          #     sub     x9, x9, #0x30               // '0'-'9': a number
mov_x10,0xa                             #     mov     x10, #10
cmp_x9,x10                              #     cmp     x9, x10
@unary_number b.cc                      #     b.lo    unary_number
mov_x9,0x1                              #     mov     x9, #1                      // '.': here
cmp_x2,x9                               #     cmp     x2, x9
@unary_symbol b.ne                      #     b.ne    unary_symbol
ldrb_w9,[x1]                            #     ldrb    w9, [x1]
mov_x10,0x2e                            #     mov     x10, #0x2e
cmp_x9,x10                              #     cmp     x9, x10
@unary_symbol b.ne                      #     b.ne    unary_symbol
^~here RCALL                            #     bl      here
^~unary_done FBRANCH                    #     b       unary_done
:unary_neg                              # unary_neg:
add_x20,x20,0x1                         #     add     x20, x20, #1
^~expr_unary RCALL                      #     bl      expr_unary
neg_x0,x0                               #     neg     x0, x0
^~unary_number_only FBRANCH             #     b       unary_number_only
:unary_not                              # unary_not:
add_x20,x20,0x1                         #     add     x20, x20, #1
^~expr_unary RCALL                      #     bl      expr_unary
mvn_x0,x0                               #     mvn     x0, x0
:unary_number_only                      # unary_number_only:
@unary_done cbz_x1                      #     cbz     x1, unary_done
^~kinds RCALL                           #     bl      kinds
^~unary_done FBRANCH                    #     b       unary_done
:unary_paren                            # unary_paren:
add_x20,x20,0x1                         #     add     x20, x20, #1
^~expr RCALL                            #     bl      expr
^~blanks RCALL                          #     bl      blanks
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x29                            #     mov     x10, #0x29                  // ')'
cmp_x9,x10                              #     cmp     x9, x10
@bad_expr b.ne                          #     b.ne    bad_expr
add_x20,x20,0x1                         #     add     x20, x20, #1
^~unary_done FBRANCH                    #     b       unary_done
:unary_symbol                           # unary_symbol:
^~find_sym RCALL                        #     bl      find_sym
@undefined cbz_x0                       #     cbz     x0, undefined
add_x0,x0,0x10                          #     add     x0, x0, #S_value            // its definition
^~unary_def FBRANCH                     #     b       unary_def
:unary_number                           # unary_number:                           // digits, then b or f: a local label's
add_x9,x1,x2                            #     add     x9, x1, x2
ldurb_w9,[x9,-1]                        #     ldrb    w9, [x9, #-1]
mov_x10,0x62                            #     mov     x10, #0x62                  // 'b'
cmp_x9,x10                              #     cmp     x9, x10
@unary_local b.eq                       #     b.eq    unary_local
mov_x10,0x66                            #     mov     x10, #0x66                  // 'f'
cmp_x9,x10                              #     cmp     x9, x10
@unary_local b.eq                       #     b.eq    unary_local
:unary_plain                            # unary_plain:
^~number FCALL                          #     bl      number
@bad_number cbnz_x3                     #     cbnz    x3, bad_number
mov_x1,0x0                              #     mov     x1, #0
^~unary_done FBRANCH                    #     b       unary_done
:unary_local                            # unary_local:
sub_x2,x2,0x1                           #     sub     x2, x2, #1
^~digits RCALL                          #     bl      digits
add_x2,x2,0x1                           #     add     x2, x2, #1
@unary_plain cbnz_x3                    #     cbnz    x3, unary_plain
^~local_ref RCALL                       #     bl      local_ref
:unary_def                              # unary_def:                              // definition x0: defined before, in this pass?
ldr_x9,[x0,16]                          #     ldr     x9, [x0, #16]               // its pass
@undefined cbz_x9                       #     cbz     x9, undefined               // none yet
ldr_x10,[x19]                           #     ldr     x10, [x19, #V_pass]
cmp_x9,x10                              #     cmp     x9, x10
@unary_exact b.eq                       #     b.eq    unary_exact
str_xzr,[x19,48]                        #     str     xzr, [x19, #V_exact]
:unary_exact                            # unary_exact:
ldr_x1,[x0,8]                           #     ldr     x1, [x0, #8]                // its kind
ldr_x0,[x0]                             #     ldr     x0, [x0]                    // its value
lsl_x9,x1,3                             #     lsl     x9, x1, #3                  // plus its section's address
add_x9,x9,x19                           #     add     x9, x9, x19
ldr_x9,[x9,152]                         #     ldr     x9, [x9, #V_base]
add_x0,x0,x9                            #     add     x0, x0, x9
:unary_done                             # unary_done:
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x10                          #     add     sp, sp, #16
ret                                     #     ret
:undefined                              # undefined:                              // a name not yet defined: an error in pass 2
ldr_x9,[x19,8]                          #     ldr     x9, [x19, #V_emit]
@not_defined cbnz_x9                    #     cbnz    x9, not_defined
str_xzr,[x19,48]                        #     str     xzr, [x19, #V_exact]
str_xzr,[x19,56]                        #     str     xzr, [x19, #V_known]
mov_x0,0x0                              #     mov     x0, #0
mov_x1,0x0                              #     mov     x1, #0
^~unary_done RBRANCH                    #     b       unary_done

:number                                 # number:                                 // x0 = the number x1, x2: decimal, 0x hex, 0 octal; x3 = 1 if none (uses x9-x13)
mov_x0,0x0                              #     mov     x0, #0
mov_x9,0x0                              #     mov     x9, #0                      // the next digit
mov_x11,0xa                             #     mov     x11, #10                    // the base
ldrb_w10,[x1]                           #     ldrb    w10, [x1]
mov_x12,0x30                            #     mov     x12, #0x30                  // '0'
cmp_x10,x12                             #     cmp     x10, x12
@number_digits b.ne                     #     b.ne    number_digits
mov_x12,0x1                             #     mov     x12, #1
cmp_x2,x12                              #     cmp     x2, x12
@number_digits b.eq                     #     b.eq    number_digits
mov_x11,0x8                             #     mov     x11, #8                     // 0...: octal
mov_x9,0x1                              #     mov     x9, #1
ldrb_w10,[x1,1]                         #     ldrb    w10, [x1, #1]
orr_x10,x10,0x20                        #     orr     x10, x10, #0x20
mov_x12,0x78                            #     mov     x12, #0x78                  // 0x...: hex
cmp_x10,x12                             #     cmp     x10, x12
@number_digits b.ne                     #     b.ne    number_digits
mov_x11,0x10                            #     mov     x11, #16
mov_x9,0x2                              #     mov     x9, #2
mov_x12,0x2                             #     mov     x12, #2
cmp_x2,x12                              #     cmp     x2, x12
@number_bad b.eq                        #     b.eq    number_bad
:number_digits                          # number_digits:
cmp_x9,x2                               #     cmp     x9, x2
@number_done b.cs                       #     b.hs    number_done
add_x10,x1,x9                           #     add     x10, x1, x9
ldrb_w10,[x10]                          #     ldrb    w10, [x10]
sub_x12,x10,0x30                        #     sub     x12, x10, #0x30             // '0'-'9'
mov_x13,0xa                             #     mov     x13, #10
cmp_x12,x13                             #     cmp     x12, x13
@number_digit b.cc                      #     b.lo    number_digit
orr_x12,x10,0x20                        #     orr     x12, x10, #0x20             // 'a'-'f', 'A'-'F': 10-15
sub_x12,x12,0x57                        #     sub     x12, x12, #0x57
cmp_x12,x13                             #     cmp     x12, x13
@number_bad b.cc                        #     b.lo    number_bad
:number_digit                           # number_digit:
cmp_x12,x11                             #     cmp     x12, x11                    // a digit of the base
@number_bad b.cs                        #     b.hs    number_bad
mul_x0,x0,x11                           #     mul     x0, x0, x11
add_x0,x0,x12                           #     add     x0, x0, x12
add_x9,x9,0x1                           #     add     x9, x9, #1
^~number_digits RBRANCH                 #     b       number_digits
:number_done                            # number_done:
mov_x3,0x0                              #     mov     x3, #0
ret                                     #     ret
:number_bad                             # number_bad:
mov_x3,0x1                              #     mov     x3, #1
ret                                     #     ret

# Directives.

:directive                              # directive:                              // x1, x2: its name
^~pack RCALL                            #     bl      pack
~directives adrp_x9 !directives add_x9,x9,:lo12: #     la      x9, directives
:directive_next                         # directive_next:
ldr_x10,[x9]                            #     ldr     x10, [x9]
@unknown_directive cbz_x10              #     cbz     x10, unknown_directive
cmp_x10,x0                              #     cmp     x10, x0
@directive_found b.eq                   #     b.eq    directive_found
add_x9,x9,0x10                          #     add     x9, x9, #16
^~directive_next RBRANCH                #     b       directive_next
:directive_found                        # directive_found:
ldr_x10,[x9,8]                          #     ldr     x10, [x9, #8]               // its routine, from directives
~directives adrp_x11 !directives add_x11,x11,:lo12: #     la      x11, directives
add_x10,x10,x11                         #     add     x10, x10, x11
br_x10                                  #     br      x10
:unknown_directive                      # unknown_directive:
~msg_directive adrp_x0 !msg_directive add_x0,x0,:lo12: #     la      x0, msg_directive
^~fail FBRANCH                          #     b       fail

:d_globl                                # d_globl:                                // .globl name: ld starts at _start anyway
^~blanks RCALL                          #     bl      blanks
^~word RCALL                            #     bl      word
^~end_line RBRANCH                      #     b       end_line

:d_section                              # d_section:                              // .section name
^~blanks RCALL                          #     bl      blanks
^~word RCALL                            #     bl      word
^~pack RCALL                            #     bl      pack
~sections adrp_x9 !sections add_x9,x9,:lo12: #     la      x9, sections
mov_x11,0x1                             #     mov     x11, #1
:d_section_next                         # d_section_next:
ldr_x10,[x9]                            #     ldr     x10, [x9]
cmp_x10,x0                              #     cmp     x10, x0
@d_section_found b.eq                   #     b.eq    d_section_found
add_x9,x9,0x8                           #     add     x9, x9, #8
add_x11,x11,0x1                         #     add     x11, x11, #1
mov_x10,0x4                             #     mov     x10, #4
cmp_x10,x11                             #     cmp     x10, x11
@d_section_next b.cs                    #     b.hs    d_section_next
~msg_section adrp_x0 !msg_section add_x0,x0,:lo12: #     la      x0, msg_section
^~fail FBRANCH                          #     b       fail
:d_section_found                        # d_section_found:
mov_x0,x11                              #     mov     x0, x11
^~set_section FBRANCH                   #     b       set_section
:d_text                                 # d_text:
mov_x0,0x1                              #     mov     x0, #1
^~set_section FBRANCH                   #     b       set_section
:d_data                                 # d_data:
mov_x0,0x3                              #     mov     x0, #3
^~set_section FBRANCH                   #     b       set_section
:d_bss                                  # d_bss:
mov_x0,0x4                              #     mov     x0, #4
:set_section                            # set_section:
str_x0,[x19,16]                         #     str     x0, [x19, #V_sec]
^~end_line RBRANCH                      #     b       end_line

:d_equ                                  # d_equ:                                  // .equ name, expr
^~blanks RCALL                          #     bl      blanks
^~word RCALL                            #     bl      word
mov_x27,x1                              #     mov     x27, x1
mov_x28,x2                              #     mov     x28, x2
^~blanks RCALL                          #     bl      blanks
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x2c                            #     mov     x10, #0x2c                  // ','
cmp_x9,x10                              #     cmp     x9, x10
@bad_syntax b.ne                        #     b.ne    bad_syntax
add_x20,x20,0x1                         #     add     x20, x20, #1
^~eval RCALL                            #     bl      eval
lsl_x9,x1,3                             #     lsl     x9, x1, #3                  // kept in its section
add_x9,x9,x19                           #     add     x9, x9, x19
ldr_x9,[x9,152]                         #     ldr     x9, [x9, #V_base]
sub_x3,x0,x9                            #     sub     x3, x0, x9
mov_x4,x1                               #     mov     x4, x1
mov_x1,x27                              #     mov     x1, x27
mov_x2,x28                              #     mov     x2, x28
mov_x5,0x0                              #     mov     x5, #0                      // may be set again
^~define RCALL                          #     bl      define
ldr_x9,[x19,48]                         #     ldr     x9, [x19, #V_exact]         // not known here: never a number known here
@end_line cbnz_x9                       #     cbnz    x9, end_line
str_xzr,[x0,32]                         #     str     xzr, [x0, #S_pass]
^~end_line RBRANCH                      #     b       end_line

:d_balign                               # d_balign:                               // .balign n: zeros up to a multiple of n
^~eval_number RCALL                     #     bl      eval_number
@bad_align cbz_x0                       #     cbz     x0, bad_align
sub_x9,x0,0x1                           #     sub     x9, x0, #1                  // a power of 2
and_x10,x0,x9                           #     and     x10, x0, x9
@bad_align cbnz_x10                     #     cbnz    x10, bad_align
ldr_x11,[x19,16]                        #     ldr     x11, [x19, #V_sec]
mov_x10,0x1                             #     mov     x10, #1                     // gas pads .text with nops: not done
cmp_x11,x10                             #     cmp     x11, x10
@bad_align b.eq                         #     b.eq    bad_align
lsl_x11,x11,3                           #     lsl     x11, x11, #3
add_x11,x11,x19                         #     add     x11, x11, x19
ldr_x10,[x11,112]                       #     ldr     x10, [x11, #V_align]        // the section's alignment
cmp_x10,x0                              #     cmp     x10, x0
@d_balign_pad b.cs                      #     b.hs    d_balign_pad
str_x0,[x11,112]                        #     str     x0, [x11, #V_align]
:d_balign_pad                           # d_balign_pad:
ldr_x10,[x11,72]                        #     ldr     x10, [x11, #V_loc]
neg_x12,x10                             #     neg     x12, x10
and_x12,x12,x9                          #     and     x12, x12, x9                // (-loc) & (n - 1)
add_x10,x10,x12                         #     add     x10, x10, x12               // zeros: the output is zero
str_x10,[x11,72]                        #     str     x10, [x11, #V_loc]
^~end_line RBRANCH                      #     b       end_line

:d_skip                                 # d_skip:                                 // .skip n: n zeros
^~eval_number RCALL                     #     bl      eval_number
ldr_x11,[x19,16]                        #     ldr     x11, [x19, #V_sec]
lsl_x11,x11,3                           #     lsl     x11, x11, #3
add_x11,x11,x19                         #     add     x11, x11, x19
ldr_x10,[x11,72]                        #     ldr     x10, [x11, #V_loc]
add_x10,x10,x0                          #     add     x10, x10, x0
str_x10,[x11,72]                        #     str     x10, [x11, #V_loc]
^~end_line RBRANCH                      #     b       end_line

:d_byte                                 # d_byte:                                 // .byte expr, ...
mov_x27,0x1                             #     mov     x27, #1
^~data FBRANCH                          #     b       data
:d_half                                 # d_half:                                 // .half expr, ...
mov_x27,0x2                             #     mov     x27, #2
^~data FBRANCH                          #     b       data
:d_word                                 # d_word:                                 // .word expr, ...
mov_x27,0x4                             #     mov     x27, #4
^~data FBRANCH                          #     b       data
:d_dword                                # d_dword:                                // .dword expr, ...
mov_x27,0x8                             #     mov     x27, #8
:data                                   # data:
^~eval RCALL                            #     bl      eval
mov_x1,x27                              #     mov     x1, x27
^~emit_n FCALL                          #     bl      emit_n
^~blanks RCALL                          #     bl      blanks
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x2c                            #     mov     x10, #0x2c                  // ','
cmp_x9,x10                              #     cmp     x9, x10
@end_line b.ne                          #     b.ne    end_line
add_x20,x20,0x1                         #     add     x20, x20, #1
^~data RBRANCH                          #     b       data

:d_asciz                                # d_asciz:                                // .asciz "text", ...: each with a 0 after it
mov_x27,0x1                             #     mov     x27, #1
^~ascii FBRANCH                         #     b       ascii
:d_ascii                                # d_ascii:                                // .ascii "text", ...
mov_x27,0x0                             #     mov     x27, #0
:ascii                                  # ascii:
^~blanks RCALL                          #     bl      blanks
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x22                            #     mov     x10, #0x22                  // '"'
cmp_x9,x10                              #     cmp     x9, x10
@bad_syntax b.ne                        #     b.ne    bad_syntax
add_x20,x20,0x1                         #     add     x20, x20, #1
:ascii_byte                             # ascii_byte:
cmp_x20,x21                             #     cmp     x20, x21
@bad_string b.cs                        #     b.hs    bad_string
ldrb_w0,[x20]                           #     ldrb    w0, [x20]
mov_x10,0xa                             #     mov     x10, #0x0a                  // '\n'
cmp_x0,x10                              #     cmp     x0, x10
@bad_string b.eq                        #     b.eq    bad_string
add_x20,x20,0x1                         #     add     x20, x20, #1
mov_x10,0x22                            #     mov     x10, #0x22                  // '"'
cmp_x0,x10                              #     cmp     x0, x10
@ascii_end b.eq                         #     b.eq    ascii_end
mov_x10,0x5c                            #     mov     x10, #0x5c                  // '\'
cmp_x0,x10                              #     cmp     x0, x10
@ascii_put b.ne                         #     b.ne    ascii_put
ldrb_w0,[x20]                           #     ldrb    w0, [x20]
add_x20,x20,0x1                         #     add     x20, x20, #1
mov_x10,0x6e                            #     mov     x10, #0x6e                  // \n
cmp_x0,x10                              #     cmp     x0, x10
@ascii_not_n b.ne                       #     b.ne    ascii_not_n
mov_x0,0xa                              #     mov     x0, #0x0a
^~ascii_put FBRANCH                     #     b       ascii_put
:ascii_not_n                            # ascii_not_n:
mov_x10,0x74                            #     mov     x10, #0x74                  // \t
cmp_x0,x10                              #     cmp     x0, x10
@ascii_not_t b.ne                       #     b.ne    ascii_not_t
mov_x0,0x9                              #     mov     x0, #0x09
^~ascii_put FBRANCH                     #     b       ascii_put
:ascii_not_t                            # ascii_not_t:
sub_x11,x0,0x30                         #     sub     x11, x0, #0x30              // \ooo: up to 3 octal digits
mov_x10,0x8                             #     mov     x10, #8
cmp_x11,x10                             #     cmp     x11, x10                    // else the byte itself
@ascii_put b.cs                         #     b.hs    ascii_put
mov_x0,x11                              #     mov     x0, x11
mov_x12,0x2                             #     mov     x12, #2
:ascii_octal                            # ascii_octal:
ldrb_w11,[x20]                          #     ldrb    w11, [x20]
sub_x11,x11,0x30                        #     sub     x11, x11, #0x30
cmp_x11,x10                             #     cmp     x11, x10
@ascii_put b.cs                         #     b.hs    ascii_put
lsl_x0,x0,3                             #     lsl     x0, x0, #3
add_x0,x0,x11                           #     add     x0, x0, x11
add_x20,x20,0x1                         #     add     x20, x20, #1
sub_x12,x12,0x1                         #     sub     x12, x12, #1
@ascii_octal cbnz_x12                   #     cbnz    x12, ascii_octal
:ascii_put                              # ascii_put:
^~emit_byte FCALL                       #     bl      emit_byte
^~ascii_byte RBRANCH                    #     b       ascii_byte
:ascii_end                              # ascii_end:
@ascii_next cbz_x27                     #     cbz     x27, ascii_next
mov_x0,0x0                              #     mov     x0, #0
^~emit_byte FCALL                       #     bl      emit_byte
:ascii_next                             # ascii_next:
^~blanks RCALL                          #     bl      blanks
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x2c                            #     mov     x10, #0x2c                  // ','
cmp_x9,x10                              #     cmp     x9, x10
@end_line b.ne                          #     b.ne    end_line
add_x20,x20,0x1                         #     add     x20, x20, #1
^~ascii RBRANCH                         #     b       ascii

# Output.

:emit_byte                              # emit_byte:                              // the byte x0 at here, in pass 2; counted (uses x9-x11)
ldr_x9,[x19,16]                         #     ldr     x9, [x19, #V_sec]
lsl_x10,x9,3                            #     lsl     x10, x9, #3
add_x10,x10,x19                         #     add     x10, x10, x19
ldr_x11,[x19,8]                         #     ldr     x11, [x19, #V_emit]
@emit_byte_count cbz_x11                #     cbz     x11, emit_byte_count
mov_x11,0x4                             #     mov     x11, #4                     // not in .bss
cmp_x9,x11                              #     cmp     x9, x11
@in_bss b.eq                            #     b.eq    in_bss
ldr_x11,[x10,192]                       #     ldr     x11, [x10, #V_off]
ldr_x9,[x10,72]                         #     ldr     x9, [x10, #V_loc]
add_x11,x11,x9                          #     add     x11, x11, x9
mov_x9,0x2610000                        #     mov     x9, #OUTBUF
add_x11,x11,x9                          #     add     x11, x11, x9
mov_x9,0x3610000                        #     mov     x9, #OUTBUF_END
cmp_x11,x9                              #     cmp     x11, x9
@output_full b.cs                       #     b.hs    output_full
strb_w0,[x11]                           #     strb    w0, [x11]
ldr_x9,[x19,16]                         #     ldr     x9, [x19, #V_sec]
:emit_byte_count                        # emit_byte_count:
ldr_x11,[x10,72]                        #     ldr     x11, [x10, #V_loc]
add_x11,x11,0x1                         #     add     x11, x11, #1
str_x11,[x10,72]                        #     str     x11, [x10, #V_loc]
ret                                     #     ret

:emit16                                 # emit16:                                 // the 2 bytes of x0 (uses x0-x2, x9-x11, x15)
mov_x1,0x2                              #     mov     x1, #2
^~emit_n FBRANCH                        #     b       emit_n
:emit32                                 # emit32:                                 // the 4 bytes of x0 (the same)
mov_x1,0x4                              #     mov     x1, #4
:emit_n                                 # emit_n:                                 // x1 bytes of x0, the low one first
mov_x15,x30                             #     mov     x15, x30
mov_x2,x0                               #     mov     x2, x0
:emit_n_byte                            # emit_n_byte:
mov_x0,x2                               #     mov     x0, x2
^~emit_byte RCALL                       #     bl      emit_byte
lsr_x2,x2,8                             #     lsr     x2, x2, #8
sub_x1,x1,0x1                           #     sub     x1, x1, #1
@emit_n_byte cbnz_x1                    #     cbnz    x1, emit_n_byte
mov_x30,x15                             #     mov     x30, x15
ret                                     #     ret

# Macros.

:d_macro                                # d_macro:                                // .macro name param, ...: its lines up to .endm
ldr_x27,[x19,32]                        #     ldr     x27, [x19, #V_nmac]
add_x9,x19,0x2,lsl12                    #     add     x9, x19, #MACROS - VARS
add_x9,x9,0x600                         #     add     x9, x9, #MAC_max * MAC_size
cmp_x27,x9                              #     cmp     x27, x9
@too_many_macros b.cs                   #     b.hs    too_many_macros
^~blanks RCALL                          #     bl      blanks
^~word RCALL                            #     bl      word
@bad_syntax cbz_x2                      #     cbz     x2, bad_syntax
^~pack RCALL                            #     bl      pack
str_x0,[x27]                            #     str     x0, [x27, #MAC_name]
mov_x28,0x0                             #     mov     x28, #0                     // its parameters
:d_macro_param                          # d_macro_param:
^~blanks RCALL                          #     bl      blanks
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
cmp_x9,0xa                              #     cmp     x9, #0x0a                   // '\n': the end of its line
@d_macro_body b.eq                      #     b.eq    d_macro_body
cmp_x9,0x2f                             #     cmp     x9, #0x2f                   // '//': a comment
@d_macro_body b.eq                      #     b.eq    d_macro_body
@d_macro_name cbz_x28                   #     cbz     x28, d_macro_name
^~p_comma FCALL                         #     bl      p_comma
^~blanks RCALL                          #     bl      blanks
:d_macro_name                           # d_macro_name:
^~word RCALL                            #     bl      word
@bad_syntax cbz_x2                      #     cbz     x2, bad_syntax
cmp_x28,0x4                             #     cmp     x28, #4
@bad_syntax b.cs                        #     b.hs    bad_syntax
add_x9,x27,0x10                         #     add     x9, x27, #MAC_params
add_x9,x9,x28,lsl4                      #     add     x9, x9, x28, lsl #4
str_x1,[x9]                             #     str     x1, [x9]
str_x2,[x9,8]                           #     str     x2, [x9, #8]
add_x28,x28,0x1                         #     add     x28, x28, #1
^~d_macro_param RBRANCH                 #     b       d_macro_param
:d_macro_body                           # d_macro_body:
str_x28,[x27,8]                         #     str     x28, [x27, #MAC_n]
^~skip_line FCALL                       #     bl      skip_line                   // its lines from the next one on
str_x20,[x27,80]                        #     str     x20, [x27, #MAC_body]
:d_macro_line                           # d_macro_line:
cmp_x20,x21                             #     cmp     x20, x21
@bad_syntax b.cs                        #     b.hs    bad_syntax                  // no .endm
mov_x29,x20                             #     mov     x29, x20                    // the line's first byte
^~blanks RCALL                          #     bl      blanks
^~word RCALL                            #     bl      word
^~pack RCALL                            #     bl      pack
~str_endm adrp_x9 !str_endm add_x9,x9,:lo12: #     la      x9, str_endm
ldr_x9,[x9]                             #     ldr     x9, [x9]
cmp_x0,x9                               #     cmp     x0, x9
@d_macro_end b.eq                       #     b.eq    d_macro_end
^~skip_line FCALL                       #     bl      skip_line
ldr_x9,[x19,24]                         #     ldr     x9, [x19, #V_line]
add_x9,x9,0x1                           #     add     x9, x9, #1
str_x9,[x19,24]                         #     str     x9, [x19, #V_line]
^~d_macro_line RBRANCH                  #     b       d_macro_line
:d_macro_end                            # d_macro_end:
str_x29,[x27,88]                        #     str     x29, [x27, #MAC_end]
add_x27,x27,0x60                        #     add     x27, x27, #MAC_size
str_x27,[x19,32]                        #     str     x27, [x19, #V_nmac]
^~end_line RBRANCH                      #     b       end_line

:d_endm                                 # d_endm:                                 // .endm without its .macro
^~bad_syntax FBRANCH                    #     b       bad_syntax

:skip_line                              # skip_line:                              // x20 after the next newline (uses x9)
cmp_x20,x21                             #     cmp     x20, x21
@skip_line_done b.cs                    #     b.hs    skip_line_done
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
add_x20,x20,0x1                         #     add     x20, x20, #1
cmp_x9,0xa                              #     cmp     x9, #0x0a
@skip_line b.ne                         #     b.ne    skip_line
:skip_line_done                         # skip_line_done:
ret                                     #     ret

:expand                                 # expand:                                 // macro x27 called: its arguments, then its lines
mov_x28,0x0                             #     mov     x28, #0                     // the arguments
ldr_x29,[x27,8]                         #     ldr     x29, [x27, #MAC_n]
:expand_arg                             # expand_arg:
cmp_x28,x29                             #     cmp     x28, x29
@expand_lines b.cs                      #     b.hs    expand_lines
@expand_first cbz_x28                   #     cbz     x28, expand_first
^~p_comma FCALL                         #     bl      p_comma
:expand_first                           # expand_first:
^~blanks RCALL                          #     bl      blanks
mov_x1,x20                              #     mov     x1, x20                     // to a ',', a newline or '//'
:expand_arg_byte                        # expand_arg_byte:
cmp_x20,x21                             #     cmp     x20, x21
@expand_arg_end b.cs                    #     b.hs    expand_arg_end
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
cmp_x9,0x2c                             #     cmp     x9, #0x2c
@expand_arg_end b.eq                    #     b.eq    expand_arg_end
cmp_x9,0xa                              #     cmp     x9, #0x0a
@expand_arg_end b.eq                    #     b.eq    expand_arg_end
cmp_x9,0x2f                             #     cmp     x9, #0x2f
@expand_arg_end b.eq                    #     b.eq    expand_arg_end
add_x20,x20,0x1                         #     add     x20, x20, #1
^~expand_arg_byte RBRANCH               #     b       expand_arg_byte
:expand_arg_end                         # expand_arg_end:
mov_x2,x20                              #     mov     x2, x20                     // without the blanks after it
:expand_arg_trim                        # expand_arg_trim:
cmp_x2,x1                               #     cmp     x2, x1
@expand_arg_store b.eq                  #     b.eq    expand_arg_store
ldurb_w9,[x2,-1]                        #     ldrb    w9, [x2, #-1]
cmp_x9,0x20                             #     cmp     x9, #0x20
@expand_arg_back b.eq                   #     b.eq    expand_arg_back
cmp_x9,0x9                              #     cmp     x9, #0x09
@expand_arg_store b.ne                  #     b.ne    expand_arg_store
:expand_arg_back                        # expand_arg_back:
sub_x2,x2,0x1                           #     sub     x2, x2, #1
^~expand_arg_trim RBRANCH               #     b       expand_arg_trim
:expand_arg_store                       # expand_arg_store:
sub_x2,x2,x1                            #     sub     x2, x2, x1
add_x9,x19,0x3,lsl12                    #     add     x9, x19, #ARGS - VARS
add_x9,x9,x28,lsl4                      #     add     x9, x9, x28, lsl #4
str_x1,[x9]                             #     str     x1, [x9]
str_x2,[x9,8]                           #     str     x2, [x9, #8]
add_x28,x28,0x1                         #     add     x28, x28, #1
^~expand_arg RBRANCH                    #     b       expand_arg
:expand_lines                           # expand_lines:
sub_sp,sp,0x30                          #     sub     sp, sp, #48                 // what the lines' statements change
ldr_x9,[x19,280]                        #     ldr     x9, [x19, #V_sret]
str_x9,[sp]                             #     str     x9, [sp]
ldr_x9,[x19,64]                         #     ldr     x9, [x19, #V_lstart]
str_x9,[sp,8]                           #     str     x9, [sp, #8]
str_x20,[sp,16]                         #     str     x20, [sp, #16]              // the rest of the call's line
str_x21,[sp,24]                         #     str     x21, [sp, #24]
str_x27,[sp,32]                         #     str     x27, [sp, #32]              // the macro
ldr_x9,[x27,80]                         #     ldr     x9, [x27, #MAC_body]
str_x9,[sp,40]                          #     str     x9, [sp, #40]               // its next line
:expand_line                            # expand_line:
ldr_x3,[sp,40]                          #     ldr     x3, [sp, #40]
ldr_x27,[sp,32]                         #     ldr     x27, [sp, #32]
ldr_x9,[x27,88]                         #     ldr     x9, [x27, #MAC_end]
cmp_x3,x9                               #     cmp     x3, x9
@expand_done b.cs                       #     b.hs    expand_done
mov_x4,0x4000 movk_x4,0x70,lsl16        #     li32    x4, EXPBUF                  // the line, \param as its argument
:expand_byte                            # expand_byte:
mov_x9,0x5000 movk_x9,0x70,lsl16        #     li32    x9, EXPBUF_END
cmp_x4,x9                               #     cmp     x4, x9
@bad_syntax b.cs                        #     b.hs    bad_syntax
ldrb_w5,[x3]                            #     ldrb    w5, [x3]
add_x3,x3,0x1                           #     add     x3, x3, #1
cmp_x5,0x5c                             #     cmp     x5, #0x5c                   // '\'
@expand_param b.eq                      #     b.eq    expand_param
strb_w5,[x4]                            #     strb    w5, [x4]
add_x4,x4,0x1                           #     add     x4, x4, #1
cmp_x5,0xa                              #     cmp     x5, #0x0a
@expand_byte b.ne                       #     b.ne    expand_byte
str_x3,[sp,40]                          #     str     x3, [sp, #40]
mov_x20,0x4000 movk_x20,0x70,lsl16      #     li32    x20, EXPBUF
mov_x21,x4                              #     mov     x21, x4
str_x20,[x19,64]                        #     str     x20, [x19, #V_lstart]
^~statement RCALL                       #     bl      statement
^~expand_line RBRANCH                   #     b       expand_line
:expand_param                           # expand_param:                           // \name: the argument of parameter name
mov_x20,x3                              #     mov     x20, x3
^~word RCALL                            #     bl      word                        // x1, x2
mov_x3,x20                              #     mov     x3, x20
ldr_x27,[sp,32]                         #     ldr     x27, [sp, #32]
ldr_x6,[x27,8]                          #     ldr     x6, [x27, #MAC_n]
add_x7,x27,0x10                         #     add     x7, x27, #MAC_params
add_x8,x19,0x3,lsl12                    #     add     x8, x19, #ARGS - VARS
:expand_find                            # expand_find:
@bad_syntax cbz_x6                      #     cbz     x6, bad_syntax              // no such parameter
ldr_x10,[x7,8]                          #     ldr     x10, [x7, #8]
cmp_x10,x2                              #     cmp     x10, x2
@expand_find_on b.ne                    #     b.ne    expand_find_on
ldr_x10,[x7]                            #     ldr     x10, [x7]
mov_x11,0x0                             #     mov     x11, #0
:expand_cmp                             # expand_cmp:
cmp_x11,x2                              #     cmp     x11, x2
@expand_found b.eq                      #     b.eq    expand_found
ldrb_w12,[x10,x11]                      #     ldrb    w12, [x10, x11]
ldrb_w13,[x1,x11]                       #     ldrb    w13, [x1, x11]
cmp_x12,x13                             #     cmp     x12, x13
@expand_find_on b.ne                    #     b.ne    expand_find_on
add_x11,x11,0x1                         #     add     x11, x11, #1
^~expand_cmp RBRANCH                    #     b       expand_cmp
:expand_find_on                         # expand_find_on:
add_x7,x7,0x10                          #     add     x7, x7, #16
add_x8,x8,0x10                          #     add     x8, x8, #16
sub_x6,x6,0x1                           #     sub     x6, x6, #1
^~expand_find RBRANCH                   #     b       expand_find
:expand_found                           # expand_found:                           // its argument's bytes
ldr_x10,[x8]                            #     ldr     x10, [x8]
ldr_x11,[x8,8]                          #     ldr     x11, [x8, #8]
:expand_copy                            # expand_copy:
@expand_byte cbz_x11                    #     cbz     x11, expand_byte
mov_x9,0x5000 movk_x9,0x70,lsl16        #     li32    x9, EXPBUF_END
cmp_x4,x9                               #     cmp     x4, x9
@bad_syntax b.cs                        #     b.hs    bad_syntax
ldrb_w12,[x10]                          #     ldrb    w12, [x10]
strb_w12,[x4]                           #     strb    w12, [x4]
add_x4,x4,0x1                           #     add     x4, x4, #1
add_x10,x10,0x1                         #     add     x10, x10, #1
sub_x11,x11,0x1                         #     sub     x11, x11, #1
^~expand_copy RBRANCH                   #     b       expand_copy
:expand_done                            # expand_done:
ldr_x9,[sp]                             #     ldr     x9, [sp]
str_x9,[x19,280]                        #     str     x9, [x19, #V_sret]
ldr_x9,[sp,8]                           #     ldr     x9, [sp, #8]
str_x9,[x19,64]                         #     str     x9, [x19, #V_lstart]
ldr_x20,[sp,16]                         #     ldr     x20, [sp, #16]
ldr_x21,[sp,24]                         #     ldr     x21, [sp, #24]
add_sp,sp,0x30                          #     add     sp, sp, #48
^~end_line RBRANCH                      #     b       end_line

# The instructions: the mnemonic's routine, with x22 its base bits and x23
# its other bits (from mnemonics). Pass 1 only counts its 4 bytes. Each
# ends with end_line.

:insn                                   # insn:                                   // x1, x2: the mnemonic, or a macro's name
^~pack RCALL                            #     bl      pack
add_x27,x19,0x2,lsl12                   #     add     x27, x19, #MACROS - VARS
ldr_x9,[x19,32]                         #     ldr     x9, [x19, #V_nmac]
:insn_macro                             # insn_macro:
cmp_x27,x9                              #     cmp     x27, x9
@insn_table b.cs                        #     b.hs    insn_table
ldr_x10,[x27]                           #     ldr     x10, [x27, #MAC_name]
cmp_x10,x0                              #     cmp     x10, x0
@expand b.eq                            #     b.eq    expand
add_x27,x27,0x60                        #     add     x27, x27, #MAC_size
^~insn_macro RBRANCH                    #     b       insn_macro
:insn_table                             # insn_table:
~mnemonics adrp_x9 !mnemonics add_x9,x9,:lo12: #     la      x9, mnemonics
:insn_next                              # insn_next:
ldr_x10,[x9]                            #     ldr     x10, [x9]
@unknown_mnemonic cbz_x10               #     cbz     x10, unknown_mnemonic
cmp_x10,x0                              #     cmp     x10, x0
@insn_found b.eq                        #     b.eq    insn_found
add_x9,x9,0x18                          #     add     x9, x9, #24
^~insn_next RBRANCH                     #     b       insn_next
:insn_found                             # insn_found:
ldr_x10,[x19,8]                         #     ldr     x10, [x19, #V_emit]
@insn_count cbz_x10                     #     cbz     x10, insn_count
ldrsw_x10,[x9,8]                        #     ldrsw   x10, [x9, #8]               // its routine, from mnemonics
ldr_w22,[x9,12]                         #     ldr     w22, [x9, #12]
ldr_x23,[x9,16]                         #     ldr     x23, [x9, #16]
~mnemonics adrp_x11 !mnemonics add_x11,x11,:lo12: #     la      x11, mnemonics
add_x10,x10,x11                         #     add     x10, x10, x11
br_x10                                  #     br      x10
:insn_count                             # insn_count:                             // pass 1: its 4 bytes, the rest of the line unread
cmp_x20,x21                             #     cmp     x20, x21
@insn_counted b.cs                      #     b.hs    insn_counted
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
cmp_x9,0xa                              #     cmp     x9, #0x0a
@insn_counted b.eq                      #     b.eq    insn_counted
add_x20,x20,0x1                         #     add     x20, x20, #1
^~insn_count RBRANCH                    #     b       insn_count
:insn_counted                           # insn_counted:
mov_x0,0x0                              #     mov     x0, #0
^~emit32 RCALL                          #     bl      emit32
^~end_line RBRANCH                      #     b       end_line

# The operands (pass 2).

:p_reg                                  # p_reg:                                  // x0 = the register at x20, x1 its class: 0 x or xzr, 1 w or wzr, 2 sp (uses x2, x9-x11, x14)
sub_sp,sp,0x10                          #     sub     sp, sp, #16
str_x30,[sp]                            #     str     x30, [sp]
^~blanks RCALL                          #     bl      blanks
^~word RCALL                            #     bl      word
@bad_operand cbz_x2                     #     cbz     x2, bad_operand
^~pack RCALL                            #     bl      pack
~registers adrp_x9 !registers add_x9,x9,:lo12: #     la      x9, registers               // x0-x30 xzr sp, then w0-w30 wzr
mov_x10,0x0                             #     mov     x10, #0
:p_reg_next                             # p_reg_next:
cmp_x10,0x41                            #     cmp     x10, #65
@unknown_register b.eq                  #     b.eq    unknown_register
ldr_x11,[x9]                            #     ldr     x11, [x9]
cmp_x11,x0                              #     cmp     x11, x0
@p_reg_found b.eq                       #     b.eq    p_reg_found
add_x9,x9,0x8                           #     add     x9, x9, #8
add_x10,x10,0x1                         #     add     x10, x10, #1
^~p_reg_next RBRANCH                    #     b       p_reg_next
:p_reg_found                            # p_reg_found:
mov_x0,x10                              #     mov     x0, x10
mov_x1,0x0                              #     mov     x1, #0
cmp_x10,0x20                            #     cmp     x10, #32
@p_reg_done b.cc                        #     b.lo    p_reg_done                  // x0-x30, xzr
mov_x0,0x1f                             #     mov     x0, #31
mov_x1,0x2                              #     mov     x1, #2
@p_reg_done b.eq                        #     b.eq    p_reg_done                  // sp
sub_x0,x10,0x21                         #     sub     x0, x10, #33                // w0-w30, wzr
mov_x1,0x1                              #     mov     x1, #1
:p_reg_done                             # p_reg_done:
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x10                          #     add     sp, sp, #16
ret                                     #     ret

:p_comma                                # p_comma:                                // a ',' (uses x9, x10, x12)
mov_x12,x30                             #     mov     x12, x30
^~blanks RCALL                          #     bl      blanks
mov_x30,x12                             #     mov     x30, x12
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
mov_x10,0x2c                            #     mov     x10, #0x2c
cmp_x9,x10                              #     cmp     x9, x10
@bad_syntax b.ne                        #     b.ne    bad_syntax
add_x20,x20,0x1                         #     add     x20, x20, #1
ret                                     #     ret

:p_byte                                 # p_byte:                                 // x0 = the next byte after blanks (uses x9, x10, x12)
mov_x12,x30                             #     mov     x12, x30
^~blanks RCALL                          #     bl      blanks
mov_x30,x12                             #     mov     x30, x12
ldrb_w0,[x20]                           #     ldrb    w0, [x20]
ret                                     #     ret

:p_expect                               # p_expect:                               // the byte x0 after blanks (uses x9, x10, x12, x13)
mov_x13,x0                              #     mov     x13, x0
mov_x12,x30                             #     mov     x12, x30
^~blanks RCALL                          #     bl      blanks
mov_x30,x12                             #     mov     x30, x12
ldrb_w9,[x20]                           #     ldrb    w9, [x20]
cmp_x9,x13                              #     cmp     x9, x13
@bad_operand b.ne                       #     b.ne    bad_operand
add_x20,x20,0x1                         #     add     x20, x20, #1
ret                                     #     ret

:p_imm                                  # p_imm:                                  // x0 = #expr, a number
sub_sp,sp,0x10                          #     sub     sp, sp, #16
str_x30,[sp]                            #     str     x30, [sp]
mov_x0,0x23                             #     mov     x0, #0x23                   // '#'
^~p_expect RCALL                        #     bl      p_expect
^~eval RCALL                            #     bl      eval
@not_number cbnz_x1                     #     cbnz    x1, not_number
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x10                          #     add     sp, sp, #16
ret                                     #     ret

:p_addr                                 # p_addr:                                 // x0 = expr, an address (a label's, plus or minus a number), x1 its section
sub_sp,sp,0x10                          #     sub     sp, sp, #16
str_x30,[sp]                            #     str     x30, [sp]
^~blanks RCALL                          #     bl      blanks
^~eval RCALL                            #     bl      eval
@bad_operand cbz_x1                     #     cbz     x1, bad_operand
ldr_x30,[sp]                            #     ldr     x30, [sp]
add_sp,sp,0x10                          #     add     sp, sp, #16
ret                                     #     ret

:p_rd                                   # p_rd:                                   // rd: x24, its class x27
mov_x15,x30                             #     mov     x15, x30
^~p_reg RCALL                           #     bl      p_reg
mov_x24,x0                              #     mov     x24, x0
mov_x27,x1                              #     mov     x27, x1
mov_x30,x15                             #     mov     x30, x15
ret                                     #     ret

:p_rn                                   # p_rn:                                   // , rn: x25, its class x28
mov_x15,x30                             #     mov     x15, x30
^~p_comma RCALL                         #     bl      p_comma
^~p_reg RCALL                           #     bl      p_reg
mov_x25,x0                              #     mov     x25, x0
mov_x28,x1                              #     mov     x28, x1
mov_x30,x15                             #     mov     x30, x15
ret                                     #     ret

:p_rm                                   # p_rm:                                   // , rm: x26
mov_x15,x30                             #     mov     x15, x30
^~p_comma RCALL                         #     bl      p_comma
^~p_reg RCALL                           #     bl      p_reg
mov_x26,x0                              #     mov     x26, x0
mov_x30,x15                             #     mov     x30, x15
ret                                     #     ret

:sf                                     # sf:                                     // x22 |= sf, 1 << 31 unless class x27 is w (uses x9)
and_x9,x27,0x1                          #     and     x9, x27, #1
eor_x9,x9,0x1                           #     eor     x9, x9, #1
orr_x22,x22,x9,lsl31                    #     orr     x22, x22, x9, lsl #31
ret                                     #     ret

:emit_rd                                # emit_rd:                                // x22 | rd, then end_line
orr_x0,x22,x24                          #     orr     x0, x22, x24
:emit_end                               # emit_end:                               // the instruction x0, then end_line
^~emit32 RCALL                          #     bl      emit32
^~end_line RBRANCH                      #     b       end_line

:emit_rn                                # emit_rn:                                // x22 | rn << 5 | rd, then end_line
orr_x22,x22,x25,lsl5                    #     orr     x22, x22, x25, lsl #5
^~emit_rd RBRANCH                       #     b       emit_rd

:emit_rm                                # emit_rm:                                // x22 | rm << 16 | rn << 5 | rd, then end_line
orr_x22,x22,x26,lsl16                   #     orr     x22, x22, x26, lsl #16
^~emit_rn RBRANCH                       #     b       emit_rn

# The instructions' routines.

:h_mov                                  # h_mov:                                  // mov rd, rm | mov rd, #n
^~p_rd RCALL                            #     bl      p_rd
^~p_comma RCALL                         #     bl      p_comma
^~p_byte RCALL                          #     bl      p_byte
cmp_x0,0x23                             #     cmp     x0, #0x23                   // '#'
@h_mov_imm b.eq                         #     b.eq    h_mov_imm
^~p_reg RCALL                           #     bl      p_reg
mov_x25,x0                              #     mov     x25, x0
orr_x9,x27,x1                           #     orr     x9, x27, x1
and_x9,x9,0x2                           #     and     x9, x9, #2
@h_mov_sp cbnz_x9                       #     cbnz    x9, h_mov_sp
mov_x26,x0                              #     mov     x26, x0                     // orr rd, zr, rm
mov_x25,0x1f                            #     mov     x25, #31
mov_x22,0x0 movk_x22,0x2a00,lsl16       #     li32    x22, 0x2a000000
^~sf RCALL                              #     bl      sf
^~emit_rm RBRANCH                       #     b       emit_rm
:h_mov_sp                               # h_mov_sp:                               // with sp: add rd, rn, #0
mov_x22,0x0 movk_x22,0x9100,lsl16       #     li32    x22, 0x91000000
^~emit_rn RBRANCH                       #     b       emit_rn
:h_mov_imm                              # h_mov_imm:
and_x9,x27,0x3                          #     and     x9, x27, #3                 // x only
@bad_operand cbnz_x9                    #     cbnz    x9, bad_operand
^~p_imm RCALL                           #     bl      p_imm
mov_x26,x0                              #     mov     x26, x0
mov_x22,0x0 movk_x22,0xd280,lsl16       #     li32    x22, 0xd2800000             // movz: n in one of its 16-bit parts
^~wide FCALL                            #     bl      wide
@h_mov_wide cbz_x1                      #     cbz     x1, h_mov_wide
mvn_x26,x26                             #     mvn     x26, x26                    // movn: ~n in one
mov_x22,0x0 movk_x22,0x9280,lsl16       #     li32    x22, 0x92800000
^~wide FCALL                            #     bl      wide
@h_mov_wide cbz_x1                      #     cbz     x1, h_mov_wide
mvn_x0,x26                              #     mvn     x0, x26                     // orr rd, zr, #bitmask
^~bitmask FCALL                         #     bl      bitmask
cmn_x0,0x1                              #     cmn     x0, #1
@out_of_range b.eq                      #     b.eq    out_of_range
mov_x22,0x3e0 movk_x22,0xb200,lsl16     #     li32    x22, 0xb20003e0
orr_x22,x22,x0,lsl10                    #     orr     x22, x22, x0, lsl #10
^~emit_rd RBRANCH                       #     b       emit_rd
:h_mov_wide                             # h_mov_wide:                             // hw, imm16
orr_x22,x22,x0                          #     orr     x22, x22, x0
^~emit_rd RBRANCH                       #     b       emit_rd

:wide                                   # wide:                                   // x0 = x26 as hw << 21 | imm16 << 5, x1 = 0; x1 = 1 if more than one part (uses x9, x10)
mov_x10,0x0                             #     mov     x10, #0                     // hw
:wide_part                              # wide_part:
lsl_x9,x10,4                            #     lsl     x9, x10, #4                 // its part's shift
lsr_x0,x26,x9                           #     lsr     x0, x26, x9
and_x0,x0,0xffff                        #     and     x0, x0, #0xffff
lsl_x0,x0,x9                            #     lsl     x0, x0, x9
cmp_x0,x26                              #     cmp     x0, x26
@wide_yes b.eq                          #     b.eq    wide_yes
add_x10,x10,0x1                         #     add     x10, x10, #1
cmp_x10,0x4                             #     cmp     x10, #4
@wide_part b.ne                         #     b.ne    wide_part
mov_x1,0x1                              #     mov     x1, #1
ret                                     #     ret
:wide_yes                               # wide_yes:
lsr_x0,x26,x9                           #     lsr     x0, x26, x9
lsl_x0,x0,5                             #     lsl     x0, x0, #5
orr_x0,x0,x10,lsl21                     #     orr     x0, x0, x10, lsl #21
mov_x1,0x0                              #     mov     x1, #0
ret                                     #     ret

:bitmask                                # bitmask:                                // x0 = n's bitmask immediate, N:immr:imms (13 bits), or -1 (uses x1, x9-x15)
mov_x1,x0                               #     mov     x1, x0
@bitmask_none cbz_x1                    #     cbz     x1, bitmask_none
cmn_x1,0x1                              #     cmn     x1, #1
@bitmask_none b.eq                      #     b.eq    bitmask_none
