mov_x9,0x400000                         #     mov     x9, #ADDR                   // its address v
add_x3,x0,x9                            #     add     x3, x0, x9
mov_x0,x3                               #     mov     x0, x3                      // ld's DATA_SEGMENT_ALIGN (0x10000, 0x1000):
mov_x1,0x10000                          #     mov     x1, #0x10000                // v up to 64 KiB (x6), plus v's low 16 bits,
^~alignup FCALL                         #     bl      alignup
mov_x6,x0                               #     mov     x6, x0
and_x9,x3,0xffff                        #     and     x9, x3, #0xffff
add_x5,x6,x9                            #     add     x5, x6, x9                  // the data segment's base (x5)
mov_x0,x5                               #     mov     x0, x5
^~data_place FCALL                      #     bl      data_place                  // x0 = its end
