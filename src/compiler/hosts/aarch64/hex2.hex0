6162656C7300
686578323A20696E70757420746F6F20 # 0131  msg_large:      .asciz "hex2: input too large"
6C6172676500
686578323A2072656164206661696C65 # 0147  msg_read:       .asciz "hex2: read failed"
6400
686578323A207772697465206661696C # 0159  msg_write:      .asciz "hex2: write failed"
656400
