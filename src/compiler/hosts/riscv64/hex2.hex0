#
# gen/hex/riscv64/hex2.s as hex0 text, made by gen/mkhex.pl: each line the bytes of
# one asm line, then its file offset and the line. hex0 reads only the
# hex digits before each '#'.
#
# hex2 for riscv64 Linux: hex0 with labels. The second link of the
# bootstrap, built by hex0 from hosts/riscv64/hex2.hex0 (made from this
# file once by gen/mkhex.pl, a dev aid; the chain never reads this file).
# It builds the seed, ttpc, from hosts/riscv64/ttpc.hex2.
#
#   hex2 < file.hex2 > file
#
# As hex0: each pair of hex digits is a byte, '#' and ';' start a comment
# to the end of the line, every other byte is skipped. And the address of
# the next byte, which starts at 0 and counts every byte written:
#   :name    defines the label name, at that address
#   &name    4 bytes, little endian: name's address (an abs32; a .dword's
#            low half)
#   ^hex     the address of the next byte is this hex number (where a
#            file's addresses jump: its next segment, the labels of a bss)
# and RISC-V's references, as stage0-posix's hex2 has them: each takes d,
# name's address minus the address of the next byte (the instruction's
# own), scatters its bits into an instruction's immediate field and XORs
# them into the next bytes written (the instruction, written with that
# field zero):
#   ~name    U (auipc): d + 0x800, its bits 31:12 (the 0x800 makes up for
#            the low part's sign); d + 0x800 must fit in 32 bits, signed
#   !name    I (the addi, ld or jalr after an auipc): d + 4 (from the
#            auipc, 4 bytes before), its bits 11:0 into 31:20; unchecked:
#            the low part of the auipc's
#   @name    B (beq ...): d in 13 bits, even
#   $name    J (jal): d in 21 bits, even
# and two for the compressed instructions, which stage0-posix uses none of:
#   |name    CB (c.beqz, c.bnez): d in 9 bits, even
#   *name    CJ (c.j): d in 12 bits, even
# Their bit layouts are the table kinds before the code, each a list of (from
# bit, bits, to bit) as the RISC-V manual draws the formats. A name is
# every byte after the sign up to a space, tab or newline. The input is
# read whole, then twice: the first pass gives every label its address,
# the second writes. On an unknown label, a label defined twice, a
# reference out of range, a full table or input and a failed read or
# write it says so on stderr and ends with status 1; else with 0.
#
# One flat file, loaded at BASE by its first program header, read and
# run; the second maps the memory it writes, LABELS to the end of INPUT.
# RV64I only, no compressed instructions. The registers:
#   s2  the next byte of the input          s3  the end of the input
#   s4  the address of the next byte        s5  the pass, 1 or 2
#   s6  the high half of a byte, or -1      s7  the next free label
#   s8  the bits to XOR into the next bytes written, the lowest first
# A label is 24 bytes: the address of its name in the input, the name's
# length, its address.

#     .equ BASE, 0x600000
#     .equ LABELS, 0x700000               # 65536 labels of 24 bytes
#     .equ LABELS_END, LABELS + 0x10000 * 24
#     .equ INPUT, 0x900000                # 16 MiB of input
#     .equ INPUT_END, INPUT + 0x1000000
#     .equ SYS_read, 63
#     .equ SYS_write, 64
#     .equ SYS_exit, 93

# 0000  ehdr:                                   # the ELF header, 64 bytes
7F454C46                # 0000      .byte 0x7f, 0x45, 0x4c, 0x46        # e_ident: the magic, 0x7f 'E' 'L' 'F'
02                      # 0004      .byte 2                             # EI_CLASS: ELFCLASS64
01                      # 0005      .byte 1                             # EI_DATA: ELFDATA2LSB, little endian
01                      # 0006      .byte 1                             # EI_VERSION: EV_CURRENT
00                      # 0007      .byte 0                             # EI_OSABI: System V
0000000000000000        # 0008      .byte 0, 0, 0, 0, 0, 0, 0, 0        # EI_ABIVERSION 0, then padding to 16
0200                    # 0010      .half 2                             # e_type: ET_EXEC, an executable
F300                    # 0012      .half 0xf3                          # e_machine: EM_RISCV
01000000                # 0014      .word 1                             # e_version: EV_CURRENT
B401600000000000        # 0018      .dword BASE + _start - ehdr         # e_entry: the address of _start
4000000000000000        # 0020      .dword phdr - ehdr                  # e_phoff: the program headers follow
0000000000000000        # 0028      .dword 0                            # e_shoff: no section headers
00000000                # 0030      .word 0                             # e_flags: no RVC, soft float (none used)
4000                    # 0034      .half 64                            # e_ehsize: this header's size
3800                    # 0036      .half 56                            # e_phentsize: a program header's size
0200                    # 0038      .half 2                             # e_phnum: two program headers
0000                    # 003a      .half 0                             # e_shentsize: no section headers
0000                    # 003c      .half 0                             # e_shnum: none
0000                    # 003e      .half 0                             # e_shstrndx: none
# 0040  phdr:                                   # the program: 56 bytes
01000000                # 0040      .word 1                             # p_type: PT_LOAD
05000000                # 0044      .word 5                             # p_flags: PF_R | PF_X, read and run
0000000000000000        # 0048      .dword 0                            # p_offset: from the file's first byte
0000600000000000        # 0050      .dword BASE                         # p_vaddr: loaded at BASE
0000600000000000        # 0058      .dword BASE                         # p_paddr: the same
7405000000000000        # 0060      .dword end - ehdr                   # p_filesz: the whole file
7405000000000000        # 0068      .dword end - ehdr                   # p_memsz: the same
0010000000000000        # 0070      .dword 0x1000                       # p_align: a page
                                        # its memory: 56 bytes
01000000                # 0078      .word 1                             # p_type: PT_LOAD
06000000                # 007c      .word 6                             # p_flags: PF_R | PF_W, read and write
0000000000000000        # 0080      .dword 0                            # p_offset: none of the file
0000700000000000        # 0088      .dword LABELS                       # p_vaddr: the labels, then the input
0000700000000000        # 0090      .dword LABELS                       # p_paddr: the same
0000000000000000        # 0098      .dword 0                            # p_filesz: none, all zero
0000200100000000        # 00a0      .dword INPUT_END - LABELS           # p_memsz: to the end of the input
0010000000000000        # 00a8      .dword 0x1000                       # p_align: a page


# The kinds of reference: its sign, the bits d must fit in (signed), 1 if
# d must be even, its pieces, the addend (2 bytes), then each piece: the
# bit of d it starts at, its bits, the bit of the field it goes to.
# 00b0  kinds:
7E200001                # 00b0      .byte 0x7e, 32, 0, 1                # '~' U: d + 0x800
0008                    # 00b4      .half 0x800
0C140C                  # 00b6      .byte 12, 20, 12                    #   imm[31:12] to 31:12
21400001                # 00b9      .byte 0x21, 64, 0, 1                # '!' I: d + 4, unchecked
0400                    # 00bd      .half 4
000C14                  # 00bf      .byte 0, 12, 20                     #   imm[11:0] to 31:20
400D0104                # 00c2      .byte 0x40, 13, 1, 4                # '@' B
0000                    # 00c6      .half 0
010408                  # 00c8      .byte 1, 4, 8                       #   imm[4:1] to 11:8
050619                  # 00cb      .byte 5, 6, 25                      #   imm[10:5] to 30:25
0B0107                  # 00ce      .byte 11, 1, 7                      #   imm[11] to 7
0C011F                  # 00d1      .byte 12, 1, 31                     #   imm[12] to 31
24150104                # 00d4      .byte 0x24, 21, 1, 4                # '$' J
0000                    # 00d8      .half 0
010A15                  # 00da      .byte 1, 10, 21                     #   imm[10:1] to 30:21
0B0114                  # 00dd      .byte 11, 1, 20                     #   imm[11] to 20
0C080C                  # 00e0      .byte 12, 8, 12                     #   imm[19:12] to 19:12
14011F                  # 00e3      .byte 20, 1, 31                     #   imm[20] to 31
7C090105                # 00e6      .byte 0x7c, 9, 1, 5                 # '|' CB
0000                    # 00ea      .half 0
010203                  # 00ec      .byte 1, 2, 3                       #   offset[2:1] to 4:3
03020A                  # 00ef      .byte 3, 2, 10                      #   offset[4:3] to 11:10
050102                  # 00f2      .byte 5, 1, 2                       #   offset[5] to 2
060205                  # 00f5      .byte 6, 2, 5                       #   offset[7:6] to 6:5
08010C                  # 00f8      .byte 8, 1, 12                      #   offset[8] to 12
2A0C0108                # 00fb      .byte 0x2a, 12, 1, 8                # '*' CJ
0000                    # 00ff      .half 0
010303                  # 0101      .byte 1, 3, 3                       #   offset[3:1] to 5:3
04010B                  # 0104      .byte 4, 1, 11                      #   offset[4] to 11
050102                  # 0107      .byte 5, 1, 2                       #   offset[5] to 2
060107                  # 010a      .byte 6, 1, 7                       #   offset[6] to 7
070106                  # 010d      .byte 7, 1, 6                       #   offset[7] to 6
080209                  # 0110      .byte 8, 2, 9                       #   offset[9:8] to 10:9
0A0108                  # 0113      .byte 10, 1, 8                      #   offset[10] to 8
0B010C                  # 0116      .byte 11, 1, 12                     #   offset[11] to 12
00                      # 0119      .byte 0                             # the end of the kinds

