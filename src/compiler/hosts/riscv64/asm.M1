rs1_s10 rs2_t0 @branch_4 beq            #     beq     s10, t0, branch_4           # c.beqz rs: beq rs, x0
rd_t0 ~0x2000 lui                       #     li      t0, 0x2000                  # 6: c.bnez over a jal (c.beqz the other way)
rd_s4 rs1_s4 rs2_t0 xor                 #     xor     s4, s4, t0
rd_a0 !6 addi                           #     li      a0, 6
rd_a1 ~k_cb auipc rd_a1 rs1_a1 !k_cb addi #     la      a1, k_cb
