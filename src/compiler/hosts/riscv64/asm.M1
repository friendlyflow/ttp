#
# gen/hex/riscv64/asm.s as M1 text, made by gen/mkhex.pl, as stage0-posix's riscv64
# M1 writes RISC-V: first a DEFINE for each instruction it uses, its
# fixed bits (opcode, funct3, funct7; little endian), and for each
# register field it uses, rd_<reg> rs1_<reg> rs2_<reg>, a word (.hex,
# which hex2 XORs into the next 4 bytes written). Then each asm line:
# :label for its labels, then each instruction's fields, then its name:
# its registers (x0 left out), its immediate (!n I, @n S, ~n U, as
# words; 0 left out) or its label (@label B, $label J, ~label and !label
# an auipc and the instruction after it, as hex2's references; a branch
# to a label out of its reach is gas's, the other branch over a jal, its
# +8 the word .00040000). Data is
# hex or a "string" (its bytes, then 00). M1 reads only what is before
# each '#'; M1's hex2 text is made by hex2.
#
DEFINE add 33000000                     # R: opcode 0110011 OP, funct3 000, funct7 0000000
DEFINE addi 13000000                    # I: opcode 0010011 OP-IMM, funct3 000
DEFINE addiw 1B000000                   # I: opcode 0011011 OP-IMM-32, funct3 000
DEFINE and 33700000                     # R: opcode 0110011 OP, funct3 111, funct7 0000000
DEFINE andi 13700000                    # I: opcode 0010011 OP-IMM, funct3 111
DEFINE auipc 17000000                   # U: opcode 0010111 AUIPC
DEFINE beq 63000000                     # B: opcode 1100011 BRANCH, funct3 000
DEFINE bge 63500000                     # B: opcode 1100011 BRANCH, funct3 101
DEFINE bgeu 63700000                    # B: opcode 1100011 BRANCH, funct3 111
DEFINE blt 63400000                     # B: opcode 1100011 BRANCH, funct3 100
DEFINE bltu 63600000                    # B: opcode 1100011 BRANCH, funct3 110
DEFINE bne 63100000                     # B: opcode 1100011 BRANCH, funct3 001
DEFINE div 33400002                     # R: opcode 0110011 OP, funct3 100, funct7 0000001
DEFINE divu 33500002                    # R: opcode 0110011 OP, funct3 101, funct7 0000001
DEFINE ecall 73000000                   # I: opcode 1110011 SYSTEM, funct3 000, all of it
DEFINE jal 6F000000                     # J: opcode 1101111 JAL
DEFINE jalr 67000000                    # I: opcode 1100111 JALR, funct3 000
DEFINE lbu 03400000                     # I: opcode 0000011 LOAD, funct3 100
DEFINE ld 03300000                      # I: opcode 0000011 LOAD, funct3 011
DEFINE lui 37000000                     # U: opcode 0110111 LUI
DEFINE lw 03200000                      # I: opcode 0000011 LOAD, funct3 010
DEFINE lwu 03600000                     # I: opcode 0000011 LOAD, funct3 110
DEFINE mul 33000002                     # R: opcode 0110011 OP, funct3 000, funct7 0000001
DEFINE or 33600000                      # R: opcode 0110011 OP, funct3 110, funct7 0000000
DEFINE ori 13600000                     # I: opcode 0010011 OP-IMM, funct3 110
DEFINE rem 33600002                     # R: opcode 0110011 OP, funct3 110, funct7 0000001
DEFINE remu 33700002                    # R: opcode 0110011 OP, funct3 111, funct7 0000001
DEFINE sb 23000000                      # S: opcode 0100011 STORE, funct3 000
DEFINE sd 23300000                      # S: opcode 0100011 STORE, funct3 011
DEFINE sll 33100000                     # R: opcode 0110011 OP, funct3 001, funct7 0000000
DEFINE slli 13100000                    # I: opcode 0010011 OP-IMM, funct3 001
DEFINE sltiu 13300000                   # I: opcode 0010011 OP-IMM, funct3 011
DEFINE sra 33500040                     # R: opcode 0110011 OP, funct3 101, funct7 0100000
DEFINE srai 13500040                    # I: opcode 0010011 OP-IMM, funct3 101, bit 30: arithmetic
DEFINE srl 33500000                     # R: opcode 0110011 OP, funct3 101, funct7 0000000
DEFINE srli 13500000                    # I: opcode 0010011 OP-IMM, funct3 101
DEFINE sub 33000040                     # R: opcode 0110011 OP, funct3 000, funct7 0100000
DEFINE xor 33400000                     # R: opcode 0110011 OP, funct3 100, funct7 0000000
DEFINE xori 13400000                    # I: opcode 0010011 OP-IMM, funct3 100
DEFINE rd_a0 .00050000                  # rd x10 a0: bits 11:7, a word
DEFINE rd_a1 .80050000                  # rd x11 a1: bits 11:7, a word
DEFINE rd_a2 .00060000                  # rd x12 a2: bits 11:7, a word
DEFINE rd_a3 .80060000                  # rd x13 a3: bits 11:7, a word
DEFINE rd_a4 .00070000                  # rd x14 a4: bits 11:7, a word
DEFINE rd_a5 .80070000                  # rd x15 a5: bits 11:7, a word
DEFINE rd_a6 .00080000                  # rd x16 a6: bits 11:7, a word
DEFINE rd_a7 .80080000                  # rd x17 a7: bits 11:7, a word
DEFINE rd_ra .80000000                  # rd x1 ra: bits 11:7, a word
DEFINE rd_s0 .00040000                  # rd x8 s0: bits 11:7, a word
DEFINE rd_s1 .80040000                  # rd x9 s1: bits 11:7, a word
DEFINE rd_s10 .000D0000                 # rd x26 s10: bits 11:7, a word
DEFINE rd_s11 .800D0000                 # rd x27 s11: bits 11:7, a word
DEFINE rd_s2 .00090000                  # rd x18 s2: bits 11:7, a word
DEFINE rd_s3 .80090000                  # rd x19 s3: bits 11:7, a word
DEFINE rd_s4 .000A0000                  # rd x20 s4: bits 11:7, a word
DEFINE rd_s5 .800A0000                  # rd x21 s5: bits 11:7, a word
DEFINE rd_s6 .000B0000                  # rd x22 s6: bits 11:7, a word
DEFINE rd_s7 .800B0000                  # rd x23 s7: bits 11:7, a word
DEFINE rd_s8 .000C0000                  # rd x24 s8: bits 11:7, a word
DEFINE rd_s9 .800C0000                  # rd x25 s9: bits 11:7, a word
DEFINE rd_sp .00010000                  # rd x2 sp: bits 11:7, a word
DEFINE rd_t0 .80020000                  # rd x5 t0: bits 11:7, a word
DEFINE rd_t1 .00030000                  # rd x6 t1: bits 11:7, a word
DEFINE rd_t2 .80030000                  # rd x7 t2: bits 11:7, a word
DEFINE rd_t3 .000E0000                  # rd x28 t3: bits 11:7, a word
DEFINE rd_t4 .800E0000                  # rd x29 t4: bits 11:7, a word
DEFINE rd_t5 .000F0000                  # rd x30 t5: bits 11:7, a word
DEFINE rd_t6 .800F0000                  # rd x31 t6: bits 11:7, a word
DEFINE rs1_a0 .00000500                 # rs1 x10 a0: bits 19:15, a word
DEFINE rs1_a1 .00800500                 # rs1 x11 a1: bits 19:15, a word
DEFINE rs1_a2 .00000600                 # rs1 x12 a2: bits 19:15, a word
DEFINE rs1_a3 .00800600                 # rs1 x13 a3: bits 19:15, a word
DEFINE rs1_a4 .00000700                 # rs1 x14 a4: bits 19:15, a word
DEFINE rs1_a5 .00800700                 # rs1 x15 a5: bits 19:15, a word
DEFINE rs1_a6 .00000800                 # rs1 x16 a6: bits 19:15, a word
DEFINE rs1_ra .00800000                 # rs1 x1 ra: bits 19:15, a word
DEFINE rs1_s0 .00000400                 # rs1 x8 s0: bits 19:15, a word
DEFINE rs1_s1 .00800400                 # rs1 x9 s1: bits 19:15, a word
DEFINE rs1_s10 .00000D00                # rs1 x26 s10: bits 19:15, a word
DEFINE rs1_s11 .00800D00                # rs1 x27 s11: bits 19:15, a word
DEFINE rs1_s2 .00000900                 # rs1 x18 s2: bits 19:15, a word
DEFINE rs1_s3 .00800900                 # rs1 x19 s3: bits 19:15, a word
DEFINE rs1_s4 .00000A00                 # rs1 x20 s4: bits 19:15, a word
DEFINE rs1_s5 .00800A00                 # rs1 x21 s5: bits 19:15, a word
DEFINE rs1_s6 .00000B00                 # rs1 x22 s6: bits 19:15, a word
DEFINE rs1_s7 .00800B00                 # rs1 x23 s7: bits 19:15, a word
DEFINE rs1_s8 .00000C00                 # rs1 x24 s8: bits 19:15, a word
DEFINE rs1_s9 .00800C00                 # rs1 x25 s9: bits 19:15, a word
DEFINE rs1_sp .00000100                 # rs1 x2 sp: bits 19:15, a word
DEFINE rs1_t0 .00800200                 # rs1 x5 t0: bits 19:15, a word
DEFINE rs1_t1 .00000300                 # rs1 x6 t1: bits 19:15, a word
DEFINE rs1_t2 .00800300                 # rs1 x7 t2: bits 19:15, a word
DEFINE rs1_t3 .00000E00                 # rs1 x28 t3: bits 19:15, a word
DEFINE rs1_t4 .00800E00                 # rs1 x29 t4: bits 19:15, a word
DEFINE rs1_t5 .00000F00                 # rs1 x30 t5: bits 19:15, a word
DEFINE rs1_t6 .00800F00                 # rs1 x31 t6: bits 19:15, a word
DEFINE rs2_a0 .0000A000                 # rs2 x10 a0: bits 24:20, a word
DEFINE rs2_a1 .0000B000                 # rs2 x11 a1: bits 24:20, a word
DEFINE rs2_a2 .0000C000                 # rs2 x12 a2: bits 24:20, a word
DEFINE rs2_a3 .0000D000                 # rs2 x13 a3: bits 24:20, a word
DEFINE rs2_a4 .0000E000                 # rs2 x14 a4: bits 24:20, a word
DEFINE rs2_a5 .0000F000                 # rs2 x15 a5: bits 24:20, a word
DEFINE rs2_a6 .00000001                 # rs2 x16 a6: bits 24:20, a word
DEFINE rs2_ra .00001000                 # rs2 x1 ra: bits 24:20, a word
DEFINE rs2_s0 .00008000                 # rs2 x8 s0: bits 24:20, a word
DEFINE rs2_s1 .00009000                 # rs2 x9 s1: bits 24:20, a word
DEFINE rs2_s10 .0000A001                # rs2 x26 s10: bits 24:20, a word
DEFINE rs2_s2 .00002001                 # rs2 x18 s2: bits 24:20, a word
DEFINE rs2_s3 .00003001                 # rs2 x19 s3: bits 24:20, a word
DEFINE rs2_s4 .00004001                 # rs2 x20 s4: bits 24:20, a word
DEFINE rs2_s5 .00005001                 # rs2 x21 s5: bits 24:20, a word
DEFINE rs2_s6 .00006001                 # rs2 x22 s6: bits 24:20, a word
DEFINE rs2_s7 .00007001                 # rs2 x23 s7: bits 24:20, a word
DEFINE rs2_s8 .00008001                 # rs2 x24 s8: bits 24:20, a word
DEFINE rs2_s9 .00009001                 # rs2 x25 s9: bits 24:20, a word
DEFINE rs2_t0 .00005000                 # rs2 x5 t0: bits 24:20, a word
DEFINE rs2_t1 .00006000                 # rs2 x6 t1: bits 24:20, a word
DEFINE rs2_t2 .00007000                 # rs2 x7 t2: bits 24:20, a word
DEFINE rs2_t3 .0000C001                 # rs2 x28 t3: bits 24:20, a word
DEFINE rs2_t4 .0000D001                 # rs2 x29 t4: bits 24:20, a word
DEFINE rs2_t5 .0000E001                 # rs2 x30 t5: bits 24:20, a word
#
# asm for riscv64 Linux: the assembler of the seed. The fourth link of the
# bootstrap, built by M1 and hex2 from hosts/riscv64/asm.M1 (made from this
# file once by gen/mkhex.pl, a dev aid; the chain never reads this file).
# It assembles hosts/riscv64/ttpc.s, the readable seed, into the seed: the
# bytes binutils' as and ld make of it (as -march=rv64imac -mabi=lp64
# -mno-arch-attr, ld -static --no-relax -s -z noseparate-code), with no
# binutils.
#
#   asm < ttpc.s > ttpc
#
# The asm it reads: riscv64 GNU syntax as ttpc.s uses it.
#   lines      labels (name: and the local n: of 0-99, as 1b and 1f), then
#              a directive or an instruction; '#' starts a comment to the
#              end of the line
#   directives .equ name, expr  .dword .word .half .byte expr, ...
#              .ascii .asciz "text", ...  (escapes \n \t \ooo, \x as x)
#              .skip n  .balign n (not in .text)  .section name (.text
#              .rodata .data .bss)  .text .data .bss  .globl name
#   exprs      numbers (decimal, 0x hex, 0 octal), names, '.' (here), and
#              as gas: unary - ~, then * / % << >>, then | & ^, then + -,
#              and ( ); a label's address plus or minus a number, or two
#              labels of a section minus each other
#   operands   registers (x0-x31 and their ABI names, fp), numbers (exprs
#              defined before the line), offset(register), and the label
#              of a branch, jump, call or la
#   mnemonics  add sub and or xor sll srl sra slt sltu mul div divu rem
#              remu, addi andi ori xori slti sltiu slli srli srai, ld lbu
#              lb lh lhu lwu sd sb sh, beq bne blt bge bltu bgeu beqz bnez
#              bltz bgez blez bgtz bgt ble bgtu bleu, j jr jalr ret call,
#              la li mv neg not seqz snez, ecall nop
# Each instruction is encoded as gas does with the C extension (RVC):
# compressed where gas's opcode table has a compressed form first that
# its operands fit (c.add c.mv c.sub c.and c.or c.xor c.addi4spn c.addi
# c.nop c.addi16sp c.li c.andi c.slli c.srli c.srai c.ldsp c.ld c.sdsp
# c.sd c.jr c.jalr c.lui c.addiw, see each mnemonic), li as gas's
# load_const (c.lui, c.li, addi, or lui and addiw: 32-bit numbers), la
# and call as auipc and addi or jalr, and the branches and j as gas relaxes
# them: c.beqz, c.bnez and c.j when the target is near, else beq/bne,
# jal, or a branch over a jal (see relax). The output is the file ld
# makes: the ELF header, two program headers (the code: the headers,
# .text, .rodata; the data: .data, .bss), the sections, .shstrtab and six
# section headers. Each of .text .rodata .data .bss must have bytes.
#
# The input is read whole, then in two passes. Pass 1 sizes: every label
# gets its section and place, every branch and jump a record (the jumps)
# and .text is cut into gas's frags (after each branch or jump, after the
# auipc of an la, after a call); relax then gives every jump its length,
# the text labels their offsets, and layout every section its place. Pass
# 2 writes the sections into the output, which is then written whole. On
# an error it says so on stderr with the line (asm: line N: what: the
# line) and ends with status 1; else with 0.
#
# One flat file, loaded at BASE by its first program header, read and
# run; the second maps the memory it writes, VARS to the end of OUTBUF.
# RV64IM, no compressed instructions. The registers:
#   s0  VARS, the variables                 s1  the next byte of the input
#   s2  the end of the input
#   s3  the instruction's base bits (from mnemonics), s4 its other bits
#   s5  rd (or a store's source)  s6  rs1  s7  rs2 or the immediate
#   s8-s11  scratch of the instructions; sp the stack of the routines
# The routines take and give a0-a7 and use the t registers (each says
# which); a routine that calls another keeps ra on the stack, or in t5 or
# t6 when what it calls does not use them. A symbol is 48 bytes (S_*), a
# local label's definition 32 (L_*), a jump 32 (J_*), a frag 32 (F_*). A
# definition (D) is a symbol's S_value or a local label's L_value: its
# value, kind (0 a number, 1-4 the section), pass (0 not defined) and frag
# (the frag of a text label in pass 1, whose value is then its offset in
# that frag) at 0, 8, 16, 24.

#     .equ BASE, 0x600000
#     .equ VARS, 0x700000                 # the variables, 64 KiB
#     .equ SYMS, VARS + 0x10000           # 65536 symbols
#     .equ SYM_size, 48
#     .equ SYMS_END, SYMS + 0x10000 * SYM_size
#     .equ LOCAL_max, 4096                # definitions of each local label
#     .equ LOCALS, SYMS_END               # 100 local labels
#     .equ LOCALS_END, LOCALS + 100 * LOCAL_max * 32
#     .equ JUMPS, LOCALS_END              # 65536 jumps
#     .equ JUMPS_END, JUMPS + 0x10000 * 32
#     .equ FRAGS, JUMPS_END               # 131072 frags
#     .equ FRAGS_END, FRAGS + 0x20000 * 32
#     .equ INPUT, FRAGS_END               # 16 MiB of input
#     .equ INPUT_END, INPUT + 0x1000000
#     .equ OUTBUF, INPUT_END              # 16 MiB of output
#     .equ OUTBUF_END, OUTBUF + 0x1000000
#     .equ ADDR, 0x10000                  # where ld places the output
#     .equ SHSTRTAB_len, 36               # the section names' bytes (shstrtab)
#     .equ SYS_read, 63
#     .equ SYS_write, 64
#     .equ SYS_exit, 93

    # a symbol: its name in the input, then its definition
#     .equ S_name, 0
#     .equ S_len, 8
#     .equ S_value, 16
#     .equ S_kind, 24
#     .equ S_pass, 32
#     .equ S_frag, 40
    # a definition of a local label
#     .equ L_value, 0
#     .equ L_kind, 8
#     .equ L_pass, 16
#     .equ L_frag, 24
    # a jump (a branch, j): the frag it ends, its target's definition, its
    # kind (1 j, unconditional; 2 compressed: c.beqz c.bnez c.j), its length
#     .equ J_frag, 0
#     .equ J_def, 8
#     .equ J_kind, 16
#     .equ J_len, 24
    # a frag of .text, as gas's: its address, its address after the last
    # round, its fixed bytes, then the jump that ends it, or 0
#     .equ F_addr, 0
#     .equ F_last, 8
#     .equ F_fix, 16
#     .equ F_jump, 24

    # the variables, at s0
#     .equ V_pass, 0                      # the pass, 1 or 2
#     .equ V_emit, 8                      # 1 in pass 2, which writes
#     .equ V_sec, 16                      # the section: 1 .text 2 .rodata 3 .data 4 .bss
#     .equ V_line, 24                     # the line's number
#     .equ V_jump, 32                     # the next jump
#     .equ V_nsym, 40                     # the next free symbol
#     .equ V_exact, 48                    # 0 once an expression used a name not defined before it
#     .equ V_known, 56                    # 0 once it used a name not defined at all
#     .equ V_lstart, 64                   # the line's first byte
#     .equ V_loc, 72                      # section s's location counter at V_loc + 8 * s
#     .equ V_align, 112                   # its alignment
#     .equ V_base, 152                    # its address (0 for s = 0, a number)
#     .equ V_off, 192                     # its file offset
#     .equ V_shstr, 232                   # the file offset of .shstrtab
#     .equ V_shoff, 240                   # of the section headers
#     .equ V_fend, 248                    # the file's size
#     .equ V_tend, 256                    # the end of .rodata in the file: of the code segment
#     .equ V_frag, 264                    # pass 1: the frag of .text being filled
#     .equ V_foff, 272                    # its bytes so far
#     .equ V_sret, 280                    # statement's return address
#     .equ V_tsize, 288                   # .text's size, after relax
#     .equ COUNTS, 400                    # local label n's definitions so far at COUNTS + 8 * n
#     .equ NUMBUF, 1200                   # a decimal number, 24

:ehdr                                   # ehdr:                                   # the ELF header, 64 bytes
7F454C46                                #     .byte 0x7f, 0x45, 0x4c, 0x46        # e_ident: the magic, 0x7f 'E' 'L' 'F'
02                                      #     .byte 2                             # EI_CLASS: ELFCLASS64
01                                      #     .byte 1                             # EI_DATA: ELFDATA2LSB, little endian
01                                      #     .byte 1                             # EI_VERSION: EV_CURRENT
00                                      #     .byte 0                             # EI_OSABI: System V
0000000000000000                        #     .byte 0, 0, 0, 0, 0, 0, 0, 0        # EI_ABIVERSION 0, then padding to 16
0200                                    #     .half 2                             # e_type: ET_EXEC, an executable
F300                                    #     .half 0xf3                          # e_machine: EM_RISCV
01000000                                #     .word 1                             # e_version: EV_CURRENT
B000600000000000                        #     .dword BASE + _start - ehdr         # e_entry: the address of _start
4000000000000000                        #     .dword phdr - ehdr                  # e_phoff: the program headers follow
0000000000000000                        #     .dword 0                            # e_shoff: no section headers
00000000                                #     .word 0                             # e_flags: no RVC, soft float (none used)
4000                                    #     .half 64                            # e_ehsize: this header's size
3800                                    #     .half 56                            # e_phentsize: a program header's size
0200                                    #     .half 2                             # e_phnum: two program headers
0000                                    #     .half 0                             # e_shentsize: no section headers
0000                                    #     .half 0                             # e_shnum: none
0000                                    #     .half 0                             # e_shstrndx: none
:phdr                                   # phdr:                                   # the program: 56 bytes
01000000                                #     .word 1                             # p_type: PT_LOAD
05000000                                #     .word 5                             # p_flags: PF_R | PF_X, read and run
0000000000000000                        #     .dword 0                            # p_offset: from the file's first byte
0000600000000000                        #     .dword BASE                         # p_vaddr: loaded at BASE
0000600000000000                        #     .dword BASE                         # p_paddr: the same
522E000000000000                        #     .dword end - ehdr                   # p_filesz: the whole file
522E000000000000                        #     .dword end - ehdr                   # p_memsz: the same
0010000000000000                        #     .dword 0x1000                       # p_align: a page
                                        # its memory: 56 bytes
01000000                                #     .word 1                             # p_type: PT_LOAD
06000000                                #     .word 6                             # p_flags: PF_R | PF_W, read and write
0000000000000000                        #     .dword 0                            # p_offset: none of the file
0000700000000000                        #     .dword VARS                         # p_vaddr: the variables, ..., the output
0000700000000000                        #     .dword VARS                         # p_paddr: the same
0000000000000000                        #     .dword 0                            # p_filesz: none, all zero
0000590300000000                        #     .dword OUTBUF_END - VARS            # p_memsz: to the end of the output
0010000000000000                        #     .dword 0x1000                       # p_align: a page

:_start                                 # _start:                                 # read all of stdin into INPUT
rd_s0 ~0x700000 lui                     #     li      s0, VARS
rd_s2 ~0x1c90000 lui                    #     li      s2, INPUT                   # the end of what is read
:read                                   # read:
rd_a2 ~0x2c90000 lui rd_a2 rs1_a2 !-1 addiw #     li      a2, INPUT_END - 1           # a 0 stays after the input
rd_a2 rs1_a2 rs2_s2 sub                 #     sub     a2, a2, s2                  # the room left
rs1_a2 .00040000 bne $too_large jal     #     beq     a2, zero, too_large
rd_a7 !63 addi                          #     li      a7, SYS_read
rd_a0 addi                              #     li      a0, 0                       # fd 0, stdin
rd_a1 rs1_s2 addi                       #     mv      a1, s2                      # after what is read
ecall                                   #     ecall
rs1_a0 .00040000 bge $read_failed jal   #     blt     a0, zero, read_failed
rs1_a0 @read_all beq                    #     beq     a0, zero, read_all          # the end of stdin
rd_s2 rs1_s2 rs2_a0 add                 #     add     s2, s2, a0
$read jal                               #     j       read
:read_all                               # read_all:
rd_t0 ~0x710000 lui                     #     li      t0, SYMS                    # no symbols yet
rs1_s0 rs2_t0 @40 sd                    #     sd      t0, V_nsym(s0)
rd_t0 !2 addi                           #     li      t0, 2                       # .text aligned to 2 (gas, with RVC)
rs1_s0 rs2_t0 @120 sd                   #     sd      t0, V_align+8(s0)
rd_t0 !1 addi                           #     li      t0, 1                       # the others to 1, until .balign
rs1_s0 rs2_t0 @128 sd                   #     sd      t0, V_align+16(s0)
rs1_s0 rs2_t0 @136 sd                   #     sd      t0, V_align+24(s0)
rs1_s0 rs2_t0 @144 sd                   #     sd      t0, V_align+32(s0)
rs1_s0 rs2_t0 sd                        #     sd      t0, V_pass(s0)              # pass 1: sizes, labels, jumps, frags
rd_ra $pass jal                         #     jal     ra, pass
rd_ra $relax jal                        #     jal     ra, relax                   # the jumps' lengths, the text labels
rd_ra $layout jal                       #     jal     ra, layout
rd_t0 !2 addi                           #     li      t0, 2                       # pass 2 writes
rs1_s0 rs2_t0 sd                        #     sd      t0, V_pass(s0)
rd_t0 !1 addi                           #     li      t0, 1
rs1_s0 rs2_t0 @8 sd                     #     sd      t0, V_emit(s0)
rd_ra $pass jal                         #     jal     ra, pass
rd_ra $headers jal                      #     jal     ra, headers
rd_a1 ~0x2c90000 lui                    #     li      a1, OUTBUF                  # write the output
rd_a3 rs1_s0 !248 ld                    #     ld      a3, V_fend(s0)
rd_a3 rs1_a3 rs2_a1 add                 #     add     a3, a3, a1                  # its end
:write                                  # write:
rd_a2 rs1_a3 rs2_a1 sub                 #     sub     a2, a3, a1                  # what is left
rs1_a2 @done beq                        #     beq     a2, zero, done
rd_a7 !64 addi                          #     li      a7, SYS_write
rd_a0 !1 addi                           #     li      a0, 1                       # fd 1, stdout
ecall                                   #     ecall
rs2_a0 .00040000 blt $write_failed jal  #     bge     zero, a0, write_failed
rd_a1 rs1_a1 rs2_a0 add                 #     add     a1, a1, a0
$write jal                              #     j       write
:done                                   # done:
rd_a0 addi                              #     li      a0, 0                       # status 0
$exit jal                               #     j       exit

# A pass over the input, line by line.
:pass                                   # pass:
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rs1_s0 @72 sd                           #     sd      zero, V_loc(s0)             # every section from 0
rs1_s0 @80 sd                           #     sd      zero, V_loc+8(s0)
rs1_s0 @88 sd                           #     sd      zero, V_loc+16(s0)
rs1_s0 @96 sd                           #     sd      zero, V_loc+24(s0)
rs1_s0 @104 sd                          #     sd      zero, V_loc+32(s0)
rd_t0 rs1_s0 !400 addi                  #     addi    t0, s0, COUNTS              # no local labels yet
rd_t1 rs1_s0 !1200 addi                 #     addi    t1, s0, COUNTS + 800
:pass_count                             # pass_count:
rs1_t0 sd                               #     sd      zero, 0(t0)
rd_t0 rs1_t0 !8 addi                    #     addi    t0, t0, 8
rs1_t0 rs2_t1 @pass_count bne           #     bne     t0, t1, pass_count
rd_t0 ~0x1690000 lui                    #     li      t0, JUMPS                   # from the first jump
rs1_s0 rs2_t0 @32 sd                    #     sd      t0, V_jump(s0)
rd_t0 ~0x1890000 lui                    #     li      t0, FRAGS                   # and the first frag
rs1_s0 rs2_t0 @264 sd                   #     sd      t0, V_frag(s0)
rs1_s0 @272 sd                          #     sd      zero, V_foff(s0)
rd_t0 !1 addi                           #     li      t0, 1                       # in .text
rs1_s0 rs2_t0 @16 sd                    #     sd      t0, V_sec(s0)
rs1_s0 rs2_t0 @24 sd                    #     sd      t0, V_line(s0)
rd_s1 ~0x1c90000 lui                    #     li      s1, INPUT
:pass_line                              # pass_line:
rs1_s1 rs2_s2 @pass_end bgeu            #     bgeu    s1, s2, pass_end
rs1_s0 rs2_s1 @64 sd                    #     sd      s1, V_lstart(s0)
rd_ra $statement jal                    #     jal     ra, statement
rd_t0 rs1_s0 !24 ld                     #     ld      t0, V_line(s0)
rd_t0 rs1_t0 !1 addi                    #     addi    t0, t0, 1
rs1_s0 rs2_t0 @24 sd                    #     sd      t0, V_line(s0)
$pass_line jal                          #     j       pass_line
:pass_end                               # pass_end:
rd_t0 rs1_s0 !264 ld                    #     ld      t0, V_frag(s0)              # the last frag's fixed bytes
rd_t1 rs1_s0 !272 ld                    #     ld      t1, V_foff(s0)
rs1_t0 rs2_t1 @16 sd                    #     sd      t1, F_fix(t0)
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

# One line, to after its newline: labels, then a directive or an
# instruction (each ends with end_line, which returns from statement).
:statement                              # statement:
rs1_s0 rs2_ra @280 sd                   #     sd      ra, V_sret(s0)
:statement_next                         # statement_next:
rd_ra $blanks jal                       #     jal     ra, blanks
rd_a0 rs1_s1 lbu                        #     lbu     a0, 0(s1)
rd_ra $is_ident jal                     #     jal     ra, is_ident
rs1_a0 @end_line beq                    #     beq     a0, zero, end_line          # no name: only a comment may follow
rd_ra $word jal                         #     jal     ra, word                    # a1, a2
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !58 addi                          #     li      t1, 0x3a                    # ':': a label
rs1_t0 rs2_t1 @label beq                #     beq     t0, t1, label
rd_t0 rs1_a1 lbu                        #     lbu     t0, 0(a1)
rd_t1 !46 addi                          #     li      t1, 0x2e                    # '.': a directive
rs1_t0 rs2_t1 @directive beq            #     beq     t0, t1, directive
$insn jal                               #     j       insn
:label                                  # label:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_ra $define_label jal                 #     jal     ra, define_label
$statement_next jal                     #     j       statement_next

:end_line                               # end_line:                               # nothing but a comment until the newline, then after it
rd_ra $blanks jal                       #     jal     ra, blanks
rs1_s1 rs2_s2 @end_line_done bgeu       #     bgeu    s1, s2, end_line_done
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !35 addi                          #     li      t1, 0x23                    # '#'
rs1_t0 rs2_t1 @end_comment beq          #     beq     t0, t1, end_comment
rd_t1 !10 addi                          #     li      t1, 0x0a                    # '\n'
rs1_t0 rs2_t1 .00040000 beq $junk jal   #     bne     t0, t1, junk
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
:end_line_done                          # end_line_done:
rd_ra rs1_s0 !280 ld                    #     ld      ra, V_sret(s0)
rs1_ra jalr                             #     ret
:end_comment                            # end_comment:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rs1_s1 rs2_s2 @end_line_done bgeu       #     bgeu    s1, s2, end_line_done
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !10 addi                          #     li      t1, 0x0a
rs1_t0 rs2_t1 @end_comment bne          #     bne     t0, t1, end_comment
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
$end_line_done jal                      #     j       end_line_done

:blanks                                 # blanks:                                 # skips spaces and tabs (uses t0, t1)
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !32 addi                          #     li      t1, 0x20                    # ' '
rs1_t0 rs2_t1 @blanks_skip beq          #     beq     t0, t1, blanks_skip
rd_t1 !9 addi                           #     li      t1, 0x09                    # '\t'
rs1_t0 rs2_t1 @blanks_done bne          #     bne     t0, t1, blanks_done
:blanks_skip                            # blanks_skip:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
$blanks jal                             #     j       blanks
:blanks_done                            # blanks_done:
rs1_ra jalr                             #     ret

:is_ident                               # is_ident:                               # a0 = 1 if byte a0 is a letter, a digit, '_' or '.', else 0 (uses t0)
rd_t0 !46 addi                          #     li      t0, 0x2e                    # '.'
rs1_a0 rs2_t0 @ident_yes beq            #     beq     a0, t0, ident_yes
rd_t0 !95 addi                          #     li      t0, 0x5f                    # '_'
rs1_a0 rs2_t0 @ident_yes beq            #     beq     a0, t0, ident_yes
rd_t0 rs1_a0 !-48 addi                  #     addi    t0, a0, -0x30               # '0'-'9'
rd_t0 rs1_t0 !10 sltiu                  #     sltiu   t0, t0, 10
rs1_t0 @ident_yes bne                   #     bne     t0, zero, ident_yes
rd_t0 rs1_a0 !32 ori                    #     ori     t0, a0, 0x20                # 'A'-'Z' as 'a'-'z'
rd_t0 rs1_t0 !-97 addi                  #     addi    t0, t0, -0x61
rd_t0 rs1_t0 !26 sltiu                  #     sltiu   t0, t0, 26
rs1_t0 @ident_yes bne                   #     bne     t0, zero, ident_yes
rd_a0 addi                              #     li      a0, 0
rs1_ra jalr                             #     ret
:ident_yes                              # ident_yes:
rd_a0 !1 addi                           #     li      a0, 1
rs1_ra jalr                             #     ret

:word                                   # word:                                   # a1, a2 = the name at s1, which moves after it (uses a0, t0, t5)
rd_t5 rs1_ra addi                       #     mv      t5, ra
rd_a1 rs1_s1 addi                       #     mv      a1, s1
:word_byte                              # word_byte:
rd_a0 rs1_s1 lbu                        #     lbu     a0, 0(s1)
rd_ra $is_ident jal                     #     jal     ra, is_ident
rs1_a0 @word_end beq                    #     beq     a0, zero, word_end
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
$word_byte jal                          #     j       word_byte
:word_end                               # word_end:
rd_a2 rs1_s1 rs2_a1 sub                 #     sub     a2, s1, a1
rd_ra rs1_t5 addi                       #     mv      ra, t5
rs1_ra jalr                             #     ret

:pack                                   # pack:                                   # a0 = name a1, a2 as 8 bytes (the first lowest), -1 if longer (uses t0, t1)
rd_a0 !-1 addi                          #     li      a0, -1
rd_t0 !8 addi                           #     li      t0, 8
rs1_t0 rs2_a2 @pack_done bltu           #     bltu    t0, a2, pack_done
rd_a0 addi                              #     li      a0, 0
rd_t0 rs1_a2 addi                       #     mv      t0, a2
:pack_byte                              # pack_byte:                              # from the last byte to the first
rs1_t0 @pack_done beq                   #     beq     t0, zero, pack_done
rd_a0 rs1_a0 !8 slli                    #     slli    a0, a0, 8
rd_t1 rs1_a1 rs2_t0 add                 #     add     t1, a1, t0
rd_t1 rs1_t1 !-1 lbu                    #     lbu     t1, -1(t1)
rd_a0 rs1_a0 rs2_t1 or                  #     or      a0, a0, t1
rd_t0 rs1_t0 !-1 addi                   #     addi    t0, t0, -1
$pack_byte jal                          #     j       pack_byte
:pack_done                              # pack_done:
rs1_ra jalr                             #     ret

# The symbols.

:define_label                           # define_label:                           # name a1, a2: here
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $digits jal                       #     jal     ra, digits                  # n: a local label
rs1_a3 @define_local beq                #     beq     a3, zero, define_local
rd_ra $here_def jal                     #     jal     ra, here_def                # a3, a4, a6
rd_a5 !1 addi                           #     li      a5, 1                       # defined twice in a pass: an error
rd_ra $define jal                       #     jal     ra, define
$define_label_done jal                  #     j       define_label_done
:define_local                           # define_local:
rd_ra $local_def jal                    #     jal     ra, local_def
:define_label_done                      # define_label_done:
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

:here_def                               # here_def:                               # a3 = here's value, a4 its kind, a6 its frag (uses t0)
rd_a4 rs1_s0 !16 ld                     #     ld      a4, V_sec(s0)
rd_t0 rs1_a4 !3 slli                    #     slli    t0, a4, 3
rd_t0 rs1_t0 rs2_s0 add                 #     add     t0, t0, s0
rd_a3 rs1_t0 !72 ld                     #     ld      a3, V_loc(t0)               # the section's location
rd_a6 addi                              #     li      a6, 0
rd_t0 !1 addi                           #     li      t0, 1                       # pass 1 in .text: the frag and the
rs1_a4 rs2_t0 @here_def_done bne        #     bne     a4, t0, here_def_done       # offset in it
rd_t0 rs1_s0 !8 ld                      #     ld      t0, V_emit(s0)
rs1_t0 @here_def_done bne               #     bne     t0, zero, here_def_done
rd_a3 rs1_s0 !272 ld                    #     ld      a3, V_foff(s0)
rd_a6 rs1_s0 !264 ld                    #     ld      a6, V_frag(s0)
:here_def_done                          # here_def_done:
rs1_ra jalr                             #     ret

:define                                 # define:                                 # a0 = symbol a1, a2, defined as a3 of kind a4, frag a6 (uses t0-t6)
rd_t6 rs1_ra addi                       #     mv      t6, ra                      # a5 = 1: an error if defined in this pass
rd_ra $find_sym jal                     #     jal     ra, find_sym
rs1_a0 @define_found bne                #     bne     a0, zero, define_found
rd_ra $sym_new jal                      #     jal     ra, sym_new
$define_set jal                         #     j       define_set
:define_found                           # define_found:
rs1_a5 @define_set beq                  #     beq     a5, zero, define_set
rd_t0 rs1_a0 !32 ld                     #     ld      t0, S_pass(a0)
rd_t1 rs1_s0 ld                         #     ld      t1, V_pass(s0)
rs1_t0 rs2_t1 .00040000 bne $twice jal  #     beq     t0, t1, twice
:define_set                             # define_set:
rs1_a0 rs2_a3 @16 sd                    #     sd      a3, S_value(a0)
rs1_a0 rs2_a4 @24 sd                    #     sd      a4, S_kind(a0)
rd_t0 rs1_s0 ld                         #     ld      t0, V_pass(s0)
rs1_a0 rs2_t0 @32 sd                    #     sd      t0, S_pass(a0)
rs1_a0 rs2_a6 @40 sd                    #     sd      a6, S_frag(a0)
rd_ra rs1_t6 addi                       #     mv      ra, t6
rs1_ra jalr                             #     ret

:sym_new                                # sym_new:                                # a0 = a new symbol a1, a2, not yet defined (uses t0)
rd_a0 rs1_s0 !40 ld                     #     ld      a0, V_nsym(s0)
rd_t0 ~0xa10000 lui                     #     li      t0, SYMS_END
rs1_a0 rs2_t0 .00040000 bltu $too_many_symbols jal #     bgeu    a0, t0, too_many_symbols
rd_t0 rs1_a0 !48 addi                   #     addi    t0, a0, SYM_size
rs1_s0 rs2_t0 @40 sd                    #     sd      t0, V_nsym(s0)
rs1_a0 rs2_a1 sd                        #     sd      a1, S_name(a0)
rs1_a0 rs2_a2 @8 sd                     #     sd      a2, S_len(a0)
rs1_ra jalr                             #     ret

:find_sym                               # find_sym:                               # a0 = symbol a1, a2, or 0 (uses t0-t5)
rd_a0 ~0x710000 lui                     #     li      a0, SYMS
rd_t4 rs1_s0 !40 ld                     #     ld      t4, V_nsym(s0)
:find_sym_next                          # find_sym_next:
rs1_a0 rs2_t4 @find_sym_none bgeu       #     bgeu    a0, t4, find_sym_none
rd_t0 rs1_a0 !8 ld                      #     ld      t0, S_len(a0)               # the same length
rs1_t0 rs2_a2 @find_sym_on bne          #     bne     t0, a2, find_sym_on
rd_t1 rs1_a0 ld                         #     ld      t1, S_name(a0)              # and the same bytes
rd_t2 rs1_a1 addi                       #     mv      t2, a1
rd_t3 rs1_a1 rs2_a2 add                 #     add     t3, a1, a2
:find_sym_byte                          # find_sym_byte:
rs1_t2 rs2_t3 @find_sym_found beq       #     beq     t2, t3, find_sym_found
rd_t0 rs1_t1 lbu                        #     lbu     t0, 0(t1)
rd_t5 rs1_t2 lbu                        #     lbu     t5, 0(t2)
rs1_t0 rs2_t5 @find_sym_on bne          #     bne     t0, t5, find_sym_on
rd_t1 rs1_t1 !1 addi                    #     addi    t1, t1, 1
rd_t2 rs1_t2 !1 addi                    #     addi    t2, t2, 1
$find_sym_byte jal                      #     j       find_sym_byte
:find_sym_on                            # find_sym_on:
rd_a0 rs1_a0 !48 addi                   #     addi    a0, a0, SYM_size
$find_sym_next jal                      #     j       find_sym_next
:find_sym_none                          # find_sym_none:
rd_a0 addi                              #     li      a0, 0
:find_sym_found                         # find_sym_found:
rs1_ra jalr                             #     ret

:local_def                              # local_def:                              # local label a0: here (uses t0, t1, t6)
rd_t0 !100 addi                         #     li      t0, 100
rs1_a0 rs2_t0 .00040000 bltu $bad_local jal #     bgeu    a0, t0, bad_local
rd_t0 rs1_a0 !3 slli                    #     slli    t0, a0, 3                   # its definitions so far: this one's number
rd_t0 rs1_t0 rs2_s0 add                 #     add     t0, t0, s0
rd_a1 rs1_t0 !400 ld                    #     ld      a1, COUNTS(t0)
rd_t1 rs1_a1 !1 addi                    #     addi    t1, a1, 1
rs1_t0 rs2_t1 @400 sd                   #     sd      t1, COUNTS(t0)
rd_t6 rs1_ra addi                       #     mv      t6, ra
rd_ra $local_entry jal                  #     jal     ra, local_entry
rd_ra $here_def jal                     #     jal     ra, here_def
rd_ra rs1_t6 addi                       #     mv      ra, t6
rs1_a0 rs2_a3 sd                        #     sd      a3, L_value(a0)
rs1_a0 rs2_a4 @8 sd                     #     sd      a4, L_kind(a0)
rd_t0 rs1_s0 ld                         #     ld      t0, V_pass(s0)
rs1_a0 rs2_t0 @16 sd                    #     sd      t0, L_pass(a0)
rs1_a0 rs2_a6 @24 sd                    #     sd      a6, L_frag(a0)
rs1_ra jalr                             #     ret

:local_entry                            # local_entry:                            # a0 = definition a1 of local label a0 (uses t0)
rd_t0 !100 addi                         #     li      t0, 100
rs1_a0 rs2_t0 .00040000 bltu $bad_local jal #     bgeu    a0, t0, bad_local
rd_t0 ~0x1000 lui                       #     li      t0, LOCAL_max               # (-1 too: below 0)
rs1_a1 rs2_t0 .00040000 bltu $bad_local jal #     bgeu    a1, t0, bad_local
rd_a0 rs1_a0 rs2_t0 mul                 #     mul     a0, a0, t0
rd_a0 rs1_a0 rs2_a1 add                 #     add     a0, a0, a1
rd_a0 rs1_a0 !5 slli                    #     slli    a0, a0, 5
rd_t0 ~0xa10000 lui                     #     li      t0, LOCALS
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
rs1_ra jalr                             #     ret

:local_ref                              # local_ref:                              # a0 = the definition nf or nb of local label a0, by the last byte of a1, a2 (uses t0-t2)
rd_t0 !100 addi                         #     li      t0, 100
rs1_a0 rs2_t0 .00040000 bltu $bad_local jal #     bgeu    a0, t0, bad_local
rd_t0 rs1_a0 !3 slli                    #     slli    t0, a0, 3                   # nf: the next definition of n
rd_t0 rs1_t0 rs2_s0 add                 #     add     t0, t0, s0
rd_t2 rs1_t0 !400 ld                    #     ld      t2, COUNTS(t0)
rd_t1 rs1_a1 rs2_a2 add                 #     add     t1, a1, a2
rd_t1 rs1_t1 !-1 lbu                    #     lbu     t1, -1(t1)
rd_t0 !102 addi                         #     li      t0, 0x66                    # 'f'
rs1_t1 rs2_t0 @local_ref_entry beq      #     beq     t1, t0, local_ref_entry
rd_t2 rs1_t2 !-1 addi                   #     addi    t2, t2, -1                  # nb: the last one
:local_ref_entry                        # local_ref_entry:
rd_a1 rs1_t2 addi                       #     mv      a1, t2
$local_entry jal                        #     j       local_entry

:digits                                 # digits:                                 # a0 = name a1, a2 when it is decimal digits only, a3 = 0; else a3 = 1 (uses t0-t2)
rd_a0 addi                              #     li      a0, 0
rd_t0 addi                              #     li      t0, 0
:digits_next                            # digits_next:
rs1_t0 rs2_a2 @digits_done bgeu         #     bgeu    t0, a2, digits_done
rd_t1 rs1_a1 rs2_t0 add                 #     add     t1, a1, t0
rd_t1 rs1_t1 lbu                        #     lbu     t1, 0(t1)
rd_t1 rs1_t1 !-48 addi                  #     addi    t1, t1, -0x30               # '0'-'9'
rd_t2 !10 addi                          #     li      t2, 10
rs1_t1 rs2_t2 @digits_not bgeu          #     bgeu    t1, t2, digits_not
rd_a0 rs1_a0 rs2_t2 mul                 #     mul     a0, a0, t2
rd_a0 rs1_a0 rs2_t1 add                 #     add     a0, a0, t1
rd_t0 rs1_t0 !1 addi                    #     addi    t0, t0, 1
$digits_next jal                        #     j       digits_next
:digits_done                            # digits_done:
rd_a3 addi                              #     li      a3, 0
rs1_ra jalr                             #     ret
:digits_not                             # digits_not:
rd_a3 !1 addi                           #     li      a3, 1
rs1_ra jalr                             #     ret

:here                                   # here:                                   # a0 = the address of the next byte, a1 its section (uses t0, t1)
rd_a1 rs1_s0 !16 ld                     #     ld      a1, V_sec(s0)
rd_t0 rs1_a1 !3 slli                    #     slli    t0, a1, 3
rd_t0 rs1_t0 rs2_s0 add                 #     add     t0, t0, s0
rd_a0 rs1_t0 !72 ld                     #     ld      a0, V_loc(t0)
rd_t1 rs1_t0 !152 ld                    #     ld      t1, V_base(t0)
rd_a0 rs1_a0 rs2_t1 add                 #     add     a0, a0, t1
rs1_ra jalr                             #     ret

# Expressions: a0 the value (with its section's address in pass 2), a1
# the kind; V_exact and V_known cleared as it says. Each level keeps its
# left side on the stack.

:eval                                   # eval:                                   # the expression at s1
rd_t0 !1 addi                           #     li      t0, 1
rs1_s0 rs2_t0 @48 sd                    #     sd      t0, V_exact(s0)
rs1_s0 rs2_t0 @56 sd                    #     sd      t0, V_known(s0)
$expr jal                               #     j       expr

:eval_number                            # eval_number:                            # a0 = the expression at s1: a number known here
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $eval jal                         #     jal     ra, eval
rs1_a1 .00040000 beq $not_number jal    #     bne     a1, zero, not_number
rd_t0 rs1_s0 !48 ld                     #     ld      t0, V_exact(s0)
rs1_t0 .00040000 bne $not_number jal    #     beq     t0, zero, not_number
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

:expr                                   # expr:                                   # + -
rd_sp rs1_sp !-32 addi                  #     addi    sp, sp, -32
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $expr_or jal                      #     jal     ra, expr_or
:expr_more                              # expr_more:
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !43 addi                          #     li      t1, 0x2b                    # '+'
rs1_t0 rs2_t1 @expr_add beq             #     beq     t0, t1, expr_add
rd_t1 !45 addi                          #     li      t1, 0x2d                    # '-'
rs1_t0 rs2_t1 @expr_sub beq             #     beq     t0, t1, expr_sub
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !32 addi                   #     addi    sp, sp, 32
rs1_ra jalr                             #     ret
:expr_add                               # expr_add:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rs1_sp rs2_a0 @8 sd                     #     sd      a0, 8(sp)
rs1_sp rs2_a1 @16 sd                    #     sd      a1, 16(sp)
rd_ra $expr_or jal                      #     jal     ra, expr_or
rd_t0 rs1_sp !8 ld                      #     ld      t0, 8(sp)                   # the left one's value
rd_t1 rs1_sp !16 ld                     #     ld      t1, 16(sp)                  # its kind
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
rs1_t1 @expr_more beq                   #     beq     t1, zero, expr_more         # a number + x: x's kind
rs1_a1 @expr_kinds bne                  #     bne     a1, zero, expr_kinds        # a label + a number: the label's
rd_a1 rs1_t1 addi                       #     mv      a1, t1
$expr_more jal                          #     j       expr_more
:expr_sub                               # expr_sub:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rs1_sp rs2_a0 @8 sd                     #     sd      a0, 8(sp)
rs1_sp rs2_a1 @16 sd                    #     sd      a1, 16(sp)
rd_ra $expr_or jal                      #     jal     ra, expr_or
rd_t0 rs1_sp !8 ld                      #     ld      t0, 8(sp)
rd_t1 rs1_sp !16 ld                     #     ld      t1, 16(sp)
rd_a0 rs1_t0 rs2_a0 sub                 #     sub     a0, t0, a0
rs1_a1 @expr_sub_kind beq               #     beq     a1, zero, expr_sub_kind     # x - a number: x's kind
rs1_a1 rs2_t1 @expr_kinds bne           #     bne     a1, t1, expr_kinds          # two labels of a section: a number
rd_a1 addi                              #     li      a1, 0
$expr_more jal                          #     j       expr_more
:expr_sub_kind                          # expr_sub_kind:
rd_a1 rs1_t1 addi                       #     mv      a1, t1
$expr_more jal                          #     j       expr_more
:expr_kinds                             # expr_kinds:
rd_ra $kinds jal                        #     jal     ra, kinds
$expr_more jal                          #     j       expr_more

:kinds                                  # kinds:                                  # an operation on labels it cannot do: fine while names are unknown (uses t0)
rd_a1 addi                              #     li      a1, 0
rd_t0 rs1_s0 !56 ld                     #     ld      t0, V_known(s0)
rs1_t0 @kinds_unknown beq               #     beq     t0, zero, kinds_unknown
rd_a0 ~msg_kinds auipc rd_a0 rs1_a0 !msg_kinds addi #     la      a0, msg_kinds
$fail jal                               #     j       fail
:kinds_unknown                          # kinds_unknown:
rs1_ra jalr                             #     ret

:expr_or                                # expr_or:                                # | & ^
rd_sp rs1_sp !-32 addi                  #     addi    sp, sp, -32
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $expr_mul jal                     #     jal     ra, expr_mul
:expr_or_more                           # expr_or_more:
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !124 addi                         #     li      t1, 0x7c                    # '|'
rs1_t0 rs2_t1 @expr_or_op beq           #     beq     t0, t1, expr_or_op
rd_t1 !38 addi                          #     li      t1, 0x26                    # '&'
rs1_t0 rs2_t1 @expr_or_op beq           #     beq     t0, t1, expr_or_op
rd_t1 !94 addi                          #     li      t1, 0x5e                    # '^'
rs1_t0 rs2_t1 @expr_or_op beq           #     beq     t0, t1, expr_or_op
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !32 addi                   #     addi    sp, sp, 32
rs1_ra jalr                             #     ret
:expr_or_op                             # expr_or_op:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rs1_sp rs2_t0 @24 sd                    #     sd      t0, 24(sp)                  # the operator
rs1_sp rs2_a0 @8 sd                     #     sd      a0, 8(sp)
rs1_sp rs2_a1 @16 sd                    #     sd      a1, 16(sp)
rd_ra $expr_mul jal                     #     jal     ra, expr_mul
rd_t1 rs1_sp !16 ld                     #     ld      t1, 16(sp)                  # numbers only
rd_t1 rs1_t1 rs2_a1 or                  #     or      t1, t1, a1
rs1_t1 @expr_or_numbers beq             #     beq     t1, zero, expr_or_numbers
rd_ra $kinds jal                        #     jal     ra, kinds
:expr_or_numbers                        # expr_or_numbers:
rd_a1 addi                              #     li      a1, 0
rd_t0 rs1_sp !8 ld                      #     ld      t0, 8(sp)
rd_t2 rs1_sp !24 ld                     #     ld      t2, 24(sp)
rd_t1 !124 addi                         #     li      t1, 0x7c                    # '|'
rs1_t2 rs2_t1 @expr_and bne             #     bne     t2, t1, expr_and
rd_a0 rs1_t0 rs2_a0 or                  #     or      a0, t0, a0
$expr_or_more jal                       #     j       expr_or_more
:expr_and                               # expr_and:
rd_t1 !38 addi                          #     li      t1, 0x26                    # '&'
rs1_t2 rs2_t1 @expr_xor bne             #     bne     t2, t1, expr_xor
rd_a0 rs1_t0 rs2_a0 and                 #     and     a0, t0, a0
$expr_or_more jal                       #     j       expr_or_more
:expr_xor                               # expr_xor:
rd_a0 rs1_t0 rs2_a0 xor                 #     xor     a0, t0, a0
$expr_or_more jal                       #     j       expr_or_more

:expr_mul                               # expr_mul:                               # * / % << >>
rd_sp rs1_sp !-32 addi                  #     addi    sp, sp, -32
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $expr_unary jal                   #     jal     ra, expr_unary
:expr_mul_more                          # expr_mul_more:
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !42 addi                          #     li      t1, 0x2a                    # '*'
rs1_t0 rs2_t1 @expr_mul_op beq          #     beq     t0, t1, expr_mul_op
rd_t1 !47 addi                          #     li      t1, 0x2f                    # '/'
rs1_t0 rs2_t1 @expr_mul_op beq          #     beq     t0, t1, expr_mul_op
rd_t1 !37 addi                          #     li      t1, 0x25                    # '%'
rs1_t0 rs2_t1 @expr_mul_op beq          #     beq     t0, t1, expr_mul_op
rd_t1 !60 addi                          #     li      t1, 0x3c                    # '<' of '<<'
rs1_t0 rs2_t1 @expr_shift beq           #     beq     t0, t1, expr_shift
rd_t1 !62 addi                          #     li      t1, 0x3e                    # '>' of '>>'
rs1_t0 rs2_t1 @expr_shift beq           #     beq     t0, t1, expr_shift
:expr_mul_done                          # expr_mul_done:
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !32 addi                   #     addi    sp, sp, 32
rs1_ra jalr                             #     ret
:expr_shift                             # expr_shift:
rd_t1 rs1_s1 !1 lbu                     #     lbu     t1, 1(s1)                   # doubled
rs1_t1 rs2_t0 @expr_mul_done bne        #     bne     t1, t0, expr_mul_done
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
:expr_mul_op                            # expr_mul_op:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rs1_sp rs2_t0 @24 sd                    #     sd      t0, 24(sp)                  # the operator
rs1_sp rs2_a0 @8 sd                     #     sd      a0, 8(sp)
rs1_sp rs2_a1 @16 sd                    #     sd      a1, 16(sp)
rd_ra $expr_unary jal                   #     jal     ra, expr_unary
rd_t1 rs1_sp !16 ld                     #     ld      t1, 16(sp)                  # numbers only
rd_t1 rs1_t1 rs2_a1 or                  #     or      t1, t1, a1
rs1_t1 @expr_mul_numbers beq            #     beq     t1, zero, expr_mul_numbers
rd_ra $kinds jal                        #     jal     ra, kinds
:expr_mul_numbers                       # expr_mul_numbers:
rd_a1 addi                              #     li      a1, 0
rd_t0 rs1_sp !8 ld                      #     ld      t0, 8(sp)                   # the left one
rd_t2 rs1_sp !24 ld                     #     ld      t2, 24(sp)
rd_t1 !42 addi                          #     li      t1, 0x2a                    # '*'
rs1_t2 rs2_t1 @expr_div bne             #     bne     t2, t1, expr_div
rd_a0 rs1_t0 rs2_a0 mul                 #     mul     a0, t0, a0
$expr_mul_more jal                      #     j       expr_mul_more
:expr_div                               # expr_div:
rd_t1 !60 addi                          #     li      t1, 0x3c                    # '<<'
rs1_t2 rs2_t1 @expr_shl beq             #     beq     t2, t1, expr_shl
rd_t1 !62 addi                          #     li      t1, 0x3e                    # '>>'
rs1_t2 rs2_t1 @expr_shr beq             #     beq     t2, t1, expr_shr
rs1_a0 @expr_by_zero beq                #     beq     a0, zero, expr_by_zero
rd_t1 !47 addi                          #     li      t1, 0x2f                    # '/': signed, as gas
rs1_t2 rs2_t1 @expr_rem bne             #     bne     t2, t1, expr_rem
rd_a0 rs1_t0 rs2_a0 div                 #     div     a0, t0, a0
$expr_mul_more jal                      #     j       expr_mul_more
:expr_rem                               # expr_rem:                               # '%'
rd_a0 rs1_t0 rs2_a0 rem                 #     rem     a0, t0, a0
$expr_mul_more jal                      #     j       expr_mul_more
:expr_by_zero                           # expr_by_zero:                           # fine while names are unknown
rd_t1 rs1_s0 !56 ld                     #     ld      t1, V_known(s0)
rs1_t1 .00040000 beq $bad_expr jal      #     bne     t1, zero, bad_expr
$expr_mul_more jal                      #     j       expr_mul_more
:expr_shl                               # expr_shl:
rd_a0 rs1_t0 rs2_a0 sll                 #     sll     a0, t0, a0
$expr_mul_more jal                      #     j       expr_mul_more
:expr_shr                               # expr_shr:
rd_a0 rs1_t0 rs2_a0 sra                 #     sra     a0, t0, a0
$expr_mul_more jal                      #     j       expr_mul_more

:expr_unary                             # expr_unary:                             # - ~ ( ), a number, a name, '.'
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $blanks jal                       #     jal     ra, blanks
rd_a0 rs1_s1 lbu                        #     lbu     a0, 0(s1)
rd_t0 !45 addi                          #     li      t0, 0x2d                    # '-'
rs1_a0 rs2_t0 @unary_neg beq            #     beq     a0, t0, unary_neg
rd_t0 !126 addi                         #     li      t0, 0x7e                    # '~'
rs1_a0 rs2_t0 @unary_not beq            #     beq     a0, t0, unary_not
rd_t0 !40 addi                          #     li      t0, 0x28                    # '('
rs1_a0 rs2_t0 @unary_paren beq          #     beq     a0, t0, unary_paren
rd_ra $is_ident jal                     #     jal     ra, is_ident
rs1_a0 .00040000 bne $bad_expr jal      #     beq     a0, zero, bad_expr
rd_ra $word jal                         #     jal     ra, word
rd_t0 rs1_a1 lbu                        #     lbu     t0, 0(a1)
rd_t0 rs1_t0 !-48 addi                  #     addi    t0, t0, -0x30               # '0'-'9': a number
rd_t1 !10 addi                          #     li      t1, 10
rs1_t0 rs2_t1 @unary_number bltu        #     bltu    t0, t1, unary_number
rd_t0 !1 addi                           #     li      t0, 1                       # '.': here
rs1_a2 rs2_t0 @unary_symbol bne         #     bne     a2, t0, unary_symbol
rd_t0 rs1_a1 lbu                        #     lbu     t0, 0(a1)
rd_t1 !46 addi                          #     li      t1, 0x2e
rs1_t0 rs2_t1 @unary_symbol bne         #     bne     t0, t1, unary_symbol
rd_ra $here jal                         #     jal     ra, here
$unary_done jal                         #     j       unary_done
:unary_neg                              # unary_neg:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_ra $expr_unary jal                   #     jal     ra, expr_unary
rd_a0 rs2_a0 sub                        #     neg     a0, a0
$unary_number_only jal                  #     j       unary_number_only
:unary_not                              # unary_not:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_ra $expr_unary jal                   #     jal     ra, expr_unary
rd_a0 rs1_a0 !-1 xori                   #     not     a0, a0
:unary_number_only                      # unary_number_only:
rs1_a1 @unary_done beq                  #     beq     a1, zero, unary_done
rd_ra $kinds jal                        #     jal     ra, kinds
$unary_done jal                         #     j       unary_done
:unary_paren                            # unary_paren:
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_ra $expr jal                         #     jal     ra, expr
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !41 addi                          #     li      t1, 0x29                    # ')'
rs1_t0 rs2_t1 .00040000 beq $bad_expr jal #     bne     t0, t1, bad_expr
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
$unary_done jal                         #     j       unary_done
:unary_symbol                           # unary_symbol:
rd_ra $find_sym jal                     #     jal     ra, find_sym
rs1_a0 @undefined beq                   #     beq     a0, zero, undefined
rd_a0 rs1_a0 !16 addi                   #     addi    a0, a0, S_value             # its definition
$unary_def jal                          #     j       unary_def
:unary_number                           # unary_number:                           # digits, then b or f: a local label's
rd_t0 rs1_a1 rs2_a2 add                 #     add     t0, a1, a2
rd_t0 rs1_t0 !-1 lbu                    #     lbu     t0, -1(t0)
rd_t1 !98 addi                          #     li      t1, 0x62                    # 'b'
rs1_t0 rs2_t1 @unary_local beq          #     beq     t0, t1, unary_local
rd_t1 !102 addi                         #     li      t1, 0x66                    # 'f'
rs1_t0 rs2_t1 @unary_local beq          #     beq     t0, t1, unary_local
:unary_plain                            # unary_plain:
rd_ra $number jal                       #     jal     ra, number
rs1_a3 .00040000 beq $bad_number jal    #     bne     a3, zero, bad_number
rd_a1 addi                              #     li      a1, 0
$unary_done jal                         #     j       unary_done
:unary_local                            # unary_local:
rd_a2 rs1_a2 !-1 addi                   #     addi    a2, a2, -1
rd_ra $digits jal                       #     jal     ra, digits
rd_a2 rs1_a2 !1 addi                    #     addi    a2, a2, 1
rs1_a3 @unary_plain bne                 #     bne     a3, zero, unary_plain
rd_ra $local_ref jal                    #     jal     ra, local_ref
:unary_def                              # unary_def:                              # definition a0: defined before, in this pass?
rd_t0 rs1_a0 !16 ld                     #     ld      t0, 16(a0)                  # its pass
rs1_t0 @undefined beq                   #     beq     t0, zero, undefined         # none yet
rd_t1 rs1_s0 ld                         #     ld      t1, V_pass(s0)
rs1_t0 rs2_t1 @unary_exact beq          #     beq     t0, t1, unary_exact
rs1_s0 @48 sd                           #     sd      zero, V_exact(s0)
:unary_exact                            # unary_exact:
rd_a1 rs1_a0 !8 ld                      #     ld      a1, 8(a0)                   # its kind
rd_a0 rs1_a0 ld                         #     ld      a0, 0(a0)                   # its value
rd_t0 rs1_a1 !3 slli                    #     slli    t0, a1, 3                   # plus its section's address
rd_t0 rs1_t0 rs2_s0 add                 #     add     t0, t0, s0
rd_t0 rs1_t0 !152 ld                    #     ld      t0, V_base(t0)
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
:unary_done                             # unary_done:
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret
:undefined                              # undefined:                              # a name not yet defined: an error in pass 2
rd_t0 rs1_s0 !8 ld                      #     ld      t0, V_emit(s0)
rs1_t0 .00040000 beq $not_defined jal   #     bne     t0, zero, not_defined
rs1_s0 @48 sd                           #     sd      zero, V_exact(s0)
rs1_s0 @56 sd                           #     sd      zero, V_known(s0)
rd_a0 addi                              #     li      a0, 0
rd_a1 addi                              #     li      a1, 0
$unary_done jal                         #     j       unary_done

:number                                 # number:                                 # a0 = the number a1, a2: decimal, 0x hex, 0 octal; a3 = 1 if none (uses t0-t4)
rd_a0 addi                              #     li      a0, 0
rd_t0 addi                              #     li      t0, 0                       # the next digit
rd_t2 !10 addi                          #     li      t2, 10                      # the base
rd_t1 rs1_a1 lbu                        #     lbu     t1, 0(a1)
rd_t3 !48 addi                          #     li      t3, 0x30                    # '0'
rs1_t1 rs2_t3 @number_digits bne        #     bne     t1, t3, number_digits
rd_t3 !1 addi                           #     li      t3, 1
rs1_a2 rs2_t3 @number_digits beq        #     beq     a2, t3, number_digits
rd_t2 !8 addi                           #     li      t2, 8                       # 0...: octal
rd_t0 !1 addi                           #     li      t0, 1
rd_t1 rs1_a1 !1 lbu                     #     lbu     t1, 1(a1)
rd_t1 rs1_t1 !32 ori                    #     ori     t1, t1, 0x20
rd_t3 !120 addi                         #     li      t3, 0x78                    # 0x...: hex
rs1_t1 rs2_t3 @number_digits bne        #     bne     t1, t3, number_digits
rd_t2 !16 addi                          #     li      t2, 16
rd_t0 !2 addi                           #     li      t0, 2
rd_t3 !2 addi                           #     li      t3, 2
rs1_a2 rs2_t3 @number_bad beq           #     beq     a2, t3, number_bad
:number_digits                          # number_digits:
rs1_t0 rs2_a2 @number_done bgeu         #     bgeu    t0, a2, number_done
rd_t1 rs1_a1 rs2_t0 add                 #     add     t1, a1, t0
rd_t1 rs1_t1 lbu                        #     lbu     t1, 0(t1)
rd_t3 rs1_t1 !-48 addi                  #     addi    t3, t1, -0x30               # '0'-'9'
rd_t4 !10 addi                          #     li      t4, 10
rs1_t3 rs2_t4 @number_digit bltu        #     bltu    t3, t4, number_digit
rd_t3 rs1_t1 !32 ori                    #     ori     t3, t1, 0x20                # 'a'-'f', 'A'-'F': 10-15
rd_t3 rs1_t3 !-87 addi                  #     addi    t3, t3, -0x57
rs1_t3 rs2_t4 @number_bad bltu          #     bltu    t3, t4, number_bad
:number_digit                           # number_digit:
rs1_t3 rs2_t2 @number_bad bgeu          #     bgeu    t3, t2, number_bad          # a digit of the base
rd_a0 rs1_a0 rs2_t2 mul                 #     mul     a0, a0, t2
rd_a0 rs1_a0 rs2_t3 add                 #     add     a0, a0, t3
rd_t0 rs1_t0 !1 addi                    #     addi    t0, t0, 1
$number_digits jal                      #     j       number_digits
:number_done                            # number_done:
rd_a3 addi                              #     li      a3, 0
rs1_ra jalr                             #     ret
:number_bad                             # number_bad:
rd_a3 !1 addi                           #     li      a3, 1
rs1_ra jalr                             #     ret

# Directives.

:directive                              # directive:                              # a1, a2: its name
rd_ra $pack jal                         #     jal     ra, pack
rd_t0 ~directives auipc rd_t0 rs1_t0 !directives addi #     la      t0, directives
:directive_next                         # directive_next:
rd_t1 rs1_t0 ld                         #     ld      t1, 0(t0)
rs1_t1 @unknown_directive beq           #     beq     t1, zero, unknown_directive
rs1_t1 rs2_a0 @directive_found beq      #     beq     t1, a0, directive_found
rd_t0 rs1_t0 !16 addi                   #     addi    t0, t0, 16
$directive_next jal                     #     j       directive_next
:directive_found                        # directive_found:
rd_t1 rs1_t0 !8 ld                      #     ld      t1, 8(t0)                   # its routine, from directives
rd_t2 ~directives auipc rd_t2 rs1_t2 !directives addi #     la      t2, directives
rd_t1 rs1_t1 rs2_t2 add                 #     add     t1, t1, t2
rs1_t1 jalr                             #     jr      t1
:unknown_directive                      # unknown_directive:
rd_a0 ~msg_directive auipc rd_a0 rs1_a0 !msg_directive addi #     la      a0, msg_directive
$fail jal                               #     j       fail

:d_globl                                # d_globl:                                # .globl name: ld starts at _start anyway
rd_ra $blanks jal                       #     jal     ra, blanks
rd_ra $word jal                         #     jal     ra, word
$end_line jal                           #     j       end_line

:d_section                              # d_section:                              # .section name
rd_ra $blanks jal                       #     jal     ra, blanks
rd_ra $word jal                         #     jal     ra, word
rd_ra $pack jal                         #     jal     ra, pack
rd_t0 ~sections auipc rd_t0 rs1_t0 !sections addi #     la      t0, sections
rd_t2 !1 addi                           #     li      t2, 1
:d_section_next                         # d_section_next:
rd_t1 rs1_t0 ld                         #     ld      t1, 0(t0)
rs1_t1 rs2_a0 @d_section_found beq      #     beq     t1, a0, d_section_found
rd_t0 rs1_t0 !8 addi                    #     addi    t0, t0, 8
rd_t2 rs1_t2 !1 addi                    #     addi    t2, t2, 1
rd_t1 !4 addi                           #     li      t1, 4
rs1_t1 rs2_t2 @d_section_next bgeu      #     bgeu    t1, t2, d_section_next
rd_a0 ~msg_section auipc rd_a0 rs1_a0 !msg_section addi #     la      a0, msg_section
$fail jal                               #     j       fail
:d_section_found                        # d_section_found:
rd_a0 rs1_t2 addi                       #     mv      a0, t2
$set_section jal                        #     j       set_section
:d_text                                 # d_text:
rd_a0 !1 addi                           #     li      a0, 1
$set_section jal                        #     j       set_section
:d_data                                 # d_data:
rd_a0 !3 addi                           #     li      a0, 3
$set_section jal                        #     j       set_section
:d_bss                                  # d_bss:
rd_a0 !4 addi                           #     li      a0, 4
:set_section                            # set_section:
rs1_s0 rs2_a0 @16 sd                    #     sd      a0, V_sec(s0)
$end_line jal                           #     j       end_line

:d_equ                                  # d_equ:                                  # .equ name, expr
rd_ra $blanks jal                       #     jal     ra, blanks
rd_ra $word jal                         #     jal     ra, word
rd_s8 rs1_a1 addi                       #     mv      s8, a1
rd_s9 rs1_a2 addi                       #     mv      s9, a2
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !44 addi                          #     li      t1, 0x2c                    # ','
rs1_t0 rs2_t1 .00040000 beq $bad_syntax jal #     bne     t0, t1, bad_syntax
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_ra $eval jal                         #     jal     ra, eval
rd_t0 rs1_a1 !3 slli                    #     slli    t0, a1, 3                   # kept in its section
rd_t0 rs1_t0 rs2_s0 add                 #     add     t0, t0, s0
rd_t0 rs1_t0 !152 ld                    #     ld      t0, V_base(t0)
rd_a3 rs1_a0 rs2_t0 sub                 #     sub     a3, a0, t0
rd_a4 rs1_a1 addi                       #     mv      a4, a1
rd_a1 rs1_s8 addi                       #     mv      a1, s8
rd_a2 rs1_s9 addi                       #     mv      a2, s9
rd_a5 addi                              #     li      a5, 0                       # may be set again
rd_a6 addi                              #     li      a6, 0
rd_ra $define jal                       #     jal     ra, define
rd_t0 rs1_s0 !48 ld                     #     ld      t0, V_exact(s0)             # not known here: never a number known here
rs1_t0 @end_line bne                    #     bne     t0, zero, end_line
rs1_a0 @32 sd                           #     sd      zero, S_pass(a0)
$end_line jal                           #     j       end_line

:d_balign                               # d_balign:                               # .balign n: zeros up to a multiple of n
rd_ra $eval_number jal                  #     jal     ra, eval_number
rs1_a0 .00040000 bne $bad_align jal     #     beq     a0, zero, bad_align
rd_t0 rs1_a0 !-1 addi                   #     addi    t0, a0, -1                  # a power of 2
rd_t1 rs1_a0 rs2_t0 and                 #     and     t1, a0, t0
rs1_t1 .00040000 beq $bad_align jal     #     bne     t1, zero, bad_align
rd_t2 rs1_s0 !16 ld                     #     ld      t2, V_sec(s0)
rd_t1 !1 addi                           #     li      t1, 1                       # gas pads .text with nops: not done
rs1_t2 rs2_t1 .00040000 bne $bad_align jal #     beq     t2, t1, bad_align
rd_t2 rs1_t2 !3 slli                    #     slli    t2, t2, 3
rd_t2 rs1_t2 rs2_s0 add                 #     add     t2, t2, s0
rd_t1 rs1_t2 !112 ld                    #     ld      t1, V_align(t2)             # the section's alignment
rs1_t1 rs2_a0 @d_balign_pad bgeu        #     bgeu    t1, a0, d_balign_pad
rs1_t2 rs2_a0 @112 sd                   #     sd      a0, V_align(t2)
:d_balign_pad                           # d_balign_pad:
rd_t1 rs1_t2 !72 ld                     #     ld      t1, V_loc(t2)
rd_t3 rs2_t1 sub                        #     neg     t3, t1
rd_t3 rs1_t3 rs2_t0 and                 #     and     t3, t3, t0                  # (-loc) & (n - 1)
rd_t1 rs1_t1 rs2_t3 add                 #     add     t1, t1, t3                  # zeros: the output is zero
rs1_t2 rs2_t1 @72 sd                    #     sd      t1, V_loc(t2)
$end_line jal                           #     j       end_line

:d_skip                                 # d_skip:                                 # .skip n: n zeros
rd_ra $eval_number jal                  #     jal     ra, eval_number
rd_t2 rs1_s0 !16 ld                     #     ld      t2, V_sec(s0)
rd_t1 !1 addi                           #     li      t1, 1                       # in .text: a frag's bytes too
rs1_t2 rs2_t1 @d_skip_loc bne           #     bne     t2, t1, d_skip_loc
rd_t1 rs1_s0 !272 ld                    #     ld      t1, V_foff(s0)
rd_t1 rs1_t1 rs2_a0 add                 #     add     t1, t1, a0
rs1_s0 rs2_t1 @272 sd                   #     sd      t1, V_foff(s0)
:d_skip_loc                             # d_skip_loc:
rd_t2 rs1_t2 !3 slli                    #     slli    t2, t2, 3
rd_t2 rs1_t2 rs2_s0 add                 #     add     t2, t2, s0
rd_t1 rs1_t2 !72 ld                     #     ld      t1, V_loc(t2)
rd_t1 rs1_t1 rs2_a0 add                 #     add     t1, t1, a0
rs1_t2 rs2_t1 @72 sd                    #     sd      t1, V_loc(t2)
$end_line jal                           #     j       end_line

:d_byte                                 # d_byte:                                 # .byte expr, ...
rd_s8 !1 addi                           #     li      s8, 1
$data jal                               #     j       data
:d_half                                 # d_half:                                 # .half expr, ...
rd_s8 !2 addi                           #     li      s8, 2
$data jal                               #     j       data
:d_word                                 # d_word:                                 # .word expr, ...
rd_s8 !4 addi                           #     li      s8, 4
$data jal                               #     j       data
:d_dword                                # d_dword:                                # .dword expr, ...
rd_s8 !8 addi                           #     li      s8, 8
:data                                   # data:
rd_ra $eval jal                         #     jal     ra, eval
rd_a1 rs1_s8 addi                       #     mv      a1, s8
rd_ra $emit_n jal                       #     jal     ra, emit_n
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !44 addi                          #     li      t1, 0x2c                    # ','
rs1_t0 rs2_t1 @end_line bne             #     bne     t0, t1, end_line
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
$data jal                               #     j       data

:d_asciz                                # d_asciz:                                # .asciz "text", ...: each with a 0 after it
rd_s8 !1 addi                           #     li      s8, 1
$ascii jal                              #     j       ascii
:d_ascii                                # d_ascii:                                # .ascii "text", ...
rd_s8 addi                              #     li      s8, 0
:ascii                                  # ascii:
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !34 addi                          #     li      t1, 0x22                    # '"'
rs1_t0 rs2_t1 .00040000 beq $bad_syntax jal #     bne     t0, t1, bad_syntax
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
:ascii_byte                             # ascii_byte:
rs1_s1 rs2_s2 .00040000 bltu $bad_string jal #     bgeu    s1, s2, bad_string
rd_a0 rs1_s1 lbu                        #     lbu     a0, 0(s1)
rd_t1 !10 addi                          #     li      t1, 0x0a                    # '\n'
rs1_a0 rs2_t1 .00040000 bne $bad_string jal #     beq     a0, t1, bad_string
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_t1 !34 addi                          #     li      t1, 0x22                    # '"'
rs1_a0 rs2_t1 @ascii_end beq            #     beq     a0, t1, ascii_end
rd_t1 !92 addi                          #     li      t1, 0x5c                    # '\'
rs1_a0 rs2_t1 @ascii_put bne            #     bne     a0, t1, ascii_put
rd_a0 rs1_s1 lbu                        #     lbu     a0, 0(s1)
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_t1 !110 addi                         #     li      t1, 0x6e                    # \n
rs1_a0 rs2_t1 @ascii_not_n bne          #     bne     a0, t1, ascii_not_n
rd_a0 !10 addi                          #     li      a0, 0x0a
$ascii_put jal                          #     j       ascii_put
:ascii_not_n                            # ascii_not_n:
rd_t1 !116 addi                         #     li      t1, 0x74                    # \t
rs1_a0 rs2_t1 @ascii_not_t bne          #     bne     a0, t1, ascii_not_t
rd_a0 !9 addi                           #     li      a0, 0x09
$ascii_put jal                          #     j       ascii_put
:ascii_not_t                            # ascii_not_t:
rd_t2 rs1_a0 !-48 addi                  #     addi    t2, a0, -0x30               # \ooo: up to 3 octal digits
rd_t1 !8 addi                           #     li      t1, 8
rs1_t2 rs2_t1 @ascii_put bgeu           #     bgeu    t2, t1, ascii_put           # else the byte itself
rd_a0 rs1_t2 addi                       #     mv      a0, t2
rd_t3 !2 addi                           #     li      t3, 2
:ascii_octal                            # ascii_octal:
rd_t2 rs1_s1 lbu                        #     lbu     t2, 0(s1)
rd_t2 rs1_t2 !-48 addi                  #     addi    t2, t2, -0x30
rs1_t2 rs2_t1 @ascii_put bgeu           #     bgeu    t2, t1, ascii_put
rd_a0 rs1_a0 !3 slli                    #     slli    a0, a0, 3
rd_a0 rs1_a0 rs2_t2 add                 #     add     a0, a0, t2
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_t3 rs1_t3 !-1 addi                   #     addi    t3, t3, -1
rs1_t3 @ascii_octal bne                 #     bne     t3, zero, ascii_octal
:ascii_put                              # ascii_put:
rd_ra $emit_byte jal                    #     jal     ra, emit_byte
$ascii_byte jal                         #     j       ascii_byte
:ascii_end                              # ascii_end:
rs1_s8 @ascii_next beq                  #     beq     s8, zero, ascii_next
rd_a0 addi                              #     li      a0, 0
rd_ra $emit_byte jal                    #     jal     ra, emit_byte
:ascii_next                             # ascii_next:
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !44 addi                          #     li      t1, 0x2c                    # ','
rs1_t0 rs2_t1 @end_line bne             #     bne     t0, t1, end_line
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
$ascii jal                              #     j       ascii

# Output.

:emit_byte                              # emit_byte:                              # the byte a0 at here, in pass 2; counted (uses t0-t2)
rd_t0 rs1_s0 !16 ld                     #     ld      t0, V_sec(s0)
rd_t1 rs1_t0 !3 slli                    #     slli    t1, t0, 3
rd_t1 rs1_t1 rs2_s0 add                 #     add     t1, t1, s0
rd_t2 rs1_s0 !8 ld                      #     ld      t2, V_emit(s0)
rs1_t2 @emit_byte_count beq             #     beq     t2, zero, emit_byte_count
rd_t2 !4 addi                           #     li      t2, 4                       # not in .bss
rs1_t0 rs2_t2 .00040000 bne $in_bss jal #     beq     t0, t2, in_bss
rd_t2 rs1_t1 !192 ld                    #     ld      t2, V_off(t1)
rd_t0 rs1_t1 !72 ld                     #     ld      t0, V_loc(t1)
rd_t2 rs1_t2 rs2_t0 add                 #     add     t2, t2, t0
rd_t0 ~0x2c90000 lui                    #     li      t0, OUTBUF
rd_t2 rs1_t2 rs2_t0 add                 #     add     t2, t2, t0
rd_t0 ~0x3c90000 lui                    #     li      t0, OUTBUF_END
rs1_t2 rs2_t0 .00040000 bltu $output_full jal #     bgeu    t2, t0, output_full
rs1_t2 rs2_a0 sb                        #     sb      a0, 0(t2)
rd_t0 rs1_s0 !16 ld                     #     ld      t0, V_sec(s0)
:emit_byte_count                        # emit_byte_count:
rd_t2 rs1_t1 !72 ld                     #     ld      t2, V_loc(t1)
rd_t2 rs1_t2 !1 addi                    #     addi    t2, t2, 1
rs1_t1 rs2_t2 @72 sd                    #     sd      t2, V_loc(t1)
rd_t2 !1 addi                           #     li      t2, 1                       # in .text: a frag's byte too
rs1_t0 rs2_t2 @emit_byte_done bne       #     bne     t0, t2, emit_byte_done
rd_t2 rs1_s0 !272 ld                    #     ld      t2, V_foff(s0)
rd_t2 rs1_t2 !1 addi                    #     addi    t2, t2, 1
rs1_s0 rs2_t2 @272 sd                   #     sd      t2, V_foff(s0)
:emit_byte_done                         # emit_byte_done:
rs1_ra jalr                             #     ret

:emit16                                 # emit16:                                 # the 2 bytes of a0 (uses a0-a2, t0-t2, t6)
rd_a1 !2 addi                           #     li      a1, 2
$emit_n jal                             #     j       emit_n
:emit32                                 # emit32:                                 # the 4 bytes of a0 (the same)
rd_a1 !4 addi                           #     li      a1, 4
:emit_n                                 # emit_n:                                 # a1 bytes of a0, the low one first
rd_t6 rs1_ra addi                       #     mv      t6, ra
rd_a2 rs1_a0 addi                       #     mv      a2, a0
:emit_n_byte                            # emit_n_byte:
rd_a0 rs1_a2 addi                       #     mv      a0, a2
rd_ra $emit_byte jal                    #     jal     ra, emit_byte
rd_a2 rs1_a2 !8 srli                    #     srli    a2, a2, 8
rd_a1 rs1_a1 !-1 addi                   #     addi    a1, a1, -1
rs1_a1 @emit_n_byte bne                 #     bne     a1, zero, emit_n_byte
rd_ra rs1_t6 addi                       #     mv      ra, t6
rs1_ra jalr                             #     ret

:frag_break                             # frag_break:                             # pass 1: the frag ends, with jump a0 or none (0) (uses t0, t1)
rd_t0 rs1_s0 !8 ld                      #     ld      t0, V_emit(s0)
rs1_t0 @frag_break_done bne             #     bne     t0, zero, frag_break_done
rd_t0 rs1_s0 !264 ld                    #     ld      t0, V_frag(s0)
rd_t1 rs1_s0 !272 ld                    #     ld      t1, V_foff(s0)
rs1_t0 rs2_t1 @16 sd                    #     sd      t1, F_fix(t0)
rs1_t0 rs2_a0 @24 sd                    #     sd      a0, F_jump(t0)
rd_t0 rs1_t0 !32 addi                   #     addi    t0, t0, 32                  # the next one
rd_t1 ~0x1c90000 lui rd_t1 rs1_t1 !-32 addiw #     li      t1, FRAGS_END - 32
rs1_t0 rs2_t1 .00040000 bltu $too_many_jumps jal #     bgeu    t0, t1, too_many_jumps
rs1_s0 rs2_t0 @264 sd                   #     sd      t0, V_frag(s0)
rs1_s0 @272 sd                          #     sd      zero, V_foff(s0)
:frag_break_done                        # frag_break_done:
rs1_ra jalr                             #     ret

:scatter                                # scatter:                                # a0 = value a0's pieces placed as table a1 says (uses a1, t0-t5)
rd_t0 rs1_a1 lbu                        #     lbu     t0, 0(a1)                   # the pieces: from bit, bits, to bit
rd_a1 rs1_a1 !1 addi                    #     addi    a1, a1, 1
rd_t1 addi                              #     li      t1, 0                       # the field
:scatter_piece                          # scatter_piece:
rs1_t0 @scatter_done beq                #     beq     t0, zero, scatter_done
rd_t2 rs1_a1 lbu                        #     lbu     t2, 0(a1)
rd_t3 rs1_a1 !1 lbu                     #     lbu     t3, 1(a1)
rd_t4 rs1_a1 !2 lbu                     #     lbu     t4, 2(a1)
rd_t2 rs1_a0 rs2_t2 srl                 #     srl     t2, a0, t2
rd_t5 !1 addi                           #     li      t5, 1                       # (1 << bits) - 1
rd_t5 rs1_t5 rs2_t3 sll                 #     sll     t5, t5, t3
rd_t5 rs1_t5 !-1 addi                   #     addi    t5, t5, -1
rd_t2 rs1_t2 rs2_t5 and                 #     and     t2, t2, t5
rd_t2 rs1_t2 rs2_t4 sll                 #     sll     t2, t2, t4
rd_t1 rs1_t1 rs2_t2 or                  #     or      t1, t1, t2
rd_a1 rs1_a1 !3 addi                    #     addi    a1, a1, 3
rd_t0 rs1_t0 !-1 addi                   #     addi    t0, t0, -1
$scatter_piece jal                      #     j       scatter_piece
:scatter_done                           # scatter_done:
rd_a0 rs1_t1 addi                       #     mv      a0, t1
rs1_ra jalr                             #     ret

:fits                                   # fits:                                   # value a0 fits in a1 bits, signed, and is even; else an error (uses t0, t1)
rd_t0 !64 addi                          #     li      t0, 64
rd_t0 rs1_t0 rs2_a1 sub                 #     sub     t0, t0, a1
rd_t1 rs1_a0 rs2_t0 sll                 #     sll     t1, a0, t0
rd_t1 rs1_t1 rs2_t0 sra                 #     sra     t1, t1, t0
rs1_t1 rs2_a0 .00040000 beq $out_of_range jal #     bne     t1, a0, out_of_range
rd_t1 rs1_a0 !1 andi                    #     andi    t1, a0, 1
rs1_t1 .00040000 beq $out_of_range jal  #     bne     t1, zero, out_of_range
rs1_ra jalr                             #     ret

:check12                                # check12:                                # the immediate s7 fits in 12 bits, signed (uses t0, t1)
rd_t1 ~0x1000 lui rd_t1 rs1_t1 !-2048 addiw #     li      t1, 2048
rd_t0 rs1_s7 rs2_t1 add                 #     add     t0, s7, t1
rd_t1 ~0x1000 lui                       #     li      t1, 4096
rs1_t0 rs2_t1 .00040000 bltu $out_of_range jal #     bgeu    t0, t1, out_of_range
rs1_ra jalr                             #     ret

# The operands of an instruction.

:p_reg                                  # p_reg:                                  # a0 = the register at s1
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $blanks jal                       #     jal     ra, blanks
rd_ra $word jal                         #     jal     ra, word
rs1_a2 .00040000 bne $bad_operand jal   #     beq     a2, zero, bad_operand
rd_ra $pack jal                         #     jal     ra, pack
rd_t0 ~registers auipc rd_t0 rs1_t0 !registers addi #     la      t0, registers               # x0-x31, then their ABI names, then fp
rd_t1 addi                              #     li      t1, 0
:p_reg_next                             # p_reg_next:
rd_t2 !65 addi                          #     li      t2, 65
rs1_t1 rs2_t2 .00040000 bne $unknown_register jal #     beq     t1, t2, unknown_register
rd_t2 rs1_t0 ld                         #     ld      t2, 0(t0)
rs1_t2 rs2_a0 @p_reg_found beq          #     beq     t2, a0, p_reg_found
rd_t0 rs1_t0 !8 addi                    #     addi    t0, t0, 8
rd_t1 rs1_t1 !1 addi                    #     addi    t1, t1, 1
$p_reg_next jal                         #     j       p_reg_next
:p_reg_found                            # p_reg_found:
rd_a0 rs1_t1 addi                       #     mv      a0, t1
rd_t2 !32 addi                          #     li      t2, 32
rs1_a0 rs2_t2 @p_reg_done bltu          #     bltu    a0, t2, p_reg_done
rd_a0 rs1_a0 !-32 addi                  #     addi    a0, a0, -32
rs1_a0 rs2_t2 @p_reg_done bltu          #     bltu    a0, t2, p_reg_done
rd_a0 !8 addi                           #     li      a0, 8                       # fp: s0
:p_reg_done                             # p_reg_done:
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

:p_comma                                # p_comma:                                # a ',' (uses t0, t1, t3)
rd_t3 rs1_ra addi                       #     mv      t3, ra
rd_ra $blanks jal                       #     jal     ra, blanks
rd_ra rs1_t3 addi                       #     mv      ra, t3
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !44 addi                          #     li      t1, 0x2c
rs1_t0 rs2_t1 .00040000 beq $bad_syntax jal #     bne     t0, t1, bad_syntax
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rs1_ra jalr                             #     ret

:p_rr                                   # p_rr:                                   # rd, rs: s5, s6
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $p_reg jal                        #     jal     ra, p_reg
rd_s5 rs1_a0 addi                       #     mv      s5, a0
rd_ra $p_comma jal                      #     jal     ra, p_comma
rd_ra $p_reg jal                        #     jal     ra, p_reg
rd_s6 rs1_a0 addi                       #     mv      s6, a0
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

:p_rrr                                  # p_rrr:                                  # rd, rs1, rs2: s5, s6, s7
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $p_rr jal                         #     jal     ra, p_rr
rd_ra $p_comma jal                      #     jal     ra, p_comma
rd_ra $p_reg jal                        #     jal     ra, p_reg
rd_s7 rs1_a0 addi                       #     mv      s7, a0
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

:p_rri                                  # p_rri:                                  # rd, rs1, a number: s5, s6, s7
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $p_rr jal                         #     jal     ra, p_rr
rd_ra $p_comma jal                      #     jal     ra, p_comma
rd_ra $eval_number jal                  #     jal     ra, eval_number
rd_s7 rs1_a0 addi                       #     mv      s7, a0
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

:p_rm                                   # p_rm:                                   # reg, offset(base): s5, s7, s6
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $p_reg jal                        #     jal     ra, p_reg
rd_s5 rs1_a0 addi                       #     mv      s5, a0
rd_ra $p_comma jal                      #     jal     ra, p_comma
rd_ra $eval_number jal                  #     jal     ra, eval_number
rd_s7 rs1_a0 addi                       #     mv      s7, a0
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !40 addi                          #     li      t1, 0x28                    # '('
rs1_t0 rs2_t1 @bad_operand bne          #     bne     t0, t1, bad_operand
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_ra $p_reg jal                        #     jal     ra, p_reg
rd_s6 rs1_a0 addi                       #     mv      s6, a0
rd_ra $blanks jal                       #     jal     ra, blanks
rd_t0 rs1_s1 lbu                        #     lbu     t0, 0(s1)
rd_t1 !41 addi                          #     li      t1, 0x29                    # ')'
rs1_t0 rs2_t1 @bad_operand bne          #     bne     t0, t1, bad_operand
rd_s1 rs1_s1 !1 addi                    #     addi    s1, s1, 1
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

:p_target                               # p_target:                               # a0 = the definition of the label at s1 (name, nb or nf)
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_ra $blanks jal                       #     jal     ra, blanks
rd_ra $word jal                         #     jal     ra, word
rs1_a2 @bad_operand beq                 #     beq     a2, zero, bad_operand
rd_t0 rs1_a1 lbu                        #     lbu     t0, 0(a1)
rd_t0 rs1_t0 !-48 addi                  #     addi    t0, t0, -0x30               # a digit: a local label
rd_t1 !10 addi                          #     li      t1, 10
rs1_t0 rs2_t1 @p_target_local bltu      #     bltu    t0, t1, p_target_local
rd_ra $find_sym jal                     #     jal     ra, find_sym
rs1_a0 @p_target_sym bne                #     bne     a0, zero, p_target_sym
rd_ra $sym_new jal                      #     jal     ra, sym_new                 # not yet defined
:p_target_sym                           # p_target_sym:
rd_a0 rs1_a0 !16 addi                   #     addi    a0, a0, S_value
$p_target_done jal                      #     j       p_target_done
:p_target_local                         # p_target_local:
rd_t0 rs1_a1 rs2_a2 add                 #     add     t0, a1, a2
rd_t0 rs1_t0 !-1 lbu                    #     lbu     t0, -1(t0)
rd_t1 !98 addi                          #     li      t1, 0x62                    # 'b'
rs1_t0 rs2_t1 @p_target_nb beq          #     beq     t0, t1, p_target_nb
rd_t1 !102 addi                         #     li      t1, 0x66                    # 'f'
rs1_t0 rs2_t1 @bad_operand bne          #     bne     t0, t1, bad_operand
:p_target_nb                            # p_target_nb:
rd_a2 rs1_a2 !-1 addi                   #     addi    a2, a2, -1
rd_ra $digits jal                       #     jal     ra, digits
rd_a2 rs1_a2 !1 addi                    #     addi    a2, a2, 1
rs1_a3 @bad_operand bne                 #     bne     a3, zero, bad_operand
rd_ra $local_ref jal                    #     jal     ra, local_ref
:p_target_done                          # p_target_done:
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

# The instructions: the mnemonic's routine, with s3 its base bits and s4
# its other bits (from mnemonics). Each ends with end_line.

:insn                                   # insn:                                   # a1, a2: the mnemonic
rd_ra $pack jal                         #     jal     ra, pack
rd_t0 ~mnemonics auipc rd_t0 rs1_t0 !mnemonics addi #     la      t0, mnemonics
:insn_next                              # insn_next:
rd_t1 rs1_t0 ld                         #     ld      t1, 0(t0)
rs1_t1 @unknown_mnemonic beq            #     beq     t1, zero, unknown_mnemonic
rs1_t1 rs2_a0 @insn_found beq           #     beq     t1, a0, insn_found
rd_t0 rs1_t0 !24 addi                   #     addi    t0, t0, 24
$insn_next jal                          #     j       insn_next
:insn_found                             # insn_found:
rd_t1 rs1_t0 !8 lw                      #     lw      t1, 8(t0)                   # its routine, from mnemonics
rd_s3 rs1_t0 !12 lwu                    #     lwu     s3, 12(t0)
rd_s4 rs1_t0 !16 ld                     #     ld      s4, 16(t0)
rd_t2 ~mnemonics auipc rd_t2 rs1_t2 !mnemonics addi #     la      t2, mnemonics
rd_t1 rs1_t1 rs2_t2 add                 #     add     t1, t1, t2
rs1_t1 jalr                             #     jr      t1

:enc_r                                  # enc_r:                                  # emits R: s3, rd s5, rs1 s6, rs2 s7
rd_t0 rs1_s5 !7 slli                    #     slli    t0, s5, 7
rd_a0 rs1_s3 rs2_t0 or                  #     or      a0, s3, t0
rd_t0 rs1_s6 !15 slli                   #     slli    t0, s6, 15
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_t0 rs1_s7 !20 slli                   #     slli    t0, s7, 20
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
$emit32 jal                             #     j       emit32
:enc_i                                  # enc_i:                                  # emits I: s3, rd s5, rs1 s6, imm s7
rd_t0 rs1_s5 !7 slli                    #     slli    t0, s5, 7
rd_a0 rs1_s3 rs2_t0 or                  #     or      a0, s3, t0
rd_t0 rs1_s6 !15 slli                   #     slli    t0, s6, 15
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_t0 rs1_s7 !52 slli                   #     slli    t0, s7, 52                  # imm[11:0] to 31:20
rd_t0 rs1_t0 !32 srli                   #     srli    t0, t0, 32
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
$emit32 jal                             #     j       emit32
:enc_s                                  # enc_s:                                  # emits S: s3, rs1 s6, rs2 s5, imm s7
rd_t0 rs1_s6 !15 slli                   #     slli    t0, s6, 15
rd_a0 rs1_s3 rs2_t0 or                  #     or      a0, s3, t0
rd_t0 rs1_s5 !20 slli                   #     slli    t0, s5, 20
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_t0 rs1_s7 !31 andi                   #     andi    t0, s7, 0x1f                # imm[4:0] to 11:7
rd_t0 rs1_t0 !7 slli                    #     slli    t0, t0, 7
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_t0 rs1_s7 !5 srli                    #     srli    t0, s7, 5                   # imm[11:5] to 31:25
rd_t0 rs1_t0 !127 andi                  #     andi    t0, t0, 0x7f
rd_t0 rs1_t0 !25 slli                   #     slli    t0, t0, 25
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
$emit32 jal                             #     j       emit32

:plain_r                                # plain_r:                                # the instruction as it is: R
rd_ra $enc_r jal                        #     jal     ra, enc_r
$end_line jal                           #     j       end_line
:plain_i                                # plain_i:                                # I
rd_ra $enc_i jal                        #     jal     ra, enc_i
$end_line jal                           #     j       end_line
:plain_s                                # plain_s:                                # S
rd_ra $enc_s jal                        #     jal     ra, enc_s
$end_line jal                           #     j       end_line
:emit16_end                             # emit16_end:                             # a compressed one, a0
rd_ra $emit16 jal                       #     jal     ra, emit16
$end_line jal                           #     j       end_line
:cr_emit                                # cr_emit:                                # CR: a0 | rd s5 at 11:7 | rs2 t0 at 6:2
rd_t1 rs1_s5 !7 slli                    #     slli    t1, s5, 7
rd_a0 rs1_a0 rs2_t1 or                  #     or      a0, a0, t1
rd_t0 rs1_t0 !2 slli                    #     slli    t0, t0, 2
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
$emit16_end jal                         #     j       emit16_end
:ca_emit                                # ca_emit:                                # CA: a0 | rd' s5 at 9:7 | rs2' t0 (x8-x15 as 0-7) at 4:2
rd_t1 rs1_s5 !-8 addi                   #     addi    t1, s5, -8
rd_t1 rs1_t1 !7 slli                    #     slli    t1, t1, 7
rd_a0 rs1_a0 rs2_t1 or                  #     or      a0, a0, t1
rd_t0 rs1_t0 !2 slli                    #     slli    t0, t0, 2
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
$emit16_end jal                         #     j       emit16_end
:ci_emit                                # ci_emit:                                # CI: a0 | rd s5 at 11:7 | imm s7 (imm[5] at 12, imm[4:0] at 6:2)
rd_a3 rs1_a0 addi                       #     mv      a3, a0
rd_a0 rs1_s5 !7 slli                    #     slli    a0, s5, 7
rd_a3 rs1_a3 rs2_a0 or                  #     or      a3, a3, a0
$ci_imm jal                             #     j       ci_imm
:cbi_emit                               # cbi_emit:                               # CB with an imm: a0 | rd' s5 at 9:7 | imm s7 as CI's
rd_a3 rs1_a0 addi                       #     mv      a3, a0
rd_a0 rs1_s5 !-8 addi                   #     addi    a0, s5, -8
rd_a0 rs1_a0 !7 slli                    #     slli    a0, a0, 7
rd_a3 rs1_a3 rs2_a0 or                  #     or      a3, a3, a0
:ci_imm                                 # ci_imm:
rd_a0 rs1_s7 addi                       #     mv      a0, s7
rd_a1 ~k_ci auipc rd_a1 rs1_a1 !k_ci addi #     la      a1, k_ci
rd_ra $scatter jal                      #     jal     ra, scatter
rd_a0 rs1_a0 rs2_a3 or                  #     or      a0, a0, a3
$emit16_end jal                         #     j       emit16_end
:cl_emit                                # cl_emit:                                # CL, CS: a0 | t0 | base' s6 at 9:7 | reg' s5 at 4:2
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_t0 rs1_s6 !-8 addi                   #     addi    t0, s6, -8
rd_t0 rs1_t0 !7 slli                    #     slli    t0, t0, 7
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_t0 rs1_s5 !-8 addi                   #     addi    t0, s5, -8
rd_t0 rs1_t0 !2 slli                    #     slli    t0, t0, 2
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
$emit16_end jal                         #     j       emit16_end

:h_r                                    # h_r:                                    # sll srl sra slt sltu mul div divu rem remu: R
rd_ra $p_rrr jal                        #     jal     ra, p_rrr
$plain_r jal                            #     j       plain_r

:h_add                                  # h_add:                                  # add: c.add, c.mv, else R
rd_ra $p_rrr jal                        #     jal     ra, p_rrr
rs1_s5 @plain_r beq                     #     beq     s5, zero, plain_r           # each form wants rd and rs2 not x0
rs1_s6 rs2_s5 @h_add_2 bne              #     bne     s6, s5, h_add_2
rs1_s7 @h_add_2 beq                     #     beq     s7, zero, h_add_2
rd_t0 rs1_s7 addi                       #     mv      t0, s7                      # add rd, rd, rs: c.add rd, rs
rd_a0 ~0x9000 lui rd_a0 rs1_a0 !2 addiw #     li      a0, 0x9002
$cr_emit jal                            #     j       cr_emit
:h_add_2                                # h_add_2:
rs1_s7 rs2_s5 @h_add_3 bne              #     bne     s7, s5, h_add_3
rs1_s6 @h_add_3 beq                     #     beq     s6, zero, h_add_3
rd_t0 rs1_s6 addi                       #     mv      t0, s6                      # add rd, rs, rd: c.add rd, rs
rd_a0 ~0x9000 lui rd_a0 rs1_a0 !2 addiw #     li      a0, 0x9002
$cr_emit jal                            #     j       cr_emit
:h_add_3                                # h_add_3:
rs1_s6 @plain_r bne                     #     bne     s6, zero, plain_r
rs1_s7 @plain_r beq                     #     beq     s7, zero, plain_r
rd_t0 rs1_s7 addi                       #     mv      t0, s7                      # add rd, x0, rs: c.mv rd, rs
rd_a0 ~0x8000 lui rd_a0 rs1_a0 !2 addiw #     li      a0, 0x8002
$cr_emit jal                            #     j       cr_emit

:h_sub                                  # h_sub:                                  # sub: c.sub rd', rd', rs2', else R
rd_ra $p_rrr jal                        #     jal     ra, p_rrr
rd_t0 rs1_s5 !-8 addi                   #     addi    t0, s5, -8
rd_t1 !8 addi                           #     li      t1, 8
rs1_t0 rs2_t1 @plain_r bgeu             #     bgeu    t0, t1, plain_r
rs1_s6 rs2_s5 @plain_r bne              #     bne     s6, s5, plain_r
rd_t0 rs1_s7 !-8 addi                   #     addi    t0, s7, -8
rs1_t0 rs2_t1 @plain_r bgeu             #     bgeu    t0, t1, plain_r
rd_a0 ~0x9000 lui rd_a0 rs1_a0 !-1023 addiw #     li      a0, 0x8c01
$ca_emit jal                            #     j       ca_emit

:h_cand                                 # h_cand:                                 # and or xor: c.and c.or c.xor (s4) rd', rd', rs' or rd', rs', rd'; else R
rd_ra $p_rrr jal                        #     jal     ra, p_rrr
rd_t0 rs1_s5 !-8 addi                   #     addi    t0, s5, -8
rd_t1 !8 addi                           #     li      t1, 8
rs1_t0 rs2_t1 @plain_r bgeu             #     bgeu    t0, t1, plain_r
rs1_s6 rs2_s5 @h_cand_2 bne             #     bne     s6, s5, h_cand_2
rd_t0 rs1_s7 !-8 addi                   #     addi    t0, s7, -8
rs1_t0 rs2_t1 @h_cand_2 bgeu            #     bgeu    t0, t1, h_cand_2
rd_a0 rs1_s4 addi                       #     mv      a0, s4
$ca_emit jal                            #     j       ca_emit
:h_cand_2                               # h_cand_2:
rs1_s7 rs2_s5 @plain_r bne              #     bne     s7, s5, plain_r
rd_t0 rs1_s6 !-8 addi                   #     addi    t0, s6, -8
rs1_t0 rs2_t1 @plain_r bgeu             #     bgeu    t0, t1, plain_r
rd_a0 rs1_s4 addi                       #     mv      a0, s4
$ca_emit jal                            #     j       ca_emit

:h_addi                                 # h_addi:                                 # addi, gas's order: c.addi4spn c.addi c.nop c.addi16sp c.li c.mv, else I
rd_ra $p_rri jal                        #     jal     ra, p_rri
rd_ra $check12 jal                      #     jal     ra, check12
rd_t0 rs1_s5 !-8 addi                   #     addi    t0, s5, -8                  # c.addi4spn rd', sp, 4-1020 (4 n)
rd_t1 !8 addi                           #     li      t1, 8
rs1_t0 rs2_t1 @h_addi_2 bgeu            #     bgeu    t0, t1, h_addi_2
rd_t1 !2 addi                           #     li      t1, 2
rs1_s6 rs2_t1 @h_addi_2 bne             #     bne     s6, t1, h_addi_2
rs1_s7 @h_addi_2 beq                    #     beq     s7, zero, h_addi_2
rd_t0 rs1_s7 !3 andi                    #     andi    t0, s7, 3
rs1_t0 @h_addi_2 bne                    #     bne     t0, zero, h_addi_2
rd_t1 !1024 addi                        #     li      t1, 1024
rs1_s7 rs2_t1 @h_addi_2 bgeu            #     bgeu    s7, t1, h_addi_2
rd_a0 rs1_s7 addi                       #     mv      a0, s7
rd_a1 ~k_c4spn auipc rd_a1 rs1_a1 !k_c4spn addi #     la      a1, k_c4spn
rd_ra $scatter jal                      #     jal     ra, scatter
rd_t0 rs1_s5 !-8 addi                   #     addi    t0, s5, -8                  # 0x0000 | rd' at 4:2
rd_t0 rs1_t0 !2 slli                    #     slli    t0, t0, 2
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
$emit16_end jal                         #     j       emit16_end
:h_addi_2                               # h_addi_2:                               # c.addi rd, rd, -32..31 but 0, rd not x0
rs1_s5 rs2_s6 @h_addi_5 bne             #     bne     s5, s6, h_addi_5
rs1_s5 @h_addi_3 beq                    #     beq     s5, zero, h_addi_3
rs1_s7 @h_addi_4 beq                    #     beq     s7, zero, h_addi_4
rd_t0 rs1_s7 !32 addi                   #     addi    t0, s7, 32
rd_t1 !64 addi                          #     li      t1, 64
rs1_t0 rs2_t1 @h_addi_4 bgeu            #     bgeu    t0, t1, h_addi_4
rd_a0 !1 addi                           #     li      a0, 0x0001
$ci_emit jal                            #     j       ci_emit
:h_addi_3                               # h_addi_3:                               # c.nop: addi x0, x0, 0
rs1_s7 @h_addi_5 bne                    #     bne     s7, zero, h_addi_5
rd_a0 !1 addi                           #     li      a0, 0x0001
$emit16_end jal                         #     j       emit16_end
:h_addi_4                               # h_addi_4:                               # c.addi16sp sp, sp, -512..496 (16 n) but 0
rd_t1 !2 addi                           #     li      t1, 2
rs1_s5 rs2_t1 @h_addi_5 bne             #     bne     s5, t1, h_addi_5
rs1_s7 @h_addi_5 beq                    #     beq     s7, zero, h_addi_5
rd_t0 rs1_s7 !15 andi                   #     andi    t0, s7, 15
rs1_t0 @h_addi_5 bne                    #     bne     t0, zero, h_addi_5
rd_t0 rs1_s7 !512 addi                  #     addi    t0, s7, 512
rd_t1 !1024 addi                        #     li      t1, 1024
rs1_t0 rs2_t1 @h_addi_5 bgeu            #     bgeu    t0, t1, h_addi_5
rd_a0 rs1_s7 addi                       #     mv      a0, s7
rd_a1 ~k_c16sp auipc rd_a1 rs1_a1 !k_c16sp addi #     la      a1, k_c16sp
rd_ra $scatter jal                      #     jal     ra, scatter
rd_t0 ~0x6000 lui rd_t0 rs1_t0 !257 addiw #     li      t0, 0x6101                  # rd sp at 11:7
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
$emit16_end jal                         #     j       emit16_end
:h_addi_5                               # h_addi_5:                               # c.li rd, -32..31: addi rd, x0, imm
rs1_s6 @h_addi_6 bne                    #     bne     s6, zero, h_addi_6
rs1_s5 @plain_i beq                     #     beq     s5, zero, plain_i
rd_t0 rs1_s7 !32 addi                   #     addi    t0, s7, 32
rd_t1 !64 addi                          #     li      t1, 64
rs1_t0 rs2_t1 @plain_i bgeu             #     bgeu    t0, t1, plain_i
rd_a0 ~0x4000 lui rd_a0 rs1_a0 !1 addiw #     li      a0, 0x4001
$ci_emit jal                            #     j       ci_emit
:h_addi_6                               # h_addi_6:                               # c.mv rd, rs: addi rd, rs, 0
rs1_s7 @plain_i bne                     #     bne     s7, zero, plain_i
rs1_s5 @plain_i beq                     #     beq     s5, zero, plain_i
rd_t0 rs1_s6 addi                       #     mv      t0, s6
rd_a0 ~0x8000 lui rd_a0 rs1_a0 !2 addiw #     li      a0, 0x8002
$cr_emit jal                            #     j       cr_emit

:h_andi                                 # h_andi:                                 # andi: c.andi rd', rd', -32..31, else I
rd_ra $p_rri jal                        #     jal     ra, p_rri
rd_ra $check12 jal                      #     jal     ra, check12
rd_t0 rs1_s5 !-8 addi                   #     addi    t0, s5, -8
rd_t1 !8 addi                           #     li      t1, 8
rs1_t0 rs2_t1 @plain_i bgeu             #     bgeu    t0, t1, plain_i
rs1_s6 rs2_s5 @plain_i bne              #     bne     s6, s5, plain_i
rd_t0 rs1_s7 !32 addi                   #     addi    t0, s7, 32
rd_t1 !64 addi                          #     li      t1, 64
rs1_t0 rs2_t1 @plain_i bgeu             #     bgeu    t0, t1, plain_i
rd_a0 ~0x9000 lui rd_a0 rs1_a0 !-2047 addiw #     li      a0, 0x8801
