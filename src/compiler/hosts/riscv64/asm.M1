# The immediates' bit layouts, as the RISC-V manual draws the formats: the
# pieces, then each piece: the bit of the value it starts at, its bits,
# the bit of the instruction it goes to.
:k_b                                    # k_b:                                    # B: beq ...
040104080506190B01070C011F              #     .byte 4, 1, 4, 8, 5, 6, 25, 11, 1, 7, 12, 1, 31
:k_j                                    # k_j:                                    # J: jal
04010A150B01140C080C14011F              #     .byte 4, 1, 10, 21, 11, 1, 20, 12, 8, 12, 20, 1, 31
:k_cb                                   # k_cb:                                   # CB: c.beqz c.bnez
0501020303020A05010206020508010C        #     .byte 5, 1, 2, 3, 3, 2, 10, 5, 1, 2, 6, 2, 5, 8, 1, 12
:k_cj                                   # k_cj:                                   # CJ: c.j
0801030304010B050102060107070106        #     .byte 8, 1, 3, 3, 4, 1, 11, 5, 1, 2, 6, 1, 7, 7, 1, 6, 8, 2, 9, 10, 1, 8, 11, 1, 12
0802090A01080B010C
:k_ci                                   # k_ci:                                   # CI: c.addi c.li c.andi c.slli c.lui ...: imm[4:0] at 6:2, imm[5] at 12
0200050205010C                          #     .byte 2, 0, 5, 2, 5, 1, 12
:k_c16sp                                # k_c16sp:                                # c.addi16sp: nzimm[4|6|8:7|5] at 6:2, [9] at 12
0504010606010507020305010209010C        #     .byte 5, 4, 1, 6, 6, 1, 5, 7, 2, 3, 5, 1, 2, 9, 1, 12
:k_c4spn                                # k_c4spn:                                # c.addi4spn: nzuimm[5:4|9:6|2|3] at 12:5
0404020B060407020106030105              #     .byte 4, 4, 2, 11, 6, 4, 7, 2, 1, 6, 3, 1, 5
:k_cldsp                                # k_cldsp:                                # c.ldsp: uimm[5] at 12, [4:3|8:6] at 6:2
0305010C030205060302                    #     .byte 3, 5, 1, 12, 3, 2, 5, 6, 3, 2
:k_csdsp                                # k_csdsp:                                # c.sdsp: uimm[5:3|8:6] at 12:7
0203030A060307                          #     .byte 2, 3, 3, 10, 6, 3, 7
:k_cld                                  # k_cld:                                  # c.ld c.sd: uimm[5:3] at 12:10, [7:6] at 6:5
0203030A060205                          #     .byte 2, 3, 3, 10, 6, 2, 5

