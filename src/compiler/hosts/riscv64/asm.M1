$emit16_end jal                         #     j       emit16_end

:jump                                   # jump:                                   # a jump of kind s8 to definition s9: pass 1 records it and ends the line
rd_t0 rs1_s0 !8 ld                      #     ld      t0, V_emit(s0)
rs1_t0 @jump_emit bne                   #     bne     t0, zero, jump_emit
rd_a0 rs1_s0 !32 ld                     #     ld      a0, V_jump(s0)              # pass 1: a new jump
rd_t1 ~0x1890000 lui                    #     li      t1, JUMPS_END
rs1_a0 rs2_t1 @too_many_jumps bgeu      #     bgeu    a0, t1, too_many_jumps
rd_t1 rs1_s0 !264 ld                    #     ld      t1, V_frag(s0)
rs1_a0 rs2_t1 sd                        #     sd      t1, J_frag(a0)
rs1_a0 rs2_s9 @8 sd                     #     sd      s9, J_def(a0)
rs1_a0 rs2_s8 @16 sd                    #     sd      s8, J_kind(a0)
rs1_a0 @24 sd                           #     sd      zero, J_len(a0)
rd_t1 rs1_a0 !32 addi                   #     addi    t1, a0, 32
rs1_s0 rs2_t1 @32 sd                    #     sd      t1, V_jump(s0)
rd_ra $frag_break jal                   #     jal     ra, frag_break              # its frag ends with it
$end_line jal                           #     j       end_line
:jump_emit                              # jump_emit:                              # pass 2: s10 = its length, s11 = the target minus here
rd_t0 rs1_s0 !32 ld                     #     ld      t0, V_jump(s0)
rd_s10 rs1_t0 !24 ld                    #     ld      s10, J_len(t0)
rd_t0 rs1_t0 !32 addi                   #     addi    t0, t0, 32
rs1_s0 rs2_t0 @32 sd                    #     sd      t0, V_jump(s0)
rd_t0 rs1_s9 !8 ld                      #     ld      t0, 8(s9)                   # the target: in .text (relax checked it)
rd_t0 rs1_t0 !3 slli                    #     slli    t0, t0, 3
rd_t0 rs1_t0 rs2_s0 add                 #     add     t0, t0, s0
rd_t0 rs1_t0 !152 ld                    #     ld      t0, V_base(t0)
rd_s11 rs1_s9 ld                        #     ld      s11, 0(s9)
rd_s11 rs1_s11 rs2_t0 add               #     add     s11, s11, t0
rd_t2 rs1_ra addi                       #     mv      t2, ra
rd_ra $here jal                         #     jal     ra, here
rd_ra rs1_t2 addi                       #     mv      ra, t2
rd_s11 rs1_s11 rs2_a0 sub               #     sub     s11, s11, a0
rs1_ra jalr                             #     ret

:h_jr                                   # h_jr:                                   # jr rs: c.jr (rs not x0), else jalr x0, 0(rs)
