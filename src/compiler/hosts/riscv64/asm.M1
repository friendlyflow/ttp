rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_t0 rs1_s6 !15 slli                   #     slli    t0, s6, 15
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
