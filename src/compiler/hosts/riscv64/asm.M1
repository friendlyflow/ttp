rd_s7 !-1 addi                          #     li      s7, -1
$plain_i jal                            #     j       plain_i

:h_seqz                                 # h_seqz:                                 # seqz rd, rs: sltiu rd, rs, 1
rd_ra $p_rr jal                         #     jal     ra, p_rr
rd_s7 !1 addi                           #     li      s7, 1
$plain_i jal                            #     j       plain_i

:h_li                                   # h_li:                                   # li rd, n: as gas's opcode table, then its load_const
rd_ra $p_reg jal                        #     jal     ra, p_reg
rd_s5 rs1_a0 addi                       #     mv      s5, a0
rd_ra $p_comma jal                      #     jal     ra, p_comma
rd_ra $eval_number jal                  #     jal     ra, eval_number
rd_s7 rs1_a0 addi                       #     mv      s7, a0
rd_s6 addi                              #     li      s6, 0
rd_t0 rs1_s7 !52 slli                   #     slli    t0, s7, 52                  # c.lui rd, n >> 12: n a multiple of 4096,
rs1_t0 @h_li_2 bne                      #     bne     t0, zero, h_li_2            # 32 bits signed
rd_t0 rs1_s7 addiw                      #     addiw   t0, s7, 0
rs1_t0 rs2_s7 @h_li_2 bne               #     bne     t0, s7, h_li_2
rd_a0 rs1_s7 !32 slli                   #     slli    a0, s7, 32
rd_a0 rs1_a0 !44 srli                   #     srli    a0, a0, 44                  # (n as 32 bits unsigned) >> 12
rd_ra $clui jal                         #     jal     ra, clui
rs1_a0 .00040000 bne $end_line jal      #     beq     a0, zero, end_line
:h_li_2                                 # h_li_2:                                 # c.li rd, -32..31 (rd not x0)
rs1_s5 @h_li_3 beq                      #     beq     s5, zero, h_li_3
rd_t0 rs1_s7 !32 addi                   #     addi    t0, s7, 32
rd_t1 !64 addi                          #     li      t1, 64
rs1_t0 rs2_t1 @h_li_3 bgeu              #     bgeu    t0, t1, h_li_3
rd_a0 ~0x4000 lui rd_a0 rs1_a0 !1 addiw #     li      a0, 0x4001
$ci_emit jal                            #     j       ci_emit
:h_li_3                                 # h_li_3:                                 # addi rd, x0, -2048..2047
rd_t1 ~0x1000 lui rd_t1 rs1_t1 !-2048 addiw #     li      t1, 2048
rd_t0 rs1_s7 rs2_t1 add                 #     add     t0, s7, t1
rd_t1 ~0x1000 lui                       #     li      t1, 4096
rs1_t0 rs2_t1 @h_li_4 bgeu              #     bgeu    t0, t1, h_li_4
rd_s3 !19 addi                          #     li      s3, 0x13
$plain_i jal                            #     j       plain_i
:h_li_4                                 # h_li_4:                                 # lui rd, upper; addiw rd, rd, lower (if not 0)
rd_t0 rs1_s7 addiw                      #     addiw   t0, s7, 0                   # 32 bits signed only
rs1_t0 rs2_s7 @out_of_range bne         #     bne     t0, s7, out_of_range
rd_s8 rs1_s7 !52 slli                   #     slli    s8, s7, 52                  # lower: n's low 12 bits, signed
rd_s8 rs1_s8 !52 srai                   #     srai    s8, s8, 52
rd_a0 rs1_s7 rs2_s8 sub                 #     sub     a0, s7, s8                  # upper: the rest, as 32 bits unsigned >> 12
rd_a0 rs1_a0 !32 slli                   #     slli    a0, a0, 32
rd_a0 rs1_a0 !44 srli                   #     srli    a0, a0, 44
rd_s9 rs1_a0 addi                       #     mv      s9, a0
rd_ra $clui jal                         #     jal     ra, clui
rs1_a0 @h_li_lower beq                  #     beq     a0, zero, h_li_lower        # c.lui, else lui:
rd_a0 rs1_s9 !12 slli                   #     slli    a0, s9, 12
rd_a0 rs1_a0 !55 ori                    #     ori     a0, a0, 0x37
rd_t0 rs1_s5 !7 slli                    #     slli    t0, s5, 7
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_ra $emit32 jal                       #     jal     ra, emit32
:h_li_lower                             # h_li_lower:                             # (rd x0: gas's addiw anyway, its hi_reg 0)
rs1_s8 @h_li_addi bne                   #     bne     s8, zero, h_li_addi
rs1_s5 .00040000 beq $end_line jal      #     bne     s5, zero, end_line
:h_li_addi                              # h_li_addi:
rd_s7 rs1_s8 addi                       #     mv      s7, s8
rs1_s5 @h_li_addiw beq                  #     beq     s5, zero, h_li_addiw        # c.addiw rd, -32..31 (rd not x0)
rd_t0 rs1_s7 !32 addi                   #     addi    t0, s7, 32
rd_t1 !64 addi                          #     li      t1, 64
rs1_t0 rs2_t1 @h_li_addiw bgeu          #     bgeu    t0, t1, h_li_addiw
rd_a0 ~0x2000 lui rd_a0 rs1_a0 !1 addiw #     li      a0, 0x2001
$ci_emit jal                            #     j       ci_emit
:h_li_addiw                             # h_li_addiw:
rd_s3 !27 addi                          #     li      s3, 0x1b                    # addiw rd, rd, lower
rd_s6 rs1_s5 addi                       #     mv      s6, s5
$plain_i jal                            #     j       plain_i

:clui                                   # clui:                                   # emits c.lui rd s5, a0 if gas would (a0 1-31 or 0xfffe0-0xfffff, rd not x0 or sp); a0 = 0 if it did, else 1
rs1_s5 @clui_no beq                     #     beq     s5, zero, clui_no
rd_t0 !2 addi                           #     li      t0, 2
rs1_s5 rs2_t0 @clui_no beq              #     beq     s5, t0, clui_no
rs1_a0 @clui_no beq                     #     beq     a0, zero, clui_no
rd_t0 !32 addi                          #     li      t0, 0x20
rs1_a0 rs2_t0 @clui_yes bltu            #     bltu    a0, t0, clui_yes
rd_t0 ~0x100000 lui rd_t0 rs1_t0 !-32 addiw #     li      t0, 0xfffe0
rs1_a0 rs2_t0 @clui_no bltu             #     bltu    a0, t0, clui_no
rd_t0 ~0x100000 lui                     #     li      t0, 0x100000
rs1_a0 rs2_t0 @clui_no bgeu             #     bgeu    a0, t0, clui_no
:clui_yes                               # clui_yes:
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_a1 ~k_ci auipc rd_a1 rs1_a1 !k_ci addi #     la      a1, k_ci
rd_ra $scatter jal                      #     jal     ra, scatter
rd_t0 ~0x6000 lui rd_t0 rs1_t0 !1 addiw #     li      t0, 0x6001
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_t0 rs1_s5 !7 slli                    #     slli    t0, s5, 7
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_ra $emit16 jal                       #     jal     ra, emit16
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rd_a0 addi                              #     li      a0, 0
rs1_ra jalr                             #     ret
:clui_no                                # clui_no:
rd_a0 !1 addi                           #     li      a0, 1
rs1_ra jalr                             #     ret

:h_la                                   # h_la:                                   # la rd, label: auipc rd; addi rd, rd (a frag ends after the auipc)
rd_ra $p_reg jal                        #     jal     ra, p_reg
rd_s5 rs1_a0 addi                       #     mv      s5, a0
rd_ra $p_comma jal                      #     jal     ra, p_comma
rd_ra $eval jal                         #     jal     ra, eval
rd_s7 rs1_a0 addi                       #     mv      s7, a0
rd_t0 rs1_s0 !8 ld                      #     ld      t0, V_emit(s0)
rs1_t0 @h_la_emit bne                   #     bne     t0, zero, h_la_emit
rd_a0 addi                              #     li      a0, 0                       # pass 1: its 8 bytes
rd_ra $emit32 jal                       #     jal     ra, emit32
rd_a0 addi                              #     li      a0, 0
rd_ra $frag_break jal                   #     jal     ra, frag_break
rd_a0 addi                              #     li      a0, 0
rd_ra $emit32 jal                       #     jal     ra, emit32
$end_line jal                           #     j       end_line
:h_la_emit                              # h_la_emit:
rs1_a1 @bad_operand beq                 #     beq     a1, zero, bad_operand       # a label
rd_ra $hi_lo jal                        #     jal     ra, hi_lo                   # s9 auipc's, s10 the addi's
rd_a0 !23 addi                          #     li      a0, 0x17
rd_a0 rs1_a0 rs2_s9 or                  #     or      a0, a0, s9
rd_t0 rs1_s5 !7 slli                    #     slli    t0, s5, 7
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_ra $emit32 jal                       #     jal     ra, emit32
rd_a0 !19 addi                          #     li      a0, 0x13
rd_a0 rs1_a0 rs2_s10 or                 #     or      a0, a0, s10
rd_t0 rs1_s5 !7 slli                    #     slli    t0, s5, 7
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_t0 rs1_s5 !15 slli                   #     slli    t0, s5, 15
rd_a0 rs1_a0 rs2_t0 or                  #     or      a0, a0, t0
rd_ra $emit32 jal                       #     jal     ra, emit32
$end_line jal                           #     j       end_line

:h_call                                 # h_call:                                 # call label: auipc ra; jalr ra, ra (a frag ends after it)
rd_ra $eval jal                         #     jal     ra, eval
rd_s7 rs1_a0 addi                       #     mv      s7, a0
rd_t0 rs1_s0 !8 ld                      #     ld      t0, V_emit(s0)
rs1_t0 @h_call_emit bne                 #     bne     t0, zero, h_call_emit
rd_a0 addi                              #     li      a0, 0                       # pass 1: its 8 bytes
rd_ra $emit32 jal                       #     jal     ra, emit32
rd_a0 addi                              #     li      a0, 0
rd_ra $emit32 jal                       #     jal     ra, emit32
rd_a0 addi                              #     li      a0, 0
rd_ra $frag_break jal                   #     jal     ra, frag_break
$end_line jal                           #     j       end_line
:h_call_emit                            # h_call_emit:
rs1_a1 @bad_operand beq                 #     beq     a1, zero, bad_operand
rd_ra $hi_lo jal                        #     jal     ra, hi_lo
rd_a0 !151 addi                         #     li      a0, 0x97                    # auipc ra
rd_a0 rs1_a0 rs2_s9 or                  #     or      a0, a0, s9
rd_ra $emit32 jal                       #     jal     ra, emit32
rd_a0 ~0x8000 lui rd_a0 rs1_a0 !231 addiw #     li      a0, 0x80e7                  # jalr ra, lo(ra)
rd_a0 rs1_a0 rs2_s10 or                 #     or      a0, a0, s10
rd_ra $emit32 jal                       #     jal     ra, emit32
$end_line jal                           #     j       end_line

:hi_lo                                  # hi_lo:                                  # target s7 minus here: s9 = auipc's bits 31:12, s10 = the low 12 at 31:20 (uses t0-t2)
rd_t2 rs1_ra addi                       #     mv      t2, ra
rd_ra $here jal                         #     jal     ra, here
rd_ra rs1_t2 addi                       #     mv      ra, t2
rd_t0 rs1_s7 rs2_a0 sub                 #     sub     t0, s7, a0                  # d
rd_t1 ~0x1000 lui rd_t1 rs1_t1 !-2048 addiw #     li      t1, 0x800                   # d + 0x800: fits in 32 bits, signed
rd_t1 rs1_t0 rs2_t1 add                 #     add     t1, t0, t1
rd_a0 rs1_t1 addiw                      #     addiw   a0, t1, 0
rs1_a0 rs2_t1 @out_of_range bne         #     bne     a0, t1, out_of_range
rd_s9 rs1_t1 !12 srli                   #     srli    s9, t1, 12                  # its bits 31:12
rd_s9 rs1_s9 !44 slli                   #     slli    s9, s9, 44
rd_s9 rs1_s9 !32 srli                   #     srli    s9, s9, 32
rd_s10 rs1_t0 !52 slli                  #     slli    s10, t0, 52                 # d's bits 11:0 to 31:20
rd_s10 rs1_s10 !32 srli                 #     srli    s10, s10, 32
rs1_ra jalr                             #     ret

# Relaxing, as gas's relax_segment does it for .text (riscv's
# relaxed_branch_length): each round first gives every frag the address
# after those before it, a jump the length its target's address then
# says (a frag after it at its address of the last round, 0 in the
# first), then passes over the frags, each moving by what the jumps
# before it grew in this pass and its jump getting the length the
# addresses say, until a pass changes no length; rounds until no frag
# moves. A length: c.beqz, c.bnez and c.j 2 when the target is within
# -256..255 (c.j -2048..2047) bytes of the jump; else 4 when it is
# within -4096..4095 (a branch; j always), the compressed one as beq,
# bne or jal; else 6, c.bnez or c.beqz over a jal, or 8, the other
# branch over a jal. Then the text labels get their offsets in .text.

:relax                                  # relax:
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_a0 ~0x1690000 lui                    #     li      a0, JUMPS                   # every target defined, in .text
rd_a1 rs1_s0 !32 ld                     #     ld      a1, V_jump(s0)
:relax_check                            # relax_check:
rs1_a0 rs2_a1 @relax_round bgeu         #     bgeu    a0, a1, relax_round
rd_t0 rs1_a0 !8 ld                      #     ld      t0, J_def(a0)
rd_t1 rs1_t0 !16 ld                     #     ld      t1, 16(t0)
rs1_t1 @undefined_target beq            #     beq     t1, zero, undefined_target
rd_t1 rs1_t0 !8 ld                      #     ld      t1, 8(t0)
rd_t2 !1 addi                           #     li      t2, 1
rs1_t1 rs2_t2 @bad_target bne           #     bne     t1, t2, bad_target
rd_a0 rs1_a0 !32 addi                   #     addi    a0, a0, 32
$relax_check jal                        #     j       relax_check
:relax_round                            # relax_round:
rd_a0 ~0x1890000 lui                    #     li      a0, FRAGS
rd_a1 rs1_s0 !264 ld                    #     ld      a1, V_frag(s0)              # the last frag
rd_a2 addi                              #     li      a2, 0                       # the address
:relax_guess                            # relax_guess:
rs1_a0 rs2_a2 sd                        #     sd      a2, F_addr(a0)
rd_t0 rs1_a0 !16 ld                     #     ld      t0, F_fix(a0)
rd_a2 rs1_a2 rs2_t0 add                 #     add     a2, a2, t0
rd_a3 rs1_a0 !24 ld                     #     ld      a3, F_jump(a0)
rs1_a3 @relax_guess_next beq            #     beq     a3, zero, relax_guess_next
rd_ra $jlen jal                         #     jal     ra, jlen                    # a4
rs1_a3 rs2_a4 @24 sd                    #     sd      a4, J_len(a3)
rd_a2 rs1_a2 rs2_a4 add                 #     add     a2, a2, a4
:relax_guess_next                       # relax_guess_next:
rd_a0 rs1_a0 !32 addi                   #     addi    a0, a0, 32
rs1_a1 rs2_a0 @relax_guess bgeu         #     bgeu    a1, a0, relax_guess
:relax_pass                             # relax_pass:
rd_a5 addi                              #     li      a5, 0                       # the growth so far
rd_a6 addi                              #     li      a6, 0                       # 1 if a length changed
rd_a0 ~0x1890000 lui                    #     li      a0, FRAGS
:relax_frag                             # relax_frag:
rd_t0 rs1_a0 ld                         #     ld      t0, F_addr(a0)
rd_t0 rs1_t0 rs2_a5 add                 #     add     t0, t0, a5
rs1_a0 rs2_t0 sd                        #     sd      t0, F_addr(a0)
rd_a3 rs1_a0 !24 ld                     #     ld      a3, F_jump(a0)
rs1_a3 @relax_frag_next beq             #     beq     a3, zero, relax_frag_next
rd_ra $jlen jal                         #     jal     ra, jlen
rd_t0 rs1_a3 !24 ld                     #     ld      t0, J_len(a3)
rd_t1 rs1_a4 rs2_t0 sub                 #     sub     t1, a4, t0
rs1_t1 @relax_frag_next beq             #     beq     t1, zero, relax_frag_next
rs1_a3 rs2_a4 @24 sd                    #     sd      a4, J_len(a3)
rd_a5 rs1_a5 rs2_t1 add                 #     add     a5, a5, t1
rd_a6 !1 addi                           #     li      a6, 1
:relax_frag_next                        # relax_frag_next:
rd_a0 rs1_a0 !32 addi                   #     addi    a0, a0, 32
rs1_a1 rs2_a0 @relax_frag bgeu          #     bgeu    a1, a0, relax_frag
rs1_a6 @relax_pass bne                  #     bne     a6, zero, relax_pass
rd_a0 ~0x1890000 lui                    #     li      a0, FRAGS                   # did a frag move since the last round?
rd_a6 addi                              #     li      a6, 0
:relax_moved                            # relax_moved:
rd_t0 rs1_a0 ld                         #     ld      t0, F_addr(a0)
rd_t1 rs1_a0 !8 ld                      #     ld      t1, F_last(a0)
rs1_t0 rs2_t1 @relax_moved_next beq     #     beq     t0, t1, relax_moved_next
rs1_a0 rs2_t0 @8 sd                     #     sd      t0, F_last(a0)
rd_a6 !1 addi                           #     li      a6, 1
:relax_moved_next                       # relax_moved_next:
rd_a0 rs1_a0 !32 addi                   #     addi    a0, a0, 32
rs1_a1 rs2_a0 @relax_moved bgeu         #     bgeu    a1, a0, relax_moved
rs1_a6 @relax_round bne                 #     bne     a6, zero, relax_round
rd_t0 rs1_a1 ld                         #     ld      t0, F_addr(a1)              # .text's size: the end of the last frag
rd_t1 rs1_a1 !16 ld                     #     ld      t1, F_fix(a1)
rd_t0 rs1_t0 rs2_t1 add                 #     add     t0, t0, t1
rs1_s0 rs2_t0 @80 sd                    #     sd      t0, V_loc+8(s0)
rs1_s0 rs2_t0 @288 sd                   #     sd      t0, V_tsize(s0)
rd_a0 ~0x710000 lui rd_a0 rs1_a0 !16 addiw #     li      a0, SYMS + S_value          # the text labels: frag + offset
rd_a1 rs1_s0 !40 ld                     #     ld      a1, V_nsym(s0)
:relax_syms                             # relax_syms:
rs1_a0 rs2_a1 @relax_locals bgeu        #     bgeu    a0, a1, relax_locals
rd_ra $place_def jal                    #     jal     ra, place_def
rd_a0 rs1_a0 !48 addi                   #     addi    a0, a0, SYM_size
$relax_syms jal                         #     j       relax_syms
:relax_locals                           # relax_locals:
rd_a2 addi                              #     li      a2, 0                       # local label n
:relax_local                            # relax_local:
rd_t0 rs1_a2 !3 slli                    #     slli    t0, a2, 3                   # its definitions
rd_t0 rs1_t0 rs2_s0 add                 #     add     t0, t0, s0
rd_a3 rs1_t0 !400 ld                    #     ld      a3, COUNTS(t0)
rd_t0 ~0x20000 lui                      #     li      t0, LOCAL_max * 32
rd_a0 rs1_a2 rs2_t0 mul                 #     mul     a0, a2, t0
rd_t0 ~0xa10000 lui                     #     li      t0, LOCALS
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
:relax_local_def                        # relax_local_def:
rs1_a3 @relax_local_next beq            #     beq     a3, zero, relax_local_next
rd_ra $place_def jal                    #     jal     ra, place_def
rd_a0 rs1_a0 !32 addi                   #     addi    a0, a0, 32
rd_a3 rs1_a3 !-1 addi                   #     addi    a3, a3, -1
$relax_local_def jal                    #     j       relax_local_def
:relax_local_next                       # relax_local_next:
rd_a2 rs1_a2 !1 addi                    #     addi    a2, a2, 1
rd_t0 !100 addi                         #     li      t0, 100
rs1_a2 rs2_t0 @relax_local bne          #     bne     a2, t0, relax_local
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

:place_def                              # place_def:                              # definition a0 of a text label: its offset in .text (uses t0, t1)
rd_t0 rs1_a0 !8 ld                      #     ld      t0, 8(a0)
rd_t1 !1 addi                           #     li      t1, 1
rs1_t0 rs2_t1 @place_def_done bne       #     bne     t0, t1, place_def_done
rd_t0 rs1_a0 !16 ld                     #     ld      t0, 16(a0)
rs1_t0 @place_def_done beq              #     beq     t0, zero, place_def_done
rd_t0 rs1_a0 !24 ld                     #     ld      t0, 24(a0)                  # its frag's address, plus its offset in it
rs1_t0 @place_def_done beq              #     beq     t0, zero, place_def_done    # (none: an .equ)
rd_t0 rs1_t0 ld                         #     ld      t0, F_addr(t0)
rd_t1 rs1_a0 ld                         #     ld      t1, 0(a0)
rd_t1 rs1_t1 rs2_t0 add                 #     add     t1, t1, t0
rs1_a0 rs2_t1 sd                        #     sd      t1, 0(a0)
:place_def_done                         # place_def_done:
rs1_ra jalr                             #     ret

:jlen                                   # jlen:                                   # a4 = the length of jump a3 at the frags' addresses now (uses t0-t5)
rd_t0 rs1_a3 !8 ld                      #     ld      t0, J_def(a3)               # the target's address
rd_t1 rs1_t0 !24 ld                     #     ld      t1, 24(t0)
rd_t1 rs1_t1 ld                         #     ld      t1, F_addr(t1)
rd_t2 rs1_t0 ld                         #     ld      t2, 0(t0)
rd_t1 rs1_t1 rs2_t2 add                 #     add     t1, t1, t2
rd_t0 rs1_a3 ld                         #     ld      t0, J_frag(a3)              # minus the jump's
rd_t2 rs1_t0 ld                         #     ld      t2, F_addr(t0)
rd_t3 rs1_t0 !16 ld                     #     ld      t3, F_fix(t0)
rd_t2 rs1_t2 rs2_t3 add                 #     add     t2, t2, t3
rd_t1 rs1_t1 rs2_t2 sub                 #     sub     t1, t1, t2
rd_t3 rs1_a3 !16 ld                     #     ld      t3, J_kind(a3)
rd_t4 rs1_t3 !1 andi                    #     andi    t4, t3, 1                   # j: 4, a branch: 8, unless near
rd_a4 !8 addi                           #     li      a4, 8
rs1_t4 @jlen_c beq                      #     beq     t4, zero, jlen_c
rd_a4 !4 addi                           #     li      a4, 4
:jlen_c                                 # jlen_c:
rd_t5 rs1_t3 !2 andi                    #     andi    t5, t3, 2                   # compressed: 2 within half its reach
rs1_t5 @jlen_4 beq                      #     beq     t5, zero, jlen_4
rd_t5 !256 addi                         #     li      t5, 256
rs1_t4 @jlen_c_reach beq                #     beq     t4, zero, jlen_c_reach
rd_t5 ~0x1000 lui rd_t5 rs1_t5 !-2048 addiw #     li      t5, 2048
:jlen_c_reach                           # jlen_c_reach:
rd_t2 rs1_t1 rs2_t5 add                 #     add     t2, t1, t5
rd_t5 rs1_t5 !1 slli                    #     slli    t5, t5, 1
rs1_t2 rs2_t5 @jlen_4 bgeu              #     bgeu    t2, t5, jlen_4
rd_a4 !2 addi                           #     li      a4, 2
rs1_ra jalr                             #     ret
:jlen_4                                 # jlen_4:                                 # within a branch's reach: 4
rd_t5 ~0x1000 lui                       #     li      t5, 4096
rd_t2 rs1_t1 rs2_t5 add                 #     add     t2, t1, t5
rd_t5 ~0x2000 lui                       #     li      t5, 8192
rs1_t2 rs2_t5 @jlen_6 bgeu              #     bgeu    t2, t5, jlen_6
rd_a4 !4 addi                           #     li      a4, 4
rs1_ra jalr                             #     ret
:jlen_6                                 # jlen_6:                                 # beyond: c.b over a jal 6; j stays 4
rs1_t4 @jlen_done bne                   #     bne     t4, zero, jlen_done
rd_t5 rs1_t3 !2 andi                    #     andi    t5, t3, 2
rs1_t5 @jlen_done beq                   #     beq     t5, zero, jlen_done
rd_a4 !6 addi                           #     li      a4, 6
:jlen_done                              # jlen_done:
rs1_ra jalr                             #     ret

# The file, as ld lays it out.

:layout                                 # layout:                                 # every section's file offset and address, as ld places them
rd_t6 rs1_ra addi                       #     mv      t6, ra
rd_a0 !176 addi                         #     li      a0, 0xb0                    # after the ELF header and two program headers
rd_a1 !1 addi                           #     li      a1, 1
rd_ra $place jal                        #     jal     ra, place                   # .text
rd_a1 !2 addi                           #     li      a1, 2
rd_ra $place jal                        #     jal     ra, place                   # .rodata: the end of the code segment
rs1_s0 rs2_a0 @256 sd                   #     sd      a0, V_tend(s0)
rd_t0 ~0x10000 lui                      #     li      t0, ADDR                    # its address v
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
rd_a3 rs1_a0 addi                       #     mv      a3, a0
rd_t0 ~0x1000 lui rd_t0 rs1_t0 !-1 addiw #     li      t0, 0xfff
rd_a4 rs1_a0 rs2_t0 and                 #     and     a4, a0, t0
rd_a1 ~0x1000 lui                       #     li      a1, 0x1000
rd_ra $alignup jal                      #     jal     ra, alignup
rd_a0 rs1_a0 rs2_a4 add                 #     add     a0, a0, a4                  # the data segment from the next page on: v2
rd_a5 rs1_a0 rs2_a3 sub                 #     sub     a5, a0, a3                  # v2 - v: its addresses after its file offsets
rd_a1 rs1_s0 !136 ld                    #     ld      a1, V_align+24(s0)
rd_ra $alignup jal                      #     jal     ra, alignup
rs1_s0 rs2_a0 @176 sd                   #     sd      a0, V_base+24(s0)           # .data
rd_t0 ~0x10000 lui                      #     li      t0, ADDR
rd_t1 rs1_a0 rs2_t0 sub                 #     sub     t1, a0, t0
rd_t1 rs1_t1 rs2_a5 sub                 #     sub     t1, t1, a5
rs1_s0 rs2_t1 @216 sd                   #     sd      t1, V_off+24(s0)
rd_t0 rs1_s0 !96 ld                     #     ld      t0, V_loc+24(s0)
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
rd_a1 rs1_s0 !144 ld                    #     ld      a1, V_align+32(s0)
rd_ra $alignup jal                      #     jal     ra, alignup
rs1_s0 rs2_a0 @184 sd                   #     sd      a0, V_base+32(s0)           # .bss
rd_a0 rs1_s0 !216 ld                    #     ld      a0, V_off+24(s0)            # its file offset, and .shstrtab's: the end
rd_t0 rs1_s0 !96 ld                     #     ld      t0, V_loc+24(s0)            # of .data (ld's, though .bss be aligned)
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
rs1_s0 rs2_a0 @224 sd                   #     sd      a0, V_off+32(s0)
rs1_s0 rs2_a0 @232 sd                   #     sd      a0, V_shstr(s0)
rd_a0 rs1_a0 !36 addi                   #     addi    a0, a0, SHSTRTAB_len        # then the section headers
rd_a1 !8 addi                           #     li      a1, 8
rd_ra $alignup jal                      #     jal     ra, alignup
rs1_s0 rs2_a0 @240 sd                   #     sd      a0, V_shoff(s0)
rd_a0 rs1_a0 !384 addi                  #     addi    a0, a0, 6 * 64
rs1_s0 rs2_a0 @248 sd                   #     sd      a0, V_fend(s0)
rd_t0 ~0x1000000 lui                    #     li      t0, OUTBUF_END - OUTBUF
rs1_t0 rs2_a0 @output_full bltu         #     bltu    t0, a0, output_full
rd_ra rs1_t6 addi                       #     mv      ra, t6
rs1_ra jalr                             #     ret

:place                                  # place:                                  # section a1 from file offset a0, aligned; a0 = its end (uses a1, a2, t0)
rd_a2 rs1_a1 !3 slli                    #     slli    a2, a1, 3
rd_a2 rs1_a2 rs2_s0 add                 #     add     a2, a2, s0
rd_a1 rs1_a2 !112 ld                    #     ld      a1, V_align(a2)
rd_t0 rs1_ra addi                       #     mv      t0, ra
rd_ra $alignup jal                      #     jal     ra, alignup
rd_ra rs1_t0 addi                       #     mv      ra, t0
rs1_a2 rs2_a0 @192 sd                   #     sd      a0, V_off(a2)
rd_t0 ~0x10000 lui                      #     li      t0, ADDR
rd_t0 rs1_t0 rs2_a0 add                 #     add     t0, t0, a0
rs1_a2 rs2_t0 @152 sd                   #     sd      t0, V_base(a2)
rd_t0 rs1_a2 !72 ld                     #     ld      t0, V_loc(a2)
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
rs1_ra jalr                             #     ret

:alignup                                # alignup:                                # a0 up to a multiple of a1, a power of 2 (uses a1)
rd_a1 rs1_a1 !-1 addi                   #     addi    a1, a1, -1
rd_a0 rs1_a0 rs2_a1 add                 #     add     a0, a0, a1
rd_a1 rs1_a1 !-1 xori                   #     not     a1, a1
rd_a0 rs1_a0 rs2_a1 and                 #     and     a0, a0, a1
rs1_ra jalr                             #     ret

:headers                                # headers:                                # the ELF header, the program headers, .shstrtab, the section headers
rd_sp rs1_sp !-16 addi                  #     addi    sp, sp, -16
rs1_sp rs2_ra sd                        #     sd      ra, 0(sp)
rd_t0 rs1_s0 !80 ld                     #     ld      t0, V_loc+8(s0)             # pass 2 wrote what relax said
rd_t1 rs1_s0 !288 ld                    #     ld      t1, V_tsize(s0)
rs1_t0 rs2_t1 @unstable bne             #     bne     t0, t1, unstable
rd_t0 rs1_s0 !80 addi                   #     addi    t0, s0, V_loc+8             # each section has bytes
rd_t1 rs1_s0 !112 addi                  #     addi    t1, s0, V_loc+40
:headers_bytes                          # headers_bytes:
rd_t2 rs1_t0 ld                         #     ld      t2, 0(t0)
rs1_t2 @empty_section beq               #     beq     t2, zero, empty_section
rd_t0 rs1_t0 !8 addi                    #     addi    t0, t0, 8
rs1_t0 rs2_t1 @headers_bytes bne        #     bne     t0, t1, headers_bytes
rd_a0 rs1_s0 !104 ld                    #     ld      a0, V_loc+32(s0)            # ld's script ends .bss at a multiple of 8
rd_a1 !8 addi                           #     li      a1, 8
rd_ra $alignup jal                      #     jal     ra, alignup
rs1_s0 rs2_a0 @104 sd                   #     sd      a0, V_loc+32(s0)
rd_a0 ~0x2c90000 lui                    #     li      a0, OUTBUF
rd_a1 ~elf_headers auipc rd_a1 rs1_a1 !elf_headers addi #     la      a1, elf_headers
rd_a2 !176 addi                         #     li      a2, 0xb0
rd_ra $copy jal                         #     jal     ra, copy
rd_a1 ~str_start auipc rd_a1 rs1_a1 !str_start addi #     la      a1, str_start               # e_entry: _start
rd_a2 !6 addi                           #     li      a2, 6
rd_ra $find_sym jal                     #     jal     ra, find_sym
rs1_a0 @no_start beq                    #     beq     a0, zero, no_start
rd_t0 rs1_a0 !32 ld                     #     ld      t0, S_pass(a0)
rs1_t0 @no_start beq                    #     beq     t0, zero, no_start
rd_t0 rs1_a0 !24 ld                     #     ld      t0, S_kind(a0)
rd_t0 rs1_t0 !3 slli                    #     slli    t0, t0, 3
rd_t0 rs1_t0 rs2_s0 add                 #     add     t0, t0, s0
rd_t0 rs1_t0 !152 ld                    #     ld      t0, V_base(t0)
rd_t1 rs1_a0 !16 ld                     #     ld      t1, S_value(a0)
rd_t1 rs1_t1 rs2_t0 add                 #     add     t1, t1, t0
rd_a0 ~0x2c90000 lui                    #     li      a0, OUTBUF
rs1_a0 rs2_t1 @24 sd                    #     sd      t1, 24(a0)
rd_t0 rs1_s0 !240 ld                    #     ld      t0, V_shoff(s0)             # e_shoff
rs1_a0 rs2_t0 @40 sd                    #     sd      t0, 40(a0)
rd_t0 rs1_s0 !256 ld                    #     ld      t0, V_tend(s0)              # the code: p_filesz, p_memsz
rs1_a0 rs2_t0 @96 sd                    #     sd      t0, 96(a0)
rs1_a0 rs2_t0 @104 sd                   #     sd      t0, 104(a0)
rd_t0 rs1_s0 !216 ld                    #     ld      t0, V_off+24(s0)            # the data: p_offset
rs1_a0 rs2_t0 @128 sd                   #     sd      t0, 128(a0)
rd_t0 rs1_s0 !176 ld                    #     ld      t0, V_base+24(s0)           # p_vaddr, p_paddr
rs1_a0 rs2_t0 @136 sd                   #     sd      t0, 136(a0)
rs1_a0 rs2_t0 @144 sd                   #     sd      t0, 144(a0)
rd_t0 rs1_s0 !96 ld                     #     ld      t0, V_loc+24(s0)            # p_filesz: .data
rs1_a0 rs2_t0 @152 sd                   #     sd      t0, 152(a0)
rd_t0 rs1_s0 !184 ld                    #     ld      t0, V_base+32(s0)           # p_memsz: to the end of .bss
rd_t1 rs1_s0 !104 ld                    #     ld      t1, V_loc+32(s0)
rd_t0 rs1_t0 rs2_t1 add                 #     add     t0, t0, t1
rd_t1 rs1_s0 !176 ld                    #     ld      t1, V_base+24(s0)
rd_t0 rs1_t0 rs2_t1 sub                 #     sub     t0, t0, t1
rs1_a0 rs2_t0 @160 sd                   #     sd      t0, 160(a0)
rd_a0 rs1_s0 !232 ld                    #     ld      a0, V_shstr(s0)             # .shstrtab
rd_t0 ~0x2c90000 lui                    #     li      t0, OUTBUF
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
rd_a1 ~shstrtab auipc rd_a1 rs1_a1 !shstrtab addi #     la      a1, shstrtab
rd_a2 !36 addi                          #     li      a2, SHSTRTAB_len
rd_ra $copy jal                         #     jal     ra, copy
rd_a0 rs1_s0 !240 ld                    #     ld      a0, V_shoff(s0)             # the section headers
rd_t0 ~0x2c90000 lui                    #     li      t0, OUTBUF
rd_a0 rs1_a0 rs2_t0 add                 #     add     a0, a0, t0
rd_a3 rs1_a0 addi                       #     mv      a3, a0
rd_a1 ~section_headers auipc rd_a1 rs1_a1 !section_headers addi #     la      a1, section_headers
rd_a2 !384 addi                         #     li      a2, 6 * 64
rd_ra $copy jal                         #     jal     ra, copy
rd_a1 !1 addi                           #     li      a1, 1
:headers_section                        # headers_section:                        # 1-4: .text .rodata .data .bss
rd_a3 rs1_a3 !64 addi                   #     addi    a3, a3, 64
rd_a2 rs1_a1 !3 slli                    #     slli    a2, a1, 3
rd_a2 rs1_a2 rs2_s0 add                 #     add     a2, a2, s0
rd_t0 rs1_a2 !152 ld                    #     ld      t0, V_base(a2)              # sh_addr
rs1_a3 rs2_t0 @16 sd                    #     sd      t0, 16(a3)
rd_t0 rs1_a2 !192 ld                    #     ld      t0, V_off(a2)               # sh_offset
rs1_a3 rs2_t0 @24 sd                    #     sd      t0, 24(a3)
rd_t0 rs1_a2 !72 ld                     #     ld      t0, V_loc(a2)               # sh_size
rs1_a3 rs2_t0 @32 sd                    #     sd      t0, 32(a3)
rd_t0 rs1_a2 !112 ld                    #     ld      t0, V_align(a2)             # sh_addralign
rs1_a3 rs2_t0 @48 sd                    #     sd      t0, 48(a3)
rd_a1 rs1_a1 !1 addi                    #     addi    a1, a1, 1
rd_t0 !5 addi                           #     li      t0, 5
rs1_a1 rs2_t0 @headers_section bne      #     bne     a1, t0, headers_section
rd_t0 rs1_s0 !232 ld                    #     ld      t0, V_shstr(s0)             # 5: .shstrtab's sh_offset
rs1_a3 rs2_t0 @88 sd                    #     sd      t0, 88(a3)
rd_ra rs1_sp ld                         #     ld      ra, 0(sp)
rd_sp rs1_sp !16 addi                   #     addi    sp, sp, 16
rs1_ra jalr                             #     ret

:copy                                   # copy:                                   # a2 bytes from a1 to a0 (uses a0-a2, t0)
rs1_a2 @copy_done beq                   #     beq     a2, zero, copy_done
rd_t0 rs1_a1 lbu                        #     lbu     t0, 0(a1)
rs1_a0 rs2_t0 sb                        #     sb      t0, 0(a0)
rd_a0 rs1_a0 !1 addi                    #     addi    a0, a0, 1
rd_a1 rs1_a1 !1 addi                    #     addi    a1, a1, 1
rd_a2 rs1_a2 !-1 addi                   #     addi    a2, a2, -1
$copy jal                               #     j       copy
:copy_done                              # copy_done:
rs1_ra jalr                             #     ret

# The errors: asm: line N: what: the line.

:junk                                   # junk:
rd_a0 ~msg_junk auipc rd_a0 rs1_a0 !msg_junk addi #     la      a0, msg_junk
$fail jal                               #     j       fail
:twice                                  # twice:
rd_a0 ~msg_twice auipc rd_a0 rs1_a0 !msg_twice addi #     la      a0, msg_twice
$fail jal                               #     j       fail
:too_many_symbols                       # too_many_symbols:
rd_a0 ~msg_symbols auipc rd_a0 rs1_a0 !msg_symbols addi #     la      a0, msg_symbols
$fail jal                               #     j       fail
:too_many_jumps                         # too_many_jumps:
rd_a0 ~msg_jumps auipc rd_a0 rs1_a0 !msg_jumps addi #     la      a0, msg_jumps
$fail jal                               #     j       fail
:bad_local                              # bad_local:
rd_a0 ~msg_local auipc rd_a0 rs1_a0 !msg_local addi #     la      a0, msg_local
$fail jal                               #     j       fail
:not_number                             # not_number:
rd_a0 ~msg_not_number auipc rd_a0 rs1_a0 !msg_not_number addi #     la      a0, msg_not_number
$fail jal                               #     j       fail
:bad_number                             # bad_number:
rd_a0 ~msg_number auipc rd_a0 rs1_a0 !msg_number addi #     la      a0, msg_number
$fail jal                               #     j       fail
:bad_expr                               # bad_expr:
rd_a0 ~msg_expr auipc rd_a0 rs1_a0 !msg_expr addi #     la      a0, msg_expr
$fail jal                               #     j       fail
:not_defined                            # not_defined:
rd_a0 ~msg_undefined auipc rd_a0 rs1_a0 !msg_undefined addi #     la      a0, msg_undefined
$fail jal                               #     j       fail
:bad_syntax                             # bad_syntax:
rd_a0 ~msg_syntax auipc rd_a0 rs1_a0 !msg_syntax addi #     la      a0, msg_syntax
$fail jal                               #     j       fail
:bad_align                              # bad_align:
rd_a0 ~msg_align auipc rd_a0 rs1_a0 !msg_align addi #     la      a0, msg_align
$fail jal                               #     j       fail
:bad_string                             # bad_string:
rd_a0 ~msg_string auipc rd_a0 rs1_a0 !msg_string addi #     la      a0, msg_string
$fail jal                               #     j       fail
:unknown_mnemonic                       # unknown_mnemonic:
rd_a0 ~msg_mnemonic auipc rd_a0 rs1_a0 !msg_mnemonic addi #     la      a0, msg_mnemonic
$fail jal                               #     j       fail
:unknown_register                       # unknown_register:
rd_a0 ~msg_register auipc rd_a0 rs1_a0 !msg_register addi #     la      a0, msg_register
$fail jal                               #     j       fail
:bad_operand                            # bad_operand:
rd_a0 ~msg_operand auipc rd_a0 rs1_a0 !msg_operand addi #     la      a0, msg_operand
$fail jal                               #     j       fail
:out_of_range                           # out_of_range:
rd_a0 ~msg_range auipc rd_a0 rs1_a0 !msg_range addi #     la      a0, msg_range
$fail jal                               #     j       fail
:in_bss                                 # in_bss:
rd_a0 ~msg_bss auipc rd_a0 rs1_a0 !msg_bss addi #     la      a0, msg_bss
:fail                                   # fail:                                   # message a0 (a C string) about the line
rd_s8 rs1_a0 addi                       #     mv      s8, a0
rd_a1 ~msg_line auipc rd_a1 rs1_a1 !msg_line addi #     la      a1, msg_line
rd_ra $eputs jal                        #     jal     ra, eputs
rd_a0 rs1_s0 !24 ld                     #     ld      a0, V_line(s0)
rd_ra $eputn jal                        #     jal     ra, eputn
rd_a1 ~msg_colon auipc rd_a1 rs1_a1 !msg_colon addi #     la      a1, msg_colon
rd_ra $eputs jal                        #     jal     ra, eputs
rd_a1 rs1_s8 addi                       #     mv      a1, s8
rd_ra $eputs jal                        #     jal     ra, eputs
rd_a1 ~msg_colon auipc rd_a1 rs1_a1 !msg_colon addi #     la      a1, msg_colon
rd_ra $eputs jal                        #     jal     ra, eputs
rd_a1 rs1_s0 !64 ld                     #     ld      a1, V_lstart(s0)            # the line, to its newline
rd_a2 rs1_a1 addi                       #     mv      a2, a1
:fail_line                              # fail_line:
rs1_a2 rs2_s2 @fail_line_end bgeu       #     bgeu    a2, s2, fail_line_end
rd_t0 rs1_a2 lbu                        #     lbu     t0, 0(a2)
rd_t1 !10 addi                          #     li      t1, 0x0a
rs1_t0 rs2_t1 @fail_line_end beq        #     beq     t0, t1, fail_line_end
rd_a2 rs1_a2 !1 addi                    #     addi    a2, a2, 1
$fail_line jal                          #     j       fail_line
:fail_line_end                          # fail_line_end:
rd_a2 rs1_a2 rs2_a1 sub                 #     sub     a2, a2, a1
rd_ra $ewrite jal                       #     jal     ra, ewrite
rd_a1 ~msg_newline auipc rd_a1 rs1_a1 !msg_newline addi #     la      a1, msg_newline
rd_ra $eputs jal                        #     jal     ra, eputs
rd_a0 !1 addi                           #     li      a0, 1
$exit jal                               #     j       exit
:undefined_target                       # undefined_target:
rd_a0 ~msg_undefined auipc rd_a0 rs1_a0 !msg_undefined addi #     la      a0, msg_undefined
$die jal                                #     j       die
:bad_target                             # bad_target:
rd_a0 ~msg_target auipc rd_a0 rs1_a0 !msg_target addi #     la      a0, msg_target
$die jal                                #     j       die
:unstable                               # unstable:
rd_a0 ~msg_unstable auipc rd_a0 rs1_a0 !msg_unstable addi #     la      a0, msg_unstable
$die jal                                #     j       die
:output_full                            # output_full:
rd_a0 ~msg_full auipc rd_a0 rs1_a0 !msg_full addi #     la      a0, msg_full
$die jal                                #     j       die
:empty_section                          # empty_section:
rd_a0 ~msg_empty auipc rd_a0 rs1_a0 !msg_empty addi #     la      a0, msg_empty
$die jal                                #     j       die
:no_start                               # no_start:
rd_a0 ~msg_start auipc rd_a0 rs1_a0 !msg_start addi #     la      a0, msg_start
$die jal                                #     j       die
:too_large                              # too_large:
rd_a0 ~msg_large auipc rd_a0 rs1_a0 !msg_large addi #     la      a0, msg_large
$die jal                                #     j       die
:read_failed                            # read_failed:
rd_a0 ~msg_read auipc rd_a0 rs1_a0 !msg_read addi #     la      a0, msg_read
$die jal                                #     j       die
:write_failed                           # write_failed:
rd_a0 ~msg_write auipc rd_a0 rs1_a0 !msg_write addi #     la      a0, msg_write
:die                                    # die:                                    # asm: message a0
rd_s8 rs1_a0 addi                       #     mv      s8, a0
rd_a1 ~msg_asm auipc rd_a1 rs1_a1 !msg_asm addi #     la      a1, msg_asm
rd_ra $eputs jal                        #     jal     ra, eputs
rd_a1 rs1_s8 addi                       #     mv      a1, s8
rd_ra $eputs jal                        #     jal     ra, eputs
rd_a1 ~msg_newline auipc rd_a1 rs1_a1 !msg_newline addi #     la      a1, msg_newline
rd_ra $eputs jal                        #     jal     ra, eputs
rd_a0 !1 addi                           #     li      a0, 1                       # status 1
:exit                                   # exit:
rd_a7 !93 addi                          #     li      a7, SYS_exit
ecall                                   #     ecall

:eputs                                  # eputs:                                  # writes the C string a1 to stderr
rd_a2 rs1_a1 addi                       #     mv      a2, a1
:eputs_len                              # eputs_len:
rd_t0 rs1_a2 lbu                        #     lbu     t0, 0(a2)
rs1_t0 @eputs_end beq                   #     beq     t0, zero, eputs_end
rd_a2 rs1_a2 !1 addi                    #     addi    a2, a2, 1
$eputs_len jal                          #     j       eputs_len
:eputs_end                              # eputs_end:
rd_a2 rs1_a2 rs2_a1 sub                 #     sub     a2, a2, a1
:ewrite                                 # ewrite:                                 # writes a1, a2 to stderr
rd_a7 !64 addi                          #     li      a7, SYS_write
rd_a0 !2 addi                           #     li      a0, 2                       # fd 2, stderr
ecall                                   #     ecall
rs1_ra jalr                             #     ret

:eputn                                  # eputn:                                  # writes a0 in decimal to stderr
rd_a1 rs1_s0 !1224 addi                 #     addi    a1, s0, NUMBUF + 24         # the last digit first, from the end
rd_a2 rs1_a1 addi                       #     mv      a2, a1
rd_t1 !10 addi                          #     li      t1, 10
:eputn_digit                            # eputn_digit:
rd_t0 rs1_a0 rs2_t1 remu                #     remu    t0, a0, t1
rd_t0 rs1_t0 !48 addi                   #     addi    t0, t0, 0x30
rd_a1 rs1_a1 !-1 addi                   #     addi    a1, a1, -1
rs1_a1 rs2_t0 sb                        #     sb      t0, 0(a1)
rd_a0 rs1_a0 rs2_t1 divu                #     divu    a0, a0, t1
rs1_a0 @eputn_digit bne                 #     bne     a0, zero, eputn_digit
rd_a2 rs1_a2 rs2_a1 sub                 #     sub     a2, a2, a1
$ewrite jal                             #     j       ewrite

