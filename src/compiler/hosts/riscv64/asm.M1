rd_s7 rs1_s6 addi                       #     mv      s7, s6
rd_s6 addi                              #     li      s6, 0
$plain_r jal                            #     j       plain_r

:h_snez                                 # h_snez:                                 # snez rd, rs: sltu rd, x0, rs
