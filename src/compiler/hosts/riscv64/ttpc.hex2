# parse_node: reads the node at s0 into a new NODE, recursing on its
# children, and leaves s0 just past it. Returns the NODE in a0.
:parse_node                             # parse_node:
0111                                    #     addi    sp, sp, -32
06E0                                    #     sd      ra, 0(sp)
52E4                                    #     sd      s4, 8(sp)                   # this NODE
56E8                                    #     sd      s5, 16(sp)                  # next slot in its children array
5AEC                                    #     sd      s6, 24(sp)                  # children left to parse

93021402                                #     addi    t0, s0, 33                  # hash + children_len
@truncated 63E05400                     #     bgtu    t0, s1, truncated
4A8A                                    #     mv      s4, s2
13090904                                #     addi    s2, s2, NODE_size

13030002                                #     li      t1, 32                      # copy the hash
D283                                    #     mv      t2, s4
:parse_node.1 034E0400                  # 1:  lbu     t3, 0(s0)
2380C301                                #     sb      t3, NODE_hash(t2)
0504                                    #     addi    s0, s0, 1
8503                                    #     addi    t2, t2, 1
7D13                                    #     addi    t1, t1, -1
@parse_node.1 63100300                  #     bnez    t1, 1b

034B0400                                #     lbu     s6, 0(s0)
0504                                    #     addi    s0, s0, 1
23006A03                                #     sb      s6, NODE_children_len(s4)
CE8A                                    #     mv      s5, s3
23345A03                                #     sd      s5, NODE_children(s4)
93123B00                                #     slli    t0, s6, 3
9699                                    #     add     s3, s3, t0
:parse_node.2 @parse_node.3 63000B00    # 2:  beqz    s6, 3f
~parse_node 97000000 !parse_node E7800000 #     call    parse_node
23B0AA00                                #     sd      a0, 0(s5)
A10A                                    #     addi    s5, s5, 8
7D1B                                    #     addi    s6, s6, -1
*parse_node.2 01A0                      #     j       2b

:parse_node.3 @truncated 63709400       # 3:  bgeu    s0, s1, truncated
83420400                                #     lbu     t0, 0(s0)
0504                                    #     addi    s0, s0, 1
23085A02                                #     sb      t0, NODE_content_len(s4)
233C8A02                                #     sd      s0, NODE_content(s4)
1694                                    #     add     s0, s0, t0
@truncated 63E08400                     #     bgtu    s0, s1, truncated

5285                                    #     mv      a0, s4
8260                                    #     ld      ra, 0(sp)
226A                                    #     ld      s4, 8(sp)
C26A                                    #     ld      s5, 16(sp)
626B                                    #     ld      s6, 24(sp)
0561                                    #     addi    sp, sp, 32
8280                                    #     ret

