#
# hosts/riscv64/ttpc.s as hex2 text, made by gen/mkhex.pl from GNU as's and ld's output:
# the whole executable in the order of its bytes. :label defines a label
# at the address of the next byte; &label is label's address in 4 bytes
# (abs32, the low half of a .dword). The code's references XOR their
# field into the instruction after them, which is written with that
# field zero; d is label minus the instruction's address: ~label
# auipc's U (d + 0x800, its bits 31:12), !label the I of the addi, ld
# or jalr after the auipc (d + 4, from the auipc, its bits 11:0), @label
# a branch's B, $label jal's J, |label c.beqz's and c.bnez's CB, *label
# c.j's CJ;
# ^address sets the address of the next byte (where the file and the
# addresses part: the data segment, the labels of the bss). Every other
# pair of hex digits is a byte; '#' and ';' start a comment to the end of
# the line. A reference that is not to a label alone (label+8, or with
# an immediate after it) is written out. Each line is followed by the asm
# line of hosts/riscv64/ttpc.s it comes from; hex2 reads only what is before the '#'.
#
^00010000                               # the first byte of the file is at this address
#
# The ELF header
7F454C46020101000000000000000000        # e_ident: the magic 7f "ELF", ELFCLASS64, little endian, EV_CURRENT, System V, padding
0200                                    # e_type = 0x2: ET_EXEC, an executable
F300                                    # e_machine = 0xf3: EM_RISCV
01000000                                # e_version = 0x1: EV_CURRENT
B000010000000000                        # e_entry = 0x100b0: the address of _start
4000000000000000                        # e_phoff = 0x40: the program headers follow
1018000000000000                        # e_shoff = 0x1810: the section headers, at the end
01000000                                # e_flags = 0x1: EF_RISCV_RVC, compressed instructions; the soft-float ABI
4000                                    # e_ehsize = 0x40: this header
3800                                    # e_phentsize = 0x38: a program header
0200                                    # e_phnum = 0x2: program headers
4000                                    # e_shentsize = 0x40: a section header
0600                                    # e_shnum = 0x6: section headers
0500                                    # e_shstrndx = 0x5: the section of the section names
#
# Program header 0
01000000                                # p_type = 0x1: 1: PT_LOAD
05000000                                # p_flags = 0x5: 4 R, 2 W, 1 X
0000000000000000                        # p_offset = 0x0: from this file offset
0000010000000000                        # p_vaddr = 0x10000: to this address
0000010000000000                        # p_paddr = 0x10000: the same
8916000000000000                        # p_filesz = 0x1689: bytes of the file
8916000000000000                        # p_memsz = 0x1689: bytes of memory, the rest zero
0010000000000000                        # p_align = 0x1000: a page
#
# Program header 1
01000000                                # p_type = 0x1: 1: PT_LOAD
06000000                                # p_flags = 0x6: 4 R, 2 W, 1 X
9016000000000000                        # p_offset = 0x1690: from this file offset
9026010000000000                        # p_vaddr = 0x12690: to this address
9026010000000000                        # p_paddr = 0x12690: the same
5801000000000000                        # p_filesz = 0x158: bytes of the file
7004450000000000                        # p_memsz = 0x450470: bytes of memory, the rest zero
0010000000000000                        # p_align = 0x1000: a page
#
# The section .text, from here its lines of hosts/riscv64/ttpc.s
# ttpc.s — the trust project compiler, in RISC-V assembly, without libc.
#
# FROZEN: this is stage0, the seed of the bootstrap (see PLAN.md). ttpc's
# source is ttpc.ff now; this file only has to assemble it, and stays
# as it is so that the chain starts from something small and auditable.
#
# A static Linux riscv64 program (run it with qemu-riscv64 on another host).
# It talks to the kernel only through ecall: it opens the ff file named by
# its first argument and loads it into memory as a tree of NODEs.
#
#   ttpc <file.ff>          prints the tree, one node per line
#   ttpc <file.ff> <out>    assembles it into the static executable <out>
#
# Assembling: a node whose content ends in ':' is a function, its leading
# children that are leaves are its parameters. Any other node is a call, its
# children are the arguments. The root's children are pages. The functions
# on every page but the last are definitions: instructions, macros,
# constants. The last page is the program: its functions are placed, they
# are labels whose children are emitted where they stand (nested ones are
# local labels, found innermost scope first), and its calls are emitted in
# order. Pass 1 finds every label's address, pass 2 emits.
#
# A function whose body (the children after its parameters) holds only
# fields, fixed fields (funct3:, ...) and slice calls (imm[11:0] imm), is an
# encoding: an instruction or a data word of 8 to 64 bits. A call runs in
# one of three contexts:
#
#   code   a call of an encoding is encoded and emitted, a call of any
#          other function expands its body in code context.
#   field  encoding: the fields, MSB first. A fixed field is its bits; a
#          slice call runs in exec context and leaves its value in a0, its
#          width is in its name.
#   exec   runs at assemble time on vregs. The ops of exec_ops are built
#          in, the seed; everything else is defined by the tree.
#
# An argument with children is a call, run in exec context: its value is
# a0. A leaf argument is a decimal or 0x number, a parameter, a register
# (its number in code context, its vreg in exec context), pc, a label (its
# address) or a constant (a function without parameters, run in exec
# context). The builtins: ascii, align, reserve, origin, bss (see
# code_call) and size (see exec_call).
#
# Registers are the functions "x10 a0:", their number is their child "01010".
# The output file is exactly what the program emits: its ELF header is ff
# too (elf_header in macros.ff.txt).
#
# ff on disk, one node, depth-first (children inline, before the content):
#   hash          byte[32]
#   children_len  u8
#   children      node × children_len
#   content_len   u8
#   content       byte × content_len    // no NUL termination: may be binary
#
# NODE in memory (64 bytes, naturally aligned):
#   0   hash          byte[32]
#   32  children_len  int8
#   40  children      NODE**            // -> pointer array in ptrs
#   48  content_len   int8
#   56  content       char*             // -> into buf, not copied

#     .equ SYS_openat, 56
#     .equ SYS_close, 57
#     .equ SYS_read, 63
#     .equ SYS_write, 64
#     .equ SYS_exit, 93

#     .equ AT_FDCWD, -100
#     .equ O_RDONLY, 0
#     .equ O_CREAT_WRONLY_TRUNC, 01 | 0100 | 01000
#     .equ MODE_0755, 0755
#     .equ STDOUT, 1
#     .equ STDERR, 2

#     .equ CH_space, 32
#     .equ CH_minus, 45
#     .equ CH_zero, 48
#     .equ CH_colon, 58
#     .equ CH_lbracket, 91
#     .equ CH_rbracket, 93
#     .equ CH_bar, 124
#     .equ CH_a, 97
#     .equ CH_x, 120

    # A frame binds the parameters of a call: count, then (param NODE*,
    # value) pairs.
#     .equ MAX_PARAMS, 8
#     .equ FRAME_count, 0
#     .equ FRAME_params, 8
#     .equ FRAME_size, 8 + MAX_PARAMS * 16

#     .equ VREG_a0, 10
#     .equ OUT_SIZE, 1 << 16
#     .equ MAX_DEPTH, 64                  # nesting of placed functions

    # A label: a placed function, its address and the address after it.
#     .equ LABEL_node, 0
#     .equ LABEL_addr, 8
#     .equ LABEL_end, 16
#     .equ LABEL_size, 24

    # An exec op: its name, NUL-padded, and its code.
#     .equ OP_name, 0
#     .equ OP_code, 8
#     .equ OP_size, 16

#     .equ NODE_hash, 0
#     .equ NODE_children_len, 32
#     .equ NODE_children, 40
#     .equ NODE_content_len, 48
#     .equ NODE_content, 56
#     .equ NODE_size, 64

#     .equ BUF_SIZE, 1 << 20
    # Every node takes at least 34 bytes on disk, so a full buf holds fewer
    # than MAX_NODES nodes: the node and pointer arenas cannot overflow.
#     .equ MAX_NODES, BUF_SIZE / 32

#     .section .text
#     .globl _start
:_start                                 # _start:
8262                                    #     ld      t0, 0(sp)                   # argc
0943                                    #     li      t1, 2
@usage 63C06200                         #     blt     t0, t1, usage
0D43                                    #     li      t1, 3
@usage 63405300                         #     bgt     t0, t1, usage
@_start.1 63C06200                      #     blt     t0, t1, 1f
6263                                    #     ld      t1, 24(sp)                  # argv[2]
~out_path 97030000 !out_path 93830300   #     la      t2, out_path
23B06300                                #     sd      t1, 0(t2)
:_start.1 C265                          # 1:  ld      a1, 16(sp)                  # argv[1]

1305C0F9                                #     li      a0, AT_FDCWD
0146                                    #     li      a2, O_RDONLY
8146                                    #     li      a3, 0
93088003                                #     li      a7, SYS_openat
73000000                                #     ecall
@open_failed 63400500                   #     bltz    a0, open_failed
2A8A                                    #     mv      s4, a0                      # fd

    # Read the whole file into buf.
~buf 17040000 !buf 13040400             #     la      s0, buf
A284                                    #     mv      s1, s0
B7021000                                #     li      t0, BUF_SIZE
B30A5400                                #     add     s5, s0, t0                  # end of buf
:read_loop                              # read_loop:
@too_large 63805401                     #     beq     s1, s5, too_large
5285                                    #     mv      a0, s4
A685                                    #     mv      a1, s1
33869A40                                #     sub     a2, s5, s1
9308F003                                #     li      a7, SYS_read
73000000                                #     ecall
@read_failed 63400500                   #     bltz    a0, read_failed
|read_done 01C1                         #     beqz    a0, read_done
AA94                                    #     add     s1, s1, a0
*read_loop 01A0                         #     j       read_loop
:read_done                              # read_done:
5285                                    #     mv      a0, s4
93089003                                #     li      a7, SYS_close
73000000                                #     ecall

~nodes 17090000 !nodes 13090900         #     la      s2, nodes
~ptrs 97090000 !ptrs 93890900           #     la      s3, ptrs
~parse_node 97000000 !parse_node E7800000 #     call    parse_node
@trailing 63109400                      #     bne     s0, s1, trailing
~out_path 97020000 !out_path 93820200   #     la      t0, out_path
83B20200                                #     ld      t0, 0(t0)
@assemble 63900200                      #     bnez    t0, assemble
8145                                    #     li      a1, 0
~print_node 97000000 !print_node E7800000 #     call    print_node

0145                                    #     li      a0, 0
$exit 6F000000                          #     j       exit

# assemble: places the last page of root a0, the program, twice: pass 1
# finds the address of every label, pass 2 emits with them. Then writes
# the output file.
:assemble                               # assemble:
2A8B                                    #     mv      s6, a0                      # root
~collect_syms 97000000 !collect_syms E7800000 #     call    collect_syms
83420B02                                #     lbu     t0, NODE_children_len(s6)
@assemble.2 63800200                    #     beqz    t0, 2f
03338B02                                #     ld      t1, NODE_children(s6)
8E02                                    #     slli    t0, t0, 3
1693                                    #     add     t1, t1, t0
833B83FF                                #     ld      s7, -8(t1)                  # the program page
054C                                    #     li      s8, 1                       # pass
:assemble.1 ~pass 97020000 !pass 93820200 # 1:  la      t0, pass
23B08201                                #     sd      s8, 0(t0)
~cur_pc 97020000 !cur_pc 93820200       #     la      t0, cur_pc
23B00200                                #     sd      zero, 0(t0)
~in_bss 97020000 !in_bss 93820200       #     la      t0, in_bss
23B00200                                #     sd      zero, 0(t0)
~out_end 97020000 !out_end 93820200     #     la      t0, out_end
~outbuf 17030000 !outbuf 13030300       #     la      t1, outbuf
23B06200                                #     sd      t1, 0(t0)
~label_next 97020000 !label_next 93820200 #     la      t0, label_next
~labels 17030000 !labels 13030300       #     la      t1, labels
23B06200                                #     sd      t1, 0(t0)
~scopes 97020000 !scopes 93820200       #     la      t0, scopes                  # the page is the outermost scope
23B07201                                #     sd      s7, 0(t0)
~scope_depth 97020000 !scope_depth 93820200 #     la      t0, scope_depth
0543                                    #     li      t1, 1
23B06200                                #     sd      t1, 0(t0)
5E85                                    #     mv      a0, s7
~run_placed 97000000 !run_placed E7800000 #     call    run_placed
050C                                    #     addi    s8, s8, 1
8D42                                    #     li      t0, 3
@assemble.1 63105C00                    #     bne     s8, t0, 1b
:assemble.2 ~write_output 97000000 !write_output E7800000 # 2:  call    write_output
0145                                    #     li      a0, 0
$exit 6F000000                          #     j       exit

