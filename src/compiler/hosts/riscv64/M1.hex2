9302C007                                #     li      t0, 0x7c
@copy 63005500                          #     beq     a0, t0, copy
9302A002                                #     li      t0, 0x2a
@copy 63005500                          #     beq     a0, t0, copy
93026002                                #     li      t0, 0x26
@copy 63005500                          #     beq     a0, t0, copy
9302E005                                #     li      t0, 0x5e
@copy 63005500                          #     beq     a0, t0, copy
9302E002                                #     li      t0, 0x2e
@copy 63005500                          #     beq     a0, t0, copy
$find EF000000                          #     jal     ra, find                    # a macro: its value
@expand 63100500                        #     bne     a0, zero, expand
13830500                                #     mv      t1, a1                      # else only hex digits, as they are
B383C500                                #     add     t2, a1, a2
:hex_only                               # hex_only:
03450300                                #     lbu     a0, 0(t1)
$hexval EF000000                        #     jal     ra, hexval                  # (keeps t1, t2)
@unknown 63400500                       #     blt     a0, zero, unknown
13031300                                #     addi    t1, t1, 1
@hex_only 63107300                      #     bne     t1, t2, hex_only
:copy                                   # copy:                                   # the token as it is, then a space
$put_text EF0D0000                      #     jal     s11, put_text
$loop 6F000000                          #     j       loop
:expand                                 # expand:
83350501                                #     ld      a1, 16(a0)                  # its value
03368501                                #     ld      a2, 24(a0)
$copy 6F000000                          #     j       copy

:define                                 # define:                                 # DEFINE name value
$token EF0C0000                         #     jal     s9, token                   # the name
@no_value 63100500                      #     bne     a0, zero, no_value
93860500                                #     mv      a3, a1
930F0600                                #     mv      t6, a2
$token EF0C0000                         #     jal     s9, token                   # the value
@no_value 63100500                      #     bne     a0, zero, no_value
93021000                                #     li      t0, 1                       # stored in pass 1, skipped in pass 2
@loop 63905A00                          #     bne     s5, t0, loop
938E0500                                #     mv      t4, a1                      # the value
130F0600                                #     mv      t5, a2
93850600                                #     mv      a1, a3                      # the name
13860F00                                #     mv      a2, t6
$find EF000000                          #     jal     ra, find                    # (keeps t4, t5)
