B7029000                                #     li      t0, MACROS_END
@too_many 63705B00                      #     bgeu    s6, t0, too_many
2330BB00                                #     sd      a1, 0(s6)                   # its name
2334CB00                                #     sd      a2, 8(s6)                   # its length
2338DB01                                #     sd      t4, 16(s6)                  # its value
233CEB01                                #     sd      t5, 24(s6)                  # its length
130B0B02                                #     addi    s6, s6, 32
$loop 6F000000                          #     j       loop

