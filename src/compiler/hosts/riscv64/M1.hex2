#
# gen/hex/riscv64/M1.s as hex2 text, made by gen/mkhex.pl: each line the bytes of
# one asm line, then the line. :label defines a label at the address
# of the next byte (from 0, the file's first byte); a reference
# (@label B, $label J, ~label and !label an auipc and the instruction
# after it) XORs label minus the instruction's address into the
# immediate field of the instruction after it, written with that field
# zero. hex2 reads only what is before each '#'.
#
# M1 for riscv64 Linux: a macro assembler, hex2 with names. The third link
# of the bootstrap, built by hex2 from hosts/riscv64/M1.hex2 (made from
# this file once by gen/mkhex.pl, a dev aid; the chain never reads this
# file). It turns hosts/riscv64/asm.M1 into hex2 text, which hex2 makes
# into asm, the assembler of the seed's asm. As stage0-posix's M1 with
# --architecture riscv64 (mescc-tools M1-macro.c, express_word).
#
#   M1 < file.M1 > file.hex2
#
# The input is tokens: bytes up to a space, tab or newline (any byte up to
# 0x20). '#' and ';' start a comment to the end of the line. A token
#   DEFINE name value   makes name a macro: every other token name, before
#                       or after, becomes the text value (hex2 text: hex
#                       digits, or a word .hex)
#   "text"              the hex of the bytes of text, then 00 (a C string;
#                       text is every byte up to the next '"')
#   'text'              text as it is (raw hex2 text, spaces too)
#   !n @n ~n            the number n in an instruction's immediate field,
#                       as a word for hex2 (.hex, XORed into the next 4
#                       bytes written: the instruction, written with that
#                       field zero): ! I (n's bits 11:0 to 31:20), @ S
#                       (11:5 to 31:25, 4:0 to 11:7), ~ U (bits 31:12 of n
#                       + 0x800, the upper part of a lui or auipc whose
#                       addi adds n's low 12 bits, signed: !n); ! and @
#                       must fit in 12 bits, ~ in 32, signed or unsigned
#   $n %n               n in 2 or 4 bytes, little endian, as hex; it must
#                       fit, signed or unsigned
#                       (n: decimal, or hex after 0x, '-' before it for a
#                       negative one)
#   :name ~name !name @name $name |name *name &name ^hex .hex
#                       hex2's labels, references, addresses and words, as
#                       they are (a sign followed by a digit or '-' is a
#                       number, above)
#   a macro's name      its value
#   hex digits          as they are (raw hex2 text)
# Anything else is an error. Out go the tokens' texts, each followed by a
# space, and a newline for each newline of the input: hex2 text, line by
# line as the input. The input is read whole, then twice: the first pass
# collects the macros, the second writes. On an unknown macro, a macro
# defined twice, a number that is none or does not fit, a string without
# its end, a full table, input or output and a failed read or write it
# says so on stderr and ends with status 1; else with 0.
#
# One flat file, loaded at BASE by its first program header, read and
# run; the second maps the memory it writes, MACROS to the end of OUTPUT.
# RV64IM, no compressed instructions. The registers:
#   s2  the next byte of the input          s3  the end of the input
#   s4  the next byte of the output         s5  the pass, 1 or 2
#   s6  the next free macro
#   s7  a number's bits (12, 16 or 32)      s8  its kind (below, sized)
#   s9, s10, s11  the return address of token, put_hex and put_text
# The routines take and give a0-a3 and use the t registers; token gives a
# token as a1 (its first byte), a2 (its length), a0 = 1 at the end of the
# input. A macro is 32 bytes: the address of its name in the input, the
# name's length, the address of its value, the value's length.

#     .equ BASE, 0x600000
#     .equ MACROS, 0x700000               # 65536 macros of 32 bytes
#     .equ MACROS_END, MACROS + 0x10000 * 32
#     .equ INPUT, 0x900000                # 16 MiB of input
#     .equ INPUT_END, INPUT + 0x1000000
#     .equ OUTPUT, 0x1900000              # 64 MiB of output
#     .equ OUTPUT_END, OUTPUT + 0x4000000
#     .equ SYS_read, 63
#     .equ SYS_write, 64
#     .equ SYS_exit, 93

:ehdr                                   # ehdr:                                   # the ELF header, 64 bytes
7F454C46                                #     .byte 0x7f, 0x45, 0x4c, 0x46        # e_ident: the magic, 0x7f 'E' 'L' 'F'
02                                      #     .byte 2                             # EI_CLASS: ELFCLASS64
01                                      #     .byte 1                             # EI_DATA: ELFDATA2LSB, little endian
01                                      #     .byte 1                             # EI_VERSION: EV_CURRENT
00                                      #     .byte 0                             # EI_OSABI: System V
0000000000000000                        #     .byte 0, 0, 0, 0, 0, 0, 0, 0        # EI_ABIVERSION 0, then padding to 16
0200                                    #     .half 2                             # e_type: ET_EXEC, an executable
F300                                    #     .half 0xf3                          # e_machine: EM_RISCV
01000000                                #     .word 1                             # e_version: EV_CURRENT
B801600000000000                        #     .dword BASE + _start - ehdr         # e_entry: the address of _start
4000000000000000                        #     .dword phdr - ehdr                  # e_phoff: the program headers follow
0000000000000000                        #     .dword 0                            # e_shoff: no section headers
00000000                                #     .word 0                             # e_flags: no RVC, soft float (none used)
4000                                    #     .half 64                            # e_ehsize: this header's size
3800                                    #     .half 56                            # e_phentsize: a program header's size
0200                                    #     .half 2                             # e_phnum: two program headers
0000                                    #     .half 0                             # e_shentsize: no section headers
0000                                    #     .half 0                             # e_shnum: none
0000                                    #     .half 0                             # e_shstrndx: none
:phdr                                   # phdr:                                   # the program: 56 bytes
01000000                                #     .word 1                             # p_type: PT_LOAD
05000000                                #     .word 5                             # p_flags: PF_R | PF_X, read and run
0000000000000000                        #     .dword 0                            # p_offset: from the file's first byte
0000600000000000                        #     .dword BASE                         # p_vaddr: loaded at BASE
0000600000000000                        #     .dword BASE                         # p_paddr: the same
CC07000000000000                        #     .dword end - ehdr                   # p_filesz: the whole file
CC07000000000000                        #     .dword end - ehdr                   # p_memsz: the same
0010000000000000                        #     .dword 0x1000                       # p_align: a page
                                        # its memory: 56 bytes
01000000                                #     .word 1                             # p_type: PT_LOAD
06000000                                #     .word 6                             # p_flags: PF_R | PF_W, read and write
0000000000000000                        #     .dword 0                            # p_offset: none of the file
0000700000000000                        #     .dword MACROS                       # p_vaddr: the macros, input, output
0000700000000000                        #     .dword MACROS                       # p_paddr: the same
0000000000000000                        #     .dword 0                            # p_filesz: none, all zero
0000200500000000                        #     .dword OUTPUT_END - MACROS          # p_memsz: to the end of the output
0010000000000000                        #     .dword 0x1000                       # p_align: a page

:str_define 444546494E45                # str_define:     .ascii "DEFINE"
:digits 30313233343536373839414243444546 # digits:         .ascii "0123456789ABCDEF\n"
0A
:msg_unknown 4D313A20756E6B6E6F776E206D616372 # msg_unknown:    .asciz "M1: unknown macro: "
6F3A2000
:msg_twice 4D313A206D6163726F20646566696E65 # msg_twice:      .asciz "M1: macro defined twice: "
642074776963653A2000
:msg_range 4D313A206E756D626572206F7574206F # msg_range:      .asciz "M1: number out of range: "
662072616E67653A2000
:msg_number 4D313A206E6F742061206E756D626572 # msg_number:     .asciz "M1: not a number: "
3A2000
:msg_string 4D313A20737472696E6720776974686F # msg_string:     .asciz "M1: string without its end"
75742069747320656E6400
:msg_value 4D313A20444546494E4520776974686F # msg_value:      .asciz "M1: DEFINE without its value"
7574206974732076616C756500
:msg_many 4D313A20746F6F206D616E79206D6163 # msg_many:       .asciz "M1: too many macros"
726F7300
:msg_large 4D313A20696E70757420746F6F206C61 # msg_large:      .asciz "M1: input too large"
72676500
:msg_long 4D313A206F757470757420746F6F206C # msg_long:       .asciz "M1: output too large"
6172676500
:msg_read 4D313A2072656164206661696C656400 # msg_read:       .asciz "M1: read failed"
:msg_write 4D313A207772697465206661696C6564 # msg_write:      .asciz "M1: write failed"
00
#     .balign 4                           # the code, 4-byte aligned (zeros)

:_start                                 # _start:                                 # read all of stdin into INPUT
B7099000                                #     li      s3, INPUT                   # the end of what is read
:read                                   # read:
37069001                                #     li      a2, INPUT_END
33063641                                #     sub     a2, a2, s3                  # the room left
@too_large 63000600                     #     beq     a2, zero, too_large
9308F003                                #     li      a7, SYS_read
13050000                                #     li      a0, 0                       # fd 0, stdin
93850900                                #     mv      a1, s3                      # after what is read
73000000                                #     ecall
@read_failed 63400500                   #     blt     a0, zero, read_failed
@read_all 63000500                      #     beq     a0, zero, read_all          # the end of stdin
B389A900                                #     add     s3, s3, a0
$read 6F000000                          #     j       read
:read_all                               # read_all:
370B7000                                #     li      s6, MACROS                  # no macros yet
370A9001                                #     li      s4, OUTPUT                  # no output yet
930A1000                                #     li      s5, 1                       # pass 1
:pass                                   # pass:
37099000                                #     li      s2, INPUT                   # from the first byte
:loop                                   # loop:                                   # the next token
$token EF0C0000                         #     jal     s9, token
@pass_end 63100500                      #     bne     a0, zero, pass_end
93026000                                #     li      t0, 6                       # DEFINE?
@not_define 63105600                    #     bne     a2, t0, not_define
~str_define 17030000 !str_define 13030300 #     la      t1, str_define
93830500                                #     mv      t2, a1
138E6500                                #     addi    t3, a1, 6
:define_byte                            # define_byte:
@define 6380C301                        #     beq     t2, t3, define
834E0300                                #     lbu     t4, 0(t1)
03CF0300                                #     lbu     t5, 0(t2)
@not_define 6390EE01                    #     bne     t4, t5, not_define
13031300                                #     addi    t1, t1, 1
93831300                                #     addi    t2, t2, 1
$define_byte 6F000000                   #     j       define_byte
:not_define                             # not_define:
93021000                                #     li      t0, 1                       # pass 1 only looks for DEFINE
@loop 63805A00                          #     beq     s5, t0, loop
03C50500                                #     lbu     a0, 0(a1)                   # its first byte
93022002                                #     li      t0, 0x22                    # '"': a string
@string 63005500                        #     beq     a0, t0, string
93027002                                #     li      t0, 0x27                    # "'": raw text
@raw 63005500                           #     beq     a0, t0, raw
930BC000                                #     li      s7, 12                      # '!': I, 12 bits
130C0000                                #     li      s8, 0
93021002                                #     li      t0, 0x21
@sized 63005500                         #     beq     a0, t0, sized
130C1000                                #     li      s8, 1                       # '@': S, 12 bits
93020004                                #     li      t0, 0x40
@sized 63005500                         #     beq     a0, t0, sized
930B0002                                #     li      s7, 32                      # '~': U, 32 bits
130C2000                                #     li      s8, 2
9302E007                                #     li      t0, 0x7e
@sized 63005500                         #     beq     a0, t0, sized
930B0001                                #     li      s7, 16                      # '$': 2 bytes
130C3000                                #     li      s8, 3
93024002                                #     li      t0, 0x24
@sized 63005500                         #     beq     a0, t0, sized
930B0002                                #     li      s7, 32                      # '%': 4 bytes, a number only
130C4000                                #     li      s8, 4
93025002                                #     li      t0, 0x25
@sized 63005500                         #     beq     a0, t0, sized
9302A003                                #     li      t0, 0x3a                    # ':' '|' '*' '&' '^' '.': for hex2
