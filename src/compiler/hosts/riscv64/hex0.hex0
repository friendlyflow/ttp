#
# gen/hex/riscv64/hex0.s as hex0 text, made by gen/mkhex.pl: each line the bytes of
# one asm line, then its file offset and the line. hex0 reads only the
# hex digits before each '#'.
#
# hex0 for riscv64 Linux: hex pairs in, bytes out. The first link of the
# bootstrap: everything after it is built from text by programs built from
# text. Its bytes are hosts/riscv64/hex0.hex0, made from this file once by
# gen/mkhex.pl (a dev aid); the chain never reads this file.
#
#   hex0 < file.hex0 > file
#
# Each pair of hex digits (0-9, A-F, a-f) is one byte, the first digit its
# high half. '#' and ';' start a comment to the end of the line. Every
# other byte (spaces, newlines, ...) is skipped. At the end of stdin the
# status is 0 (a lone last digit is dropped); a failed read or write ends
# with status 1.
#
# One flat file, loaded whole at BASE by its one program header: no
# sections, no linker. RV64I only, no compressed instructions: every
# instruction is 4 bytes, its fields as the RISC-V manual draws them. Only
# the stack is written (its first byte, argc's, is the buffer of a byte).
# The registers:
#   s1  the high half of the byte being read, or -1 before its first digit

#     .equ BASE, 0x600000
#     .equ SYS_read, 63
#     .equ SYS_write, 64
#     .equ SYS_exit, 93

# 0000  ehdr:                                   # the ELF header, 64 bytes
7F454C46                # 0000      .byte 0x7f, 0x45, 0x4c, 0x46        # e_ident: the magic, 0x7f 'E' 'L' 'F'
02                      # 0004      .byte 2                             # EI_CLASS: ELFCLASS64
01                      # 0005      .byte 1                             # EI_DATA: ELFDATA2LSB, little endian
01                      # 0006      .byte 1                             # EI_VERSION: EV_CURRENT
00                      # 0007      .byte 0                             # EI_OSABI: System V
0000000000000000        # 0008      .byte 0, 0, 0, 0, 0, 0, 0, 0        # EI_ABIVERSION 0, then padding to 16
0200                    # 0010      .half 2                             # e_type: ET_EXEC, an executable
F300                    # 0012      .half 0xf3                          # e_machine: EM_RISCV
01000000                # 0014      .word 1                             # e_version: EV_CURRENT
7800600000000000        # 0018      .dword BASE + _start - ehdr         # e_entry: the address of _start
4000000000000000        # 0020      .dword phdr - ehdr                  # e_phoff: the program header follows
0000000000000000        # 0028      .dword 0                            # e_shoff: no section headers
00000000                # 0030      .word 0                             # e_flags: no RVC, soft float (none used)
4000                    # 0034      .half 64                            # e_ehsize: this header's size
3800                    # 0036      .half 56                            # e_phentsize: a program header's size
0100                    # 0038      .half 1                             # e_phnum: one program header
0000                    # 003a      .half 0                             # e_shentsize: no section headers
0000                    # 003c      .half 0                             # e_shnum: none
0000                    # 003e      .half 0                             # e_shstrndx: none
# 0040  phdr:                                   # the program header, 56 bytes
01000000                # 0040      .word 1                             # p_type: PT_LOAD
05000000                # 0044      .word 5                             # p_flags: PF_R | PF_X, read and run
0000000000000000        # 0048      .dword 0                            # p_offset: from the file's first byte
0000600000000000        # 0050      .dword BASE                         # p_vaddr: loaded at BASE
0000600000000000        # 0058      .dword BASE                         # p_paddr: the same
3C01000000000000        # 0060      .dword end - ehdr                   # p_filesz: the whole file
3C01000000000000        # 0068      .dword end - ehdr                   # p_memsz: the same, no bss
0010000000000000        # 0070      .dword 0x1000                       # p_align: a page

# 0078  _start:
9304F0FF                # 0078      li      s1, -1                      # addi s1, zero, -1: no high half yet
#       I 111111111111 00000 000 01001 0010011: imm -1, rs1 x0 zero, rd x9 s1
# 007c  next:                                   # the next byte of stdin
EF004006                # 007c      jal     ra, getc                    # a0 = the byte
#       J 00000110010000000000 00001 1101111: imm 100, rd x1 ra
93023002                # 0080      li      t0, 0x23                    # '#': a comment
#       I 000000100011 00000 000 00101 0010011: imm 35, rs1 x0 zero, rd x5 t0
63065504                # 0084      beq     a0, t0, comment
#       B 0000010 00101 01010 000 01100 1100011: imm 76, rs2 x5 t0, rs1 x10 a0
9302B003                # 0088      li      t0, 0x3b                    # ';': a comment
#       I 000000111011 00000 000 00101 0010011: imm 59, rs1 x0 zero, rd x5 t0
63025504                # 008c      beq     a0, t0, comment
#       B 0000010 00101 01010 000 00100 1100011: imm 68, rs2 x5 t0, rs1 x10 a0
930205FD                # 0090      addi    t0, a0, -0x30               # '0'-'9' to 0-9
#       I 111111010000 01010 000 00101 0010011: imm -48, rs1 x10 a0, rd x5 t0
1303A000                # 0094      li      t1, 10
#       I 000000001010 00000 000 00110 0010011: imm 10, rs1 x0 zero, rd x6 t1
63EE6200                # 0098      bltu    t0, t1, digit               # unsigned: below '0' is large
#       B 0000000 00110 00101 110 11100 1100011: imm 28, rs2 x6 t1, rs1 x5 t0
93620502                # 009c      ori     t0, a0, 0x20                # 'A'-'F' to 'a'-'f'
#       I 000000100000 01010 110 00101 0010011: imm 32, rs1 x10 a0, rd x5 t0
938292FA                # 00a0      addi    t0, t0, -0x57               # 'a'-'f' to 10-15
#       I 111110101001 00101 000 00101 0010011: imm -87, rs1 x5 t0, rd x5 t0
938362FF                # 00a4      addi    t2, t0, -10                 # 0-5 for 'a'-'f'
#       I 111111110110 00101 000 00111 0010011: imm -10, rs1 x5 t0, rd x7 t2
13036000                # 00a8      li      t1, 6
#       I 000000000110 00000 000 00110 0010011: imm 6, rs1 x0 zero, rd x6 t1
63E46300                # 00ac      bltu    t2, t1, digit
#       B 0000000 00110 00111 110 01000 1100011: imm 8, rs2 x6 t1, rs1 x7 t2
6FF0DFFC                # 00b0      j       next                        # anything else: skipped
#       J 11111100110111111111 00000 1101111: imm -52, rd x0 zero
# 00b4  digit:                                  # t0 = the digit's value, 0-15
63CA0400                # 00b4      blt     s1, zero, high              # the first digit of a pair?
#       B 0000000 00000 01001 100 10100 1100011: imm 20, rs2 x0 zero, rs1 x9 s1
93944400                # 00b8      slli    s1, s1, 4                   # the second: high half, then this one
#       I 000000000100 01001 001 01001 0010011: imm 4, rs1 x9 s1, rd x9 s1
33E55400                # 00bc      or      a0, s1, t0
#       R 0000000 00101 01001 110 01010 0110011: rs2 x5 t0, rs1 x9 s1, rd x10 a0
EF004004                # 00c0      jal     ra, putc
#       J 00000100010000000000 00001 1101111: imm 68, rd x1 ra
6FF05FFB                # 00c4      j       _start                      # the next pair
#       J 11111011010111111111 00000 1101111: imm -76, rd x0 zero
# 00c8  high:
93840200                # 00c8      mv      s1, t0                      # addi s1, t0, 0: keep it for the second
#       I 000000000000 00101 000 01001 0010011: imm 0, rs1 x5 t0, rd x9 s1
6FF01FFB                # 00cc      j       next
#       J 11111011000111111111 00000 1101111: imm -80, rd x0 zero
# 00d0  comment:                                # skip to the end of the line
EF000001                # 00d0      jal     ra, getc
#       J 00000001000000000000 00001 1101111: imm 16, rd x1 ra
9302A000                # 00d4      li      t0, 0x0a                    # '\n'
#       I 000000001010 00000 000 00101 0010011: imm 10, rs1 x0 zero, rd x5 t0
E31C55FE                # 00d8      bne     a0, t0, comment
#       B 1111111 00101 01010 001 11001 1100011: imm -8, rs2 x5 t0, rs1 x10 a0
6FF01FFA                # 00dc      j       next
#       J 11111010000111111111 00000 1101111: imm -96, rd x0 zero

# 00e0  getc:                                   # a0 = the next byte of stdin
9308F003                # 00e0      li      a7, SYS_read
#       I 000000111111 00000 000 10001 0010011: imm 63, rs1 x0 zero, rd x17 a7
13050000                # 00e4      li      a0, 0                       # fd 0, stdin
#       I 000000000000 00000 000 01010 0010011: imm 0, rs1 x0 zero, rd x10 a0
93050100                # 00e8      mv      a1, sp                      # into the stack
#       I 000000000000 00010 000 01011 0010011: imm 0, rs1 x2 sp, rd x11 a1
13061000                # 00ec      li      a2, 1                       # 1 byte
#       I 000000000001 00000 000 01100 0010011: imm 1, rs1 x0 zero, rd x12 a2
73000000                # 00f0      ecall
#       I 000000000000 00000 000 00000 1110011: imm 0, rs1 x0 zero, rd x0 zero
634E0502                # 00f4      blt     a0, zero, fail              # a failed read
#       B 0000001 00000 01010 100 11100 1100011: imm 60, rs2 x0 zero, rs1 x10 a0
63080502                # 00f8      beq     a0, zero, done              # the end of stdin
#       B 0000001 00000 01010 000 10000 1100011: imm 48, rs2 x0 zero, rs1 x10 a0
03450100                # 00fc      lbu     a0, 0(sp)                   # the byte, zero-extended
#       I 000000000000 00010 100 01010 0000011: imm 0, rs1 x2 sp, rd x10 a0
67800000                # 0100      ret                                 # jalr zero, 0(ra)
#       I 000000000000 00001 000 00000 1100111: imm 0, rs1 x1 ra, rd x0 zero

# 0104  putc:                                   # writes a0's low byte to stdout
2300A100                # 0104      sb      a0, 0(sp)
#       S 0000000 01010 00010 000 00000 0100011: imm 0, rs2 x10 a0, rs1 x2 sp
93080004                # 0108      li      a7, SYS_write
#       I 000001000000 00000 000 10001 0010011: imm 64, rs1 x0 zero, rd x17 a7
13051000                # 010c      li      a0, 1                       # fd 1, stdout
#       I 000000000001 00000 000 01010 0010011: imm 1, rs1 x0 zero, rd x10 a0
93050100                # 0110      mv      a1, sp                      # from the stack
#       I 000000000000 00010 000 01011 0010011: imm 0, rs1 x2 sp, rd x11 a1
13061000                # 0114      li      a2, 1                       # 1 byte
#       I 000000000001 00000 000 01100 0010011: imm 1, rs1 x0 zero, rd x12 a2
73000000                # 0118      ecall
#       I 000000000000 00000 000 00000 1110011: imm 0, rs1 x0 zero, rd x0 zero
93021000                # 011c      li      t0, 1                       # written?
#       I 000000000001 00000 000 00101 0010011: imm 1, rs1 x0 zero, rd x5 t0
63185500                # 0120      bne     a0, t0, fail
#       B 0000000 00101 01010 001 10000 1100011: imm 16, rs2 x5 t0, rs1 x10 a0
67800000                # 0124      ret
#       I 000000000000 00001 000 00000 1100111: imm 0, rs1 x1 ra, rd x0 zero

# 0128  done:
13050000                # 0128      li      a0, 0                       # status 0
#       I 000000000000 00000 000 01010 0010011: imm 0, rs1 x0 zero, rd x10 a0
6F008000                # 012c      j       exit
#       J 00000000100000000000 00000 1101111: imm 8, rd x0 zero
# 0130  fail:
13051000                # 0130      li      a0, 1                       # status 1
#       I 000000000001 00000 000 01010 0010011: imm 1, rs1 x0 zero, rd x10 a0
# 0134  exit:
9308D005                # 0134      li      a7, SYS_exit
#       I 000001011101 00000 000 10001 0010011: imm 93, rs1 x0 zero, rd x17 a7
73000000                # 0138      ecall
#       I 000000000000 00000 000 00000 1110011: imm 0, rs1 x0 zero, rd x0 zero
# 013c  end:
