#
# gen/hex/arm/M1.s as hex2 text, made by gen/mkhex.pl: each line the bytes of
# one asm line, then the line. :label defines a label at the address
# of the next byte (from BASE, the file's first byte's: ^ below);
# ^~label writes 3 bytes, imm24 of B, BL or B<cond> ((label minus the
# instruction's address minus 8) / 4), the byte after them is cond and
# the opcode; !label and ~label XOR label's address into the MOVW
# (:lower16:) and the MOVT (:upper16:) after them, each written with its
# immediate zero. hex2 reads only what is before each '#'.
#
^00010000                               # the first byte is at BASE, where it runs
# M1 for arm Linux (EABI): a macro assembler, hex2 with names. The third
# link of the bootstrap, built by hex2 from hosts/arm/M1.hex2 (made from
# this file once by gen/mkhex.pl, a dev aid; the chain never reads this
# file). It turns hosts/arm/asm.M1 into hex2 text, which hex2 makes into
# asm, the assembler of the seed's asm. As stage0-posix's M1.
#
#   M1 < file.M1 > file.hex2
#
# The input is tokens: bytes up to a space, tab or newline (any byte up to
# 0x20). '#' and ';' start a comment to the end of the line. A token
#   DEFINE name value   makes name a macro: every other token name, before
#                       or after, becomes the text value (hex digits)
#   "text"              the hex of the bytes of text, then 00 (a C string;
#                       text is every byte up to the next '"')
#   'text'              text as it is (raw hex2 text, spaces too)
#   !n @n %n            the number n in 1, 2 or 4 bytes, little endian, as
#                       hex: decimal, or hex after 0x, '-' before it for a
#                       negative one; it must fit, signed or unsigned
#   :name ^~name !name ~name &name ^hex
#                       hex2's labels, references and addresses, as they are
#                       (after ! @ % a name, not a number)
#   a macro's name      its value
#   hex digits          as they are (raw hex2 text)
# Anything else is an error. Out go the tokens' texts, each followed by a
# space, and a newline for each newline of the input: hex2 text, line by
# line as the input. The input is read whole, then twice: the first pass
# collects the macros, the second writes. On an unknown macro, a macro
# defined twice, a number that is none or does not fit, a string without
# its end, a full table, input or output and a failed read or write it
# says so on stderr and ends with status 1; else with 0.
#
# One flat file, loaded at BASE by its first program header, read and
# run; the second maps the memory it writes, MACROS to the end of OUTPUT.
# ARM state (ARMv7-A). The registers:
#   r4  the next byte of the input          r5  the end of the input
#   r6  the next byte of the output         r8  the pass, 1 or 2
#   r10 the next free macro
#   r7  the system call's number, else scratch, as r0-r3, r9, r11, r12
# A macro is 16 bytes: the address of its name in the input, the name's
# length, the address of its value, the value's length.

#     .syntax unified
#     .arch armv7-a
#     .arm
#     .equ BASE, 0x10000
#     .equ MACROS, 0x100000               @ 65536 macros of 16 bytes
#     .equ MACROS_END, MACROS + 0x10000 * 16
#     .equ INPUT, 0x200000                @ 16 MiB of input
#     .equ INPUT_END, INPUT + 0x1000000
#     .equ OUTPUT, 0x1200000              @ 64 MiB of output
#     .equ OUTPUT_END, OUTPUT + 0x4000000
#     .equ SYS_read, 3
#     .equ SYS_write, 4
#     .equ SYS_exit, 1

# la: reg = the address of sym, as ttpc.s's
#     .macro la reg, sym
#     movw    \reg, #:lower16:\sym
#     movt    \reg, #:upper16:\sym
#     .endm

:ehdr                                   # ehdr:                                   @ the ELF header, 52 bytes
7F454C46                                #     .byte 0x7f, 0x45, 0x4c, 0x46        @ e_ident: the magic, 0x7f 'E' 'L' 'F'
01                                      #     .byte 1                             @ EI_CLASS: ELFCLASS32
01                                      #     .byte 1                             @ EI_DATA: ELFDATA2LSB, little endian
01                                      #     .byte 1                             @ EI_VERSION: EV_CURRENT
00                                      #     .byte 0                             @ EI_OSABI: System V
0000000000000000                        #     .byte 0, 0, 0, 0, 0, 0, 0, 0        @ EI_ABIVERSION 0, then padding to 16
0200                                    #     .hword 2                            @ e_type: ET_EXEC, an executable
2800                                    #     .hword 40                           @ e_machine: EM_ARM
01000000                                #     .word 1                             @ e_version: EV_CURRENT
74010100                                #     .word BASE + _start - ehdr          @ e_entry: the address of _start
34000000                                #     .word phdr - ehdr                   @ e_phoff: the program headers follow
00000000                                #     .word 0                             @ e_shoff: no section headers
00020005                                #     .word 0x05000200                    @ e_flags: EABI version 5, soft float
3400                                    #     .hword 52                           @ e_ehsize: this header's size
2000                                    #     .hword 32                           @ e_phentsize: a program header's size
0200                                    #     .hword 2                            @ e_phnum: two program headers
0000                                    #     .hword 0                            @ e_shentsize: no section headers
0000                                    #     .hword 0                            @ e_shnum: none
0000                                    #     .hword 0                            @ e_shstrndx: none
:phdr                                   # phdr:                                   @ the program: 32 bytes
01000000                                #     .word 1                             @ p_type: PT_LOAD
00000000                                #     .word 0                             @ p_offset: from the file's first byte
00000100                                #     .word BASE                          @ p_vaddr: loaded at BASE
00000100                                #     .word BASE                          @ p_paddr: the same
94070000                                #     .word end - ehdr                    @ p_filesz: the whole file
94070000                                #     .word end - ehdr                    @ p_memsz: the same
05000000                                #     .word 5                             @ p_flags: PF_R | PF_X, read and run
00100000                                #     .word 0x1000                        @ p_align: a page
                                        # its memory: 32 bytes
01000000                                #     .word 1                             @ p_type: PT_LOAD
00000000                                #     .word 0                             @ p_offset: none of the file
00001000                                #     .word MACROS                        @ p_vaddr: the macros, input, output
00001000                                #     .word MACROS                        @ p_paddr: the same
00000000                                #     .word 0                             @ p_filesz: none, all zero
00001005                                #     .word OUTPUT_END - MACROS           @ p_memsz: to the end of the output
06000000                                #     .word 6                             @ p_flags: PF_R | PF_W, read and write
00100000                                #     .word 0x1000                        @ p_align: a page

:str_define 444546494E45                # str_define:     .ascii "DEFINE"
:digits 30313233343536373839414243444546 # digits:         .ascii "0123456789ABCDEF\n"
0A
:msg_unknown 4D313A20756E6B6E6F776E206D616372 # msg_unknown:    .ascii "M1: unknown macro: "
6F3A20
#     .equ msg_unknown_len, . - msg_unknown
:msg_twice 4D313A206D6163726F20646566696E65 # msg_twice:      .ascii "M1: macro defined twice: "
642074776963653A20
#     .equ msg_twice_len, . - msg_twice
:msg_range 4D313A206E756D626572206F7574206F # msg_range:      .ascii "M1: number out of range: "
662072616E67653A20
#     .equ msg_range_len, . - msg_range
:msg_number 4D313A206E6F742061206E756D626572 # msg_number:     .ascii "M1: not a number: "
3A20
#     .equ msg_number_len, . - msg_number
:msg_string 4D313A20737472696E6720776974686F # msg_string:     .ascii "M1: string without its end"
75742069747320656E64
#     .equ msg_string_len, . - msg_string
:msg_value 4D313A20444546494E4520776974686F # msg_value:      .ascii "M1: DEFINE without its value"
7574206974732076616C7565
#     .equ msg_value_len, . - msg_value
:msg_many 4D313A20746F6F206D616E79206D6163 # msg_many:       .ascii "M1: too many macros"
726F73
#     .equ msg_many_len, . - msg_many
:msg_large 4D313A20696E70757420746F6F206C61 # msg_large:      .ascii "M1: input too large"
726765
#     .equ msg_large_len, . - msg_large
:msg_long 4D313A206F757470757420746F6F206C # msg_long:       .ascii "M1: output too large"
61726765
#     .equ msg_long_len, . - msg_long
:msg_read 4D313A2072656164206661696C6564 # msg_read:       .ascii "M1: read failed"
#     .equ msg_read_len, . - msg_read
:msg_write 4D313A207772697465206661696C6564 # msg_write:      .ascii "M1: write failed"
#     .equ msg_write_len, . - msg_write
000000                                  #     .balign 4                           @ the code, 4-byte aligned (zeros)

:_start                                 # _start:                                 @ read all of stdin into INPUT
0256A0E3                                #     mov     r5, #INPUT                  @ the end of what is read
:read                                   # read:
1226A0E3                                #     mov     r2, #INPUT_END
052052E0                                #     subs    r2, r2, r5                  @ the room left
^~too_large 0A                          #     beq     too_large
0370A0E3                                #     mov     r7, #SYS_read
0000A0E3                                #     mov     r0, #0                      @ fd 0, stdin
0510A0E1                                #     mov     r1, r5                      @ after what is read
000000EF                                #     svc     #0
000050E3                                #     cmp     r0, #0
^~read_failed BA                        #     blt     read_failed
^~read_all 0A                           #     beq     read_all                    @ the end of stdin
005085E0                                #     add     r5, r5, r0
^~read EA                               #     b       read
:read_all                               # read_all:
01A6A0E3                                #     mov     r10, #MACROS                @ no macros yet
1266A0E3                                #     mov     r6, #OUTPUT                 @ no output yet
0180A0E3                                #     mov     r8, #1                      @ pass 1
:pass                                   # pass:
0246A0E3                                #     mov     r4, #INPUT                  @ from the first byte
:loop                                   # loop:                                   @ the next token
^~token EB                              #     bl      token
000050E3                                #     cmp     r0, #0
^~pass_end 1A                           #     bne     pass_end
060052E3                                #     cmp     r2, #6                      @ DEFINE?
^~not_define 1A                         #     bne     not_define
!str_define 003000E3 ~str_define 003040E3 #     la      r3, str_define
00C0A0E3                                #     mov     r12, #0
:define_byte                            # define_byte:
0C70D3E7                                #     ldrb    r7, [r3, r12]
0C00D1E7                                #     ldrb    r0, [r1, r12]
000057E1                                #     cmp     r7, r0
^~not_define 1A                         #     bne     not_define
01C08CE2                                #     add     r12, r12, #1
06005CE3                                #     cmp     r12, #6
^~define_byte 1A                        #     bne     define_byte
^~define EA                             #     b       define
:not_define                             # not_define:
010058E3                                #     cmp     r8, #1                      @ pass 1 only looks for DEFINE
^~loop 0A                               #     beq     loop
0070D1E5                                #     ldrb    r7, [r1]                    @ its first byte
220057E3                                #     cmp     r7, #0x22                   @ '"': a string
^~string 0A                             #     beq     string
270057E3                                #     cmp     r7, #0x27                   @ "'": raw text
^~raw 0A                                #     beq     raw
0190A0E3                                #     mov     r9, #1                      @ '!': 1 byte
210057E3                                #     cmp     r7, #0x21
^~sized 0A                              #     beq     sized
0490A0E3                                #     mov     r9, #4                      @ '%': 4 bytes
250057E3                                #     cmp     r7, #0x25
^~sized 0A                              #     beq     sized
0290A0E3                                #     mov     r9, #2                      @ '@': 2 bytes
400057E3                                #     cmp     r7, #0x40
^~sized 0A                              #     beq     sized
3A0057E3                                #     cmp     r7, #0x3a                   @ ':' '&' '^' '~': for hex2
^~copy 0A                               #     beq     copy
260057E3                                #     cmp     r7, #0x26
^~copy 0A                               #     beq     copy
5E0057E3                                #     cmp     r7, #0x5e
^~copy 0A                               #     beq     copy
7E0057E3                                #     cmp     r7, #0x7e
^~copy 0A                               #     beq     copy
^~find EB                               #     bl      find                        @ a macro: r1, r2 its value
000050E3                                #     cmp     r0, #0
^~copy 0A                               #     beq     copy
0130A0E1                                #     mov     r3, r1                      @ else only hex digits, as they are
02C081E0                                #     add     r12, r1, r2
:hex_only                               # hex_only:
0000D3E5                                #     ldrb    r0, [r3]
^~hexval EB                             #     bl      hexval
000050E3                                #     cmp     r0, #0
^~unknown BA                            #     blt     unknown
013083E2                                #     add     r3, r3, #1
0C0053E1                                #     cmp     r3, r12
^~hex_only 1A                           #     bne     hex_only
:copy                                   # copy:                                   @ the token as it is, then a space
^~put_text EB                           #     bl      put_text
^~loop EA                               #     b       loop

:define                                 # define:                                 @ DEFINE name value
^~token EB                              #     bl      token                       @ the name
000050E3                                #     cmp     r0, #0
^~no_value 1A                           #     bne     no_value
02065AE3                                #     cmp     r10, #MACROS_END            @ kept in the next free macro
^~too_many 2A                           #     bhs     too_many
00108AE5                                #     str     r1, [r10]                   @ its name
04208AE5                                #     str     r2, [r10, #4]               @ its length
^~token EB                              #     bl      token                       @ the value
000050E3                                #     cmp     r0, #0
^~no_value 1A                           #     bne     no_value
010058E3                                #     cmp     r8, #1                      @ stored in pass 1, skipped in pass 2
^~loop 1A                               #     bne     loop
08108AE5                                #     str     r1, [r10, #8]               @ its value
0C208AE5                                #     str     r2, [r10, #12]              @ its length
00109AE5                                #     ldr     r1, [r10]                   @ the name: not yet a macro?
04209AE5                                #     ldr     r2, [r10, #4]
^~find EB                               #     bl      find
000050E3                                #     cmp     r0, #0
00109A05                                #     ldreq   r1, [r10]                   @ (find gave its value)
04209A05                                #     ldreq   r2, [r10, #4]
^~twice 0A                              #     beq     twice
10A08AE2                                #     add     r10, r10, #16
^~loop EA                               #     b       loop

:string                                 # string:                                 @ "text": its bytes as hex, then 00
011081E2                                #     add     r1, r1, #1                  @ after the '"'
022052E2                                #     subs    r2, r2, #2                  @ without both '"'
^~string_end 0A                         #     beq     string_end
:string_byte                            # string_byte:
0000D1E5                                #     ldrb    r0, [r1]
