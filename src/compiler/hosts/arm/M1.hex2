0C20A0E1                                #     mov     r2, r12
000050E3                                #     cmp     r0, #0
^~bad_number 1A                         #     bne     bad_number
040059E3                                #     cmp     r9, #4                      @ 4 bytes: any 32-bit number
^~number_byte 0A                        #     beq     number_byte
8971A0E1                                #     lsl     r7, r9, #3                  @ fits: -2^(8n-1) <= n < 2^(8n)
0100A0E3                                #     mov     r0, #1
1007A0E1                                #     lsl     r0, r0, r7                  @ 2^(8n)
A070A0E1                                #     lsr     r7, r0, #1                  @ 2^(8n-1)
07C083E0                                #     add     r12, r3, r7                 @ + 2^(8n-1): from 0 ...
007087E0                                #     add     r7, r7, r0                  @ ... to below 2^(8n) + 2^(8n-1)
07005CE1                                #     cmp     r12, r7
^~range 2A                              #     bhs     range
:number_byte                            # number_byte:                            @ the low byte first
0300A0E1                                #     mov     r0, r3
^~put_hex EB                            #     bl      put_hex
2334A0E1                                #     lsr     r3, r3, #8
019059E2                                #     subs    r9, r9, #1
^~number_byte 1A                        #     bne     number_byte
2000A0E3                                #     mov     r0, #0x20
^~put EB                                #     bl      put
^~loop EA                               #     b       loop

:pass_end                               # pass_end:
018088E2                                #     add     r8, r8, #1
020058E3                                #     cmp     r8, #2                      @ after pass 1, pass 2
^~pass 0A                               #     beq     pass
