011081E2                                #     add     r1, r1, #1
012052E2                                #     subs    r2, r2, #1
^~string_byte 1A                        #     bne     string_byte
:string_end                             # string_end:
0000A0E3                                #     mov     r0, #0                      @ the 00
^~put_hex EB                            #     bl      put_hex
2000A0E3                                #     mov     r0, #0x20
^~put EB                                #     bl      put
^~loop EA                               #     b       loop

:raw                                    # raw:                                    @ 'text': text as it is
011081E2                                #     add     r1, r1, #1
022042E2                                #     sub     r2, r2, #2
^~put_text EB                           #     bl      put_text
^~loop EA                               #     b       loop

:sized                                  # sized:                                  @ !n @n %n: r9 bytes of n; else a label
0170D1E5                                #     ldrb    r7, [r1, #1]                @ a digit or '-' after the sign
2D0057E3                                #     cmp     r7, #0x2d
^~number 0A                             #     beq     number
307047E2                                #     sub     r7, r7, #0x30
090057E3                                #     cmp     r7, #9
^~number 9A                             #     bls     number
^~copy EA                               #     b       copy                        @ !name @name %name: for hex2
:number                                 # number:
01B0A0E1                                #     mov     r11, r1                     @ the token, for a message
02C0A0E1                                #     mov     r12, r2
011081E2                                #     add     r1, r1, #1                  @ after the sign
012042E2                                #     sub     r2, r2, #1
