616E646900000000                        #     .ascii "andi\0\0\0\0"
&op_and 00000000                        #     .word   op_and, 0
6F72000000000000                        #     .ascii "or\0\0\0\0\0\0"
&op_or 00000000                         #     .word   op_or, 0
6F72690000000000                        #     .ascii "ori\0\0\0\0\0"
&op_or 00000000                         #     .word   op_or, 0
786F720000000000                        #     .ascii "xor\0\0\0\0\0"
&op_xor 00000000                        #     .word   op_xor, 0
786F726900000000                        #     .ascii "xori\0\0\0\0"
&op_xor 00000000                        #     .word   op_xor, 0
736C6C0000000000                        #     .ascii "sll\0\0\0\0\0"
&op_sll 00000000                        #     .word   op_sll, 0
736C6C6900000000                        #     .ascii "slli\0\0\0\0"
&op_sll 00000000                        #     .word   op_sll, 0
73726C0000000000                        #     .ascii "srl\0\0\0\0\0"
&op_srl 00000000                        #     .word   op_srl, 0
73726C6900000000                        #     .ascii "srli\0\0\0\0"
&op_srl 00000000                        #     .word   op_srl, 0
7372610000000000                        #     .ascii "sra\0\0\0\0\0"
&op_sra 00000000                        #     .word   op_sra, 0
7372616900000000                        #     .ascii "srai\0\0\0\0"
&op_sra 00000000                        #     .word   op_sra, 0
