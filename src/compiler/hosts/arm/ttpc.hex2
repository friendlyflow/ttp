#
# hosts/arm/ttpc.s as hex2 text, made by gen/mkhex.pl from GNU as's and ld's output:
# the whole executable in the order of its bytes. :label defines a label
# at the address of the next byte; &label is label's address in 4 bytes
# (abs32, a .word). The code's references: ^~label (stage0-posix's B, BL
# and B<cond>) writes 3 bytes, imm24, (d - 8) / 4 (d is label minus the
# instruction's address, the pc reads 8 ahead), the byte after them is
# cond and the opcode (EA b, EB bl, 0A beq, ...); !label and ~label XOR
# label's address into the MOVW (:lower16:, its low 16 bits) and the MOVT
# (:upper16:, its high 16 bits) after them, each written with its imm4
# and imm12 zero;
# ^address sets the address of the next byte (where the file and the
# addresses part: the data segment, the labels of the bss). Every other
# pair of hex digits is a byte; '#' and ';' start a comment to the end of
# the line. A reference that is not to a label alone (label+8, or with
# an immediate after it) is written out. Each line is followed by the asm
# line of hosts/arm/ttpc.s it comes from; hex2 reads only what is before the '#'.
#
^00010000                               # the first byte of the file is at this address
#
# The ELF header
7F454C46010101000000000000000000        # e_ident: the magic 7f "ELF", ELFCLASS32, little endian, EV_CURRENT, System V, padding
0200                                    # e_type = 0x2: ET_EXEC, an executable
2800                                    # e_machine = 0x28: EM_ARM
01000000                                # e_version = 0x1: EV_CURRENT
74000100                                # e_entry = 0x10074: the address of _start
34000000                                # e_phoff = 0x34: the program headers follow
5C1D0000                                # e_shoff = 0x1d5c: the section headers, at the end
00020005                                # e_flags = 0x5000200: EF_ARM_EABI_VER5, EF_ARM_ABI_FLOAT_SOFT
3400                                    # e_ehsize = 0x34: this header
2000                                    # e_phentsize = 0x20: a program header
0200                                    # e_phnum = 0x2: program headers
2800                                    # e_shentsize = 0x28: a section header
0700                                    # e_shnum = 0x7: section headers
0600                                    # e_shstrndx = 0x6: the section of the section names
#
# Program header 0
01000000                                # p_type = 0x1: 1: PT_LOAD
00000000                                # p_offset = 0x0: from this file offset
00000100                                # p_vaddr = 0x10000: to this address
00000100                                # p_paddr = 0x10000: the same
A91B0000                                # p_filesz = 0x1ba9: bytes of the file
A91B0000                                # p_memsz = 0x1ba9: bytes of memory, the rest zero
05000000                                # p_flags = 0x5: 4 R, 2 W, 1 X
00100000                                # p_align = 0x1000: a page
#
# Program header 1
01000000                                # p_type = 0x1: 1: PT_LOAD
B01B0000                                # p_offset = 0x1bb0: from this file offset
B02B0100                                # p_vaddr = 0x12bb0: to this address
B02B0100                                # p_paddr = 0x12bb0: the same
58010000                                # p_filesz = 0x158: bytes of the file
70045400                                # p_memsz = 0x540470: bytes of memory, the rest zero
06000000                                # p_flags = 0x6: 4 R, 2 W, 1 X
00100000                                # p_align = 0x1000: a page
#
# The section .text, from here its lines of hosts/arm/ttpc.s
# ttpc.s (arm) — the trust project compiler, in 32-bit ARM assembly, without
# libc.
#
# FROZEN: this is stage0 on an arm host, a port of ../riscv64/ttpc.s,
# the seed of the bootstrap (see PLAN.md). It must agree with ttpc.s byte for
# byte: the same stdout, stderr, output file and exit status for every input.
# It translates ttpc.s function by function, with the same labels in the same
# order, so that an auditor can read the two side by side. There is ONE
# deliberate difference: OUT_SIZE is 1 << 20 (1 MiB) here, 1 << 16 in ttpc.s,
# so that this seed assembles programs that the riscv seed finds too large.
#
# A static Linux arm program (ARMv7-A, ARM mode, EABI; run it with qemu-arm on
# another host). It talks to the kernel only through svc: it opens the ff
# file named by its first argument and loads it into memory as a tree of
# NODEs.
#
#   ttpc <file.ff>          prints the tree, one node per line
#   ttpc <file.ff> <out>    assembles it into the static executable <out>
#
# Assembling: a node whose content ends in ':' is a function, its leading
# children that are leaves are its parameters. Any other node is a call, its
# children are the arguments. The root's children are pages. The functions
# on every page but the last are definitions: instructions, macros,
# constants. The last page is the program: its functions are placed, they
# are labels whose children are emitted where they stand (nested ones are
# local labels, found innermost scope first), and its calls are emitted in
# order. Pass 1 finds every label's address, pass 2 emits.
#
# A function whose body (the children after its parameters) holds only
# fields, fixed fields (funct3:, ...) and slice calls (imm[11:0] imm), is an
# encoding: an instruction or a data word of 8 to 64 bits. A call runs in
# one of three contexts:
#
#   code   a call of an encoding is encoded and emitted, a call of any
#          other function expands its body in code context.
#   field  encoding: the fields, MSB first. A fixed field is its bits; a
#          slice call runs in exec context and leaves its value in a0, its
#          width is in its name.
#   exec   runs at assemble time on vregs. The ops of exec_ops are built
#          in, the seed; everything else is defined by the tree.
#
# An argument with children is a call, run in exec context: its value is
# a0. A leaf argument is a decimal or 0x number, a parameter, a register
# (its number in code context, its vreg in exec context), pc, a label (its
# address) or a constant (a function without parameters, run in exec
# context). The builtins: ascii, align, reserve, origin, bss (see
# code_call) and size (see exec_call).
#
# Registers are the functions "x10 a0:", their number is their child "01010".
# The output file is exactly what the program emits: its ELF header is ff
# too (elf_header in macros.ff.txt).
#
# ff on disk, one node, depth-first (children inline, before the content):
#   hash          byte[32]
#   children_len  u8
#   children      node × children_len
#   content_len   u8
#   content       byte × content_len    // no NUL termination: may be binary
#
# NODE in memory (64 bytes, naturally aligned), the layout of ttpc.s:
#   0   hash          byte[32]
#   32  children_len  int8
#   40  children      NODE**            // -> pointer array in ptrs
#   48  content_len   int8
#   56  content       char*             // -> into buf, not copied
#
# The port. ttpc.s computes in 64 bits, this machine has 32. All memory
# layouts stay those of ttpc.s (NODE, FRAME, LABEL, OP, vregs, the .dword
# variables): a pointer is 32 bits and sits in the low word of its 8-byte
# slot, its high word is 0 (bss starts zeroed and only the low word is ever
# written, or a 0 is stored with it). Small counters in .dword variables
# (pass, in_bss, scope_depth) likewise only use the low word.
#
# Every VALUE (vregs, numbers, parameters, fields, the encoded word, widths
# of fields, cur_pc, label addresses) is 64 bits: a register pair lo:hi,
# always an even/odd pair (r0:r1, r2:r3, r4:r5, ...) so that ldrd/strd move
# it. It wraps exactly as on RV64.
#
# Register map (riscv64 -> arm):
#   a0 a1 a2 a3   r0 r1 r2 r3       arguments and results; a 64-bit a0
#                                   result is r0:r1 (see each function for
#                                   where its other 64-bit values go)
#   a4            r12 (ip)          the fifth argument (bind, die_name)
#   a7            r7                the syscall number
#   t0..t6        r0-r3, r12        scratch; lr once it is saved
#   s0 s1 s2 s3   r8 r9 r10 r11     the loading globals (parse cursor, end of
#                                   the loaded bytes, next NODE, next slot
#                                   in ptrs), only in _start and parse_node
#   s4..s11       r4..r11           callee-saved, per function as in ttpc.s
#                                   unless its comment says otherwise
#   ra            lr
# r7 is both s7 and the syscall number: every svc site that returns saves
# r7. Functions save their callee-saved registers and lr with push/pop (an
# even count, so sp stays 8-byte aligned), or, where ttpc.s keeps locals at
# fixed offsets in its frame (code_call, exec_call, execute, encode), with
# the same frame and offsets.
#
# The 64-bit helpers (section "64-bit values") do what RV64 does in one
# instruction. They take the value in r0:r1 and leave the result there,
# touch only r0-r3 and r12, and are called with bl:
#   sll64, srl64, sra64   r0:r1 shifted by r2 mod 64 (sll, srl, sra)
#   mul64                 r0:r1 = low 64 bits of r0:r1 * r2:r3 (mul)
#   remu64                r0:r1 = r0:r1 mod r2:r3, unsigned, r0:r1 when
#                         r2:r3 is 0 (remu); keeps r2:r3
# Adds, subtracts and compares of values are inline: adds/adc, subs/sbc,
# and equality as cmp lo + cmpeq hi. A value's sign (bltz) is its hi's.

#     .syntax unified
#     .arch armv7-a
#     .arm

    # la: the address of a symbol (movw/movt, no literal pool).
#     .macro la rd, sym
#     movw    \rd, #:lower16:\sym
#     movt    \rd, #:upper16:\sym
#     .endm

#     .equ SYS_openat, 322
#     .equ SYS_close, 6
#     .equ SYS_read, 3
#     .equ SYS_write, 4
#     .equ SYS_exit, 1

#     .equ AT_FDCWD, -100
#     .equ O_RDONLY, 0
#     .equ O_CREAT_WRONLY_TRUNC, 01 | 0100 | 01000
#     .equ MODE_0755, 0755
#     .equ STDOUT, 1
#     .equ STDERR, 2

#     .equ CH_space, 32
#     .equ CH_minus, 45
#     .equ CH_zero, 48
#     .equ CH_colon, 58
#     .equ CH_lbracket, 91
#     .equ CH_rbracket, 93
#     .equ CH_bar, 124
#     .equ CH_a, 97
#     .equ CH_x, 120

    # A frame binds the parameters of a call: count, then (param NODE*,
    # value) pairs.
#     .equ MAX_PARAMS, 8
#     .equ FRAME_count, 0
#     .equ FRAME_params, 8
#     .equ FRAME_size, 8 + MAX_PARAMS * 16

#     .equ VREG_a0, 10
#     .equ OUT_SIZE, 1 << 20              @ 1 << 16 in ttpc.s: the one difference
#     .equ MAX_DEPTH, 64                  @ nesting of placed functions

    # A label: a placed function, its address and the address after it.
#     .equ LABEL_node, 0
#     .equ LABEL_addr, 8
#     .equ LABEL_end, 16
#     .equ LABEL_size, 24

    # An exec op: its name, NUL-padded, and its code.
#     .equ OP_name, 0
#     .equ OP_code, 8
#     .equ OP_size, 16

#     .equ NODE_hash, 0
#     .equ NODE_children_len, 32
#     .equ NODE_children, 40
#     .equ NODE_content_len, 48
#     .equ NODE_content, 56
#     .equ NODE_size, 64

#     .equ BUF_SIZE, 1 << 20
    # Every node takes at least 34 bytes on disk, so a full buf holds fewer
    # than MAX_NODES nodes: the node and pointer arenas cannot overflow.
#     .equ MAX_NODES, BUF_SIZE / 32

#     .section .text
#     .globl _start
:_start                                 # _start:
00009DE5                                #     ldr     r0, [sp]                    @ argc
020050E3                                #     cmp     r0, #2
^~usage BA                              #     blt     usage
030050E3                                #     cmp     r0, #3
^~usage CA                              #     bgt     usage
^~_start.1 BA                           #     blt     1f
0C109DE5                                #     ldr     r1, [sp, #12]               @ argv[2]
!out_path 002000E3 ~out_path 002040E3   #     la      r2, out_path
001082E5                                #     str     r1, [r2]
:_start.1 08109DE5                      # 1:  ldr     r1, [sp, #8]                @ argv[1]

6300E0E3                                #     mov     r0, #AT_FDCWD
0020A0E3                                #     mov     r2, #O_RDONLY
0030A0E3                                #     mov     r3, #0
427100E3                                #     movw    r7, #SYS_openat
000000EF                                #     svc     #0
000050E3                                #     cmp     r0, #0
^~open_failed BA                        #     blt     open_failed
0040A0E1                                #     mov     r4, r0                      @ fd

    # Read the whole file into buf.
!buf 008000E3 ~buf 008040E3             #     la      r8, buf
0890A0E1                                #     mov     r9, r8
015688E2                                #     add     r5, r8, #BUF_SIZE           @ end of buf
:read_loop                              # read_loop:
050059E1                                #     cmp     r9, r5
^~too_large 0A                          #     beq     too_large
0400A0E1                                #     mov     r0, r4
0910A0E1                                #     mov     r1, r9
092045E0                                #     sub     r2, r5, r9
0370A0E3                                #     mov     r7, #SYS_read
000000EF                                #     svc     #0
000050E3                                #     cmp     r0, #0
^~read_failed BA                        #     blt     read_failed
^~read_done 0A                          #     beq     read_done
009089E0                                #     add     r9, r9, r0
^~read_loop EA                          #     b       read_loop
:read_done                              # read_done:
0400A0E1                                #     mov     r0, r4
0670A0E3                                #     mov     r7, #SYS_close
000000EF                                #     svc     #0

!nodes 00A000E3 ~nodes 00A040E3         #     la      r10, nodes
!ptrs 00B000E3 ~ptrs 00B040E3           #     la      r11, ptrs
^~parse_node EB                         #     bl      parse_node
090058E1                                #     cmp     r8, r9
^~trailing 1A                           #     bne     trailing
!out_path 001000E3 ~out_path 001040E3   #     la      r1, out_path
001091E5                                #     ldr     r1, [r1]
000051E3                                #     cmp     r1, #0
^~assemble 1A                           #     bne     assemble
0010A0E3                                #     mov     r1, #0
^~print_node EB                         #     bl      print_node

0000A0E3                                #     mov     r0, #0
^~exit EA                               #     b       exit

# assemble: places the last page of root r0, the program, twice: pass 1
# finds the address of every label, pass 2 emits with them. Then writes
# the output file.
:assemble                               # assemble:
0060A0E1                                #     mov     r6, r0                      @ root
^~collect_syms EB                       #     bl      collect_syms
2000D6E5                                #     ldrb    r0, [r6, #NODE_children_len]
000050E3                                #     cmp     r0, #0
^~assemble.2 0A                         #     beq     2f
281096E5                                #     ldr     r1, [r6, #NODE_children]
801181E0                                #     add     r1, r1, r0, lsl #3
087011E5                                #     ldr     r7, [r1, #-8]               @ the program page
0180A0E3                                #     mov     r8, #1                      @ pass
:assemble.1 !pass 000000E3 ~pass 000040E3 # 1:  la      r0, pass
008080E5                                #     str     r8, [r0]
!cur_pc 000000E3 ~cur_pc 000040E3       #     la      r0, cur_pc
0020A0E3                                #     mov     r2, #0
0030A0E3                                #     mov     r3, #0
F020C0E1                                #     strd    r2, r3, [r0]
!in_bss 000000E3 ~in_bss 000040E3       #     la      r0, in_bss
002080E5                                #     str     r2, [r0]
!out_end 000000E3 ~out_end 000040E3     #     la      r0, out_end
!outbuf 001000E3 ~outbuf 001040E3       #     la      r1, outbuf
001080E5                                #     str     r1, [r0]
!label_next 000000E3 ~label_next 000040E3 #     la      r0, label_next
!labels 001000E3 ~labels 001040E3       #     la      r1, labels
001080E5                                #     str     r1, [r0]
!scopes 000000E3 ~scopes 000040E3       #     la      r0, scopes                  @ the page is the outermost scope
007080E5                                #     str     r7, [r0]
!scope_depth 000000E3 ~scope_depth 000040E3 #     la      r0, scope_depth
0110A0E3                                #     mov     r1, #1
001080E5                                #     str     r1, [r0]
0700A0E1                                #     mov     r0, r7
^~run_placed EB                         #     bl      run_placed
018088E2                                #     add     r8, r8, #1
030058E3                                #     cmp     r8, #3
^~assemble.1 1A                         #     bne     1b
:assemble.2 ^~write_output EB           # 2:  bl      write_output
0000A0E3                                #     mov     r0, #0
^~exit EA                               #     b       exit

# The errors of loading (kept here, next to _start and parse_node, as in
# ttpc.s, where they had to be within branch reach).
:usage                                  # usage:
!msg_usage 001000E3 ~msg_usage 001040E3 #     la      r1, msg_usage
1E20A0E3                                #     mov     r2, #msg_usage_len
^~die EA                                #     b       die
:open_failed                            # open_failed:
!msg_open 001000E3 ~msg_open 001040E3   #     la      r1, msg_open
1720A0E3                                #     mov     r2, #msg_open_len
^~die EA                                #     b       die
:read_failed                            # read_failed:
!msg_read 001000E3 ~msg_read 001040E3   #     la      r1, msg_read
1220A0E3                                #     mov     r2, #msg_read_len
^~die EA                                #     b       die
:too_large                              # too_large:
!msg_large 001000E3 ~msg_large 001040E3 #     la      r1, msg_large
1520A0E3                                #     mov     r2, #msg_large_len
^~die EA                                #     b       die
:truncated                              # truncated:
!msg_truncated 001000E3 ~msg_truncated 001040E3 #     la      r1, msg_truncated
1520A0E3                                #     mov     r2, #msg_truncated_len
^~die EA                                #     b       die
:trailing                               # trailing:
!msg_trailing 001000E3 ~msg_trailing 001040E3 #     la      r1, msg_trailing
2920A0E3                                #     mov     r2, #msg_trailing_len
^~die EA                                #     b       die

# parse_node: reads the node at r8 into a new NODE, recursing on its
# children, and leaves r8 just past it. Returns the NODE in r0.
:parse_node                             # parse_node:
70402DE9                                #     push    {r4, r5, r6, lr}
    # r4 this NODE, r5 next slot in its children array, r6 children left
    # to parse

210088E2                                #     add     r0, r8, #33                 @ hash + children_len
090050E1                                #     cmp     r0, r9
^~truncated 8A                          #     bhi     truncated
0A40A0E1                                #     mov     r4, r10
40A08AE2                                #     add     r10, r10, #NODE_size

2010A0E3                                #     mov     r1, #32                     @ copy the hash
0420A0E1                                #     mov     r2, r4
:parse_node.1 0030D8E5                  # 1:  ldrb    r3, [r8]
0030C2E5                                #     strb    r3, [r2, #NODE_hash]
018088E2                                #     add     r8, r8, #1
012082E2                                #     add     r2, r2, #1
011051E2                                #     subs    r1, r1, #1
^~parse_node.1 1A                       #     bne     1b

0060D8E5                                #     ldrb    r6, [r8]
018088E2                                #     add     r8, r8, #1
2060C4E5                                #     strb    r6, [r4, #NODE_children_len]
0B50A0E1                                #     mov     r5, r11
285084E5                                #     str     r5, [r4, #NODE_children]
86B18BE0                                #     add     r11, r11, r6, lsl #3
:parse_node.2 000056E3                  # 2:  cmp     r6, #0
^~parse_node.3 0A                       #     beq     3f
^~parse_node EB                         #     bl      parse_node
000085E5                                #     str     r0, [r5]
085085E2                                #     add     r5, r5, #8
016046E2                                #     sub     r6, r6, #1
^~parse_node.2 EA                       #     b       2b

:parse_node.3 090058E1                  # 3:  cmp     r8, r9
^~truncated 2A                          #     bhs     truncated
0000D8E5                                #     ldrb    r0, [r8]
018088E2                                #     add     r8, r8, #1
3000C4E5                                #     strb    r0, [r4, #NODE_content_len]
388084E5                                #     str     r8, [r4, #NODE_content]
008088E0                                #     add     r8, r8, r0
090058E1                                #     cmp     r8, r9
^~truncated 8A                          #     bhi     truncated

0400A0E1                                #     mov     r0, r4
7080BDE8                                #     pop     {r4, r5, r6, pc}

# print_node: prints NODE r0 at depth r1 as "<hash[0..4] in hex>  <indent>
# <content>", then its children one level deeper.
:print_node                             # print_node:
F0412DE9                                #     push    {r4, r5, r6, r7, r8, lr}
    # r4 this NODE, r5 depth, r6 counter, r7 next child pointer
0040A0E1                                #     mov     r4, r0
0150A0E1                                #     mov     r5, r1

!hexbuf 000000E3 ~hexbuf 000040E3       #     la      r0, hexbuf
!hexdigits 001000E3 ~hexdigits 001040E3 #     la      r1, hexdigits
0420A0E3                                #     mov     r2, #4
0430A0E1                                #     mov     r3, r4
:print_node.1 00C0D3E5                  # 1:  ldrb    r12, [r3, #NODE_hash]
2CE2A0E1                                #     lsr     lr, r12, #4
0EE0D1E7                                #     ldrb    lr, [r1, lr]
00E0C0E5                                #     strb    lr, [r0]
0FC00CE2                                #     and     r12, r12, #15
0CC0D1E7                                #     ldrb    r12, [r1, r12]
01C0C0E5                                #     strb    r12, [r0, #1]
020080E2                                #     add     r0, r0, #2
013083E2                                #     add     r3, r3, #1
012052E2                                #     subs    r2, r2, #1
^~print_node.1 1A                       #     bne     1b
!hexbuf 001000E3 ~hexbuf 001040E3       #     la      r1, hexbuf
0A20A0E3                                #     mov     r2, #10
^~write_out EB                          #     bl      write_out

0560A0E1                                #     mov     r6, r5
:print_node.2 000056E3                  # 2:  cmp     r6, #0
^~print_node.3 0A                       #     beq     3f
!indent 001000E3 ~indent 001040E3       #     la      r1, indent
0220A0E3                                #     mov     r2, #2
^~write_out EB                          #     bl      write_out
016046E2                                #     sub     r6, r6, #1
^~print_node.2 EA                       #     b       2b

:print_node.3 381094E5                  # 3:  ldr     r1, [r4, #NODE_content]
3020D4E5                                #     ldrb    r2, [r4, #NODE_content_len]
^~write_out EB                          #     bl      write_out
!newline 001000E3 ~newline 001040E3     #     la      r1, newline
0120A0E3                                #     mov     r2, #1
^~write_out EB                          #     bl      write_out

2060D4E5                                #     ldrb    r6, [r4, #NODE_children_len]
287094E5                                #     ldr     r7, [r4, #NODE_children]
:print_node.4 000056E3                  # 4:  cmp     r6, #0
^~print_node.5 0A                       #     beq     5f
000097E5                                #     ldr     r0, [r7]
