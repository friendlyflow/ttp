#
# The section .ARM.attributes: gas's build attributes (not loaded), as readelf -A says them
41                                      # format 'A'
1C000000                                # the subsection's length, 0x1c
616561626900                            # "aeabi" and its 0
0112000000                              # Tag_File 1, then the length of its attributes, 0x12
05372D4100                              # Tag_CPU_name 5: "7-A" and its 0
060A                                    # Tag_CPU_arch 6: 10, v7
0741                                    # Tag_CPU_arch_profile 7: 'A', application
0801                                    # Tag_ARM_ISA_use 8: 1, yes
0902                                    # Tag_THUMB_ISA_use 9: 2, Thumb-2
#
# The section .bss: no bytes in the file, only its labels
#     .section .bss
#     .balign 8
^00012D08 :nodes                        # nodes:          .skip MAX_NODES * NODE_size
^00212D08 :ptrs                         # ptrs:           .skip MAX_NODES * 8
^00252D08 :syms                         # syms:           .skip MAX_NODES * 8         @ the function NODEs, see collect_syms
^00292D08 :labels                       # labels:         .skip MAX_NODES * LABEL_size
^00352D08 :scopes                       # scopes:         .skip MAX_DEPTH * 8         @ the placed functions around pc
^00352F08 :vregs                        # vregs:          .skip 32 * 8                @ the registers of exec context
^00353008 :linebuf                      # linebuf:        .skip 24                    @ hex of an emitted word
^00353020 :outbuf                       # outbuf:         .skip OUT_SIZE
^00453020 :buf                          # buf:            .skip BUF_SIZE

# Registers that live across the loading (s0..s3 of ttpc.s):
#   r8   parse cursor in buf
#   r9   end of the loaded bytes
#   r10  next free NODE in nodes
#   r11  next free slot in ptrs

