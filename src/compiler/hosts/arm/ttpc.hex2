# ---------------------------------------------------------------------------
# 64-bit values: what RV64 does in one instruction. Value in r0:r1, result
# in r0:r1; they touch only r0-r3 and r12. (A register-specified LSL or LSR
# by 32 to 255 gives 0, ASR by 32 to 255 the sign.)
# ---------------------------------------------------------------------------

# sll64: r0:r1 <<= r2 mod 64.
:sll64                                  # sll64:
3F2002E2                                #     and     r2, r2, #63
1112A0E1                                #     lsl     r1, r1, r2
203042E2                                #     sub     r3, r2, #32                 @ n >= 32: lo << (n - 32)
101381E1                                #     orr     r1, r1, r0, lsl r3
203062E2                                #     rsb     r3, r2, #32                 @ n < 32: lo >> (32 - n)
301381E1                                #     orr     r1, r1, r0, lsr r3
1002A0E1                                #     lsl     r0, r0, r2
1EFF2FE1                                #     bx      lr

# srl64: r0:r1 >>= r2 mod 64, logical.
:srl64                                  # srl64:
3F2002E2                                #     and     r2, r2, #63
3002A0E1                                #     lsr     r0, r0, r2
203042E2                                #     sub     r3, r2, #32                 @ n >= 32: hi >> (n - 32)
310380E1                                #     orr     r0, r0, r1, lsr r3
203062E2                                #     rsb     r3, r2, #32                 @ n < 32: hi << (32 - n)
110380E1                                #     orr     r0, r0, r1, lsl r3
3112A0E1                                #     lsr     r1, r1, r2
1EFF2FE1                                #     bx      lr

# sra64: r0:r1 >>= r2 mod 64, arithmetic.
:sra64                                  # sra64:
3F2002E2                                #     and     r2, r2, #63
3002A0E1                                #     lsr     r0, r0, r2
203062E2                                #     rsb     r3, r2, #32                 @ n < 32: hi << (32 - n)
110380E1                                #     orr     r0, r0, r1, lsl r3
203052E2                                #     subs    r3, r2, #32                 @ n >= 32: hi >> (n - 32), signed
51038051                                #     orrpl   r0, r0, r1, asr r3
5112A0E1                                #     asr     r1, r1, r2
1EFF2FE1                                #     bx      lr

# mul64: r0:r1 = the low 64 bits of r0:r1 * r2:r3.
:mul64                                  # mul64:
90030CE0                                #     mul     r12, r0, r3                 @ lo * hi'
91C22CE0                                #     mla     r12, r1, r2, r12            @ + hi * lo'
900281E0                                #     umull   r0, r1, r0, r2              @ lo * lo'
0C1081E0                                #     add     r1, r1, r12
1EFF2FE1                                #     bx      lr

# remu64: r0:r1 = r0:r1 mod r2:r3, unsigned; r0:r1 when r2:r3 is 0, as
# remu. Keeps r2:r3. Restoring division, one bit at a time.
:remu64                                 # remu64:
03C092E1                                #     orrs    r12, r2, r3
1EFF2F01                                #     bxeq    lr
70402DE9                                #     push    {r4, r5, r6, lr}
0040A0E3                                #     mov     r4, #0                      @ the remainder
0050A0E3                                #     mov     r5, #0
4060A0E3                                #     mov     r6, #64
:remu64.1 000090E0                      # 1:  adds    r0, r0, r0                  @ remainder:dividend <<= 1
0110B1E0                                #     adcs    r1, r1, r1
0440B4E0                                #     adcs    r4, r4, r4
0550B5E0                                #     adcs    r5, r5, r5
^~remu64.2 2A                           #     bcs     2f                          @ past 64 bits: surely >= divisor
020054E1                                #     cmp     r4, r2
03C0D5E0                                #     sbcs    r12, r5, r3
^~remu64.3 3A                           #     bcc     3f
:remu64.2 024054E0                      # 2:  subs    r4, r4, r2
0350C5E0                                #     sbc     r5, r5, r3
:remu64.3 016056E2                      # 3:  subs    r6, r6, #1
^~remu64.1 1A                           #     bne     1b
0400A0E1                                #     mov     r0, r4
0510A0E1                                #     mov     r1, r5
7080BDE8                                #     pop     {r4, r5, r6, pc}

