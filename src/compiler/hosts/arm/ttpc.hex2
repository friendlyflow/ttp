# The ops of exec_ops: r0:r1 = v1 (r0:r1) op v0 (r2:r3), then exec_store,
# still in the frame of execute.
:op_add                                 # op_add:
020090E0                                #     adds    r0, r0, r2
0310A1E0                                #     adc     r1, r1, r3
^~exec_store EA                         #     b       exec_store
:op_sub                                 # op_sub:
020050E0                                #     subs    r0, r0, r2
0310C1E0                                #     sbc     r1, r1, r3
^~exec_store EA                         #     b       exec_store
:op_and                                 # op_and:
020000E0                                #     and     r0, r0, r2
031001E0                                #     and     r1, r1, r3
^~exec_store EA                         #     b       exec_store
:op_or                                  # op_or:
020080E1                                #     orr     r0, r0, r2
031081E1                                #     orr     r1, r1, r3
^~exec_store EA                         #     b       exec_store
:op_xor                                 # op_xor:
020020E0                                #     eor     r0, r0, r2
031021E0                                #     eor     r1, r1, r3
^~exec_store EA                         #     b       exec_store
:op_sll                                 # op_sll:
^~sll64 EB                              #     bl      sll64
^~exec_store EA                         #     b       exec_store
:op_srl                                 # op_srl:
^~srl64 EB                              #     bl      srl64
^~exec_store EA                         #     b       exec_store
:op_sra                                 # op_sra:
^~sra64 EB                              #     bl      sra64
^~exec_store EA                         #     b       exec_store
:op_mul                                 # op_mul:
^~mul64 EB                              #     bl      mul64
# exec_store: stores r0:r1 in the destination vreg r9 (r11 its high word)
# and returns from execute.
:exec_store                             # exec_store:
0BC099E1                                #     orrs    r12, r9, r11                @ x0 stays 0
^~exec_store.1 0A                       #     beq     1f
!vregs 00C000E3 ~vregs 00C040E3         #     la      r12, vregs
89C18CE0                                #     add     r12, r12, r9, lsl #3
F000CCE1                                #     strd    r0, r1, [r12]
:exec_store.1 00E09DE5                  # 1:  ldr     lr, [sp, #0]
08409DE5                                #     ldr     r4, [sp, #8]
10509DE5                                #     ldr     r5, [sp, #16]
18609DE5                                #     ldr     r6, [sp, #24]
20709DE5                                #     ldr     r7, [sp, #32]
28809DE5                                #     ldr     r8, [sp, #40]
30909DE5                                #     ldr     r9, [sp, #48]
38A09DE5                                #     ldr     r10, [sp, #56]
50B09DE5                                #     ldr     r11, [sp, #80]
60D08DE2                                #     add     sp, sp, #96
1EFF2FE1                                #     bx      lr

# ---------------------------------------------------------------------------
# Encoding and output
# ---------------------------------------------------------------------------

# encode: encodes instruction r0, its parameters bound in frame r1: r0:r1 =
# the word, r2 = its width in bits (8, 16, 32 or 64). The fields come MSB
# first: word = word << width | value.
:encode                                 # encode:
60D04DE2                                #     sub     sp, sp, #96
00E08DE5                                #     str     lr, [sp, #0]
08408DE5                                #     str     r4, [sp, #8]                @ the instruction
10508DE5                                #     str     r5, [sp, #16]               @ frame
18608DE5                                #     str     r6, [sp, #24]               @ fields left
20708DE5                                #     str     r7, [sp, #32]               @ next field
28808DE5                                #     str     r8, [sp, #40]               @ word, lo (r8:r9)
30908DE5                                #     str     r9, [sp, #48]               @ word, hi
38A08DE5                                #     str     r10, [sp, #56]              @ width so far, lo (r10:r11)
40B08DE5                                #     str     r11, [sp, #64]              @ width so far, hi
    # 72(sp): width of this field (s10), 64 bits; 80(sp): its value
0040A0E1                                #     mov     r4, r0
0150A0E1                                #     mov     r5, r1
^~param_count EB                        #     bl      param_count
2060D4E5                                #     ldrb    r6, [r4, #NODE_children_len]
006046E0                                #     sub     r6, r6, r0
287094E5                                #     ldr     r7, [r4, #NODE_children]
807187E0                                #     add     r7, r7, r0, lsl #3
0080A0E3                                #     mov     r8, #0
0090A0E3                                #     mov     r9, #0
00A0A0E3                                #     mov     r10, #0
00B0A0E3                                #     mov     r11, #0
:encode.1 000056E3                      # 1:  cmp     r6, #0
^~encode.4 0A                           #     beq     4f
000097E5                                #     ldr     r0, [r7]
^~is_fn EB                              #     bl      is_fn
00C097E5                                #     ldr     r12, [r7]
000050E3                                #     cmp     r0, #0
^~encode.2 0A                           #     beq     2f
2010DCE5                                #     ldrb    r1, [r12, #NODE_children_len] @ a fixed field: its child is its bits
000051E3                                #     cmp     r1, #0
^~encode.8 0A                           #     beq     8f
28109CE5                                #     ldr     r1, [r12, #NODE_children]
001091E5                                #     ldr     r1, [r1]
380091E5                                #     ldr     r0, [r1, #NODE_content]
3020D1E5                                #     ldrb    r2, [r1, #NODE_content_len]
0030A0E3                                #     mov     r3, #0
F824CDE1                                #     strd    r2, r3, [sp, #72]
0210A0E1                                #     mov     r1, r2
^~parse_bits EB                         #     bl      parse_bits
^~encode.3 EA                           #     b       3f
:encode.2 0C00A0E1                      # 2:  mov     r0, r12                     @ a slice call: run it, value in a0
0510A0E1                                #     mov     r1, r5
^~exec_call EB                          #     bl      exec_call
00C097E5                                #     ldr     r12, [r7]
38009CE5                                #     ldr     r0, [r12, #NODE_content]
3010DCE5                                #     ldrb    r1, [r12, #NODE_content_len]
^~slice_width EB                        #     bl      slice_width
F804CDE1                                #     strd    r0, r1, [sp, #72]
!vregs 002000E3 ~vregs 002040E3         #     la      r2, vregs
D005C2E1                                #     ldrd    r0, r1, [r2, #VREG_a0*8]
:encode.3 D824CDE1                      # 3:  ldrd    r2, r3, [sp, #72]
400052E3                                #     cmp     r2, #64
00005303                                #     cmpeq   r3, #0
^~encode.10 0A                          #     beq     10f                         @ a 64-bit field is the whole word
F005CDE1                                #     strd    r0, r1, [sp, #80]
0100A0E3                                #     mov     r0, #1                      @ value &= (1 << width) - 1
0010A0E3                                #     mov     r1, #0
^~sll64 EB                              #     bl      sll64
010050E2                                #     subs    r0, r0, #1
0010C1E2                                #     sbc     r1, r1, #0
D025CDE1                                #     ldrd    r2, r3, [sp, #80]
002002E0                                #     and     r2, r2, r0
013003E0                                #     and     r3, r3, r1
F025CDE1                                #     strd    r2, r3, [sp, #80]
0800A0E1                                #     mov     r0, r8                      @ word <<= width
0910A0E1                                #     mov     r1, r9
48209DE5                                #     ldr     r2, [sp, #72]
^~sll64 EB                              #     bl      sll64
0080A0E1                                #     mov     r8, r0
0190A0E1                                #     mov     r9, r1
D005CDE1                                #     ldrd    r0, r1, [sp, #80]
:encode.10 008088E1                     # 10: orr     r8, r8, r0
019089E1                                #     orr     r9, r9, r1
D824CDE1                                #     ldrd    r2, r3, [sp, #72]
02A09AE0                                #     adds    r10, r10, r2
03B0ABE0                                #     adc     r11, r11, r3
087087E2                                #     add     r7, r7, #8
016046E2                                #     sub     r6, r6, #1
^~encode.1 EA                           #     b       1b
:encode.4 00005BE3                      # 4:  cmp     r11, #0
^~encode.9 1A                           #     bne     9f
08005AE3                                #     cmp     r10, #8
10005A13                                #     cmpne   r10, #16
20005A13                                #     cmpne   r10, #32
40005A13                                #     cmpne   r10, #64
^~encode.9 1A                           #     bne     9f
:encode.5 0800A0E1                      # 5:  mov     r0, r8
0910A0E1                                #     mov     r1, r9
0A20A0E1                                #     mov     r2, r10
00E09DE5                                #     ldr     lr, [sp, #0]
08409DE5                                #     ldr     r4, [sp, #8]
10509DE5                                #     ldr     r5, [sp, #16]
18609DE5                                #     ldr     r6, [sp, #24]
20709DE5                                #     ldr     r7, [sp, #32]
28809DE5                                #     ldr     r8, [sp, #40]
30909DE5                                #     ldr     r9, [sp, #48]
38A09DE5                                #     ldr     r10, [sp, #56]
40B09DE5                                #     ldr     r11, [sp, #64]
60D08DE2                                #     add     sp, sp, #96
1EFF2FE1                                #     bx      lr
:encode.8 !msg_field 001000E3 ~msg_field 001040E3 # 8:  la      r1, msg_field
2020A0E3                                #     mov     r2, #msg_field_len
38309CE5                                #     ldr     r3, [r12, #NODE_content]
30C0DCE5                                #     ldrb    r12, [r12, #NODE_content_len]
^~die_name EA                           #     b       die_name
:encode.9 !msg_width 001000E3 ~msg_width 001040E3 # 9:  la      r1, msg_width
2920A0E3                                #     mov     r2, #msg_width_len
383094E5                                #     ldr     r3, [r4, #NODE_content]
30C0D4E5                                #     ldrb    r12, [r4, #NODE_content_len]
^~die_name EA                           #     b       die_name

# emit: emits the r2-bit word r0:r1, little endian, and in pass 2 prints it
# as "<hex>  <name of call r3>".
:emit                                   # emit:
F0472DE9                                #     push    {r4-r10, lr}
08D04DE2                                #     sub     sp, sp, #8
    # r4:r5 word, r6 width, r7 the call; r8 next byte of linebuf, r9 hex
    # digits left, r10 shift of the next one; 0(sp): the word in memory
0040A0E1                                #     mov     r4, r0
0150A0E1                                #     mov     r5, r1
0260A0E1                                #     mov     r6, r2
0370A0E1                                #     mov     r7, r3
F040CDE1                                #     strd    r4, r5, [sp]
0D00A0E1                                #     mov     r0, sp
A611A0E1                                #     lsr     r1, r6, #3
^~emit_raw EB                           #     bl      emit_raw
!pass 000000E3 ~pass 000040E3           #     la      r0, pass
000090E5                                #     ldr     r0, [r0]
020050E3                                #     cmp     r0, #2
^~emit.5 1A                             #     bne     5f
!linebuf 008000E3 ~linebuf 008040E3     #     la      r8, linebuf
2691A0E1                                #     lsr     r9, r6, #2                  @ hex digits
04A046E2                                #     sub     r10, r6, #4                 @ shift of the next one
:emit.3 000059E3                        # 3:  cmp     r9, #0
^~emit.4 0A                             #     beq     4f
0400A0E1                                #     mov     r0, r4
0510A0E1                                #     mov     r1, r5
0A20A0E1                                #     mov     r2, r10
^~srl64 EB                              #     bl      srl64
0F0000E2                                #     and     r0, r0, #15
!hexdigits 001000E3 ~hexdigits 001040E3 #     la      r1, hexdigits
0000D1E7                                #     ldrb    r0, [r1, r0]
0000C8E5                                #     strb    r0, [r8]
018088E2                                #     add     r8, r8, #1
04A04AE2                                #     sub     r10, r10, #4
019049E2                                #     sub     r9, r9, #1
^~emit.3 EA                             #     b       3b
:emit.4 2000A0E3                        # 4:  mov     r0, #CH_space
0000C8E5                                #     strb    r0, [r8]
0100C8E5                                #     strb    r0, [r8, #1]
028088E2                                #     add     r8, r8, #2
!linebuf 001000E3 ~linebuf 001040E3     #     la      r1, linebuf
