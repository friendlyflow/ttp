#
# The section .data, from here its lines of hosts/arm/ttpc.s
#     .section .data
:hexbuf 30303030303030302020            # hexbuf:         .ascii "00000000  "         @ hash prefix of a printed line
000000000000                            #     .balign 8
# Each a .dword of ttpc.s: low word, high word.
:out_path 0000000000000000              # out_path:       .word 0, 0                  @ argv[2], 0 when only printing
:out_end &outbuf 00000000               # out_end:        .word outbuf, 0             @ next free byte in outbuf
:syms_end &syms 00000000                # syms_end:       .word syms, 0               @ next free slot in syms
:labels_end &labels 00000000            # labels_end:     .word labels, 0             @ next free LABEL (pass 1)
:label_next &labels 00000000            # label_next:     .word labels, 0             @ next LABEL to check (pass 2)
:pass 0000000000000000                  # pass:           .word 0, 0                  @ 1 or 2
:cur_pc 0000000000000000                # cur_pc:         .word 0, 0                  @ address of the next byte (64 bits)
:in_bss 0000000000000000                # in_bss:         .word 0, 0                  @ 1 after the builtin bss
:scope_depth 0000000000000000           # scope_depth:    .word 0, 0                  @ placed functions in scopes

# The exec seed: the instructions that exec context runs itself, rd = v1 op
# v0, with v0 and v1 the other operands in parameter order (rs2 rs1, or imm
# rs1, or shamt rs1). The code pointer is the .dword of ttpc.s: the address
# and a 0 high word, so OP_size stays 16.
:exec_ops                               # exec_ops:
6164640000000000                        #     .ascii "add\0\0\0\0\0"
&op_add 00000000                        #     .word   op_add, 0
6164646900000000                        #     .ascii "addi\0\0\0\0"
&op_add 00000000                        #     .word   op_add, 0
7375620000000000                        #     .ascii "sub\0\0\0\0\0"
&op_sub 00000000                        #     .word   op_sub, 0
616E640000000000                        #     .ascii "and\0\0\0\0\0"
