#
# gen/hex/arm/hex2.s as hex0 text, made by gen/mkhex.pl: each line the bytes of
# one asm line, then its file offset and the line. hex0 reads only the
# hex digits before each '#'.
#
# hex2 for arm Linux (EABI): hex0 with labels. The second link of the
# bootstrap, built by hex0 from hosts/arm/hex2.hex0 (made from this file
# once by gen/mkhex.pl, a dev aid; the chain never reads this file). It
# builds the seed, ttpc, from hosts/arm/ttpc.hex2.
#
#   hex2 < file.hex2 > file
#
# As hex0: each pair of hex digits is a byte, '#' and ';' start a comment
# to the end of the line, every other byte is skipped. And the address of
# the next byte, which starts at 0 and counts every byte written:
#   :name    defines the label name, at that address
#   &name    4 bytes, little endian: name's address (an abs32)
#   ^hex     the address of the next byte is this hex number (where a
#            file's addresses jump: its next segment, the labels of a bss)
#   ^~name   stage0-posix's branch (B, BL, B<cond>): d, name's address
#            minus the address of the next byte (the instruction's own)
#            minus 8 (the pc reads 8 ahead), in 26 bits, a multiple of 4;
#            its 3 bytes are written: imm24 (d / 4). The byte after them,
#            written as hex, is cond and the opcode: EA B, EB BL, 0A BEQ,
#            1A BNE, ...
# and ARM's other references, which stage0-posix's hex2 does without (its
# code loads addresses from words after it): each scatters its bits into
# an instruction's immediate field and XORs them into the next bytes
# written (the instruction, written with that field zero), as riscv64's
# and aarch64's:
#   !name    MOVW's :lower16:: name's address, its bits 11:0 to 11:0
#            (imm12), 15:12 to 19:16 (imm4)
#   ~name    MOVT's :upper16:: its bits 27:16 to 11:0, 31:28 to 19:16
# Their bit layouts are the table kinds before the code, each a list of
# (from bit, bits, to bit) as the Arm manual draws the fields. A name is
# every byte after the sign up to a space, tab or newline. The input is
# read whole, then twice: the first pass gives every label its address,
# the second writes. On an unknown label, a label defined twice, a
# reference out of range, a full table or input and a failed read or
# write it says so on stderr and ends with status 1; else with 0.
#
# One flat file, loaded at BASE by its first program header, read and
# run; the second maps the memory it writes, LABELS to the end of INPUT.
# ARM state (ARMv7-A): every instruction is 4 bytes, its condition in its
# top 4 bits. The registers:
#   r4  the next byte of the input          r5  the end of the input
#   r6  the address of the next byte        r8  the pass, 1 or 2
#   r9  the high half of a byte, or -1      r10 the next free label
#   r11 the bits to XOR into the next bytes written, the lowest first
#   r7  the system call's number, else scratch, as r0-r3, r12 and lr
# A label is 12 bytes: the address of its name in the input, the name's
# length, its address.

#     .syntax unified
#     .arch armv7-a
#     .arm
#     .equ BASE, 0x10000
#     .equ LABELS, 0x100000               @ 65536 labels of 12 bytes
#     .equ LABELS_END, LABELS + 0x10000 * 12
#     .equ INPUT, 0x200000                @ 16 MiB of input
#     .equ INPUT_END, INPUT + 0x1000000
#     .equ SYS_read, 3
#     .equ SYS_write, 4
#     .equ SYS_exit, 1

# la: reg = the address of sym (movw, movt: its low and high 16 bits)
#     .macro la reg, sym
#     movw    \reg, #:lower16:(BASE + \sym - ehdr)
#     movt    \reg, #:upper16:(BASE + \sym - ehdr)
#     .endm

# 0000  ehdr:                                   @ the ELF header, 52 bytes
7F454C46                # 0000      .byte 0x7f, 0x45, 0x4c, 0x46        @ e_ident: the magic, 0x7f 'E' 'L' 'F'
01                      # 0004      .byte 1                             @ EI_CLASS: ELFCLASS32
01                      # 0005      .byte 1                             @ EI_DATA: ELFDATA2LSB, little endian
01                      # 0006      .byte 1                             @ EI_VERSION: EV_CURRENT
00                      # 0007      .byte 0                             @ EI_OSABI: System V
0000000000000000        # 0008      .byte 0, 0, 0, 0, 0, 0, 0, 0        @ EI_ABIVERSION 0, then padding to 16
0200                    # 0010      .hword 2                            @ e_type: ET_EXEC, an executable
2800                    # 0012      .hword 40                           @ e_machine: EM_ARM
01000000                # 0014      .word 1                             @ e_version: EV_CURRENT
30010100                # 0018      .word BASE + _start - ehdr          @ e_entry: the address of _start
34000000                # 001c      .word phdr - ehdr                   @ e_phoff: the program headers follow
00000000                # 0020      .word 0                             @ e_shoff: no section headers
00020005                # 0024      .word 0x05000200                    @ e_flags: EABI version 5, soft float
3400                    # 0028      .hword 52                           @ e_ehsize: this header's size
2000                    # 002a      .hword 32                           @ e_phentsize: a program header's size
0200                    # 002c      .hword 2                            @ e_phnum: two program headers
0000                    # 002e      .hword 0                            @ e_shentsize: no section headers
0000                    # 0030      .hword 0                            @ e_shnum: none
0000                    # 0032      .hword 0                            @ e_shstrndx: none
# 0034  phdr:                                   @ the program: 32 bytes
01000000                # 0034      .word 1                             @ p_type: PT_LOAD
00000000                # 0038      .word 0                             @ p_offset: from the file's first byte
00000100                # 003c      .word BASE                          @ p_vaddr: loaded at BASE
00000100                # 0040      .word BASE                          @ p_paddr: the same
60050000                # 0044      .word end - ehdr                    @ p_filesz: the whole file
60050000                # 0048      .word end - ehdr                    @ p_memsz: the same
05000000                # 004c      .word 5                             @ p_flags: PF_R | PF_X, read and run
00100000                # 0050      .word 0x1000                        @ p_align: a page
                                        # its memory: 32 bytes
01000000                # 0054      .word 1                             @ p_type: PT_LOAD
00000000                # 0058      .word 0                             @ p_offset: none of the file
00001000                # 005c      .word LABELS                        @ p_vaddr: the labels, then the input
00001000                # 0060      .word LABELS                        @ p_paddr: the same
00000000                # 0064      .word 0                             @ p_filesz: none, all zero
00001001                # 0068      .word INPUT_END - LABELS            @ p_memsz: to the end of the input
06000000                # 006c      .word 6                             @ p_flags: PF_R | PF_W, read and write
00100000                # 0070      .word 0x1000                        @ p_align: a page

# The kinds of reference: its sign; its mode (1: name's address, not d;
# 4: its bytes written, not XORed); the bits it must fit in, signed; how
# many low bits must be zero; what d has subtracted (the pc's 8); its
# pieces, then each piece: the bit it starts at, its bits, the bit of the
# field it goes to.
# 0074  kinds:
5E041A020801            # 0074      .byte 0x5e, 4, 26, 2, 8, 1          @ '^' (^~name) B, BL: 3 bytes written
021800                  # 007a      .byte 2, 24, 0                      @   imm24, d[25:2]
210120000002            # 007d      .byte 0x21, 1, 32, 0, 0, 2          @ '!' MOVW :lower16:, name's address
000C00                  # 0083      .byte 0, 12, 0                      @   imm12, bits 11:0
0C0410                  # 0086      .byte 12, 4, 16                     @   imm4, bits 15:12 to 19:16
7E0120000002            # 0089      .byte 0x7e, 1, 32, 0, 0, 2          @ '~' MOVT :upper16:, name's address
100C00                  # 008f      .byte 16, 12, 0                     @   imm12, bits 27:16 to 11:0
1C0410                  # 0092      .byte 28, 4, 16                     @   imm4, bits 31:28 to 19:16
00                      # 0095      .byte 0                             @ the end of the kinds

686578323A20756E6B6E6F776E206C61 # 0096  msg_unknown:    .asciz "hex2: unknown label: "
62656C3A2000
686578323A206C6162656C2064656669 # 00ac  msg_twice:      .asciz "hex2: label defined twice: "
6E65642074776963653A2000
686578323A206F7574206F662072616E # 00c8  msg_range:      .asciz "hex2: out of range: "
67653A2000
686578323A20746F6F206D616E79206C # 00dd  msg_many:       .asciz "hex2: too many labels"
6162656C7300
686578323A20696E70757420746F6F20 # 00f3  msg_large:      .asciz "hex2: input too large"
6C6172676500
686578323A2072656164206661696C65 # 0109  msg_read:       .asciz "hex2: read failed"
6400
686578323A207772697465206661696C # 011b  msg_write:      .asciz "hex2: write failed"
656400
0A                      # 012e  newline:        .ascii "\n"
00                      # 012f      .balign 4                           @ the code, 4-byte aligned (zeros)

