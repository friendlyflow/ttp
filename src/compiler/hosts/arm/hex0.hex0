#
# gen/hex/arm/hex0.s as hex0 text, made by gen/mkhex.pl: each line the bytes of
# one asm line, then its file offset and the line. hex0 reads only the
# hex digits before each '#'.
#
# hex0 for arm Linux (EABI): hex pairs in, bytes out. The first link of
# the bootstrap: everything after it is built from text by programs built
# from text. Its bytes are hosts/arm/hex0.hex0, made from this file once by
# gen/mkhex.pl (a dev aid); the chain never reads this file.
#
#   hex0 < file.hex0 > file
#
# Each pair of hex digits (0-9, A-F, a-f) is one byte, the first digit its
# high half. '#' and ';' start a comment to the end of the line. Every
# other byte (spaces, newlines, ...) is skipped. At the end of stdin the
# status is 0 (a lone last digit is dropped); a failed read or write ends
# with status 1.
#
# One flat file, loaded whole at BASE by its one program header: no
# sections, no linker. ARM state (ARMv7-A, no Thumb): every instruction is
# 4 bytes, little endian, its fields as the Arm manual draws them, its
# condition (cond) in its top 4 bits, 1110 (al) unless it says otherwise.
# Only the stack is written (its first byte, argc's, is the buffer of a
# byte). The registers:
#   r4  the high half of the byte being read, or -1 before its first digit
#   r5  a digit's value
#   r7  the system call's number

#     .syntax unified
#     .arch armv7-a
#     .arm
#     .equ BASE, 0x10000
#     .equ SYS_read, 3
#     .equ SYS_write, 4
#     .equ SYS_exit, 1

# 0000  ehdr:                                   @ the ELF header, 52 bytes
7F454C46                # 0000      .byte 0x7f, 0x45, 0x4c, 0x46        @ e_ident: the magic, 0x7f 'E' 'L' 'F'
01                      # 0004      .byte 1                             @ EI_CLASS: ELFCLASS32
01                      # 0005      .byte 1                             @ EI_DATA: ELFDATA2LSB, little endian
01                      # 0006      .byte 1                             @ EI_VERSION: EV_CURRENT
00                      # 0007      .byte 0                             @ EI_OSABI: System V
0000000000000000        # 0008      .byte 0, 0, 0, 0, 0, 0, 0, 0        @ EI_ABIVERSION 0, then padding to 16
0200                    # 0010      .hword 2                            @ e_type: ET_EXEC, an executable
2800                    # 0012      .hword 40                           @ e_machine: EM_ARM
01000000                # 0014      .word 1                             @ e_version: EV_CURRENT
54000100                # 0018      .word BASE + _start - ehdr          @ e_entry: the address of _start
34000000                # 001c      .word phdr - ehdr                   @ e_phoff: the program header follows
00000000                # 0020      .word 0                             @ e_shoff: no section headers
00020005                # 0024      .word 0x05000200                    @ e_flags: EABI version 5, soft float
3400                    # 0028      .hword 52                           @ e_ehsize: this header's size
2000                    # 002a      .hword 32                           @ e_phentsize: a program header's size
0100                    # 002c      .hword 1                            @ e_phnum: one program header
0000                    # 002e      .hword 0                            @ e_shentsize: no section headers
0000                    # 0030      .hword 0                            @ e_shnum: none
0000                    # 0032      .hword 0                            @ e_shstrndx: none
# 0034  phdr:                                   @ the program header, 32 bytes
01000000                # 0034      .word 1                             @ p_type: PT_LOAD
00000000                # 0038      .word 0                             @ p_offset: from the file's first byte
00000100                # 003c      .word BASE                          @ p_vaddr: loaded at BASE
00000100                # 0040      .word BASE                          @ p_paddr: the same
20010000                # 0044      .word end - ehdr                    @ p_filesz: the whole file
20010000                # 0048      .word end - ehdr                    @ p_memsz: the same, no bss
05000000                # 004c      .word 5                             @ p_flags: PF_R | PF_X, read and run
00100000                # 0050      .word 0x1000                        @ p_align: a page

# 0054  _start:
0040E0E3                # 0054      mvn     r4, #0                      @ -1: no high half yet
#       MVN (immediate) 1110 00 1 1111 0 0000 0100 0000 00000000: cond 1110 al, I 1, opcode 1111 mvn, S 0, Rn none, Rd r4, rotate 0, imm8 0 (0)
# 0058  next:                                   @ the next byte of stdin
180000EB                # 0058      bl      getc                        @ r0 = the byte
#       BL 1110 101 1 000000000000000000011000: cond 1110 al, L 1 with link, imm24 24 (offset 96, from the instruction + 8)
230050E3                # 005c      cmp     r0, #0x23                   @ '#': a comment
#       CMP (immediate) 1110 00 1 1010 1 0000 0000 0000 00100011: cond 1110 al, I 1, opcode 1010 cmp, S 1, Rn r0, Rd none (only the flags), rotate 0, imm8 35 (35)
1200000A                # 0060      beq     comment
#       B 0000 101 0 000000000000000000010010: cond 0000 eq, L 0 without link, imm24 18 (offset 72, from the instruction + 8)
3B0050E3                # 0064      cmp     r0, #0x3b                   @ ';': a comment
#       CMP (immediate) 1110 00 1 1010 1 0000 0000 0000 00111011: cond 1110 al, I 1, opcode 1010 cmp, S 1, Rn r0, Rd none (only the flags), rotate 0, imm8 59 (59)
1000000A                # 0068      beq     comment
#       B 0000 101 0 000000000000000000010000: cond 0000 eq, L 0 without link, imm24 16 (offset 64, from the instruction + 8)
305040E2                # 006c      sub     r5, r0, #0x30               @ '0'-'9' to 0-9
#       SUB (immediate) 1110 00 1 0010 0 0000 0101 0000 00110000: cond 1110 al, I 1, opcode 0010 sub, S 0, Rn r0, Rd r5, rotate 0, imm8 48 (48)
0A0055E3                # 0070      cmp     r5, #10
#       CMP (immediate) 1110 00 1 1010 1 0101 0000 0000 00001010: cond 1110 al, I 1, opcode 1010 cmp, S 1, Rn r5, Rd none (only the flags), rotate 0, imm8 10 (10)
0600003A                # 0074      blo     digit                       @ unsigned: below '0' is large
#       B 0011 101 0 000000000000000000000110: cond 0011 cc, L 0 without link, imm24 6 (offset 24, from the instruction + 8)
415040E2                # 0078      sub     r5, r0, #0x41               @ 'A'-'F' to 0-5
#       SUB (immediate) 1110 00 1 0010 0 0000 0101 0000 01000001: cond 1110 al, I 1, opcode 0010 sub, S 0, Rn r0, Rd r5, rotate 0, imm8 65 (65)
060055E3                # 007c      cmp     r5, #6
#       CMP (immediate) 1110 00 1 1010 1 0101 0000 0000 00000110: cond 1110 al, I 1, opcode 1010 cmp, S 1, Rn r5, Rd none (only the flags), rotate 0, imm8 6 (6)
0200003A                # 0080      blo     letter
#       B 0011 101 0 000000000000000000000010: cond 0011 cc, L 0 without link, imm24 2 (offset 8, from the instruction + 8)
615040E2                # 0084      sub     r5, r0, #0x61               @ 'a'-'f' to 0-5
#       SUB (immediate) 1110 00 1 0010 0 0000 0101 0000 01100001: cond 1110 al, I 1, opcode 0010 sub, S 0, Rn r0, Rd r5, rotate 0, imm8 97 (97)
060055E3                # 0088      cmp     r5, #6
#       CMP (immediate) 1110 00 1 1010 1 0101 0000 0000 00000110: cond 1110 al, I 1, opcode 1010 cmp, S 1, Rn r5, Rd none (only the flags), rotate 0, imm8 6 (6)
F1FFFF2A                # 008c      bhs     next                        @ anything else: skipped
#       B 0010 101 0 111111111111111111110001: cond 0010 cs, L 0 without link, imm24 -15 (offset -60, from the instruction + 8)
# 0090  letter:
0A5085E2                # 0090      add     r5, r5, #10                 @ 10-15
#       ADD (immediate) 1110 00 1 0100 0 0101 0101 0000 00001010: cond 1110 al, I 1, opcode 0100 add, S 0, Rn r5, Rd r5, rotate 0, imm8 10 (10)
# 0094  digit:                                  @ r5 = the digit's value, 0-15
000054E3                # 0094      cmp     r4, #0                      @ the first digit of a pair?
#       CMP (immediate) 1110 00 1 1010 1 0100 0000 0000 00000000: cond 1110 al, I 1, opcode 1010 cmp, S 1, Rn r4, Rd none (only the flags), rotate 0, imm8 0 (0)
020000BA                # 0098      blt     high
#       B 1011 101 0 000000000000000000000010: cond 1011 lt, L 0 without link, imm24 2 (offset 8, from the instruction + 8)
040285E0                # 009c      add     r0, r5, r4, lsl #4          @ the second: high half, then this one
#       ADD (register) 1110 00 0 0100 0 0101 0000 00100 00 0 0100: cond 1110 al, I 0, opcode 0100 add, S 0, Rn r5, Rd r0, imm5 4, type 00 lsl, Rm r4
100000EB                # 00a0      bl      putc
#       BL 1110 101 1 000000000000000000010000: cond 1110 al, L 1 with link, imm24 16 (offset 64, from the instruction + 8)
EAFFFFEA                # 00a4      b       _start                      @ the next pair
#       B 1110 101 0 111111111111111111101010: cond 1110 al, L 0 without link, imm24 -22 (offset -88, from the instruction + 8)
# 00a8  high:
0540A0E1                # 00a8      mov     r4, r5                      @ keep it for the second
#       MOV (register) 1110 00 0 1101 0 0000 0100 00000 00 0 0101: cond 1110 al, I 0, opcode 1101 mov, S 0, Rn none, Rd r4, imm5 0, type 00 lsl, Rm r5
E9FFFFEA                # 00ac      b       next
#       B 1110 101 0 111111111111111111101001: cond 1110 al, L 0 without link, imm24 -23 (offset -92, from the instruction + 8)
# 00b0  comment:                                @ skip to the end of the line
020000EB                # 00b0      bl      getc
#       BL 1110 101 1 000000000000000000000010: cond 1110 al, L 1 with link, imm24 2 (offset 8, from the instruction + 8)
0A0050E3                # 00b4      cmp     r0, #0x0a                   @ '\n'
#       CMP (immediate) 1110 00 1 1010 1 0000 0000 0000 00001010: cond 1110 al, I 1, opcode 1010 cmp, S 1, Rn r0, Rd none (only the flags), rotate 0, imm8 10 (10)
FCFFFF1A                # 00b8      bne     comment
#       B 0001 101 0 111111111111111111111100: cond 0001 ne, L 0 without link, imm24 -4 (offset -16, from the instruction + 8)
E5FFFFEA                # 00bc      b       next
#       B 1110 101 0 111111111111111111100101: cond 1110 al, L 0 without link, imm24 -27 (offset -108, from the instruction + 8)

# 00c0  getc:                                   @ r0 = the next byte of stdin
0370A0E3                # 00c0      mov     r7, #SYS_read
#       MOV (immediate) 1110 00 1 1101 0 0000 0111 0000 00000011: cond 1110 al, I 1, opcode 1101 mov, S 0, Rn none, Rd r7, rotate 0, imm8 3 (3)
0000A0E3                # 00c4      mov     r0, #0                      @ fd 0, stdin
#       MOV (immediate) 1110 00 1 1101 0 0000 0000 0000 00000000: cond 1110 al, I 1, opcode 1101 mov, S 0, Rn none, Rd r0, rotate 0, imm8 0 (0)
0D10A0E1                # 00c8      mov     r1, sp                      @ into the stack
#       MOV (register) 1110 00 0 1101 0 0000 0001 00000 00 0 1101: cond 1110 al, I 0, opcode 1101 mov, S 0, Rn none, Rd r1, imm5 0, type 00 lsl, Rm sp
0120A0E3                # 00cc      mov     r2, #1                      @ 1 byte
#       MOV (immediate) 1110 00 1 1101 0 0000 0010 0000 00000001: cond 1110 al, I 1, opcode 1101 mov, S 0, Rn none, Rd r2, rotate 0, imm8 1 (1)
000000EF                # 00d0      svc     #0
#       SVC 1110 1111 000000000000000000000000: cond 1110 al, imm24 0
000050E3                # 00d4      cmp     r0, #0
#       CMP (immediate) 1110 00 1 1010 1 0000 0000 0000 00000000: cond 1110 al, I 1, opcode 1010 cmp, S 1, Rn r0, Rd none (only the flags), rotate 0, imm8 0 (0)
0D0000BA                # 00d8      blt     fail                        @ a failed read
#       B 1011 101 0 000000000000000000001101: cond 1011 lt, L 0 without link, imm24 13 (offset 52, from the instruction + 8)
0A00000A                # 00dc      beq     done                        @ the end of stdin
#       B 0000 101 0 000000000000000000001010: cond 0000 eq, L 0 without link, imm24 10 (offset 40, from the instruction + 8)
0000DDE5                # 00e0      ldrb    r0, [sp]                    @ the byte, zero-extended
#       LDRB (immediate) 1110 010 1 1 1 0 1 1101 0000 000000000000: cond 1110 al, I 0, P 1, U 1 add, B 1, W 0, L 1 load, Rn sp, Rt r0 (offset), imm12 0
1EFF2FE1                # 00e4      bx      lr                          @ return
#       BX 1110 00010010 111111111111 0001 1110: cond 1110 al, Rm lr

# 00e8  putc:                                   @ writes r0's low byte to stdout
0000CDE5                # 00e8      strb    r0, [sp]
#       STRB (immediate) 1110 010 1 1 1 0 0 1101 0000 000000000000: cond 1110 al, I 0, P 1, U 1 add, B 1, W 0, L 0 store, Rn sp, Rt r0 (offset), imm12 0
0470A0E3                # 00ec      mov     r7, #SYS_write
#       MOV (immediate) 1110 00 1 1101 0 0000 0111 0000 00000100: cond 1110 al, I 1, opcode 1101 mov, S 0, Rn none, Rd r7, rotate 0, imm8 4 (4)
0100A0E3                # 00f0      mov     r0, #1                      @ fd 1, stdout
#       MOV (immediate) 1110 00 1 1101 0 0000 0000 0000 00000001: cond 1110 al, I 1, opcode 1101 mov, S 0, Rn none, Rd r0, rotate 0, imm8 1 (1)
0D10A0E1                # 00f4      mov     r1, sp                      @ from the stack
#       MOV (register) 1110 00 0 1101 0 0000 0001 00000 00 0 1101: cond 1110 al, I 0, opcode 1101 mov, S 0, Rn none, Rd r1, imm5 0, type 00 lsl, Rm sp
0120A0E3                # 00f8      mov     r2, #1                      @ 1 byte
#       MOV (immediate) 1110 00 1 1101 0 0000 0010 0000 00000001: cond 1110 al, I 1, opcode 1101 mov, S 0, Rn none, Rd r2, rotate 0, imm8 1 (1)
000000EF                # 00fc      svc     #0
#       SVC 1110 1111 000000000000000000000000: cond 1110 al, imm24 0
010050E3                # 0100      cmp     r0, #1                      @ written?
#       CMP (immediate) 1110 00 1 1010 1 0000 0000 0000 00000001: cond 1110 al, I 1, opcode 1010 cmp, S 1, Rn r0, Rd none (only the flags), rotate 0, imm8 1 (1)
0200001A                # 0104      bne     fail
#       B 0001 101 0 000000000000000000000010: cond 0001 ne, L 0 without link, imm24 2 (offset 8, from the instruction + 8)
1EFF2FE1                # 0108      bx      lr
#       BX 1110 00010010 111111111111 0001 1110: cond 1110 al, Rm lr

# 010c  done:
0000A0E3                # 010c      mov     r0, #0                      @ status 0
#       MOV (immediate) 1110 00 1 1101 0 0000 0000 0000 00000000: cond 1110 al, I 1, opcode 1101 mov, S 0, Rn none, Rd r0, rotate 0, imm8 0 (0)
000000EA                # 0110      b       exit
#       B 1110 101 0 000000000000000000000000: cond 1110 al, L 0 without link, imm24 0 (offset 0, from the instruction + 8)
# 0114  fail:
0100A0E3                # 0114      mov     r0, #1                      @ status 1
#       MOV (immediate) 1110 00 1 1101 0 0000 0000 0000 00000001: cond 1110 al, I 1, opcode 1101 mov, S 0, Rn none, Rd r0, rotate 0, imm8 1 (1)
# 0118  exit:
0170A0E3                # 0118      mov     r7, #SYS_exit
#       MOV (immediate) 1110 00 1 1101 0 0000 0111 0000 00000001: cond 1110 al, I 1, opcode 1101 mov, S 0, Rn none, Rd r7, rotate 0, imm8 1 (1)
000000EF                # 011c      svc     #0
#       SVC 1110 1111 000000000000000000000000: cond 1110 al, imm24 0
# 0120  end:
