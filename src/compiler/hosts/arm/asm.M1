# gen/hex/arm/asm.s as M1 text, made by gen/mkhex.pl, as stage0-posix's armv7l
# M1 writes ARM: first a DEFINE for each instruction it uses, its 4 bytes
# (little endian), named as objdump writes it (its first space '_', no
# other spaces, no '#'), and for the references to labels: JUMP_ALWAYS
# CALL_ALWAYS JUMP_EQUAL JUMP_NE ... the top byte of B, BL, B<cond> (cond
# and the opcode) after hex2's ^~label (imm24, its 3 low bytes), movw_rN
# after !label and movt_rN after ~label (la's pair, the immediate zero:
# hex2 XORs in label's low and high 16 bits). Then each asm line: :label
# for its labels, then its instructions. Data is hex or a "string" (its
# bytes, then 00). It starts at BASE (^00010000). M1 reads only what is
# before each '#'; M1's hex2 text is made by hex2.
#
DEFINE CALL_ALWAYS EB                   # BL: cond 1110 al, 101, L 1, after ^~label's 3 bytes (imm24)
DEFINE CALL_NE 1B                       # BL: cond 0001 ne, 101, L 1, after ^~label's 3 bytes (imm24)
DEFINE JUMP_ALWAYS EA                   # B: cond 1110 al, 101, L 0, after ^~label's 3 bytes (imm24)
DEFINE JUMP_CC 3A                       # B: cond 0011 cc, 101, L 0, after ^~label's 3 bytes (imm24)
DEFINE JUMP_CS 2A                       # B: cond 0010 cs, 101, L 0, after ^~label's 3 bytes (imm24)
DEFINE JUMP_EQUAL 0A                    # B: cond 0000 eq, 101, L 0, after ^~label's 3 bytes (imm24)
DEFINE JUMP_GE AA                       # B: cond 1010 ge, 101, L 0, after ^~label's 3 bytes (imm24)
DEFINE JUMP_HI 8A                       # B: cond 1000 hi, 101, L 0, after ^~label's 3 bytes (imm24)
DEFINE JUMP_LE DA                       # B: cond 1101 le, 101, L 0, after ^~label's 3 bytes (imm24)
DEFINE JUMP_LS 9A                       # B: cond 1001 ls, 101, L 0, after ^~label's 3 bytes (imm24)
DEFINE JUMP_LT BA                       # B: cond 1011 lt, 101, L 0, after ^~label's 3 bytes (imm24)
DEFINE JUMP_NE 1A                       # B: cond 0001 ne, 101, L 0, after ^~label's 3 bytes (imm24)
