xor_eax,eax                             #     xor     %eax, %eax
:eval_operand_exact                     # eval_operand_exact:
mov_rax,d8(rbx) !48                     #     mov     %rax, O_exact(%rbx)
ret                                     #     ret

:reg_name                               # reg_name:                               # register %name at %r12: %rax its number, %rcx its size, %rdx 1 if it needs a REX
cmpb_$i8,(r12) !37                      #     cmpb    $0x25, (%r12)               # '%'
