orq_$i8,d32(rbp) %280 !64               #     orq     $0x40, I_rex(%rbp)
:rm_done                                # rm_done:
ret                                     #     ret
:rm_mem                                 # rm_mem:
cmpq_$i8,(rsi) !3                       #     cmpq    $3, O_kind(%rsi)
