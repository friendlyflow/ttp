# The encoding: the classes fill I_*, finish writes the bytes.

:opsize                                 # opsize:                                 # I_size: the suffix's, else the last register operand's; REX.W for 8
mov_d32(rbp),rax %272                   #     mov     I_size(%rbp), %rax
