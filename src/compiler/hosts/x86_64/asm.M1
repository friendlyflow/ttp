DEFINE neg_rax 48F7D8                   # REX.W, F7, ModRM 11 011 000
DEFINE neg_rcx 48F7D9                   # REX.W, F7, ModRM 11 011 001
DEFINE not_rax 48F7D0                   # REX.W, F7, ModRM 11 010 000
DEFINE not_rcx 48F7D1                   # REX.W, F7, ModRM 11 010 001
DEFINE or_$i32,ecx 81C9                 # 81, ModRM 11 001 001, then imm32
DEFINE or_$i32,r9 4981C9                # REX.W.B, 81, ModRM 11 001 001, then imm32
DEFINE or_$i8,cl 80C9                   # 80, ModRM 11 001 001, then imm8
DEFINE or_$i8,eax 83C8                  # 83, ModRM 11 001 000, then imm8
DEFINE or_$i8,edi 83CF                  # 83, ModRM 11 001 111, then imm8
DEFINE or_ecx,eax 09C8                  # 09, ModRM 11 001 000
DEFINE or_rax,d32(rbp) 480985           # REX.W, 09, ModRM 10 000 101, then disp32
DEFINE or_rcx,d32(rbp) 48098D           # REX.W, 09, ModRM 10 001 101, then disp32
DEFINE or_rdi,rax 4809F8                # REX.W, 09, ModRM 11 111 000
DEFINE or_rdx,rcx 4809D1                # REX.W, 09, ModRM 11 010 001
DEFINE or_rsi,rax 4809F0                # REX.W, 09, ModRM 11 110 000
DEFINE orq_$i32,d32(rbp) 48818D         # REX.W, 81, ModRM 10 001 101, then disp32, then imm32
DEFINE orq_$i8,d32(rbp) 48838D          # REX.W, 83, ModRM 10 001 101, then disp32, then imm8
DEFINE pop_r9 4159                      # REX.B, 59
DEFINE pop_rax 58                       # 58
DEFINE pop_rcx 59                       # 59
DEFINE pop_rdi 5F                       # 5F
DEFINE pop_rdx 5A                       # 5A
DEFINE pop_rsi 5E                       # 5E
DEFINE push_r9 4151                     # REX.B, 51
DEFINE push_rax 50                      # 50
DEFINE push_rcx 51                      # 51
DEFINE push_rdi 57                      # 57
DEFINE push_rdx 52                      # 52
DEFINE push_rsi 56                      # 56
DEFINE rep_movsb F3A4                   # F3 rep, A4
DEFINE repe_cmpsb F3A6                  # F3 rep, A6
DEFINE ret C3                           # C3
DEFINE sar_cl,rsi 48D3FE                # REX.W, D3, ModRM 11 111 110
DEFINE shl_$i8,eax C1E0                 # C1, ModRM 11 100 000, then imm8
DEFINE shl_$i8,ecx C1E1                 # C1, ModRM 11 100 001, then imm8
DEFINE shl_$i8,r9 49C1E1                # REX.W.B, C1, ModRM 11 100 001, then imm8
DEFINE shl_$i8,rax 48C1E0               # REX.W, C1, ModRM 11 100 000, then imm8
DEFINE shl_cl,rsi 48D3E6                # REX.W, D3, ModRM 11 100 110
DEFINE shr_$1,rax 48D1E8                # REX.W, D1, ModRM 11 101 000
DEFINE shr_$i8,rax 48C1E8               # REX.W, C1, ModRM 11 101 000, then imm8
DEFINE stc F9                           # F9
DEFINE sub_$i32,rdx 4881EA              # REX.W, 81, ModRM 11 101 010, then imm32
DEFINE sub_$i8,eax 83E8                 # 83, ModRM 11 101 000, then imm8
DEFINE sub_$i8,ecx 83E9                 # 83, ModRM 11 101 001, then imm8
DEFINE sub_$i8,edi 83EF                 # 83, ModRM 11 101 111, then imm8
DEFINE sub_d32(rbp),rax 482B85          # REX.W, 2B, ModRM 10 000 101, then disp32
DEFINE sub_d32(rbp,rcx,8),rax 482B84CD  # REX.W, 2B, ModRM 10 000 100, SIB 11 001 101, then disp32
DEFINE sub_r13d,edx 4429EA              # REX.R, 29, ModRM 11 101 010
DEFINE sub_r9,rdx 4C29CA                # REX.W.R, 29, ModRM 11 001 010
DEFINE sub_rax,rcx 4829C1               # REX.W, 29, ModRM 11 000 001
DEFINE sub_rax,rsi 4829C6               # REX.W, 29, ModRM 11 000 110
DEFINE sub_rdx,r9 4929D1                # REX.W.B, 29, ModRM 11 010 001
DEFINE sub_rsi,rdx 4829F2               # REX.W, 29, ModRM 11 110 010
DEFINE syscall 0F05                     # 0F 05
DEFINE test_$i8,al A8                   # A8, then imm8
DEFINE test_$i8,cl F6C1                 # F6, ModRM 11 000 001, then imm8
DEFINE test_$i8,dl F6C2                 # F6, ModRM 11 000 010, then imm8
DEFINE test_r8,r8 4D85C0                # REX.W.R.B, 85, ModRM 11 000 000
DEFINE test_rax,rax 4885C0              # REX.W, 85, ModRM 11 000 000
DEFINE test_rax,rcx 4885C1              # REX.W, 85, ModRM 11 000 001
DEFINE test_rcx,rcx 4885C9              # REX.W, 85, ModRM 11 001 001
DEFINE test_rdx,rdx 4885D2              # REX.W, 85, ModRM 11 010 010
DEFINE xor_eax,eax 31C0                 # 31, ModRM 11 000 000
DEFINE xor_ecx,ecx 31C9                 # 31, ModRM 11 001 001
DEFINE xor_edi,edi 31FF                 # 31, ModRM 11 111 111
DEFINE xor_edx,edx 31D2                 # 31, ModRM 11 010 010
DEFINE xor_r8d,r8d 4531C0               # REX.R.B, 31, ModRM 11 000 000
DEFINE xor_rsi,rax 4831F0               # REX.W, 31, ModRM 11 110 000
#
# asm for x86_64 Linux: the assembler of the seed. The fourth link of the
# bootstrap, built by M1 and hex2 from hosts/x86_64/asm.M1 (made from this
# file once by gen/mkhex.pl, a dev aid; the chain never reads this file).
# It assembles hosts/x86_64/ttpc.s, the readable seed, into the seed: the
# bytes binutils' as and ld make of it (as -mx86-used-note=no, ld -static
# -s -z noseparate-code), with no binutils.
#
#   asm < ttpc.s > ttpc
#
# The asm it reads: x86_64 GNU syntax (AT&T) as ttpc.s uses it.
#   lines      labels (name: and the local n: of 0-99, as 1b and 1f), then
#              a directive or an instruction; '#' starts a comment to the
#              end of the line
#   directives .equ name, expr  .quad expr, ...  .byte expr, ...
#              .ascii "text", ...  (escapes \n \t \ooo, \x as x)
#              .skip n  .balign n (not in .text)  .section name (.text
#              .rodata .data .bss)  .text .data .bss  .globl name  .code64
#   exprs      numbers (decimal, 0x hex, 0 octal), names, '.' (here), and
#              as gas: unary - ~, then * << >>, then | & ^, then + -, and
#              ( ); a label's address plus or minus a number, or two labels
#              of a section minus each other
#   operands   %reg (64, 32 and 8 bits, %rip), $expr, expr(%base,%index,
#              scale) with a base and as many of the rest as needed,
#              expr(%rip), and a jump's expr, or *%reg and *memory for an
#              indirect jmp or call
#   mnemonics  add or and sub xor cmp test mov (with q, l, b), movzbq
#              movzbl lea inc dec neg not mul div idiv shl shr sar imul,
#              setcc jcc jmp call ret nop syscall
# Each instruction is encoded as gas does: the short forms where gas uses
# them (imm8, disp8, the %al/%eax/%rax forms, shift by 1, no displacement
# when it is 0) and jumps as short as they can be: every jump starts short
# and grows to rel32 while it does not fit, pass after pass, as gas relaxes
# them. The output is the file ld makes: the ELF header, two program
# headers (the code: the headers, .text, .rodata; the data: .data, .bss),
# the sections, .shstrtab and six section headers. Each of .text .rodata
# .data .bss must have bytes.
#
# The input is read whole, then in passes: the sizing passes give every
# label its place (and every jump its size) until no jump grows, then the
# sections are laid out and the last pass writes them into the output,
# which is then written whole. On an error it says so on stderr with the
# line (asm: line N: what: the line) and ends with status 1; else with 0.
#
# One flat file, loaded at BASE by its first program header, read and
# run; the second maps the memory it writes, VARS to the end of OUTBUF.
# The registers:
#   %r12  the next byte of the input        %r13  the end of the input
#   %rbp  VARS, the variables               %rbx  the operand being parsed
# A symbol is 48 bytes (SYM_*), a local label's definition 24 (L_*), an
# operand 96 (O_*).

#     .equ BASE, 0x600000
#     .equ VARS, 0x700000                 # the variables, 64 KiB
#     .equ SYMS, VARS + 0x10000           # 65536 symbols
#     .equ SYM_size, 48
#     .equ SYMS_END, SYMS + 0x10000 * SYM_size
#     .equ LOCAL_max, 4096                # definitions of each local label
#     .equ LOCALS, SYMS_END               # 100 local labels
#     .equ LOCALS_END, LOCALS + 100 * LOCAL_max * 24
#     .equ JUMPS, LOCALS_END              # a byte per jump: 1 when it is long
#     .equ JUMPS_END, JUMPS + 0x100000
#     .equ INPUT, JUMPS_END               # 16 MiB of input
#     .equ INPUT_END, INPUT + 0x1000000
#     .equ OUTBUF, INPUT_END              # 16 MiB of output
#     .equ OUTBUF_END, OUTBUF + 0x1000000
#     .equ ADDR, 0x400000                 # where ld places the output

    # a symbol: its name in the input, the value (in its section), the
    # kind (0 a number, else the section), the pass that defined it
#     .equ S_name, 0
#     .equ S_len, 8
#     .equ S_value, 16
#     .equ S_kind, 24
#     .equ S_pass, 32
    # a definition of a local label
#     .equ L_value, 0
#     .equ L_kind, 8
#     .equ L_pass, 16
    # an operand
#     .equ O_kind, 0                      # 1 register, 2 $expr, 3 memory, 4 expr
#     .equ O_reg, 8                       # a register: its number, 16 %rip
#     .equ O_size, 16                     # its bytes
#     .equ O_rexf, 24                     # 1 for %spl %bpl %sil %dil: a REX
#     .equ O_val, 32                      # the expression's value
#     .equ O_vkind, 40                    # its kind
#     .equ O_exact, 48                    # 1 when it is a number known here
#     .equ O_known, 56                    # 1 when all its names are defined
#     .equ O_base, 64                     # memory: the base register, or -1
#     .equ O_index, 72                    # the index register, or -1
#     .equ O_scale, 80                    # log2 of the scale
#     .equ O_ind, 88                      # 1 after '*': a jump's or call's register or memory

    # the variables, at %rbp
#     .equ V_pass, 0                      # the pass, from 1
#     .equ V_emit, 8                      # 1 in the last pass, which writes
#     .equ V_changed, 16                  # 1 when this pass needs another
#     .equ V_sec, 24                      # the section: 1 .text 2 .rodata 3 .data 4 .bss
#     .equ V_line, 32                     # the line's number
#     .equ V_jump, 40                     # the next jump's number
#     .equ V_nsym, 48                     # the next free symbol
#     .equ V_exact, 56                    # 0 once an expression used a name not defined before it
#     .equ V_known, 64                    # 0 once it used a name not defined at all
#     .equ V_lstart, 72                   # the line's first byte
#     .equ V_loc, 80                      # section s's location counter at V_loc + 8 * s
#     .equ V_align, 120                   # its alignment
#     .equ V_base, 160                    # its address (0 for s = 0, a number)
#     .equ V_off, 200                     # its file offset
#     .equ V_shstr, 240                   # the file offset of .shstrtab
#     .equ V_shoff, 248                   # of the section headers
#     .equ V_fend, 256                    # the file's size
#     .equ V_nops, 264                    # the instruction's operands
#     .equ I_size, 272                    # its operand size: 1, 4, 8, 0 not yet known
#     .equ I_rex, 280                     # its REX: 8 W, 4 R, 2 X, 1 B, 0x40 one without them
#     .equ I_op, 288                      # its opcode, the first byte lowest
#     .equ I_oplen, 296                   # the opcode's bytes
#     .equ I_hasm, 304                    # 1 with a ModRM byte
#     .equ I_modrm, 312                   # the ModRM byte
#     .equ I_hass, 320                    # 1 with a SIB byte
#     .equ I_sib, 328                     # the SIB byte
#     .equ I_disp, 336                    # the displacement
#     .equ I_dsize, 344                   # its bytes: 0, 1 or 4
#     .equ I_rip, 352                     # 1 when it is from %rip
#     .equ I_ripval, 360                  # then the address it is to
#     .equ I_imm, 368                     # the immediate (or a jump's rel)
#     .equ I_isize, 376                   # its bytes: 0, 1, 4 or 8
#     .equ I_dpos, 384                    # where the displacement is in IBUF
#     .equ I_ext, 392                     # the mnemonic's op: an opcode, its /digit, a condition
#     .equ IBUF, 400                      # the instruction's bytes, 16
#     .equ OP0, 416                       # the first operand
#     .equ OP1, 512                       # the second
#     .equ COUNTS, 608                    # local label n's definitions so far at COUNTS + 8 * n
#     .equ NUMBUF, 1408                   # a decimal number, 24
#     .equ V_tend, 1432                   # the end of .rodata in the file: of the code segment

:ehdr                                   # ehdr:                                   # the ELF header, 64 bytes
7F454C46                                #     .byte 0x7f, 0x45, 0x4c, 0x46        # e_ident: the magic, 0x7f 'E' 'L' 'F'
02                                      #     .byte 2                             # EI_CLASS: ELFCLASS64
01                                      #     .byte 1                             # EI_DATA: ELFDATA2LSB, little endian
01                                      #     .byte 1                             # EI_VERSION: EV_CURRENT
00                                      #     .byte 0                             # EI_OSABI: System V
0000000000000000                        #     .byte 0, 0, 0, 0, 0, 0, 0, 0        # EI_ABIVERSION 0, then padding to 16
0200                                    #     .word 2                             # e_type: ET_EXEC, an executable
3E00                                    #     .word 0x3e                          # e_machine: EM_X86_64
01000000                                #     .long 1                             # e_version: EV_CURRENT
B000600000000000                        #     .quad BASE + _start - ehdr          # e_entry: the address of _start
4000000000000000                        #     .quad phdr - ehdr                   # e_phoff: the program headers follow
0000000000000000                        #     .quad 0                             # e_shoff: no section headers
00000000                                #     .long 0                             # e_flags: none on x86_64
4000                                    #     .word 64                            # e_ehsize: this header's size
3800                                    #     .word 56                            # e_phentsize: a program header's size
0200                                    #     .word 2                             # e_phnum: two program headers
0000                                    #     .word 0                             # e_shentsize: no section headers
0000                                    #     .word 0                             # e_shnum: none
0000                                    #     .word 0                             # e_shstrndx: none
:phdr                                   # phdr:                                   # the program: 56 bytes
01000000                                #     .long 1                             # p_type: PT_LOAD
05000000                                #     .long 5                             # p_flags: PF_R | PF_X, read and run
0000000000000000                        #     .quad 0                             # p_offset: from the file's first byte
0000600000000000                        #     .quad BASE                          # p_vaddr: loaded at BASE
0000600000000000                        #     .quad BASE                          # p_paddr: the same
A92A000000000000                        #     .quad end - ehdr                    # p_filesz: the whole file
A92A000000000000                        #     .quad end - ehdr                    # p_memsz: the same
0010000000000000                        #     .quad 0x1000                        # p_align: a page
                                        # its memory: 56 bytes
01000000                                #     .long 1                             # p_type: PT_LOAD
06000000                                #     .long 6                             # p_flags: PF_R | PF_W, read and write
0000000000000000                        #     .quad 0                             # p_offset: none of the file
0000700000000000                        #     .quad VARS                          # p_vaddr: the variables to the output
0000700000000000                        #     .quad VARS                          # p_paddr: the same
0000000000000000                        #     .quad 0                             # p_filesz: none, all zero
0000D70200000000                        #     .quad OUTBUF_END - VARS             # p_memsz: to the end of the output
0010000000000000                        #     .quad 0x1000                        # p_align: a page

:_start                                 # _start:                                 # read all of stdin into INPUT
mov_$i32,ebp %0x700000                  #     mov     $VARS, %ebp
mov_$i32,r13d %0x1470000                #     mov     $INPUT, %r13d               # the end of what is read
:read                                   # read:
mov_$i32,edx %0x246ffff                 #     mov     $INPUT_END - 1, %edx        # a 0 stays after the input
sub_r13d,edx                            #     sub     %r13d, %edx                 # the room left
jz32 %too_large                         #     jz      too_large
xor_eax,eax                             #     xor     %eax, %eax                  # SYS_read
xor_edi,edi                             #     xor     %edi, %edi                  # fd 0, stdin
mov_r13,rsi                             #     mov     %r13, %rsi                  # after what is read
syscall                                 #     syscall
test_rax,rax                            #     test    %rax, %rax
jl32 %read_failed                       #     jl      read_failed
je8 !read_all                           #     je      read_all                    # the end of stdin
add_rax,r13                             #     add     %rax, %r13
jmp8 !read                              #     jmp     read
:read_all                               # read_all:
mov_$i32,eax %0x710000                  #     mov     $SYMS, %eax                 # no symbols yet
mov_rax,d8(rbp) !48                     #     mov     %rax, V_nsym(%rbp)
mov_$i32,ecx %1                         #     mov     $1, %ecx
:init_align                             # init_align:                             # each section aligned to 1, until .balign
movq_$i32,d8(rbp,rcx,8) !120 %1         #     movq    $1, V_align(%rbp,%rcx,8)
inc_ecx                                 #     inc     %ecx
cmp_$i8,ecx !4                          #     cmp     $4, %ecx
jbe8 !init_align                        #     jbe     init_align
movq_$i32,d8(rbp) !0 %1                 #     movq    $1, V_pass(%rbp)
:sizing                                 # sizing:                                 # sizing passes until no jump grows
call %pass                              #     call    pass
cmpq_$i8,d8(rbp) !16 !0                 #     cmpq    $0, V_changed(%rbp)
je8 !sized                              #     je      sized
incq_d8(rbp) !0                         #     incq    V_pass(%rbp)
jmp8 !sizing                            #     jmp     sizing
:sized                                  # sized:
call %layout                            #     call    layout
incq_d8(rbp) !0                         #     incq    V_pass(%rbp)                # the last pass writes
movq_$i32,d8(rbp) !8 %1                 #     movq    $1, V_emit(%rbp)
call %pass                              #     call    pass
call %headers                           #     call    headers
mov_$i32,esi %0x2470000                 #     mov     $OUTBUF, %esi               # write the output
mov_d32(rbp),rbx %256                   #     mov     V_fend(%rbp), %rbx
add_rsi,rbx                             #     add     %rsi, %rbx                  # its end
:write                                  # write:
mov_rbx,rdx                             #     mov     %rbx, %rdx
sub_rsi,rdx                             #     sub     %rsi, %rdx                  # what is left
jz8 !done                               #     jz      done
mov_$i32,eax %1                         #     mov     $1, %eax                    # SYS_write
mov_eax,edi                             #     mov     %eax, %edi                  # fd 1, stdout
syscall                                 #     syscall
test_rax,rax                            #     test    %rax, %rax
jle32 %write_failed                     #     jle     write_failed
add_rax,rsi                             #     add     %rax, %rsi
jmp8 !write                             #     jmp     write
:done                                   # done:
xor_edi,edi                             #     xor     %edi, %edi                  # status 0
jmp32 %exit                             #     jmp     exit

# A pass over the input, line by line. Pass 1 always needs another: its
# forward references were not yet known.
:pass                                   # pass:
xor_eax,eax                             #     xor     %eax, %eax
mov_rax,d8(rbp) !16                     #     mov     %rax, V_changed(%rbp)
cmpq_$i8,d8(rbp) !0 !1                  #     cmpq    $1, V_pass(%rbp)
jne8 !pass_reset                        #     jne     pass_reset
movq_$i32,d8(rbp) !16 %1                #     movq    $1, V_changed(%rbp)
:pass_reset                             # pass_reset:
mov_rax,d8(rbp) !40                     #     mov     %rax, V_jump(%rbp)          # from the first jump
mov_$i32,ecx %4                         #     mov     $4, %ecx
:pass_loc                               # pass_loc:                               # every section from 0
mov_rax,d8(rbp,rcx,8) !80               #     mov     %rax, V_loc(%rbp,%rcx,8)
dec_ecx                                 #     dec     %ecx
jns8 !pass_loc                          #     jns     pass_loc
mov_$i32,ecx %99                        #     mov     $99, %ecx
:pass_count                             # pass_count:                             # no local labels yet
mov_rax,d32(rbp,rcx,8) %608             #     mov     %rax, COUNTS(%rbp,%rcx,8)
dec_ecx                                 #     dec     %ecx
jns8 !pass_count                        #     jns     pass_count
movq_$i32,d8(rbp) !24 %1                #     movq    $1, V_sec(%rbp)             # in .text
movq_$i32,d8(rbp) !32 %1                #     movq    $1, V_line(%rbp)
mov_$i32,r12d %0x1470000                #     mov     $INPUT, %r12d
:pass_line                              # pass_line:
cmp_r13,r12                             #     cmp     %r13, %r12
jae8 !pass_end                          #     jae     pass_end
mov_r12,d8(rbp) !72                     #     mov     %r12, V_lstart(%rbp)
call %statement                         #     call    statement
incq_d8(rbp) !32                        #     incq    V_line(%rbp)
jmp8 !pass_line                         #     jmp     pass_line
:pass_end                               # pass_end:
ret                                     #     ret

# One line, to after its newline: labels, then a directive or an
# instruction (each ends with end_line).
:statement                              # statement:
call %blanks                            #     call    blanks
movzbl_(r12),eax                        #     movzbl  (%r12), %eax
call %is_ident                          #     call    is_ident
jc8 !end_line                           #     jc      end_line                    # no name: only a comment may follow
call %word                              #     call    word                        # %rsi, %rdx
cmpb_$i8,(r12) !58                      #     cmpb    $0x3a, (%r12)               # ':': a label
je8 !label                              #     je      label
cmpb_$i8,(rsi) !46                      #     cmpb    $0x2e, (%rsi)               # '.': a directive
je32 %directive                         #     je      directive
jmp32 %insn                             #     jmp     insn
:label                                  # label:
inc_r12                                 #     inc     %r12
call %define_label                      #     call    define_label
jmp8 !statement                         #     jmp     statement

:end_line                               # end_line:                               # nothing but a comment until the newline, then after it
call %blanks                            #     call    blanks
cmp_r13,r12                             #     cmp     %r13, %r12
jae8 !end_line_done                     #     jae     end_line_done
movzbl_(r12),eax                        #     movzbl  (%r12), %eax
cmp_$i8,al !35                          #     cmp     $0x23, %al                  # '#'
je8 !end_comment                        #     je      end_comment
cmp_$i8,al !10                          #     cmp     $0x0a, %al                  # '\n'
jne32 %junk                             #     jne     junk
inc_r12                                 #     inc     %r12
:end_line_done                          # end_line_done:
ret                                     #     ret
:end_comment                            # end_comment:
inc_r12                                 #     inc     %r12
cmp_r13,r12                             #     cmp     %r13, %r12
jae8 !end_line_done                     #     jae     end_line_done
cmpb_$i8,(r12) !10                      #     cmpb    $0x0a, (%r12)
jne8 !end_comment                       #     jne     end_comment
inc_r12                                 #     inc     %r12
ret                                     #     ret

:at_eol                                 # at_eol:                                 # CF at a comment or the end of the line
call %blanks                            #     call    blanks
cmp_r13,r12                             #     cmp     %r13, %r12
jae8 !at_eol_yes                        #     jae     at_eol_yes
movzbl_(r12),eax                        #     movzbl  (%r12), %eax
cmp_$i8,al !35                          #     cmp     $0x23, %al                  # '#'
je8 !at_eol_yes                         #     je      at_eol_yes
cmp_$i8,al !10                          #     cmp     $0x0a, %al                  # '\n'
je8 !at_eol_yes                         #     je      at_eol_yes
clc                                     #     clc
ret                                     #     ret
:at_eol_yes                             # at_eol_yes:
stc                                     #     stc
ret                                     #     ret

:blanks                                 # blanks:                                 # skips spaces and tabs (no register changes)
cmpb_$i8,(r12) !32                      #     cmpb    $0x20, (%r12)               # ' '
je8 !blanks_skip                        #     je      blanks_skip
cmpb_$i8,(r12) !9                       #     cmpb    $0x09, (%r12)               # '\t'
jne8 !blanks_done                       #     jne     blanks_done
:blanks_skip                            # blanks_skip:
inc_r12                                 #     inc     %r12
jmp8 !blanks                            #     jmp     blanks
:blanks_done                            # blanks_done:
ret                                     #     ret

:is_ident                               # is_ident:                               # CF unless %al is a letter, a digit, '_' or '.'
cmp_$i8,al !46                          #     cmp     $0x2e, %al                  # '.'
je8 !ident_yes                          #     je      ident_yes
cmp_$i8,al !95                          #     cmp     $0x5f, %al                  # '_'
je8 !ident_yes                          #     je      ident_yes
cmp_$i8,al !48                          #     cmp     $0x30, %al                  # below '0'
jb8 !ident_no                           #     jb      ident_no
cmp_$i8,al !57                          #     cmp     $0x39, %al                  # '0'-'9'
jbe8 !ident_yes                         #     jbe     ident_yes
mov_eax,ecx                             #     mov     %eax, %ecx
or_$i8,cl !32                           #     or      $0x20, %cl                  # 'A'-'Z' as 'a'-'z'
cmp_$i8,cl !97                          #     cmp     $0x61, %cl                  # 'a'
jb8 !ident_no                           #     jb      ident_no
cmp_$i8,cl !122                         #     cmp     $0x7a, %cl                  # 'z'
ja8 !ident_no                           #     ja      ident_no
:ident_yes                              # ident_yes:
clc                                     #     clc
ret                                     #     ret
:ident_no                               # ident_no:
stc                                     #     stc
ret                                     #     ret

:word                                   # word:                                   # %rsi, %rdx = the name at %r12, which moves after it
mov_r12,rsi                             #     mov     %r12, %rsi
:word_byte                              # word_byte:
movzbl_(r12),eax                        #     movzbl  (%r12), %eax
call %is_ident                          #     call    is_ident
jc8 !word_end                           #     jc      word_end
inc_r12                                 #     inc     %r12
jmp8 !word_byte                         #     jmp     word_byte
:word_end                               # word_end:
mov_r12,rdx                             #     mov     %r12, %rdx
sub_rsi,rdx                             #     sub     %rsi, %rdx
ret                                     #     ret

:pack                                   # pack:                                   # %rax = name %rsi, %rdx as 8 bytes (the first lowest), -1 if longer
mov_$i32,rax %-1                        #     mov     $-1, %rax
cmp_$i8,rdx !8                          #     cmp     $8, %rdx
ja8 !pack_done                          #     ja      pack_done
xor_eax,eax                             #     xor     %eax, %eax
mov_rdx,rcx                             #     mov     %rdx, %rcx
:pack_byte                              # pack_byte:                              # from the last byte to the first
test_rcx,rcx                            #     test    %rcx, %rcx
jz8 !pack_done                          #     jz      pack_done
shl_$i8,rax !8                          #     shl     $8, %rax
movzbl_d8(rsi,rcx),edi !-1              #     movzbl  -1(%rsi,%rcx), %edi
or_rdi,rax                              #     or      %rdi, %rax
dec_rcx                                 #     dec     %rcx
jmp8 !pack_byte                         #     jmp     pack_byte
:pack_done                              # pack_done:
ret                                     #     ret

# The symbols.

:define_label                           # define_label:                           # name %rsi, %rdx: here
call %digits                            #     call    digits                      # n: a local label
jnc32 %local_def                        #     jnc     local_def
call %here_offset                       #     call    here_offset                 # %rax, %rcx
mov_$i32,r8d %1                         #     mov     $1, %r8d                    # defined twice in a pass: an error
:define                                 # define:                                 # symbol %rsi, %rdx = %rax of kind %rcx; %rdi = it
push_rax                                #     push    %rax
push_rcx                                #     push    %rcx
call %find_sym                          #     call    find_sym
jnc8 !define_found                      #     jnc     define_found
mov_d8(rbp),rdi !48                     #     mov     V_nsym(%rbp), %rdi          # a new one
cmp_$i32,rdi %0xa10000                  #     cmp     $SYMS_END, %rdi
jae32 %too_many_symbols                 #     jae     too_many_symbols
lea_d8(rdi),rax !48                     #     lea     SYM_size(%rdi), %rax
mov_rax,d8(rbp) !48                     #     mov     %rax, V_nsym(%rbp)
mov_rsi,(rdi)                           #     mov     %rsi, S_name(%rdi)
mov_rdx,d8(rdi) !8                      #     mov     %rdx, S_len(%rdi)
jmp8 !define_set                        #     jmp     define_set
:define_found                           # define_found:
test_r8,r8                              #     test    %r8, %r8
jz8 !define_set                         #     jz      define_set
mov_d8(rbp),rax !0                      #     mov     V_pass(%rbp), %rax
cmp_rax,d8(rdi) !32                     #     cmp     %rax, S_pass(%rdi)
je32 %twice                             #     je      twice
:define_set                             # define_set:
pop_rcx                                 #     pop     %rcx
pop_rax                                 #     pop     %rax
mov_rax,d8(rdi) !16                     #     mov     %rax, S_value(%rdi)
mov_rcx,d8(rdi) !24                     #     mov     %rcx, S_kind(%rdi)
mov_d8(rbp),rax !0                      #     mov     V_pass(%rbp), %rax
mov_rax,d8(rdi) !32                     #     mov     %rax, S_pass(%rdi)
ret                                     #     ret

:find_sym                               # find_sym:                               # %rdi = symbol %rsi, %rdx; CF if none
mov_$i32,edi %0x710000                  #     mov     $SYMS, %edi
:find_sym_next                          # find_sym_next:
cmp_d8(rbp),rdi !48                     #     cmp     V_nsym(%rbp), %rdi
jae8 !find_sym_none                     #     jae     find_sym_none
cmp_d8(rdi),rdx !8                      #     cmp     S_len(%rdi), %rdx           # the same length
jne8 !find_sym_on                       #     jne     find_sym_on
push_rsi                                #     push    %rsi
push_rdi                                #     push    %rdi
mov_(rdi),rdi                           #     mov     S_name(%rdi), %rdi
mov_rdx,rcx                             #     mov     %rdx, %rcx
repe_cmpsb                              #     repe cmpsb                          # and the same bytes
pop_rdi                                 #     pop     %rdi
pop_rsi                                 #     pop     %rsi
je8 !find_sym_found                     #     je      find_sym_found
:find_sym_on                            # find_sym_on:
add_$i8,rdi !48                         #     add     $SYM_size, %rdi
jmp8 !find_sym_next                     #     jmp     find_sym_next
:find_sym_none                          # find_sym_none:
stc                                     #     stc
ret                                     #     ret
:find_sym_found                         # find_sym_found:
clc                                     #     clc
ret                                     #     ret

:local_def                              # local_def:                              # local label %rax: here
cmp_$i8,rax !100                        #     cmp     $100, %rax
jae32 %bad_local                        #     jae     bad_local
mov_d32(rbp,rax,8),rcx %608             #     mov     COUNTS(%rbp,%rax,8), %rcx   # its definitions so far
incq_d32(rbp,rax,8) %608                #     incq    COUNTS(%rbp,%rax,8)
call %local_entry                       #     call    local_entry
call %here_offset                       #     call    here_offset
mov_rax,(rdi)                           #     mov     %rax, L_value(%rdi)
mov_rcx,d8(rdi) !8                      #     mov     %rcx, L_kind(%rdi)
mov_d8(rbp),rax !0                      #     mov     V_pass(%rbp), %rax
mov_rax,d8(rdi) !16                     #     mov     %rax, L_pass(%rdi)
ret                                     #     ret

:local_entry                            # local_entry:                            # %rdi = definition %rcx of local label %rax
cmp_$i8,rax !100                        #     cmp     $100, %rax
jae32 %bad_local                        #     jae     bad_local
cmp_$i32,rcx %0x1000                    #     cmp     $LOCAL_max, %rcx            # (-1 too: below 0)
jae32 %bad_local                        #     jae     bad_local
imul_$i32,rax,rdi %0x1000               #     imul    $LOCAL_max, %rax, %rdi
add_rcx,rdi                             #     add     %rcx, %rdi
imul_$i8,rdi,rdi !24                    #     imul    $24, %rdi, %rdi
add_$i32,rdi %0xa10000                  #     add     $LOCALS, %rdi
ret                                     #     ret

:digits                                 # digits:                                 # %rax = name %rsi, %rdx when it is decimal digits only; else CF
xor_eax,eax                             #     xor     %eax, %eax
xor_ecx,ecx                             #     xor     %ecx, %ecx
:digits_next                            # digits_next:
cmp_rdx,rcx                             #     cmp     %rdx, %rcx
jae8 !digits_done                       #     jae     digits_done
movzbl_(rsi,rcx),edi                    #     movzbl  (%rsi,%rcx), %edi
sub_$i8,edi !48                         #     sub     $0x30, %edi                 # '0'-'9'
cmp_$i8,edi !9                          #     cmp     $9, %edi
ja8 !digits_not                         #     ja      digits_not
imul_$i8,rax,rax !10                    #     imul    $10, %rax, %rax
add_rdi,rax                             #     add     %rdi, %rax
inc_rcx                                 #     inc     %rcx
jmp8 !digits_next                       #     jmp     digits_next
:digits_done                            # digits_done:
clc                                     #     clc
ret                                     #     ret
:digits_not                             # digits_not:
stc                                     #     stc
ret                                     #     ret

:here_offset                            # here_offset:                            # %rax = the location in section %rcx, the current one
mov_d8(rbp),rcx !24                     #     mov     V_sec(%rbp), %rcx
mov_d8(rbp,rcx,8),rax !80               #     mov     V_loc(%rbp,%rcx,8), %rax
ret                                     #     ret
:here                                   # here:                                   # %rax = the address of the next byte, %rcx its section
call %here_offset                       #     call    here_offset
add_d32(rbp,rcx,8),rax %160             #     add     V_base(%rbp,%rcx,8), %rax
ret                                     #     ret

# Expressions: %rax the value (with its section's address in the last
# pass), %rdx the kind; V_exact and V_known cleared as it says.

:eval                                   # eval:                                   # the expression at %r12
movq_$i32,d8(rbp) !56 %1                #     movq    $1, V_exact(%rbp)
movq_$i32,d8(rbp) !64 %1                #     movq    $1, V_known(%rbp)
jmp8 !expr                              #     jmp     expr

:eval_number                            # eval_number:                            # %rax = the expression at %r12: a number known here
call %eval                              #     call    eval
test_rdx,rdx                            #     test    %rdx, %rdx
jnz32 %not_number                       #     jnz     not_number
cmpq_$i8,d8(rbp) !56 !0                 #     cmpq    $0, V_exact(%rbp)
je32 %not_number                        #     je      not_number
ret                                     #     ret

:expr                                   # expr:                                   # + -
call %expr_or                           #     call    expr_or
:expr_more                              # expr_more:
call %blanks                            #     call    blanks
cmpb_$i8,(r12) !43                      #     cmpb    $0x2b, (%r12)               # '+'
je8 !expr_add                           #     je      expr_add
cmpb_$i8,(r12) !45                      #     cmpb    $0x2d, (%r12)               # '-'
je8 !expr_sub                           #     je      expr_sub
ret                                     #     ret
:expr_add                               # expr_add:
inc_r12                                 #     inc     %r12
push_rax                                #     push    %rax
push_rdx                                #     push    %rdx
call %expr_or                           #     call    expr_or
pop_rcx                                 #     pop     %rcx                        # the left one's kind
pop_rsi                                 #     pop     %rsi                        # its value
add_rsi,rax                             #     add     %rsi, %rax
test_rcx,rcx                            #     test    %rcx, %rcx                  # a number + x: x's kind
jz8 !expr_more                          #     jz      expr_more
test_rdx,rdx                            #     test    %rdx, %rdx                  # a label + a number: the label's
jnz8 !expr_kinds                        #     jnz     expr_kinds
mov_rcx,rdx                             #     mov     %rcx, %rdx
jmp8 !expr_more                         #     jmp     expr_more
:expr_sub                               # expr_sub:
inc_r12                                 #     inc     %r12
push_rax                                #     push    %rax
push_rdx                                #     push    %rdx
call %expr_or                           #     call    expr_or
pop_rcx                                 #     pop     %rcx
pop_rsi                                 #     pop     %rsi
sub_rax,rsi                             #     sub     %rax, %rsi
mov_rsi,rax                             #     mov     %rsi, %rax
test_rdx,rdx                            #     test    %rdx, %rdx                  # x - a number: x's kind
jz8 !expr_sub_kind                      #     jz      expr_sub_kind
cmp_rcx,rdx                             #     cmp     %rcx, %rdx                  # two labels of a section: a number
jne8 !expr_kinds                        #     jne     expr_kinds
xor_edx,edx                             #     xor     %edx, %edx
jmp8 !expr_more                         #     jmp     expr_more
:expr_sub_kind                          # expr_sub_kind:
mov_rcx,rdx                             #     mov     %rcx, %rdx
jmp8 !expr_more                         #     jmp     expr_more
:expr_kinds                             # expr_kinds:
call %kinds                             #     call    kinds
jmp8 !expr_more                         #     jmp     expr_more

:kinds                                  # kinds:                                  # an operation on labels it cannot do: fine while names are unknown
xor_edx,edx                             #     xor     %edx, %edx
cmpq_$i8,d8(rbp) !64 !0                 #     cmpq    $0, V_known(%rbp)
je8 !kinds_unknown                      #     je      kinds_unknown
lea_rel(rip),rsi %msg_kinds             #     lea     msg_kinds(%rip), %rsi
jmp32 %fail                             #     jmp     fail
:kinds_unknown                          # kinds_unknown:
ret                                     #     ret

:expr_or                                # expr_or:                                # | & ^
call %expr_mul                          #     call    expr_mul
:expr_or_more                           # expr_or_more:
call %blanks                            #     call    blanks
movzbl_(r12),ecx                        #     movzbl  (%r12), %ecx
cmp_$i8,ecx !124                        #     cmp     $0x7c, %ecx                 # '|'
je8 !expr_or_op                         #     je      expr_or_op
cmp_$i8,ecx !38                         #     cmp     $0x26, %ecx                 # '&'
je8 !expr_or_op                         #     je      expr_or_op
cmp_$i8,ecx !94                         #     cmp     $0x5e, %ecx                 # '^'
je8 !expr_or_op                         #     je      expr_or_op
ret                                     #     ret
:expr_or_op                             # expr_or_op:
inc_r12                                 #     inc     %r12
push_rcx                                #     push    %rcx                        # the operator
push_rax                                #     push    %rax
push_rdx                                #     push    %rdx
call %expr_mul                          #     call    expr_mul
pop_rcx                                 #     pop     %rcx
pop_rsi                                 #     pop     %rsi
pop_rdi                                 #     pop     %rdi
or_rdx,rcx                              #     or      %rdx, %rcx                  # numbers only
jz8 !expr_or_numbers                    #     jz      expr_or_numbers
call %kinds                             #     call    kinds
:expr_or_numbers                        # expr_or_numbers:
xor_edx,edx                             #     xor     %edx, %edx
cmp_$i8,edi !124                        #     cmp     $0x7c, %edi                 # '|'
jne8 !expr_and                          #     jne     expr_and
or_rsi,rax                              #     or      %rsi, %rax
jmp8 !expr_or_more                      #     jmp     expr_or_more
:expr_and                               # expr_and:
cmp_$i8,edi !38                         #     cmp     $0x26, %edi                 # '&'
jne8 !expr_xor                          #     jne     expr_xor
and_rsi,rax                             #     and     %rsi, %rax
jmp8 !expr_or_more                      #     jmp     expr_or_more
:expr_xor                               # expr_xor:
xor_rsi,rax                             #     xor     %rsi, %rax
jmp8 !expr_or_more                      #     jmp     expr_or_more

:expr_mul                               # expr_mul:                               # * << >>
call %expr_unary                        #     call    expr_unary
:expr_mul_more                          # expr_mul_more:
call %blanks                            #     call    blanks
movzbl_(r12),ecx                        #     movzbl  (%r12), %ecx
cmp_$i8,ecx !42                         #     cmp     $0x2a, %ecx                 # '*'
je8 !expr_mul_op                        #     je      expr_mul_op
cmp_$i8,ecx !60                         #     cmp     $0x3c, %ecx                 # '<' of '<<'
je8 !expr_shift                         #     je      expr_shift
cmp_$i8,ecx !62                         #     cmp     $0x3e, %ecx                 # '>' of '>>'
je8 !expr_shift                         #     je      expr_shift
ret                                     #     ret
:expr_shift                             # expr_shift:
cmp_cl,d8(r12) !1                       #     cmp     %cl, 1(%r12)                # doubled
jne8 !expr_mul_done                     #     jne     expr_mul_done
inc_r12                                 #     inc     %r12
:expr_mul_op                            # expr_mul_op:
inc_r12                                 #     inc     %r12
push_rcx                                #     push    %rcx
push_rax                                #     push    %rax
push_rdx                                #     push    %rdx
call %expr_unary                        #     call    expr_unary
pop_rcx                                 #     pop     %rcx
pop_rsi                                 #     pop     %rsi
pop_rdi                                 #     pop     %rdi
or_rdx,rcx                              #     or      %rdx, %rcx                  # numbers only
jz8 !expr_mul_numbers                   #     jz      expr_mul_numbers
call %kinds                             #     call    kinds
:expr_mul_numbers                       # expr_mul_numbers:
xor_edx,edx                             #     xor     %edx, %edx
cmp_$i8,edi !42                         #     cmp     $0x2a, %edi                 # '*'
jne8 !expr_shl                          #     jne     expr_shl
imul_rsi,rax                            #     imul    %rsi, %rax
jmp8 !expr_mul_more                     #     jmp     expr_mul_more
:expr_shl                               # expr_shl:
mov_eax,ecx                             #     mov     %eax, %ecx
cmp_$i8,edi !60                         #     cmp     $0x3c, %edi                 # '<<'
jne8 !expr_shr                          #     jne     expr_shr
shl_cl,rsi                              #     shl     %cl, %rsi
mov_rsi,rax                             #     mov     %rsi, %rax
jmp8 !expr_mul_more                     #     jmp     expr_mul_more
:expr_shr                               # expr_shr:                               # '>>'
sar_cl,rsi                              #     sar     %cl, %rsi
mov_rsi,rax                             #     mov     %rsi, %rax
jmp8 !expr_mul_more                     #     jmp     expr_mul_more
:expr_mul_done                          # expr_mul_done:
ret                                     #     ret

:expr_unary                             # expr_unary:                             # - ~ ( ), a number, a name, '.'
call %blanks                            #     call    blanks
movzbl_(r12),eax                        #     movzbl  (%r12), %eax
cmp_$i8,al !45                          #     cmp     $0x2d, %al                  # '-'
je8 !unary_neg                          #     je      unary_neg
cmp_$i8,al !126                         #     cmp     $0x7e, %al                  # '~'
je8 !unary_not                          #     je      unary_not
cmp_$i8,al !40                          #     cmp     $0x28, %al                  # '('
je8 !unary_paren                        #     je      unary_paren
call %is_ident                          #     call    is_ident
jc32 %bad_expr                          #     jc      bad_expr
call %word                              #     call    word
movzbl_(rsi),eax                        #     movzbl  (%rsi), %eax
sub_$i8,eax !48                         #     sub     $0x30, %eax                 # '0'-'9': a number
cmp_$i8,eax !9                          #     cmp     $9, %eax
jbe32 %unary_number                     #     jbe     unary_number
cmp_$i8,rdx !1                          #     cmp     $1, %rdx                    # '.': here
jne8 !unary_symbol                      #     jne     unary_symbol
cmpb_$i8,(rsi) !46                      #     cmpb    $0x2e, (%rsi)
jne8 !unary_symbol                      #     jne     unary_symbol
call %here                              #     call    here
mov_rcx,rdx                             #     mov     %rcx, %rdx
ret                                     #     ret
:unary_neg                              # unary_neg:
inc_r12                                 #     inc     %r12
call %expr_unary                        #     call    expr_unary
neg_rax                                 #     neg     %rax
jmp8 !unary_number_only                 #     jmp     unary_number_only
:unary_not                              # unary_not:
inc_r12                                 #     inc     %r12
call %expr_unary                        #     call    expr_unary
not_rax                                 #     not     %rax
:unary_number_only                      # unary_number_only:
test_rdx,rdx                            #     test    %rdx, %rdx
jz8 !unary_done                         #     jz      unary_done
call %kinds                             #     call    kinds
:unary_done                             # unary_done:
ret                                     #     ret
:unary_paren                            # unary_paren:
inc_r12                                 #     inc     %r12
call %expr                              #     call    expr
call %blanks                            #     call    blanks
cmpb_$i8,(r12) !41                      #     cmpb    $0x29, (%r12)               # ')'
jne32 %bad_expr                         #     jne     bad_expr
inc_r12                                 #     inc     %r12
ret                                     #     ret
:unary_symbol                           # unary_symbol:
call %find_sym                          #     call    find_sym
jc32 %undefined                         #     jc      undefined
mov_d8(rdi),rcx !32                     #     mov     S_pass(%rdi), %rcx          # defined before, in this pass?
cmp_d8(rbp),rcx !0                      #     cmp     V_pass(%rbp), %rcx
je8 !unary_symbol_exact                 #     je      unary_symbol_exact
movq_$i32,d8(rbp) !56 %0                #     movq    $0, V_exact(%rbp)
:unary_symbol_exact                     # unary_symbol_exact:
mov_d8(rdi),rdx !24                     #     mov     S_kind(%rdi), %rdx
mov_d8(rdi),rax !16                     #     mov     S_value(%rdi), %rax
add_d32(rbp,rdx,8),rax %160             #     add     V_base(%rbp,%rdx,8), %rax
ret                                     #     ret
:unary_number                           # unary_number:                           # digits, then b or f: a local label's
movzbl_d8(rsi,rdx),ecx !-1              #     movzbl  -1(%rsi,%rdx), %ecx
cmp_$i8,ecx !98                         #     cmp     $0x62, %ecx                 # 'b'
je8 !unary_local                        #     je      unary_local
cmp_$i8,ecx !102                        #     cmp     $0x66, %ecx                 # 'f'
je8 !unary_local                        #     je      unary_local
:unary_plain                            # unary_plain:
call %number                            #     call    number
jc32 %bad_number                        #     jc      bad_number
xor_edx,edx                             #     xor     %edx, %edx
ret                                     #     ret
:unary_local                            # unary_local:
push_rdx                                #     push    %rdx
dec_rdx                                 #     dec     %rdx
call %digits                            #     call    digits
pop_rdx                                 #     pop     %rdx
jc8 !unary_plain                        #     jc      unary_plain
cmp_$i8,rax !100                        #     cmp     $100, %rax
jae32 %bad_local                        #     jae     bad_local
mov_d32(rbp,rax,8),rcx %608             #     mov     COUNTS(%rbp,%rax,8), %rcx   # nf: the next definition of n
cmpb_$i8,d8(rsi,rdx) !-1 !102           #     cmpb    $0x66, -1(%rsi,%rdx)        # 'f'
je8 !unary_local_entry                  #     je      unary_local_entry
dec_rcx                                 #     dec     %rcx                        # nb: the last one
:unary_local_entry                      # unary_local_entry:
call %local_entry                       #     call    local_entry
mov_d8(rdi),rcx !16                     #     mov     L_pass(%rdi), %rcx
