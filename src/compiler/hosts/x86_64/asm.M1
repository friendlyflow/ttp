jne8 !is_acc_done                       #     jne     is_acc_done
cmpq_$i8,d8(rdi) !8 !0                  #     cmpq    $0, O_reg(%rdi)
:is_acc_done                            # is_acc_done:
ret                                     #     ret

:regf                                   # regf:                                   # register operand %rsi into ModRM's reg
mov_d8(rsi),rax !8                      #     mov     O_reg(%rsi), %rax
call %ext_field                         #     call    ext_field
cmpq_$i8,d8(rsi) !24 !0                 #     cmpq    $0, O_rexf(%rsi)
