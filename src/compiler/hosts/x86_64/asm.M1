mov_$i32,edx %6                         #     mov     $6, %edx
call %find_sym                          #     call    find_sym
jc32 %no_start                          #     jc      no_start
mov_d8(rdi),rcx !24                     #     mov     S_kind(%rdi), %rcx
mov_d8(rdi),rax !16                     #     mov     S_value(%rdi), %rax
add_d32(rbp,rcx,8),rax %160             #     add     V_base(%rbp,%rcx,8), %rax
mov_$i32,edi %0x2470000                 #     mov     $OUTBUF, %edi
mov_rax,d8(rdi) !24                     #     mov     %rax, 24(%rdi)
mov_d32(rbp),rax %248                   #     mov     V_shoff(%rbp), %rax         # e_shoff
mov_rax,d8(rdi) !40                     #     mov     %rax, 40(%rdi)
mov_d32(rbp),rax %1432                  #     mov     V_tend(%rbp), %rax          # the code: p_filesz, p_memsz
mov_rax,d8(rdi) !96                     #     mov     %rax, 96(%rdi)
mov_rax,d8(rdi) !104                    #     mov     %rax, 104(%rdi)
mov_d32(rbp),rax %224                   #     mov     V_off+24(%rbp), %rax        # the data: p_offset
mov_rax,d32(rdi) %128                   #     mov     %rax, 128(%rdi)
mov_d32(rbp),rax %184                   #     mov     V_base+24(%rbp), %rax       # p_vaddr, p_paddr
mov_rax,d32(rdi) %136                   #     mov     %rax, 136(%rdi)
mov_rax,d32(rdi) %144                   #     mov     %rax, 144(%rdi)
mov_d8(rbp),rax !104                    #     mov     V_loc+24(%rbp), %rax        # p_filesz: .data
mov_rax,d32(rdi) %152                   #     mov     %rax, 152(%rdi)
mov_d32(rbp),rax %192                   #     mov     V_base+32(%rbp), %rax       # p_memsz: to the end of .bss
add_d8(rbp),rax !112                    #     add     V_loc+32(%rbp), %rax
sub_d32(rbp),rax %184                   #     sub     V_base+24(%rbp), %rax
mov_rax,d32(rdi) %160                   #     mov     %rax, 160(%rdi)
mov_d32(rbp),rdi %240                   #     mov     V_shstr(%rbp), %rdi         # .shstrtab
add_$i32,rdi %0x2470000                 #     add     $OUTBUF, %rdi
lea_rel(rip),rsi %shstrtab              #     lea     shstrtab(%rip), %rsi
mov_$i32,ecx %36                        #     mov     $shstrtab_len, %ecx
rep_movsb                               #     rep movsb
mov_d32(rbp),rdi %248                   #     mov     V_shoff(%rbp), %rdi         # the section headers
add_$i32,rdi %0x2470000                 #     add     $OUTBUF, %rdi
mov_rdi,rdx                             #     mov     %rdi, %rdx
lea_rel(rip),rsi %section_headers       #     lea     section_headers(%rip), %rsi
mov_$i32,ecx %384                       #     mov     $6 * 64, %ecx
rep_movsb                               #     rep movsb
mov_rdx,rdi                             #     mov     %rdx, %rdi
mov_$i32,ecx %1                         #     mov     $1, %ecx
:headers_section                        # headers_section:                        # 1-4: .text .rodata .data .bss
add_$i8,rdi !64                         #     add     $64, %rdi
mov_d32(rbp,rcx,8),rax %160             #     mov     V_base(%rbp,%rcx,8), %rax   # sh_addr
mov_rax,d8(rdi) !16                     #     mov     %rax, 16(%rdi)
