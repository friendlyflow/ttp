:ext_field                              # ext_field:                              # %rax into ModRM's reg (a register's number or a /digit)
movq_$i32,d32(rbp) %304 %1              #     movq    $1, I_hasm(%rbp)
mov_eax,ecx                             #     mov     %eax, %ecx
and_$i8,ecx !7                          #     and     $7, %ecx
