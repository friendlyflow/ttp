:check_imm                              # check_imm:                              # the immediate fits in its bytes
mov_d32(rbp),rcx %376                   #     mov     I_isize(%rbp), %rcx
mov_d32(rbp),rax %368                   #     mov     I_imm(%rbp), %rax
cmp_$i8,rcx !1                          #     cmp     $1, %rcx
