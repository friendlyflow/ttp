:finish                                 # finish:                                 # the bytes of I_* into IBUF, then out
lea_d32(rbp),rdi %400                   #     lea     IBUF(%rbp), %rdi
mov_d32(rbp),rax %280                   #     mov     I_rex(%rbp), %rax
test_rax,rax                            #     test    %rax, %rax
jz8 !finish_op                          #     jz      finish_op
