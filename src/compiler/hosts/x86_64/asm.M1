mov_d32(rbp),rcx %360                   #     mov     I_ripval(%rbp), %rcx
sub_rax,rcx                             #     sub     %rax, %rcx
movslq_ecx,rax                          #     movslq  %ecx, %rax                  # fits in 32 bits
cmp_rax,rcx                             #     cmp     %rax, %rcx
