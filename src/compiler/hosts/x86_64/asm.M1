cmp_(rdi),rax                           #     cmp     (%rdi), %rax
je8 !reg_found                          #     je      reg_found
add_$i8,rdi !16                         #     add     $16, %rdi
jmp8 !reg_next                          #     jmp     reg_next
:reg_found                              # reg_found:
