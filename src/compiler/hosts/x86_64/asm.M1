mov_rax,d8(rdi) !48                     #     mov     %rax, 48(%rdi)
inc_ecx                                 #     inc     %ecx
cmp_$i8,ecx !4                          #     cmp     $4, %ecx
jbe8 !headers_section                   #     jbe     headers_section
