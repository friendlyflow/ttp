mov_rdx,d32(rbp,rcx,8) %160             #     mov     %rdx, V_base(%rbp,%rcx,8)
add_d8(rbp,rcx,8),rax !80               #     add     V_loc(%rbp,%rcx,8), %rax
ret                                     #     ret

:alignup                                # alignup:                                # %rax up to a multiple of %rcx, a power of 2
dec_rcx                                 #     dec     %rcx
add_rcx,rax                             #     add     %rcx, %rax
not_rcx                                 #     not     %rcx
and_rcx,rax                             #     and     %rcx, %rax
ret                                     #     ret

:headers                                # headers:                                # the ELF header, the program headers, .shstrtab, the section headers
mov_$i32,ecx %1                         #     mov     $1, %ecx
:headers_bytes                          # headers_bytes:                          # each section has bytes
cmpq_$i8,d8(rbp,rcx,8) !80 !0           #     cmpq    $0, V_loc(%rbp,%rcx,8)
je32 %empty_section                     #     je      empty_section
