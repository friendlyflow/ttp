:rm_disp32                              # rm_disp32:                              # mod 10
movq_$i32,d32(rbp) %344 %4              #     movq    $4, I_dsize(%rbp)
orq_$i32,d32(rbp) %312 %128             #     orq     $0x80, I_modrm(%rbp)
:rm_base                                # rm_base:
test_$i8,al !8                          #     test    $8, %al                     # r8-r15: REX.B
jz8 !rm_base_low                        #     jz      rm_base_low
orq_$i8,d32(rbp) %280 !1                #     orq     $1, I_rex(%rbp)
:rm_base_low                            # rm_base_low:
and_$i8,eax !7                          #     and     $7, %eax
mov_d8(rsi),rdx !72                     #     mov     O_index(%rsi), %rdx
