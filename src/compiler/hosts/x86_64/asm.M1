add_d8(rbp),rax !112                    #     add     V_loc+32(%rbp), %rax        # (its address)
mov_$i32,ecx %8                         #     mov     $8, %ecx
call %alignup                           #     call    alignup
sub_d32(rbp),rax %192                   #     sub     V_base+32(%rbp), %rax
mov_rax,d8(rbp) !112                    #     mov     %rax, V_loc+32(%rbp)
