:emit_byte                              # emit_byte:                              # the byte %al at here, in the last pass; counted
mov_d8(rbp),rcx !24                     #     mov     V_sec(%rbp), %rcx
cmpq_$i8,d8(rbp) !8 !0                  #     cmpq    $0, V_emit(%rbp)
je8 !emit_byte_count                    #     je      emit_byte_count
