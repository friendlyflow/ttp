jns8 !rm_sib                            #     jns     rm_sib
cmp_$i8,eax !4                          #     cmp     $4, %eax                    # %rsp, %r12: a SIB without index
je8 !rm_sib                             #     je      rm_sib
or_rax,d32(rbp) %312                    #     or      %rax, I_modrm(%rbp)
