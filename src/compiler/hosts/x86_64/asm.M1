mov_d8(rsi),rcx !32                     #     mov     O_val(%rsi), %rcx
sub_rax,rcx                             #     sub     %rax, %rcx
mov_rcx,d32(rbp) %368                   #     mov     %rcx, I_imm(%rbp)
jmp32 %finish                           #     jmp     finish

:indirect                               # indirect:                               # *operand: FF /%eax, and back to the line's end
cmpq_$i8,d32(rbp) %504 !0               #     cmpq    $0, OP0+O_ind(%rbp)
je8 !indirect_done                      #     je      indirect_done
pop_rcx                                 #     pop     %rcx                        # not back to the caller
call %ext_field                         #     call    ext_field
mov_$i32,eax %255                       #     mov     $0xff, %eax
call %op1                               #     call    op1
lea_d32(rbp),rsi %416                   #     lea     OP0(%rbp), %rsi
call %rm                                #     call    rm
jmp32 %finish                           #     jmp     finish
:indirect_done                          # indirect_done:
ret                                     #     ret

:c_byte                                 # c_byte:                                 # ret: its opcode
mov_d32(rbp),rax %392                   #     mov     I_ext(%rbp), %rax
call %op1                               #     call    op1
jmp32 %finish                           #     jmp     finish
:c_0f                                   # c_0f:                                   # syscall: 0F, its opcode
mov_d32(rbp),rax %392                   #     mov     I_ext(%rbp), %rax
call %op2                               #     call    op2
jmp32 %finish                           #     jmp     finish

# The output file.

:layout                                 # layout:                                 # every section's file offset and address, as ld places them
mov_$i32,eax %176                       #     mov     $0xb0, %eax                 # after the ELF header and two program headers
mov_$i32,ecx %1                         #     mov     $1, %ecx
call %place                             #     call    place                       # .text
mov_$i32,ecx %2                         #     mov     $2, %ecx
call %place                             #     call    place                       # .rodata: the end of the code segment
mov_rax,d32(rbp) %1432                  #     mov     %rax, V_tend(%rbp)
add_$i32,rax %0x400000                  #     add     $ADDR, %rax                 # its address v
mov_rax,rdx                             #     mov     %rax, %rdx
mov_eax,r8d                             #     mov     %eax, %r8d
and_$i32,r8d %4095                      #     and     $0xfff, %r8d
mov_$i32,ecx %0x1000                    #     mov     $0x1000, %ecx
call %alignup                           #     call    alignup
add_r8,rax                              #     add     %r8, %rax                   # the data segment from the next page on: v2
mov_rax,r9                              #     mov     %rax, %r9
sub_rdx,r9                              #     sub     %rdx, %r9                   # v2 - v: its addresses after its file offsets
mov_d32(rbp),rcx %144                   #     mov     V_align+24(%rbp), %rcx
call %alignup                           #     call    alignup
mov_rax,d32(rbp) %184                   #     mov     %rax, V_base+24(%rbp)       # .data
mov_rax,rdx                             #     mov     %rax, %rdx
sub_$i32,rdx %0x400000                  #     sub     $ADDR, %rdx
sub_r9,rdx                              #     sub     %r9, %rdx
mov_rdx,d32(rbp) %224                   #     mov     %rdx, V_off+24(%rbp)
add_d8(rbp),rax !104                    #     add     V_loc+24(%rbp), %rax
mov_d32(rbp),rcx %152                   #     mov     V_align+32(%rbp), %rcx
call %alignup                           #     call    alignup
mov_rax,d32(rbp) %192                   #     mov     %rax, V_base+32(%rbp)       # .bss
mov_d32(rbp),rax %224                   #     mov     V_off+24(%rbp), %rax        # its file offset, and .shstrtab's: the end
add_d8(rbp),rax !104                    #     add     V_loc+24(%rbp), %rax        # of .data (ld's, though .bss be aligned)
mov_rax,d32(rbp) %232                   #     mov     %rax, V_off+32(%rbp)
mov_rax,d32(rbp) %240                   #     mov     %rax, V_shstr(%rbp)
add_$i32,rax %36                        #     add     $shstrtab_len, %rax         # then the section headers
mov_$i32,ecx %8                         #     mov     $8, %ecx
call %alignup                           #     call    alignup
mov_rax,d32(rbp) %248                   #     mov     %rax, V_shoff(%rbp)
add_$i32,rax %384                       #     add     $6 * 64, %rax
mov_rax,d32(rbp) %256                   #     mov     %rax, V_fend(%rbp)
cmp_$i32,rax %0x1000000                 #     cmp     $OUTBUF_END - OUTBUF, %rax
ja32 %output_full                       #     ja      output_full
ret                                     #     ret

:place                                  # place:                                  # section %rcx from file offset %rax, aligned; %rax = its end
push_rcx                                #     push    %rcx
mov_d8(rbp,rcx,8),rcx !120              #     mov     V_align(%rbp,%rcx,8), %rcx
call %alignup                           #     call    alignup
